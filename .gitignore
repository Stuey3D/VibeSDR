# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native build artifacts (keep source, exclude build output)
/ios/build/
/ios/Pods/
/android/build/
/android/.gradle/
/android/app/build/

# Release binaries (distributed via GitHub Releases, not repo)
*.ipa
*.apk

# Reference assets (local dev only)
Reference/

# Android release signing secrets (NEVER commit)
android/keystore.properties
android/app/upload-keystore.jks
*.keystore

# stray local iOS build/derived-data dirs
ios/build-check/
ios/build/

# local storage cleanup helper (not part of the app)
cleanup.sh

# V5 vibedsp host-test build output (dev machine only)
android/app/src/main/cpp/vibedsp/test/build/

# vibedsp host harness binary + cmake build dir
android/app/src/main/cpp/vibedsp/test/fm_probe
android/app/src/main/cpp/vibedsp/test/build/

# Spike (WristSDR) watch build output + logs — dev machine only
spike/WristSDR/build/
spike/WristSDR/build-*.log
/build/
vibeserver/mac/AppIcon.icns
vibeserver/mac/Resources/

# Notarised VibeServer release artefacts (attached to GitHub releases, not tracked)
VibeServer-*.zip

# tvOS native project (generated once by EXPO_TV=1 prebuild, then hand-maintained — see briefs/BRIEF-tvos-app.md)
/tvos/Pods/
/tvos/build/
tvos/.xcode.env.local

# App Store submission helper — lives in ~/.appstoreconnect/tools/, carries private contact details
scripts/asc-submit.py

# Wrangler local cache — contained a Cloudflare account id and personal email
.wrangler/

# Scratch probe scripts left at the root
fr2.mjs

# SDRplay headers staged into the build context at publish time — theirs to license,
# so they are copied from the build machine per build and never committed. See
# scripts/publish-apt-docker.sh and vibeserver/linux/Dockerfile.build.
vibeserver/linux/sdrplay-inc/

# cloudflared for Android — 27 MB, rebuilt by tools/cloudflared-android/build.sh
android/app/src/main/cpp/cloudflared/

# ★ cloudflared binaries we SHIP but do not author — fetched by tools/cloudflared-desktop/fetch.sh.
#   Committing 110 MB of somebody else's release artefacts would bloat every clone for ever.
tools/cloudflared-desktop/bin/

# Tunnel-drop debugging harness — a scratch probe, not release material. It was swept into a
# release commit by `git add -A` on 2026-08-26 and taken back out before it reached GitHub.
.ws-hold.mjs
