<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- ★★★ COARSE ONLY, DELIBERATELY. ACCESS_FINE_LOCATION was declared here and NEVER REQUESTED:
       the only runtime request in the app is COARSE (instancesApi.ts), and getLocation() walks
       whatever providers are enabled catching SecurityException per provider, so it simply skips
       GPS when fine is not granted. Declaring a permission we never ask for is pure Play-review
       liability — fine location needs its own declaration and justification — for a feature that
       sorts a server list by distance and aligns a decode map.
       ★ Notes claimed this went for build 86; no commit ever removed it (found 07-31, removed
       08-02 before the 10.0.2 Play submission).
       ★ iOS has the same intent expressed its own way: NSLocationDefaultAccuracyReduced = true. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <!-- mDNS/NSD discovery of networked RTL-TCP servers -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <!-- RTL-TCP server: connectedDevice FGS + wake lock (keep USB/TCP stream alive screen-off) -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
  <!-- ★★★ NO FOREGROUND_SERVICE_DATA_SYNC. It was declared here for a front-door service that
       would bind a port and route with no device to claim connectedDevice — and that service was
       never built. NOTHING calls startForeground with FOREGROUND_SERVICE_TYPE_DATA_SYNC: the only
       two foreground services are RtlTcpServerService (connectedDevice) and VibeStreamService
       (mediaPlayback), and no dependency asks for it either (checked against the MERGED manifest,
       not just this one).
       ★★ It is not free to leave in. Google Play makes you DECLARE and JUSTIFY every foreground
       service permission — a video for each, and a review question per task type. Declaring one
       the app cannot use means answering for a capability it does not have, on every submission,
       for ever. Same shape as ACCESS_FINE_LOCATION, which was declared here and never requested.
       ★ If a real dataSync service is ever built, add this back WITH the service in the same
       edit — the permission and the foregroundServiceType belong together. -->
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- V4 local SDR: USB host for RTL-SDR over OTG (optional; phones without it still run as network clients) -->
  <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/backup_rules_v2" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:usesCleartextTraffic="true">
    <!-- ★★★ LET A RELEASE BUILD BE PROFILED, WITHOUT MAKING IT DEBUGGABLE. Android 10+ only.
         `shell="true"` permits heapprofd and Perfetto from adb and NOTHING ELSE — no debugger, no
         run-as, no reduced hardening. Google recommends shipping it precisely so production
         behaviour can be measured instead of inferred from a debug build that allocates
         differently.
         ★ Added 2026-09-08 after an audit could not attribute 163 MB of native heap on the
           Xcover: on a `user` build /proc/pid/maps, smaps and run-as are all closed, so the only
           honest answer available was "measured but unexplained". This is the instrument that
           answers it, and it will be there the next time too. -->
    <profileable android:shell="true" tools:targetApi="q"/>
    <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <!-- ★★★ ICON & ART (2026-10-05): the launcher icon follows the user's colour through <activity-alias>es, one
         per colour, switched with setComponentEnabledSetting (VibeAppIcon.kt). The REAL activity is VibeActivity
         (a bare subclass of MainActivity — all the code stays in MainActivity.kt) and carries no MAIN/LAUNCHER.
         ★ The GREEN alias is NAMED ".MainActivity" on purpose: it is the very component every existing install's
           home-screen shortcut points at, so an update changes nothing for anyone who never picks a colour.
         ★ The deep links (vibesdr://, sdr://) and USB_DEVICE_ATTACHED stay on the REAL activity, which is never
           disabled — they work whichever alias is on. Android keeps a USB "always open with" choice per PACKAGE,
           not per component, so moving the filter off the old component name loses nobody's default.
         ★ Anything that launches the app explicitly must use getLaunchIntentForPackage (it resolves the enabled
           alias) or VibeActivity — never `.MainActivity`, which is disabled while another colour is picked. -->
    <activity android:name=".VibeActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="unspecified">
      <!-- vibesdr:// deep links (QR / "Open in VibeSDR" from UberSDR overlay) -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="vibesdr"/>
      </intent-filter>
      <!-- sdr:// SpyServer links (Airspy directory / SDR# convention). Separate
           filter (not a 2nd <data> on the vibesdr one) so schemes never
           cross-product with future host rules. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="sdr"/>
      </intent-filter>
      <!-- Offer "Open with VibeSDR" when an RTL-SDR dongle is plugged in. The
           device_filter lists the RTL2832U VID/PIDs VibeSDR supports. -->
      <intent-filter>
        <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
      </intent-filter>
      <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                 android:resource="@xml/device_filter"/>
    </activity>
    <activity-alias android:name=".MainActivity" android:targetActivity=".VibeActivity" android:enabled="true" android:exported="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconRed" android:targetActivity=".VibeActivity" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_red" android:roundIcon="@mipmap/ic_launcher_red_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconAmber" android:targetActivity=".VibeActivity" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_amber" android:roundIcon="@mipmap/ic_launcher_amber_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconBlue" android:targetActivity=".VibeActivity" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_blue" android:roundIcon="@mipmap/ic_launcher_blue_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconWhite" android:targetActivity=".VibeActivity" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_white" android:roundIcon="@mipmap/ic_launcher_white_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconTeal" android:targetActivity=".VibeActivity" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_teal" android:roundIcon="@mipmap/ic_launcher_teal_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconNeon" android:targetActivity=".VibeActivity" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_neon" android:roundIcon="@mipmap/ic_launcher_neon_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <service android:name=".RtlTcpServerService" android:foregroundServiceType="connectedDevice" android:exported="false"/>
    <!-- ★★★ PUT A RUNNING SERVER BACK AFTER AN UPDATE — see VibeUpdateReceiver. A package replace
         stops the app and Android does not recreate the service, so an unattended receiver went
         dark and stayed dark; MY_PACKAGE_REPLACED is the one signal that says it happened. -->
    <!-- ★ Start when power returns — acts only on Android 7.0 (this app's minSdk is 24, so 7.0 is the one
         version in VibeBootStart's range), only if the owner switched it on. See VibeBootStart. -->
    <receiver android:name=".VibeBootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
      </intent-filter>
    </receiver>
    <receiver android:name=".VibeUpdateReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
      </intent-filter>
    </receiver>
        <service android:name=".VibeStreamService" android:foregroundServiceType="mediaPlayback" android:exported="true">
      <intent-filter>
        <action android:name="android.media.browse.MediaBrowserService"/>
      </intent-filter>
    </service>
  </application>
</manifest>