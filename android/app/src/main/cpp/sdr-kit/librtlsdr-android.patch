 	struct e4k_state e4k_s;
@@ -1442,6 +1443,60 @@ int rtlsdr_check_dongle_model(void *dev, char *manufact_check, char *product_che
 }
 
 
+/* ★ ANDROID: everything after the device handle is open, shared by rtlsdr_open() and
+ * rtlsdr_open_sys_dev(). Split out rather than duplicated — the tail probes the tuner and applies
+ * the RTL-SDR Blog quirks, and two copies would drift the moment either is touched. */
+static int rtlsdr_open_tail(rtlsdr_dev_t *dev, rtlsdr_dev_t **out_dev);
+
+int rtlsdr_open_sys_dev(rtlsdr_dev_t **out_dev, intptr_t sys_dev)
+{
+	int r;
+	rtlsdr_dev_t *dev = NULL;
+
+	dev = malloc(sizeof(rtlsdr_dev_t));
+	if (NULL == dev)
+		return -ENOMEM;
+
+	memset(dev, 0, sizeof(rtlsdr_dev_t));
+	memcpy(dev->fir, fir_default, sizeof(fir_default));
+
+	/* ★★★ NO DEVICE DISCOVERY ON ANDROID. An unrooted Android process cannot enumerate USB —
+	 *     only the Java layer can, and it hands us an already-open FILE DESCRIPTOR. Asking libusb
+	 *     to scan would fail before we ever got to use it. */
+	libusb_set_option(NULL, LIBUSB_OPTION_NO_DEVICE_DISCOVERY, NULL);
+
+	r = libusb_init(&dev->ctx);
+	if (r < 0) {
+		free(dev);
+		return -1;
+	}
+
+	dev->dev_lost = 1;
+
+	r = libusb_wrap_sys_device(dev->ctx, sys_dev, &dev->devh);
+	if (r < 0 || dev->devh == NULL) {
+		fprintf(stderr, "libusb_wrap_sys_device failed: %d\n", r);
+		goto err;
+	}
+
+	r = libusb_claim_interface(dev->devh, 0);
+	if (r < 0) {
+		fprintf(stderr, "usb_claim_interface error %d\n", r);
+		goto err;
+	}
+
+	return rtlsdr_open_tail(dev, out_dev);
+err:
+	if (dev) {
+		if (dev->devh)
+			libusb_close(dev->devh);
+		if (dev->ctx)
+			libusb_exit(dev->ctx);
+		free(dev);
+	}
+	return r;
+}
+
 int rtlsdr_open(rtlsdr_dev_t **out_dev, uint32_t index)
 {
 	int r;
@@ -1529,6 +1584,23 @@ int rtlsdr_open(rtlsdr_dev_t **out_dev, uint32_t index)
 		goto err;
 	}
 
+	return rtlsdr_open_tail(dev, out_dev);
+err:
+	if (dev) {
+		if (dev->devh)
+			libusb_close(dev->devh);
+		if (dev->ctx)
+			libusb_exit(dev->ctx);
+		free(dev);
+	}
+	return r;
+}
+
+static int rtlsdr_open_tail(rtlsdr_dev_t *dev, rtlsdr_dev_t **out_dev)
+{
+	int r;
+	uint8_t reg;
+
 	dev->rtl_xtal = DEF_RTL_XTAL_FREQ;
 
 	/* perform a dummy write, if it fails, reset the device */
@@ -2055,3 +2127,46 @@ int rtlsdr_set_bias_tee(rtlsdr_dev_t *dev, int on)
 {
 	return rtlsdr_set_bias_tee_gpio(dev, 0, on);
 }
+
+int rtlsdr_get_r82xx_state(rtlsdr_dev_t *dev, uint8_t *hw, int len, uint8_t *shadow,
+			   uint32_t *int_freq, uint32_t *xtal, int *has_lock)
+{
+	/* ★ An R82xx read always starts at register 0x00 and is ONE I2C transaction through the
+	 *  RTL2832's bridge, whose read length is limited (a 30-byte read fails on a NooElec R820T2
+	 *  that reads 5 bytes all day long in r82xx_set_pll). So ask for everything, then step down
+	 *  until the bridge accepts it, and remember what worked. The caller learns how many registers
+	 *  it got from the return value. */
+	static const int tries[] = { 30, 24, 23, 16, 8, 5 };
+	unsigned int i;
+	int r = -1, got = 0;
+
+	if (!dev || !hw || len <= 0)
+		return -1;
+	if ((dev->tuner_type != RTLSDR_TUNER_R820T) && (dev->tuner_type != RTLSDR_TUNER_R828D))
+		return -2;
+
+	rtlsdr_set_i2c_repeater(dev, 1);
+	for (i = 0; i < sizeof(tries) / sizeof(tries[0]); i++) {
+		int n = tries[i];
+		if (n > len || (dev->r82xx_max_read && n > dev->r82xx_max_read))
+			continue;
+		r = r82xx_read_regs(&dev->r82xx_p, hw, n);
+		if (r == 0) {
+			got = n;
+			dev->r82xx_max_read = n;
+			break;
+		}
+	}
+	rtlsdr_set_i2c_repeater(dev, 0);
+
+	if (shadow)
+		memcpy(shadow, dev->r82xx_p.regs, NUM_REGS);
+	if (int_freq)
+		*int_freq = dev->r82xx_p.int_freq;
+	if (xtal)
+		*xtal = dev->r82xx_c.xtal;
+	if (has_lock)
+		*has_lock = dev->r82xx_p.has_lock;
+
+	return got > 0 ? got : (r < 0 ? r : -3);
+}
diff --git a/src/tuner_r82xx.c b/src/tuner_r82xx.c
index 8c3b2b1..574c266 100644
--- a/src/tuner_r82xx.c
+++ b/src/tuner_r82xx.c
@@ -1425,3 +1425,14 @@ static int r82xx_gpio(struct r82xx_priv *priv, int enable)
 	return r82xx_write_reg_mask(priv, 0x0f, enable ? 1 : 0, 0x01);
 }
 #endif
+
+/* ★ VibeSDR: the chip's own registers, read back — the only way to see what the tuner was really
+ *  left with. The shadow-register skip (r82xx_write) and an I2C write that fails after the shadow
+ *  is stored can both leave the chip and librtlsdr's copy disagreeing, and nothing else reports it.
+ *  A read always starts at register 0x00 on the R82xx. */
+int r82xx_read_regs(struct r82xx_priv *priv, uint8_t *val, int len)
+{
+	if (len <= 0 || len > NUM_REGS)
+		return -1;
+	return r82xx_read(priv, 0x00, val, len);
+}
