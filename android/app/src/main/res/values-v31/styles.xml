<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Android 12+ draws its own launch screen: the launcher icon on this colour. Without it the system used a
       light default behind the new dark icon. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/splash_window</item>
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
  </style>
</resources>
