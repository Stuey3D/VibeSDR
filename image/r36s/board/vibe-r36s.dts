// vibe-r36s.dts — the VibeSDR handheld's own device-tree overlay, applied by U-Boot after ROCKNIX's mipi-panel.dtbo.
// Built at image time: dtc -@ -I dts -O dtb -o vibe-r36s.dtbo vibe-r36s.dts
//
// ★★★ THE STOCK CPU STEPS, 408–1296 MHz (Stuart 2026-11-05: schedutil + the stock table). ROCKNIX's EE-clone tree gives
//     the A35s only 1008 / 1296 (and 1416 as turbo): a receiver idling at 1008 MHz wastes the battery. These are the
//     steps and voltages of the vendor tree that shipped on this unit (rf3536k3ka.dtb, cpu0-opp-table, its base
//     `opp-microvolt` row — the highest of its PVTM L0–L3 rows, so never under-volted). vdd_arm allows 0.85–1.35 V.
//     ★ NEVER ABOVE 1296: 1416 is switched off here (the vendor tree had it disabled; ROCKNIX makes it turbo) and 1512
//     needs 1.35 V flat out — an overclock (§0).
// ★ 1008 and 1296 already exist in ROCKNIX's table with the same voltages; restating them changes nothing.
// ★★ The backlight's boot level 128 → 120, Stuart's default, so the kernel and vibe-hwd agree from the first frame.
/dts-v1/;
/plugin/;

&cpu0_opp_table {
	opp-408000000 {
		opp-hz = /bits/ 64 <408000000>;
		opp-microvolt = <950000 950000 1350000>;
		clock-latency-ns = <40000>;
		opp-suspend;
	};
	opp-600000000 {
		opp-hz = /bits/ 64 <600000000>;
		opp-microvolt = <950000 950000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-816000000 {
		opp-hz = /bits/ 64 <816000000>;
		opp-microvolt = <1050000 1050000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1008000000 {
		opp-hz = /bits/ 64 <1008000000>;
		opp-microvolt = <1175000 1175000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1104000000 {
		opp-hz = /bits/ 64 <1104000000>;
		opp-microvolt = <1300000 1300000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1200000000 {
		opp-hz = /bits/ 64 <1200000000>;
		opp-microvolt = <1300000 1300000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1248000000 {
		opp-hz = /bits/ 64 <1248000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1296000000 {
		opp-hz = /bits/ 64 <1296000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1416000000 {
		status = "disabled";
	};
};

// ★★★ THE STOCK GPU STEPS, 200–520 MHz (Stuart, 2026-11-07: "what is the GPU doing can that be downclocked?"). ROCKNIX's
//     tree gives the Mali-G31 ONE step, 560 MHz at 1.15 V — and the GPU shares vdd_logic with the memory controller
//     (mali-supply and the dmc's center-supply are the same regulator), so a GPU pinned at 1.15 V held the whole rail
//     there: the 450 MHz memory cap (vibe-cpu.service) could not take the rail down to its 0.95 V. These are the vendor
//     tree's steps (rf3536k3ka.dtb gpu-opp-table) at its base `opp-microvolt` — the highest of its PVTM L0–L3 rows, so
//     never under-volted. A 640×480 UI asks little of it: the devfreq governor (simple_ondemand) settles low by itself.
// ★ ROCKNIX's own 560 MHz / 1.15 V stays, the top step for a heavy moment (the map).
// ★★★ <target min max> — "this voltage OR HIGHER", as the CPU steps are written (handheld27: a bare <950000> asked the
//     rail for EXACTLY 0.95 V while the memory controller on the same rail was holding at least 1.05 V; the regulator
//     could meet both only with an empty range, refused (-22: "failed to set voltage (950000 950000 950000)"), and
//     Panfrost gave up — the UI fell back to llvmpipe at 95 % CPU). With a range the rail settles at the higher of the
//     two needs, and drops to 0.95 V when both are low.
&gpu_opp_table {
	opp-200000000 {
		opp-hz = /bits/ 64 <200000000>;
		opp-microvolt = <950000 950000 1350000>;
	};
	opp-300000000 {
		opp-hz = /bits/ 64 <300000000>;
		opp-microvolt = <975000 975000 1350000>;
	};
	opp-400000000 {
		opp-hz = /bits/ 64 <400000000>;
		opp-microvolt = <1050000 1050000 1350000>;
	};
	opp-480000000 {
		opp-hz = /bits/ 64 <480000000>;
		opp-microvolt = <1125000 1125000 1350000>;
	};
	opp-520000000 {
		opp-hz = /bits/ 64 <520000000>;
		opp-microvolt = <1175000 1175000 1350000>;
	};
};

&backlight {
	default-brightness-level = <120>;
};
