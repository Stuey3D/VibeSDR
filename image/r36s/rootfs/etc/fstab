# /etc/fstab — the VibeSDR R36S handheld
# ★★ / is NOT here: the kernel mounts the ext4 root read-only and overlay-init lays a RAM overlay over it.
# ★★ Nor are the state partition (vibe-state.service), the boot partition (also vibe-state, read-only at
#    /boot/firmware) or VIBESDR (vibe-card.service): a fstab device job for a missing partition held the engine back
#    for ever; those services wait a bounded time and carry on.
tmpfs  /tmp  tmpfs  mode=1777,size=64M  0 0
