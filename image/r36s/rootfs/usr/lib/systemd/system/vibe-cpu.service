[Unit]
Description=VibeSDR CPU: schedutil over the stock 408–1296 MHz steps; the memory clock at most 450 MHz, the GPU 300 MHz
DefaultDependencies=no
After=sysinit.target
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
# ★ schedutil (Stuart 2026-11-05) — also set by cpufreq.default_governor= on the kernel command line; this repeats it in
#   case the kernel ignored the parameter, and caps every policy at 1296 MHz whatever the device tree says.
ExecStart=-/bin/sh -c 'for p in /sys/devices/system/cpu/cpufreq/policy*; do echo schedutil > $p/scaling_governor; echo 1296000 > $p/scaling_max_freq; done'
# ★★ THE MEMORY CLOCK AT MOST 450 MHz (Stuart, 2026-11-07, the battery; handheld21's power log): the DDR's own governor sat
#    at its top step, 666 MHz at 1.05 V, for 47 of 48 minutes — the receiver's DSP keeps it "busy" by its rule. 450 MHz runs
#    at 0.95 V (the device tree's opp-table-dmc) and is still many times what a 640×480 screen and a 2 MS/s receiver move.
#    The governor still steps down to 194 MHz when there is nothing to do.
ExecStart=-/bin/sh -c 'for d in /sys/class/devfreq/dmc; do [ -w $d/max_freq ] && echo 450000000 > $d/max_freq; done'
# ★★ THE GPU AT MOST 300 MHz, 0.975 V (Stuart, 2026-11-07, handheld28's log): with the stock steps back (vibe-r36s.dts)
#    Panfrost's governor still sat at 400–560 MHz (1.05–1.15 V) — it steps up as soon as the GPU is 45 % busy, and the
#    waterfall at 30 fps keeps it there — so the rail it shares with the memory controller stayed high. 560 MHz ran it
#    under half busy: 300 MHz is ~¾ busy, still inside a 640×480 frame at 30 fps (vibe-hhui logs its fps: if it ever
#    falls short — the map — 400 MHz / 1.05 V is the next step).
#    ★ Panfrost is a module (systemd-modules-load): its devfreq node may not exist yet — wait up to 5 s for it.
ExecStart=-/bin/sh -c 'd=/sys/class/devfreq/ff400000.gpu; i=0; while [ ! -w $d/max_freq ] && [ $i -lt 25 ]; do sleep 0.2; i=$((i+1)); done; [ -w $d/max_freq ] && echo 300000000 > $d/max_freq'

[Install]
WantedBy=basic.target
