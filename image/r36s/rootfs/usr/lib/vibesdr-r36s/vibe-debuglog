#!/bin/sh
# vibe-debuglog — ONLY with `vibe.debuglog` on the kernel command line (extlinux.conf on VIBEBOOT, editable from any
# computer): every 15 s, a snapshot of the running system to the card — Diagnostic logs/debuglog-<boot>.txt.
#
# ★★★ WHY. The handheld has no SSH and no network (Stuart), and the journal lives in RAM. When the receiver itself
#     will not come up (the first card, 2026-11-06: no audio, a waterfall row every ~10 s, START RADIO dead), the
#     page's EXPORT DIAGNOSTICS cannot be reached. This writes what that export would, from outside the page, while
#     the fault is happening — and the last snapshot survives a crash or a pulled battery.
# ★ OFF BY DEFAULT (ConditionKernelCommandLine): the card is not a log disk. Each write is temp file + rename.
# ★ No card mounted: the boot partition is remounted read-write for these writes only — a debug aid, never normal use.
set -u
CARD=/media/VIBESDR
BOOT=/boot/firmware
ID=$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo boot)

target() {
  if mountpoint -q "$CARD"; then mkdir -p "$CARD/Diagnostic logs" 2>/dev/null && { echo "$CARD/Diagnostic logs"; return; }; fi
  if mountpoint -q "$BOOT"; then mount -o remount,rw "$BOOT" 2>/dev/null && { echo "$BOOT"; return; }; fi
  echo ""
}

snap() {
  echo "=== vibe-debuglog $(date -u '+%Y-%m-%d %H:%M:%S UTC') · up $(cut -d' ' -f1 /proc/uptime) s · load $(cat /proc/loadavg)"
  echo "image $(cat /etc/vibesdr-r36s-version 2>/dev/null) · kernel $(uname -r)"
  echo "cmdline $(cat /proc/cmdline)"
  echo; echo "=== cpufreq"
  for p in /sys/devices/system/cpu/cpufreq/policy*; do
    echo "$p: gov=$(cat "$p/scaling_governor" 2>/dev/null) cur=$(cat "$p/scaling_cur_freq" 2>/dev/null) min=$(cat "$p/scaling_min_freq" 2>/dev/null) max=$(cat "$p/scaling_max_freq" 2>/dev/null) avail=[$(cat "$p/scaling_available_frequencies" 2>/dev/null)]"
  done
  for z in /sys/class/thermal/thermal_zone*; do echo "$z $(cat "$z/type" 2>/dev/null) $(cat "$z/temp" 2>/dev/null)"; done
  echo; echo "=== memory"; free -m; cat /proc/pressure/cpu /proc/pressure/memory /proc/pressure/io 2>/dev/null
  echo; echo "=== top"; top -b -n 1 -w 200 2>/dev/null | head -30
  echo; echo "=== failed units"; systemctl --failed --no-pager --no-legend 2>&1
  echo; echo "=== our units"
  for u in vibe-splash vibe-state vibe-card vibe-hwd vibe-clock vibe-cpu vibe-bootkeys vibeserver-handheld vibe-kiosk; do
    echo "$u: $(systemctl show -p ActiveState,SubState,NRestarts,ExecMainStatus --value "$u" 2>/dev/null | tr '\n' ' ')"
  done
  echo; echo "=== GPU / display / input / sound"
  ls -l /dev/dri 2>&1; lsmod 2>/dev/null | grep -E '^(panfrost|mali|rockchipdrm|gpu_sched)' ; cat /sys/kernel/debug/dri/0/name 2>/dev/null
  cat /proc/bus/input/devices 2>/dev/null | grep -E '^N: Name'
  cat /proc/asound/cards 2>/dev/null; amixer -c rk817ext contents 2>&1 | grep -A2 -E "Master Playback Volume|Playback Mux" | head -12
  ls -l /run/vibe-hwd.sock 2>&1
  for u in /sys/bus/usb/devices/*; do [ -f "$u/idVendor" ] && echo "usb $(basename "$u") $(cat "$u/idVendor"):$(cat "$u/idProduct") $(cat "$u/product" 2>/dev/null)"; done
  echo; echo "=== journal (this boot, last 4000 lines)"; journalctl -b --no-pager -o short-monotonic -n 4000 2>&1
  echo; echo "=== kernel (last 400 lines)"; dmesg 2>/dev/null | tail -400
}

while :; do
  D=$(target)
  if [ -n "$D" ]; then
    F="$D/debuglog-$ID.txt"
    snap > "$F.tmp" 2>&1 && sync "$F.tmp" 2>/dev/null; mv -f "$F.tmp" "$F"; sync
    [ "$D" = "$BOOT" ] && mount -o remount,ro "$BOOT" 2>/dev/null
  fi
  sleep 15
done
