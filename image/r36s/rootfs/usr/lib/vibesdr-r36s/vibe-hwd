def rd_num(path, scale=1e6):
    """A sysfs µ-unit figure scaled (µV → V by default); None when missing or not a number."""
    v = rd(path)
    try:
        return int(v) / scale
    except (TypeError, ValueError):
        return None

def cal_pct(q_now_uah, result):
    """★ THE % ON THE MEASURED CAPACITY: where the counter is between this unit's own empty and full, as calibrated —
    (now − the counter at empty) / the measured capacity. None when not calibrated or the counter cannot be read."""
    if not result or q_now_uah is None:
        return None
    try:
        span = float(result["mah"]) * 1000.0
        q_empty = float(result["qEmpty"])
    except (KeyError, TypeError, ValueError):
        return None
    if span <= 0:
        return None
    return int(max(0, min(100, round((q_now_uah - q_empty) * 100.0 / span))))

def cal_plausible(mah, design_mah):
    """A measured capacity worth keeping: 30 … 150 % of what the gauge assumes (or ≥ 200 mAh when it says nothing)."""
    if mah is None or mah <= 0:
        return False
    if not design_mah:
        return mah >= 200
    return 0.3 * design_mah <= mah <= 1.5 * design_mah

class EmptyDetector:
    """CAL_EMPTY_V or under, held CAL_EMPTY_HOLD_S with no reading above it (a reading of None changes nothing)."""
    def __init__(self, volts=CAL_EMPTY_V, hold_s=CAL_EMPTY_HOLD_S):
        self.volts, self.hold_s, self.since = volts, hold_s, None
    def feed(self, t, v):
        if v is None:
            return False
        if v > self.volts:
            self.since = None
            return False
        if self.since is None:
            self.since = t
        return t - self.since >= self.hold_s

# ── is the battery REALLY full? (Stuart 2026-11-16) ──────────────────────────────────────────────────────────────────
# ★★★ THE GAUGE'S % IS NEVER THE JUDGE. On Stuart's unit the gauge read 100 % for ~30 min with 0.96 A still going into
#     the cell at 4.15 V — the charger still in constant CURRENT, nowhere near full. An uncalibrated gauge says 100 % when
#     its believed capacity is used up, which is exactly the number calibration exists to find. So "full" is judged from
#     the CHARGER'S PHYSICS, from what the rk817 itself is set to and reports:
#       • CV — the constant-voltage ceiling: CHRG_OUT 0xE4 bits 6:4, 4.10 + 0.05 × sel V (the driver reads the same
#         register for sysfs constant_charge_voltage_max; 0xA0 here = 4.20 V). Never assumed to be 4.20.
#       • TERMINATION — CHRG_TERM 0xE6: bit 2 = digital mode (the mainline driver always sets analog, 0), bits 1:0 =
#         150 / 200 / 300 / 400 mA. Fallback: the device tree's charge-term-current-microamp, clamped as the driver
#         clamps it (outside 150–400 mA → 200); last resort 150 mA, the rk817's lowest step (the strictest).
#       • VLIM — the port's input-voltage floor: CHRG_IN 0xE5 bit 7 enable, bits 6:4 = 4.0 + 0.1 × sel V (0xDD = 4.5 V).
#       • CHRG_STS 0xEB: bits 6:4 the charger's state (4 = CHARGE_FINISH — what sysfs reports as "Full"), bit 2
#         CHRG_IN_CLAMP — the charger is held back by its input.
#     FULL = the charger's own CHARGE_FINISH, OR (the backstop when it never says so — its termination is judged on its
#     own output, which the console's load shares) the BATTERY'S measured current tapered to the termination current
#     or below WITH the voltage within FULL_NEAR_CV_V of CV, smoothed (FULL_TAU_S) and held FULL_HOLD_S with no failing
#     reading, never while the input is clamped or at its floor (a starved charger's current falls too — that is not
#     a full cell). The voltage need not reach CV exactly: a cell sits a little under it for a long time while the
#     current tapers; the CURRENT decides. Once full it stays full until the cord comes out.
FULL_NEAR_CV_V = 0.06         # within 60 mV of CV (Stuart's 4.16 V against 4.20 is "close" only once the current is low)
FULL_TAU_S = 30.0             # the current and voltage smoothed over ~30 s (the gauge's own average is noisy at ±50 mA)
FULL_HOLD_S = 300.0           # … and held 5 min: the CV taper takes tens of minutes, so 5 min under it is real
TERM_FALLBACK_A = 0.15        # nothing readable: the rk817's lowest termination step
VLIM_NEAR_V = 0.15            # the port this close to VLIM: the hint ("a shorter cable charges faster")
VLIM_AT_V = 0.05              # … this close: treated as limited (never judged full)
TERM_STEPS_MA = (150, 200, 300, 400)
PAUSE_RESET_S = 60.0          # a pause on the cord longer than this restarts the hold
CC_FRACTION = 0.85            # the current this close to the CC setting: still constant current
CHG_FINISH = 4

def cv_from_chrg_out(reg):
    return None if reg is None else round(4.10 + 0.05 * ((reg >> 4) & 7), 2)

def term_from_chrg_term(reg):
    """Amps, or None in the digital mode (an ADC count that needs the sense resistor) / unreadable."""
    if reg is None or reg & 0x04:
        return None
    return TERM_STEPS_MA[reg & 3] / 1000.0

def term_from_dt(ua):
    """The device tree's charge-term-current-microamp as the driver programs it: 150–400 mA, else 200; analog steps."""
    if ua is None:
        return None
    ma = ua // 1000
    if ma < 150 or ma > 400:
        ma = 200
    return TERM_STEPS_MA[(ma - 100) // 100] / 1000.0

def vlim_from_chrg_in(reg):
    if reg is None or not reg & 0x80:
        return None
    return round(4.0 + 0.1 * ((reg >> 4) & 7), 2)

def read_charger_cfg(pmic):
    """{cvV, termA, vlimV, src} — the rk817's own settings (pmic(reg) → byte or None), sysfs / device tree behind."""
    cv = rd_num(BAT + "/constant_charge_voltage_max")
    cv_src = "sysfs"
    if cv is None:
        cv, cv_src = cv_from_chrg_out(pmic(CHRG_OUT)), "register"
    if cv is None:
        cv, cv_src = 4.20, "assumed"            # ★ nothing readable: the Li-ion standard, and said so on the wire
    term, t_src = term_from_chrg_term(pmic(CHRG_TERM)), "register"
    if term is None:
        raw = None
        try:
            with open(SYS + "/firmware/devicetree/base/battery/charge-term-current-microamp", "rb") as f:
                b = f.read(4)
            raw = int.from_bytes(b, "big") if len(b) == 4 else None
        except OSError:
            pass
        term, t_src = term_from_dt(raw), "devicetree"
    if term is None:
        term, t_src = TERM_FALLBACK_A, "assumed"
    cc = rd_num(BAT + "/constant_charge_current_max")   # (the driver's decode of CHRG_OUT 2:0; None = not known)
    return {"cvV": round(cv, 2), "ccA": cc, "termA": term, "vlimV": vlim_from_chrg_in(pmic(CHRG_IN)), "cvSrc": cv_src, "termSrc": t_src}

class FullJudge:
    """Once a second: is the battery genuinely full? (see FULL_NEAR_CV_V above). States:
       off (no cord) · paused (on the cord, the battery not taking charge) · cc (below the CV ceiling) · cv (topping up) ·
       hold (tapered; counting FULL_HOLD_S) · full (latched until unplug; `by` = "charger" | "taper").
    `limited` is separate (the hint): the port within VLIM_NEAR_V of VLIM, or the PMIC's input clamp."""
    def __init__(self, tau=FULL_TAU_S, hold=FULL_HOLD_S):
        self.tau, self.hold = tau, hold
        self.reset()

    def reset(self):
        self.state, self.by, self.v, self.a, self.t, self.since = "off", None, None, None, None, None
        self.limited = self.near = False
        self.paused_since = None

    def _ema(self, old, x, dt):
        if old is None:
            return x
        return old + (x - old) * (1.0 - math.exp(-max(0.0, dt) / self.tau))

    def feed(self, t, online, status, bat_v, bat_a, port_v, cfg, chg_sts=None):
        """bat_a signed: + into the battery. cfg = read_charger_cfg(). chg_sts = CHRG_STS 0xEB or None."""
        if not online:
            self.reset()
            return self.state
        clamp = chg_sts is not None and bool(chg_sts & 0x04)
        vlim = cfg.get("vlimV")
        self.near = port_v is not None and vlim is not None and port_v <= vlim + VLIM_NEAR_V
        self.limited = clamp or (port_v is not None and vlim is not None and port_v <= vlim + VLIM_AT_V)
        if self.state == "full":
            return self.state
        hw_full = status == "Full" or (chg_sts is not None and (chg_sts >> 4) & 7 == CHG_FINISH)
        if hw_full:
            self.state, self.by = "full", "charger"
            return self.state
        if bat_v is None or bat_a is None:
            return self.state                       # ★ a missing reading changes nothing
        dt = 0.0 if self.t is None else t - self.t
        self.t = t
        self.v, self.a = self._ema(self.v, bat_v, dt), self._ema(self.a, bat_a, dt)
        if status not in ("Charging", "Full") or bat_a <= 0:
            # the console's load has the port; nothing is going in. ★ The status flaps Charging ↔ Not charging on this
            # board (ChargerWatch's flip lines): a flap shorter than PAUSE_RESET_S keeps the hold — it only can never
            # END on a paused reading; a longer pause starts it again.
            if self.paused_since is None:
                self.paused_since = t
            if t - self.paused_since >= PAUSE_RESET_S:
                self.since = None
            self.state = "paused"
            return self.state
        self.paused_since = None
        near_cv = self.v >= cfg["cvV"] - FULL_NEAR_CV_V
        # ★ still at the charger's constant current (≥ 85 % of it) is CC whatever the voltage says — Stuart's 4.15 V
        #   at 0.96 A of a 1.0 A setting is not topping up yet
        at_cc = bool(cfg.get("ccA")) and self.a >= CC_FRACTION * cfg["ccA"]
        tapered = 0.0 < self.a <= cfg["termA"] and bat_a <= 2 * cfg["termA"]   # (a burst far over it: not tapered)
        if near_cv and tapered and not self.limited:
            if self.since is None:
                self.since = t
            if t - self.since >= self.hold:
                self.state, self.by = "full", "taper"
            else:
                self.state = "hold"
        else:
            self.since = None
            self.state = "cv" if near_cv and not at_cc else "cc"
        return self.state

    def wire(self, t, cfg):
        """The `charge` part of state.power."""
        left = None if self.state != "hold" or self.since is None else max(0, int(round(self.hold - (t - self.since))))
        r = lambda x, n: None if x is None else round(x, n)
        return {"state": self.state, "by": self.by, "cvV": cfg.get("cvV"), "ccA": cfg.get("ccA"), "termA": cfg.get("termA"),
                "vlimV": cfg.get("vlimV"), "nearVlim": self.near, "limited": self.limited, "holdLeftS": left,
                "smoothA": r(self.a, 3), "cvSrc": cfg.get("cvSrc"), "termSrc": cfg.get("termSrc")}


class UseSmoother:
    """★ WHAT THE UNIT ITSELF USES. The rk817 driver reports no input current and no system draw, so on the charger
    the console's own use is not measured at all. The best figure is the last one measured: the battery's discharge
    power, smoothed (exponential, USE_TAU_S), kept from before the cord went in.
    ★★ Fed ONLY with a genuine discharge (the signed current below zero, 2026-11-16): the old feed took abs(current)
       whenever `online` read 0, so a charge current read in a plug edge's gap could have been taken for the unit's use.
    ★ `t` is when it was last fed — the wire carries its age (useAgeS): on the charger it goes stale, and the input
       estimate built on it is dropped after kUseStaleS (battery_math.h)."""
    def __init__(self, tau=USE_TAU_S):
        self.tau, self.w, self.t = tau, None, None
    def feed(self, t, watts):
        if watts is None or watts <= 0:
            return self.w
        if self.w is None or self.t is None:
            self.w = watts
        else:
            k = 1.0 - math.exp(-max(0.0, t - self.t) / self.tau)
            self.w += (watts - self.w) * k
        self.t = t
        return self.w
    def feed_battery(self, t, bat_v, bat_a_signed):
        """The battery's own figures: only a discharge (current < 0) is the unit's use."""
        if bat_v is None or bat_a_signed is None or bat_a_signed >= 0:
            return self.w
        return self.feed(t, -bat_a_signed * bat_v)
    def age(self, t):
        return None if self.t is None else max(0, int(t - self.t))

def live_power(online, status, bat_v, bat_a, port_v, use_w, charge_now_uah, full_uah, use_age_s=None, gauge_pct=None,
               charge=None):
    """The figures the Battery block shows (rounded for the wire). bat_a is a magnitude; `dir` says which way.
    `charge` = FullJudge.wire() on the cord (None off it); `gaugePct` = the gauge's own % (never the judge of full)."""
    discharging = not online or status == "Discharging"
    r = lambda x, n: None if x is None else round(x, n)
    return {"online": online, "status": status, "batV": r(bat_v, 3), "batA": r(None if bat_a is None else abs(bat_a), 3),
            "batW": r(None if bat_a is None or bat_v is None else abs(bat_a) * bat_v, 2),
            "dir": "discharge" if discharging else "charge", "portV": r(port_v, 3) if online else None,
            "useW": r(use_w, 2), "useAgeS": use_age_s,
            "chargeMah": None if charge_now_uah is None else int(charge_now_uah // 1000),
            "fullMah": None if full_uah is None else int(full_uah // 1000), "gaugePct": gauge_pct,
            "charge": charge if online else None}


class BatteryCal:
    """★★★ BATTERY CALIBRATION (Stuart, 2026-11-15): the rk817 gauge assumes a full-charge capacity (boot log "fcc 2808
    mAh") that is not this owner's cell. Every unit differs, so nothing is hard-coded: the DISCHARGE leg is measured —
    the PMIC's coulomb counter (charge_now) at a GENUINE full and again at a SAFE empty (CAL_EMPTY_V under load, held —
    EmptyDetector); the difference is this cell's capacity. Then a CLEAN shutdown (never the hard cut-off).
    ★★★ STARTED ON THE CHARGER (Stuart 2026-11-16 — it refused to start for 30 min at a gauge "100 %" with 0.96 A still
       going in: the old rule waited for the charger's Full, which an uncalibrated gauge cannot hurry and the owner
       cannot see coming). START needs the cord in; the run then WAITS for a genuine full (FullJudge — the charger's
       physics, never the gauge's %), then asks for the unplug, and the count begins at the unplug. Pulled out before
       full: nothing starts — it says so and waits for the cord to come back (or CANCEL). STRESS's load starts only at
       the unplug (on the charger it would only slow the charge).
    ★★ The PMIC's counter keeps counting while the console is off, so a power-off mid-way does not spoil it: the state
       is on the state partition (CAL_JSON) and the next boot carries on — a RUNNING one in NORMAL mode always (a STRESS
       run is ended by holding POWER; the next boot is the ordinary radio). Only CHARGING before empty cancels it.
    Phases: idle → charging (the cord in, waiting for full; `plugged` false = pulled out early) → armed (genuinely
    full, the cord still in; the counter at Full kept fresh to the unplug) → running (unplugged) → idle."""
    PHASES = ("idle", "charging", "armed", "running")

    def __init__(self, path=CAL_JSON):
        self.path = path
        self.phase, self.mode, self.q0, self.started, self.note, self.result = "idle", "normal", None, None, "", None
        self.plugged = True
        self.empty = EmptyDetector()
        try:
            with open(path) as f:
                d = json.load(f)
            self.phase = d.get("phase", "idle") if d.get("phase") in self.PHASES else "idle"
            self.q0, self.started, self.note = d.get("q0"), d.get("started"), d.get("note", "")
            self.mode = d.get("mode") if d.get("mode") in ("normal", "stress") else "normal"
            self.result = d.get("result") if isinstance(d.get("result"), dict) else None
            if self.phase == "running":
                # ★ a boot in the middle: carry on, as an ordinary radio (a stress run never resumes)
                self.mode = "normal"
            if self.phase != "idle":
                log("battery calibration: resumed after a restart (%s, %s, counter at Full %s µAh)" % (self.phase, self.mode, self.q0))
        except (OSError, ValueError):
            pass

    def save(self):
        try:
            os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
            atomic_write(self.path, json.dumps({"phase": self.phase, "mode": self.mode, "q0": self.q0,
                                                "started": self.started, "note": self.note, "result": self.result}))
        except OSError as e:
            log("battery calibration: could not save", self.path, e)

    def start(self, mode, online, full, q_now):
        """`full` = FullJudge says genuinely full now. On the cord only."""
        if mode not in ("normal", "stress"):
            raise ValueError("mode must be normal or stress")
        if self.phase != "idle":
            raise ValueError("a calibration is already under way")
        if not online:
            raise ValueError("plug in the charger first — it starts from a full charge")
        if q_now is None:
            raise ValueError("this battery has no charge counter to read")
        self.phase = "armed" if full else "charging"
        self.mode, self.q0, self.started, self.note, self.plugged = mode, q_now, time.time(), "", True
        self.empty = EmptyDetector()
        self.save()
        log("battery calibration: %s (%s) — counter %d µAh" % ("full already, unplug to start" if full else
                                                                 "waiting on the charger for a genuine full", mode, q_now))

    def cancel(self, note):
        if self.phase == "idle":
            return False
        log("battery calibration:", note)
        self.phase, self.note, self.q0, self.plugged = "idle", note, None, True
        self.save()
        return True

    def step(self, t, online, status, bat_v, q_now, design_uah, full=False):
        """Once a second. Returns None, ("armed",), ("notfull",), ("charging",), ("running",), ("cancelled", note) or
        ("done", result-or-None, note). `full` = FullJudge's verdict this second."""
        if self.phase == "charging":
            if not online:
                if self.plugged:
                    self.plugged = False
                    log("battery calibration: unplugged before full — waiting for the charger to come back")
                    return ("notfull",)
                return None
            if not self.plugged:
                self.plugged = True
                log("battery calibration: the charger is back — waiting for full")
                return ("charging",)
            if full:
                self.phase = "armed"
                if q_now is not None:
                    self.q0 = q_now
                self.save()
                log("battery calibration: genuinely full — counter %s µAh; unplug to start" % self.q0)
                return ("armed",)
            return None
        if self.phase == "armed":
            if online:
                if q_now is not None:
                    self.q0 = q_now                        # ★ the counter at Full, as of the moment the cord comes out
                return None
            self.phase = "running"
            self.save()
            log("battery calibration: unplugged — counting from %s µAh down to %.2f V" % (self.q0, CAL_EMPTY_V))
            return ("running",)
        if self.phase != "running":
            return None
        if online:
            n = "calibration cancelled — it was charged before empty"
            self.cancel(n)
            return ("cancelled", n)
        if self.empty.feed(t, bat_v):
            return self.finish(q_now, design_uah, "%.2f V held %.0f s" % (bat_v, CAL_EMPTY_HOLD_S))
        return None

    def finish(self, q_now, design_uah, why):
        """The empty point: the capacity is the counter's fall since Full."""
        if self.phase != "running":
            return None
        mah = None if q_now is None or self.q0 is None else (self.q0 - q_now) / 1000.0
        design = None if not design_uah else design_uah / 1000.0
        if cal_plausible(mah, design):
            self.result = {"mah": int(round(mah)), "design": None if design is None else int(round(design)),
                           "qEmpty": q_now, "qFull": self.q0, "utc": int(time.time())}
            self.note = ""
            log("battery calibration: empty (%s) — measured %d mAh (the gauge assumes %s)" % (why, self.result["mah"], self.result["design"]))
        else:
            self.note = "calibration failed — the charge counter read %s mAh" % ("?" if mah is None else int(round(mah)))
            log("battery calibration:", self.note, "(%s)" % why)
        self.phase, self.q0 = "idle", None
        self.save()
        return ("done", self.result if not self.note else None, self.note)

    def wire(self, q_now):
        """The calibration's part of {"get":"state"}."""
        counted = None if self.phase != "running" or self.q0 is None or q_now is None else int((self.q0 - q_now) // 1000)
        return {"phase": self.phase, "mode": self.mode, "plugged": self.plugged, "countedMah": counted, "note": self.note,
                "result": self.result}


class Stress:
    """★★ STRESS calibration's load (the FAST way to empty): the backlight at full, the CPU on `performance` at the
    image's own ceiling (STRESS_MAX_KHZ — never the overclock steps), a busy loop per core (nice 10, killed with us),
    the speaker muted — none of it saved, all of it put back by stop() (and by any restart: hwd.json is untouched).
    ★ Thermal: over STRESS_HOT_C two burners pause, over STRESS_HOTTER_C all four; under STRESS_COOL_C they run again.
    ★ No GPU load: any clock step off the 300 MHz pin has reset this board's GPU (BOOST_TARGETS' notes), and a
      synthetic GL load means a second display client — not cheap, not safe.
    ★★ THE RADIO IS PART OF THE LOAD (Stuart 2026-11-15: "SDR at max sample rate with audio muted and no waterfall";
       built h80): the UI does it, because the UI is the radio's client — while a STRESS run is RUNNING the native UI
       (handheld-ui battery_cal.h StressSdr) puts the radio on the top sample rate the engine offers it, keeps it
       decoding and streaming (the speaker muted here, the waterfall not drawn — the calibration's own screen), and
       puts its rate back when the run ends or is cancelled. wire() tells that screen how many busy loops run and why."""
    def __init__(self, hwd, spawn=None):
        self.hwd, self.procs, self.running, self.gov = hwd, [], 0, {}
        self.temp_c, self.why = None, ""
        self._spawn = spawn or self._spawn_burner

    @staticmethod
    def _spawn_burner():
        def child():
            try:   # ★ PR_SET_PDEATHSIG: if vibe-hwd dies, so does the load
                ctypes.CDLL(None).prctl(1, signal.SIGKILL)
            except Exception:
                pass
        return subprocess.Popen(["nice", "-n", "10", "sh", "-c", "while :; do :; done"], stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=child)

    @property
    def on(self):
        return bool(self.procs)

    def start(self):
        if self.procs:
            return
        h = self.hwd
        try:
            wr(BL + "/bl_power", 0)
            wr(BL + "/brightness", h.max_brightness)
        except OSError as e:
            log("stress: backlight:", e)
        for p in glob.glob(CPUFREQ + "/policy*"):
            self.gov[p] = rd(p + "/scaling_governor")
            avail = sorted(int(f) for f in rd(p + "/scaling_available_frequencies", "").split() if f.isdigit())
            top = max([f for f in avail if f <= STRESS_MAX_KHZ] or avail[:1] or [0])
            try:
                if top:
                    wr(p + "/scaling_max_freq", top)
                wr(p + "/scaling_governor", "performance")
            except OSError as e:
                log("stress: cpufreq:", e)
        amixer("cset", "name=Master Playback Volume", "0,0")
        try:
            self.procs = [self._spawn() for _ in range(STRESS_BURNERS)]
        except OSError as e:
            log("stress: load not started:", e)
        self.running = len(self.procs)
        log("stress: on — backlight %d, CPU performance ≤ %d MHz, %d busy loops, speaker muted" %
            (h.max_brightness, STRESS_MAX_KHZ // 1000, len(self.procs)))

    def thermal(self):
        """Once a second while on: pause / resume burners by the SoC temperature."""
        if not self.procs:
            return
        t = rd_num(THERMAL, 1000.0)
        if t is None:
            return
        self.temp_c = t
        want = 0 if t >= STRESS_HOTTER_C else STRESS_BURNERS // 2 if t >= STRESS_HOT_C else \
            len(self.procs) if t < STRESS_COOL_C else self.running
        want = min(want, len(self.procs))
        if want != self.running:
            for i, pr in enumerate(self.procs):
                try:
                    os.kill(pr.pid, signal.SIGCONT if i < want else signal.SIGSTOP)
                except OSError:
                    pass
            log("stress: %.1f °C — %d of %d busy loops running" % (t, want, len(self.procs)))
            self.running = want
        # ★ why fewer than all: the temperature that paused them (the screen's "2 of 4 — 76 °C")
        self.why = "" if self.running >= len(self.procs) else "%.0f °C" % t

    def wire(self):
        """For state.calib.stress: {on, loops, of, tempC, why}."""
        return {"on": self.on, "loops": self.running if self.procs else 0, "of": STRESS_BURNERS,
                "tempC": None if self.temp_c is None else round(self.temp_c, 1), "why": self.why}

    def stop(self):
        if not self.procs and not self.gov:
            return
        for pr in self.procs:
            try:
                os.kill(pr.pid, signal.SIGCONT)
                pr.kill()
                pr.wait(timeout=2)
            except Exception:
                pass
        self.procs, self.running, self.why = [], 0, ""
        for p, g in self.gov.items():
            if g:
                try:
                    wr(p + "/scaling_governor", g)
                except OSError as e:
                    log("stress: governor back:", e)
        self.gov = {}
        h = self.hwd
        h.apply_cpu()
        if h.screen == "on":
            h.apply_brightness()
        h.apply_volume()
        log("stress: off — clocks, backlight and volume back")


class ChargerWatch:
    """★★★ THE CHARGE PORT, WATCHED CLOSELY (Stuart, 2026-11-15 log): vibe-hwd took up to 58 s to notice a plug-in (a
    1 s look, and a 30 s back-off after any PMIC error), the SDR dropped off USB at the very moment of plug-in, and the
    charge LED goes off / on at ~20 % while the bank still puts out 5.2 V. So:
      • the plug edge is seen within POLL_S (sysfs `online`, read 10 times a second — one small file; the driver sets it
        from the PMIC's plug interrupt, so unlike its voltages it is not 8 s old) and the input limit goes on AT the
        edge, not up to a second (or 30 s) later;
      • every edge starts a FastTrace burst (h80: the PMIC's registers every 20 ms, the 2 s before and 3 s after) — it
        replaces the old 5 s of sysfs lines, whose figures only change every 8 s (the h79 log: 50 identical lines);
      • a line whenever the battery's status flips (Charging ↔ Not charging / Discharging / Full) with the cord still
        in, with the port voltage at that moment — the LED symptom.
    ★★ THE VALUE written is the INPUT FLOOR test setting's (VLIM_CHOICES; 0xDD = 4.5 V, the default) — one fixed byte
       per setting, never a read-modify-write.
    ★ Bounded: a handful of numbers, no history; the flip lines are capped at FLIP_MAX a minute (the rest counted).
    The PMIC reads are the same atomic SMBus transfers as the limit's (pmic_read)."""
    POLL_S, CHECK_S, ERR_BACKOFF_S, FLIP_MAX = 0.1, 1.0, 5.0, 20

    def __init__(self, dev, target=lambda: CHRG_IN_2A, trace=None):
        self.dev = dev
        self.target = target          # () → the CHRG_IN byte to hold (the INPUT FLOOR setting)
        self.trace = trace            # FastTrace or None
        self.online = None            # last `online` seen (None before the first look)
        self.status = None
        self.next_check = 0.0
        self.err_logged_at = -1e9
        self.flip_min, self.flip_n, self.flip_dropped = -1, 0, 0

    def _pmic(self, reg):
        if not self.dev:
            return None
        try:
            return pmic_read(self.dev, reg)
        except OSError as e:
            self._err("read", e)
            return None

    def _err(self, what, e):
        now = time.monotonic()
        if now - self.err_logged_at >= 30:              # ★ one line per 30 s, however often the bus fails
            self.err_logged_at = now
            log("charger: PMIC %s failed:" % what, e)

    def apply_limit(self, why, now):
        """CHRG_IN to the setting's byte if it is not (one atomic read; a write only when needed). True when it is."""
        if not self.dev:
            return False
        want = self.target()
        try:
            old = pmic_read(self.dev, CHRG_IN)
            if old == want:
                return True
            pmic_write(self.dev, CHRG_IN, want)
            got = pmic_read(self.dev, CHRG_IN)
            fl = vlim_from_chrg_in(want)
            log("charger: input limit 2 A, floor %.1f V%s at %s (CHRG_IN 0x%02x -> 0x%02x)%s" %
                (fl, "" if want == CHRG_IN_2A else " (TEST)", why, old, got, "" if got == want else " ✗ DID NOT STICK"))
            return got == want
        except OSError as e:
            self._err("input limit", e)
            self.next_check = now + self.ERR_BACKOFF_S     # ★ 5 s, not 30: a plug-in still gets its limit soon
            return False

    def sample(self):
        """The flip line's figures (sysfs — the driver's 8 s values): port V, battery V / A, status."""
        return {"port": _uv(CHG + "/voltage_avg"), "batV": _uv(BAT + "/voltage_avg"), "batA": _uv(BAT + "/current_avg"),
                "status": rd(BAT + "/status", "Unknown")}

    def tick(self, now):
        online = rd(CHG + "/online", "0") == "1"
        status = rd(BAT + "/status", "Unknown")
        if self.trace:
            self.trace.set_online(online)
        if self.online is None:
            self.online, self.status = online, status
            if online:
                self.apply_limit("start-up", now)
            return
        if online != self.online:
            # ★ the edge: the limit FIRST (the SDR is drawing through this port right now), then the trace's burst
            if online and self.apply_limit("plug-in", now):
                self.next_check = now + self.CHECK_S
            edge = "plug-in" if online else "plug-out"
            if self.trace:
                self.trace.edge(edge, now)
            log("charger: %s seen (within %.1f s, mono %.3f)%s" % (edge, self.POLL_S, now,
                " — the fast trace follows" if self.trace and self.trace.reader else ""))
        elif online and status != self.status:
            self._flip(now, status)
        self.online, self.status = online, status
        if online and now >= self.next_check:
            self.next_check = now + self.CHECK_S
            self.apply_limit("check", now)            # (a failure moves next_check out to ERR_BACKOFF_S)

    def _flip(self, now, status):
        m = int(now // 60)
        if m != self.flip_min:
            if self.flip_dropped:
                log("charger: (%d more status flips on the cord that minute, not logged)" % self.flip_dropped)
            self.flip_min, self.flip_n, self.flip_dropped = m, 0, 0
        self.flip_n += 1
        if self.flip_n > self.FLIP_MAX:
            self.flip_dropped += 1
            return
        s = self.sample()
        cin = self._pmic(CHRG_IN)
        log("charger: battery %s -> %s with the cord in — port %s, bat %s %s, CHRG_IN %s" %
            (self.status, status, _f(s["port"], "V"), _f(s["batV"], "V"), _f(s["batA"], "A", True),
             "?" if cin is None else "0x%02x" % cin))


# ── the drop-triggered charger trace (h80, 2026-11-19) ────────────────────────────────────────────────────────────────
# ★★★ WHY: Stuart's h79 log (debuglog-f0d2614a): with the charger in and the battery at/near full (4.17–4.19 V, still
#     taking 0.33–0.40 A) the RTL-SDR V4 dropped off USB ("usb 1-1: USB disconnect") 0.6–6 s after starting, again and
#     again; on battery never. The old 100 ms plug trace was useless for it: its sysfs figures come from the rk817
#     driver's own poll, every 8 s (rk817_charger.c queue_delayed_work 8000 ms), so 5 s of identical lines — and it ran
#     only at plug edges. So this reads the PMIC's REGISTERS directly, every SAMPLE_S, into a ring of RING_S, and when a
#     USB device disappears it logs the ring plus POST_S after it; the same burst at every plug-in / plug-out.
# ★★ WHAT IS READ (all read only, one i2c transfer each — PmicFd):
#     CHRG_OUT 0xE4 + CHRG_IN 0xE5 (one 2-byte block), CHRG_STS 0xEB (bits 6:4 the charger's state, 7 BAT_EXS, 3 BAT_OVP,
#     2 CHRG_IN_CLAMP, 1 USB_EXS, 0 USB_EFF — BSP rk817_charger.c's reg_fields), and the gas gauge's ADC registers with
#     the MAINLINE DRIVER'S OWN SCALING (drivers/power/supply/rk817_charger.c, rk817_read_props; addresses from
#     include/linux/mfd/rk808.h):
#       BAT_VOL 0x78/0x79 (big-endian 16)   µV = k × raw + 1000 × b
#       BAT_CUR 0x7A/0x7B (signed BE 16)    µA = raw × 172 / res_div   (+ = into the battery, as sysfs current_avg)
#       USB_VOL 0x7E/0x7F (BE 16)           mV = (k × raw / 1000 + b) × 60 / 46   (raw ≤ 1 → 0, as the driver)
#     where k = (4025 − 2300) × 1000 / (VCALIB1 − VCALIB0), b = 4025 − k × VCALIB1 / 1000 (VCALIB0 0x93/0x94, VCALIB1
#     0x95/0x96, C integer arithmetic), and res_div = 2 for a 20 mΩ sense resistor, 1 for 10 mΩ (the device tree's
#     rockchip,resistor-sense-micro-ohms — read from /sys/firmware; unknown → the current is left out, never guessed).
#     These are the same registers sysfs voltage_avg / current_avg / the charger's voltage_avg are made from — read at
#     20 ms instead of 8 s. ★ How often the PMIC itself refreshes them is not documented in either driver: a run of
#     identical samples in the trace is the ADC's own cadence, and the "ADC check" line compares them with sysfs.
#     ✗ Left out: SYS_VOL 0x80/0x81 — neither driver scales it, so its volts are not known.
# ★ BOUNDED: the ring is RING_S / SAMPLE_S samples of small tuples; it runs only while the charger is in AND a USB device
#   is plugged (or a plug burst is under way); bursts are capped (BURST_MAX per BURST_WINDOW_S) and their identical
#   samples collapsed; the sampler's own CPU time is measured and logged with every summary.
STS_STATES = ("off", "dead", "trickle", "cccv", "FINISH", "USB-OVP", "bat-temp", "bat-timer")

def _cdiv(a, b):
    """C integer division (truncates toward zero) — the driver's arithmetic."""
    q = abs(a) // abs(b)
    return q if (a >= 0) == (b > 0) else -q

def adc_coeffs(vcalib0, vcalib1):
    """(k, b) as rk817_bat_calib_vol computes them, or None when the calibration words make no sense."""
    if vcalib1 is None or vcalib0 is None or vcalib1 <= vcalib0:
        return None
    k = _cdiv((4025 - 2300) * 1000, vcalib1 - vcalib0)
    return k, 4025 - _cdiv(k * vcalib1, 1000)

def adc_bat_v(raw, kb):
    return None if kb is None or raw is None else (kb[0] * raw + 1000 * kb[1]) / 1e6

def adc_usb_v(raw, kb):
    if kb is None or raw is None:
        return None
    if raw <= 1:
        return 0.0
    return _cdiv((_cdiv(kb[0] * raw, 1000) + kb[1]) * 60, 46) / 1000.0

def adc_bat_a(raw, res_div):
    return None if not res_div or raw is None else _cdiv(raw * 172, res_div) / 1e6

def sense_res_div():
    for p in glob.glob(SYS + "/firmware/devicetree/base/i2c@*/pmic@20/charger/rockchip,resistor-sense-micro-ohms"):
        try:
            with open(p, "rb") as f:
                b = f.read(4)
        except OSError:
            continue
        if len(b) == 4:
            v = int.from_bytes(b, "big")
            return {20000: 2, 10000: 1}.get(v)
    return None

def sts_text(sts):
    if sts is None:
        return "STS ?"
    bits = [STS_STATES[(sts >> 4) & 7]]
    if sts & 0x04: bits.append("CLAMP")
    if sts & 0x02: bits.append("usb")
    if sts & 0x01: bits.append("eff")
    if sts & 0x08: bits.append("BAT-OVP")
    if not sts & 0x80: bits.append("NO-BAT")
    return "/".join(bits)

def usb_devices(root=None):
    """The USB devices on the bus now (sysfs names like '1-1', '1-1.2' — no interfaces, no root hubs)."""
    root = root or SYS + "/bus/usb/devices"
    try:
        names = os.listdir(root)
    except OSError:
        return frozenset()
    return frozenset(n for n in names if ":" not in n and "-" in n and n[0].isdigit())


class FastTrace:
    SAMPLE_S, RING_S, POST_S, PLUG_POST_S, MAX_POST_S = 0.02, 2.0, 1.0, 3.0, 6.0
    BURST_MAX, BURST_WINDOW_S, SUMMARY_S, CHANGE_MAX = 10, 600.0, 30.0, 20

    def __init__(self, reader=None, usb=usb_devices, res_div=None, vlim_mv=lambda: VLIM_DEFAULT_MV):
        """reader(): a PmicFd-like object (byte / block) or None; usb(): the set of USB device names."""
        self.reader, self.usb, self.res_div, self.vlim_mv = reader, usb, res_div, vlim_mv
        self.ring = collections.deque(maxlen=int(round(self.RING_S / self.SAMPLE_S)) + 1)
        self.kb, self.kb_at = None, -1e9
        self.online = False
        self.devs = None              # last USB set seen while sampling
        self.burst = None             # {"n", "kind", "what", "t0", "end", "pre": [...], "post": [...], "marks": {}}
        self.burst_n, self.burst_times, self.burst_dropped = 0, collections.deque(), 0
        self.last_sts, self.change_min, self.change_n = None, -1, 0
        self.sum_t0, self.sum = None, None
        self.cpu_t0 = self.cpu_w0 = None
        self.gone_at = {}             # name → when it disappeared (for "back after N s")
        self.err_at, self.checked = -1e9, False
        self.lock = threading.Lock()

    # ── input from ChargerWatch (the event loop) ──
    def set_online(self, online):
        self.online = online

    def edge(self, kind, t):
        """A plug-in / plug-out at monotonic t: a burst (the ring before it, PLUG_POST_S after)."""
        with self.lock:
            self._start_burst(kind, "the cord %s" % ("went in" if kind == "plug-in" else "came out"), t, self.PLUG_POST_S)

    # ── sampling ──
    def _coeffs(self, t):
        if self.kb is None or t - self.kb_at >= 60:
            self.kb_at = t
            try:
                c0, c1 = self.reader.block(0x93, 2), self.reader.block(0x95, 2)
                self.kb = adc_coeffs(int.from_bytes(c0, "big"), int.from_bytes(c1, "big"))
            except (OSError, AttributeError):
                self.kb = None
        return self.kb

    def read(self, t):
        """One sample: (t, sts, cin, cout, bat_raw, cur_raw, usb_raw) — None for whatever could not be read."""
        r = self.reader
        sts = cin = cout = bv = bc = uv = None
        if r is not None:
            try:
                e4 = r.block(0xE4, 2); cout, cin = e4[0], e4[1]
                sts = r.byte(CHRG_STS)
                g = r.block(0x78, 4)
                bv = int.from_bytes(g[0:2], "big"); bc = int.from_bytes(g[2:4], "big", signed=True)
                uv = int.from_bytes(r.block(0x7E, 2), "big")
            except OSError as e:
                if t - self.err_at >= 30:
                    self.err_at = t
                    log("chgtrace: PMIC read failed:", e)
        return (t, sts, cin, cout, bv, bc, uv)

    def step(self, t):
        """Once a SAMPLE_S (the sampler thread; tests call it on a fake clock). Returns True when it sampled."""
        with self.lock:
            if self.burst is None and not self.online:
                # on battery: nothing read at all (not even the USB list)
                self.ring.clear(); self.devs = None; self.sum_t0 = None; self.last_sts = None
                return False
            devs = self.usb()
            if self.burst is None and not devs and not self.devs:
                # on the cord with no radio: nothing can drop; the next plug-in of a radio starts the ring
                self.ring.clear(); self.devs = devs; self.sum_t0 = None
                return False
            self._coeffs(t)
            s = self.read(t)
            if not self.checked and s[4] is not None:
                self.checked = True
                self._adc_check(s)
            mark = ""
            if self.devs is not None:
                for n in sorted(self.devs - devs):
                    mark += " ★ USB %s GONE" % n
                    self.gone_at[n] = t
                    if self.burst is None:
                        self._start_burst("drop", "USB %s disappeared" % n, t, self.POST_S)
                    else:   # ★ inside a burst already: noted in it, and the burst runs on POST_S past it
                        self.burst["end"] = min(self.burst["t0"] + self.MAX_POST_S, max(self.burst["end"], t + self.POST_S))
                for n in sorted(devs - self.devs):
                    since = self.gone_at.pop(n, None)
                    mark += " ★ USB %s BACK%s" % (n, "" if since is None else " after %.1f s" % (t - since))
                    if self.burst is None:
                        log("chgtrace: USB %s back%s (mono %.3f)" % (n, "" if since is None else " after %.1f s" % (t - since), t))
            self.devs = devs
            if self.burst is not None:
                self.burst["post"].append((s, mark))
            else:
                self.ring.append((s, mark))
            self._watch_sts(s)
            self._summary(s)
            if self.burst is not None and t >= self.burst["end"] - 1e-9:
                self._dump(self.burst)
                # the post samples become the ring's newest (a drop right after a burst still has its "before")
                for x in self.burst["post"][-self.ring.maxlen:]:
                    self.ring.append(x)
                self.burst = None
            return True

    def _start_burst(self, kind, what, t, post):
        if self.burst is not None:
            self.burst["end"] = min(self.burst["t0"] + self.MAX_POST_S, max(self.burst["end"], t + post))
            self.burst["what"] += "; then %s at %+.3f" % (what, t - self.burst["t0"])
            return
        while self.burst_times and t - self.burst_times[0] > self.BURST_WINDOW_S:
            self.burst_times.popleft()
        if len(self.burst_times) >= self.BURST_MAX:
            self.burst_dropped += 1
            log("chgtrace: %s at mono %.3f — not traced (%d bursts in %.0f min already; %d skipped)" %
                (what, t, self.BURST_MAX, self.BURST_WINDOW_S / 60, self.burst_dropped))
            return
        self.burst_times.append(t)
        self.burst_n += 1
        self.burst = {"n": self.burst_n, "kind": kind, "what": what, "t0": t, "end": t + post,
                      "pre": list(self.ring), "post": []}
        self.ring.clear()

    # ── output ──
    def _fmt(self, s):
        t, sts, cin, cout, bv, bc, uv = s
        hx = lambda x: "??" if x is None else "%02x" % x
        return "%s IN %s OUT %s bat %s %s port %s" % (sts_text(sts), hx(cin), hx(cout), _f(adc_bat_v(bv, self.kb), "V"),
                                                     _f(adc_bat_a(bc, self.res_div), "A", True), _f(adc_usb_v(uv, self.kb), "V"))

    def _stats(self, samples):
        pv = [adc_usb_v(s[6], self.kb) for s in samples]; pv = [x for x in pv if x is not None]
        ba = [adc_bat_a(s[5], self.res_div) for s in samples]; ba = [x for x in ba if x is not None]
        bv = [adc_bat_v(s[4], self.kb) for s in samples]; bv = [x for x in bv if x is not None]
        clamp = sum(1 for s in samples if s[1] is not None and s[1] & 0x04)
        f3 = lambda xs, u, sg=False: "?" if not xs else "%s/%s/%s" % (_f(min(xs), u, sg), _f(sum(xs) / len(xs), u, sg), _f(max(xs), u, sg))
        return "port %s · bat %s %s (min/mean/max) · input clamp %d of %d samples" % (f3(pv, "V"), f3(bv, "V"), f3(ba, "A", True), clamp, len(samples))

    def _dump(self, b):
        pre, post = b["pre"], b["post"]
        t0 = b["t0"]
        vl = self.vlim_mv()
        log("chgtrace#%d %s: %s at mono %.3f s (≈ the kernel's [time]) — %.1f s before, %.1f s after, a sample every %d ms; "
            "input floor %.1f V%s; %s" % (b["n"], b["kind"].upper(), b["what"], t0, len(pre) * self.SAMPLE_S,
                                         len(post) * self.SAMPLE_S, round(self.SAMPLE_S * 1000), vl / 1000.0,
                                         "" if vl == VLIM_DEFAULT_MV else " (TEST)", self._sysfs_now()))
        prev, run_n, run_t = None, 0, None
        tag = "chgtrace#%d" % b["n"]
        for s, mark in pre + post:
            body = self._fmt(s)
            if body == prev and not mark:
                run_n += 1; run_t = s[0]
                continue
            if run_n:
                log("%s   … same ×%d to %+.3f" % (tag, run_n, run_t - t0))
                run_n = 0
            log("%s %+.3f %s%s" % (tag, s[0] - t0, body, mark))
            prev = body if not mark else None
        if run_n:
            log("%s   … same ×%d to %+.3f" % (tag, run_n, run_t - t0))
        log("%s end — %s" % (tag, self._stats([s for s, _ in pre + post])))

    def _sysfs_now(self):
        return "sysfs (the driver's 8 s figures): port %s bat %s %s" % (_f(_uv(CHG + "/voltage_avg"), "V"),
                                                                       _f(_uv(BAT + "/voltage_avg"), "V"), _f(_uv(BAT + "/current_avg"), "A", True))

    def _adc_check(self, s):
        log("chgtrace: ADC check — registers: bat %s %s port %s (k,b %s, sense ÷%s) · %s" %
            (_f(adc_bat_v(s[4], self.kb), "V"), _f(adc_bat_a(s[5], self.res_div), "A", True), _f(adc_usb_v(s[6], self.kb), "V"),
             self.kb, self.res_div if self.res_div else "? — current left out", self._sysfs_now()))

    def _watch_sts(self, s):
        """★ a line whenever CHRG_STS changes while sampling (the charger's state, the clamp, USB_EXS / USB_EFF) — the h79
        oddity (the port reading 0 V then 1.84 V for ~95 s with the console on battery after a plug-in) shows up as
        exactly this kind of line. Capped at CHANGE_MAX a minute."""
        sts = s[1]
        if sts is None or sts == self.last_sts:
            return
        old, self.last_sts = self.last_sts, sts
        if old is None:
            return
        m = int(s[0] // 60)
        if m != self.change_min:
            self.change_min, self.change_n = m, 0
        self.change_n += 1
        if self.change_n <= self.CHANGE_MAX:
            log("chgtrace: CHRG_STS 0x%02x -> 0x%02x (%s -> %s) at mono %.3f — %s" %
                (old, sts, sts_text(old), sts_text(sts), s[0], self._fmt(s)))

    def _summary(self, s):
        """Every SUMMARY_S while sampling on the cord: min/mean/max of the port and the battery (compare cables), and the
        sampler's own CPU."""
        t = s[0]
        if self.sum_t0 is None:
            self.sum_t0, self.sum = t, []
            self.cpu_t0, self.cpu_w0 = time.thread_time(), time.monotonic()
        self.sum.append(s)
        if t - self.sum_t0 < self.SUMMARY_S:
            return
        cpu = time.thread_time() - self.cpu_t0
        wall = max(1e-6, time.monotonic() - self.cpu_w0)
        log("chgtrace: last %.0f s on the cord — %s · USB %s · sampler %.1f %% of a core" %
            (t - self.sum_t0, self._stats(self.sum), ",".join(sorted(self.devs or ())) or "none", 100.0 * cpu / wall))
        self.sum_t0 = None

    # ── the thread ──
    def run(self, stop):
        nxt = time.monotonic()
        while not stop.is_set():
            now = time.monotonic()
            try:
                sampled = self.step(now)
            except Exception as e:          # ★ the trace must never take the service down
                log("chgtrace:", type(e).__name__, e)
                sampled = False
            if sampled:
                nxt = max(nxt + self.SAMPLE_S, now)
            else:
                nxt = now + 0.1                  # idle: look again 10 times a second
            stop.wait(max(0.0, nxt - time.monotonic()))


class Hwd:
    def __init__(self):
        self.clients = set()          # writers of every connection
        self.subscribers = set()
        self.acks = set()
        # ★★ cpuMax: the CPU's cap, FIXED at 1008 MHz (Stuart, 2026-11-07: "try 1.0GHz" — 1.175 V against 1.30 V at 1104,
        #    a quarter less energy per unit of work). The CPU SPEED row is gone (2026-11-09: "that isnt needed anymore since we
        #    have determined 1GHz gives us good performance"), so a cap an older build saved is NOT read back — it could
        #    otherwise strand a console at 408 MHz with no way to change it.
        self.cfg = {"brightness": DEFAULT_BRIGHTNESS, "volume": DEFAULT_VOLUME, "cpuMax": 1008000, "vlimMv": VLIM_DEFAULT_MV}
        try:
            with open(HWD_JSON) as f:
                self.cfg.update({k: v for k, v in json.load(f).items() if k in self.cfg and k != "cpuMax"})
        except (OSError, ValueError):
            pass
        if self.cfg.get("vlimMv") not in VLIM_CHOICES:      # ★ anything odd on the card: the default floor
            self.cfg["vlimMv"] = VLIM_DEFAULT_MV
        if self.cfg["vlimMv"] != VLIM_DEFAULT_MV:
            log("charger: TEST setting in force — input voltage floor %.1f V (CHRG_IN 0x%02x), saved from before" %
                (self.cfg["vlimMv"] / 1000.0, VLIM_CHOICES[self.cfg["vlimMv"]]))
        self.watch = None             # ChargerWatch (charger_loop)
        self.max_brightness = int(rd(BL + "/max_brightness", "255"))
        self.screen = "on"
        self.output = "speaker"
        self.battery = {"pct": None, "raw": None, "charging": False, "online": False, "status": "Unknown"}
        self.bat_against = 0
        self.low_warned = False
        self.empty_count = 0
        self.shutting_down = False
        self.power_down_at = None
        self.power_task = None
        self.save_task = None
        self.readers = {}             # path → task
        self.cal = BatteryCal()       # ★ battery calibration (BatteryCal) — resumes a run a power-off interrupted
        self.stress = Stress(self)
        self.use = UseSmoother()
        self.power = {}               # the live figures (power_tick, once a second)
        self.q_now = self.full_uah = None
        # ★★ is it REALLY full (FullJudge): the charger's own settings, read from the PMIC (read only, atomic transfers)
        self.pmic_dev = pmic_bus()
        self.judge = FullJudge()
        self.chg_cfg, self.chg_cfg_at = None, -1e9
        self._pmic_err_at = -1e9

    def pmic(self, reg):
        """One PMIC register (read only), or None — no bus, or the read failed (logged once a minute)."""
        if not self.pmic_dev:
            return None
        try:
            return pmic_read(self.pmic_dev, reg)
        except OSError as e:
            if time.monotonic() - self._pmic_err_at > 60:
                self._pmic_err_at = time.monotonic()
                log("full judge: PMIC read failed:", e)
            return None

    def charger_cfg(self, t):
        """read_charger_cfg, again once a minute (the driver sets these at probe; CHRG_IN is rewritten on unplug)."""
        if self.chg_cfg is None or t - self.chg_cfg_at >= 60:
            cfg = read_charger_cfg(self.pmic)
            if cfg != self.chg_cfg:
                log("full judge: CV %.2f V (%s), termination %.2f A (%s), input floor %s" % (cfg["cvV"], cfg["cvSrc"],
                    cfg["termA"], cfg["termSrc"], "?" if cfg["vlimV"] is None else "%.2f V" % cfg["vlimV"]))
            self.chg_cfg, self.chg_cfg_at = cfg, t
        return self.chg_cfg

    # ── persistence ──
    def save_soon(self):
        # ★ debounced: holding a volume button sends ~30 auto-repeats a second; the card gets one write.
        if self.save_task:
            self.save_task.cancel()
        async def later():
            await asyncio.sleep(2)
            try:
                os.makedirs(STATE_DIR, exist_ok=True)
                atomic_write(HWD_JSON, json.dumps(self.cfg))
            except OSError as e:
                log("could not save", HWD_JSON, e)
        self.save_task = asyncio.get_running_loop().create_task(later())

    # ── CPU speed ──
    def cpu_steps(self):
        steps = set()
        for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            for f in rd(p + "/scaling_available_frequencies", "").split():
                if f.isdigit():
                    steps.add(int(f))
        return sorted(steps)

    def apply_cpu(self):
        steps = self.cpu_steps()
        want = int(self.cfg.get("cpuMax", 1008000))
        # ★★★ NO CPU BOOST EITHER (handheld43 log, 2026-11-08): with the GPU left at 300, 14 GPU timeouts still came
        #     within ~1 s of the boost lifting the CPU to 1296 MHz (157–184 s), and none with the map up unboosted
        #     (handheld40, 1277–1327 s). The map never needed it: the UI thread used 19–25 % of a core with the map up.
        #     So the boost moves nothing; the request is still accepted and logged (an older UI sends it).
        ok = [f for f in steps if f <= want] or steps[:1]
        if not ok:
            return
        cap = ok[-1]
        for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            try:
                wr(p + "/scaling_max_freq", cap)
            except OSError as e:
                log("cpu speed:", e)
        log("cpu speed: capped at", cap // 1000, "MHz")


    # ★★ THE MAP'S BOOST (Stuart, 2026-11-07: "the map is super slow and keeps looking like it is refreshing all the time"
    #    — on handheld29's caps: the CPU 1008 MHz, the GPU 300 MHz, the memory 450 MHz). While the UI asks (the map is on
    #    screen) every cap is lifted to the top step; off, the caps come straight back. NEVER saved — a restart, or a UI
    #    that went away, always comes back capped (vibe-cpu.service sets the GPU and memory caps at boot).
    DEVFREQ_CAPS = (("/sys/class/devfreq/ff400000.gpu", 300000000), ("/sys/class/devfreq/dmc", 450000000))
    # ★★★ WHAT THE MAP BOOST MAY RAISE (handheld40 log, 2026-11-08). Boosting BOTH to their tops (GPU 560, memory 666) was
    #     followed within ~1 s, every time, by Panfrost "gpu sched timeout"s (13 in one session: a GPU job over half a
    #     second, the GPU reset) — and their burst starved the speaker (12 starved / 9 underruns that minute). The steady
    #     boosted map was fine; the STEP was not. And at 300 the map page costs 1.4–5.6 ms a frame at 26–30 fps — the
    #     boost bought little. So: the memory clock is never moved (a DDR frequency change stalls the bus under the GPU),
    #     and the GPU steps one notch, to 400. If the timeouts persist, take the GPU out of the boost too.
    # ★★★ THEY PERSISTED — WORSE (handheld42 log, 2026-11-08): at 400 the timeouts ran the WHOLE boost, one every
    #     ~0.7 s (37 in two boosts: 209–226 s and 256–274 s), none before the first boost and none with it off. Each
    #     reset cut a map render short and left the old picture in the buffer (Stuart: "a zoomed in UK over a zoomed
    #     out USA"), and the renders it did finish took 84–193 ms. Unboosted at 300 the same map rendered in ~20 ms with
    #     no timeouts at all (handheld40, 1277–1327 s). So the GPU is no longer boosted: ANY step off the 300 pin breaks
    #     this board's GPU. The boost is the CPU's top step alone (apply_cpu); the GPU and memory stay on their caps.
    BOOST_TARGETS = {}

    def set_boost(self, v):
        on = bool(int(v))
        if on == getattr(self, "boost", False):
            return
        self.boost = on
        self.apply_cpu()
        for d, cap in self.DEVFREQ_CAPS:
            avail = sorted(int(x) for x in rd(d + "/available_frequencies", "").split() if x.isdigit())
            if not avail:
                continue
            if d not in self.BOOST_TARGETS:
                continue                                    # ★ never moved by the boost (BOOST_TARGETS)
            up = max([f for f in avail if f <= self.BOOST_TARGETS[d]] or [avail[0]])
            target = up if on else min(cap, avail[-1])
            # ★★★ the GPU is PINNED (min = max — vibe-cpu.service): its clock may share a PLL with the speaker's I2S, so it
            #     never roams; the boost moves the pin (400 while the map is up, 300 after). Order keeps min ≤ max.
            pin = d.endswith("ff400000.gpu")
            try:
                if on:
                    wr(d + "/max_freq", target)
                    if pin: wr(d + "/min_freq", target)
                else:
                    if pin: wr(d + "/min_freq", target)
                    wr(d + "/max_freq", target)
            except OSError as e:
                log("boost:", d, e)
        log("performance boost:", "ON (the map) — no clock moved" if on else "off")

    # ── the INPUT FLOOR test setting (VLIM_CHOICES) ──
    def chrg_in_target(self):
        return VLIM_CHOICES.get(self.cfg.get("vlimMv"), CHRG_IN_2A)

    def set_vlim(self, v):
        mv = int(v)
        if mv not in VLIM_CHOICES:
            raise ValueError("input floor must be one of %s mV" % "/".join(str(x) for x in sorted(VLIM_CHOICES, reverse=True)))
        old = self.cfg["vlimMv"]
        if mv == old:
            return
        self.cfg["vlimMv"] = mv
        log("charger: INPUT FLOOR (TEST) changed %.1f V -> %.1f V — CHRG_IN will be 0x%02x%s" %
            (old / 1000.0, mv / 1000.0, VLIM_CHOICES[mv], "" if mv != VLIM_DEFAULT_MV else " (the default again)"))
        self.save_soon()
        if self.watch:
            self.watch.next_check = 0.0              # ★ applied on the watch's next tick (≤ 0.1 s) if the cord is in
        self.chg_cfg = None                          # FullJudge reads the floor again

    # ── backlight ──
    def apply_brightness(self):
        if self.screen == "on":
            try:
                wr(BL + "/bl_power", 0)
                # ★ a STRESS calibration holds the backlight at full (Stress) — a screen woken mid-run stays at full
                st = getattr(self, "stress", None)
                wr(BL + "/brightness", self.max_brightness if st and st.on else self.cfg["brightness"])
            except OSError as e:
                log("backlight:", e)

    def set_brightness(self, v):
        v = int(v)
        if not 0 <= v <= self.max_brightness:
            raise ValueError("brightness out of range 0..%d" % self.max_brightness)
        self.cfg["brightness"] = max(MIN_BRIGHTNESS, v)
        self.apply_brightness()
        self.save_soon()

    def set_screen(self, on, why="request"):
        want = "on" if on else "off"
        if want == self.screen:
            return
        self.screen = want
        log("screen", want, "(%s, %d listening)" % (why, len(self.subscribers)))
        try:
            if on:
                self.apply_brightness()
            else:
                # ★ bl_power 4 = FB_BLANK_POWERDOWN: pwm-backlight drops its enable line and stops the PWM — the LEDs
                #   are what cost the battery. The panel itself keeps scanning out: DPMS needs the DRM master, and that
                #   is Cog. Audio is untouched (Stuart: short press = screen off, audio keeps playing).
                wr(BL + "/brightness", 0)
                wr(BL + "/bl_power", 4)
        except OSError as e:
            log("screen:", e)
        self.emit({"event": "screen", "screen": self.screen})

    # ── audio ──
    def apply_volume(self):
        raw = pct_to_raw(self.cfg["volume"])
        amixer("cset", "name=Master Playback Volume", "%d,%d" % (raw, raw))

    def set_volume(self, v, announce=False):
        v = int(v)
        if not 0 <= v <= 100:
            raise ValueError("volume out of range 0..100")
        self.cfg["volume"] = v
        self.apply_volume()
        self.save_soon()
        if announce:
            self.emit({"event": "volume", "volume": v, "muted": v == 0})

    def set_output(self, headphones):
        # ★ 'Playback Mux' (numid 6 on rk817_ext): item 0 = HP, 1 = SPK. The card is SILENT until it is set — day one
        #   (2026-11-05, measured on the device: SPK = the speaker).
        # ★★ This unit's tree is rk817-sound-AMPLIFIED: the speaker is an external amp ("Speaker Amp", GPIO enable) behind
        #    a DAPM pin switch, 'Internal Speakers Switch'. Under ROCKNIX something had it on; here nothing did, so it is
        #    set explicitly — on for the speaker, off with headphones in (2026-11-06, the first card: no audio).
        self.output = "headphones" if headphones else "speaker"
        amixer("cset", "name=Playback Mux", "HP" if headphones else "SPK")
        if self.has_control("Internal Speakers Switch"):
            amixer("cset", "name=Internal Speakers Switch", "off" if headphones else "on")
        self.emit({"event": "output", "output": self.output})

    def has_control(self, name):
        cache = self.__dict__.setdefault("_controls", None)
        if cache is None:
            try:
                r = subprocess.run(["amixer", "-c", CARD, "controls"], capture_output=True, text=True, timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                return False                      # ★ not cached: asked again on the next switch
            cache = self._controls = r.stdout
            log("ALSA controls:", " | ".join(l.split("name=", 1)[-1] for l in r.stdout.splitlines()))
        return ("name='%s'" % name) in cache

    # ── battery ──
    def read_battery(self):
        pct = rd(BAT + "/capacity")
        status = rd(BAT + "/status", "Unknown")
        online = rd(CHG + "/online", "0") == "1"
        raw = int(pct) if pct and pct.lstrip("-").isdigit() else None
        # ★★ CALIBRATED: the % on this unit's MEASURED capacity (BatteryCal), not the gauge's assumed one — the meter,
        #    the 10 % warning, the 3 % floor and the engine's time-left (its slope of this %) all follow it
        cal = getattr(self, "cal", None)
        cp = cal_pct(rd_num(BAT + "/charge_now", 1), cal.result) if cal else None
        if cp is not None:
            raw = 100 if status == "Full" else cp
        # ★★ CHARGING = THE CORD IS IN (Stuart 2026-11-14: "the battery meter seems a bit erratic when charging"). The
        #    battery's own status flips Charging / Not charging / Discharging while the console + radio share the 2 A port
        #    with it (the charge current falls to ~0 and back), so the bolt came and went; the charger's `online` is the
        #    plug itself. "Full" with the cord in is still "on the charger".
        return {"pct": raw, "raw": raw, "charging": online or status in ("Charging", "Full"), "online": online, "status": status}

    # ★★★ WHAT THE METER SHOWS IS SMOOTHED; WHAT SWITCHES THE RADIO OFF IS NOT. The rk817 fuel gauge's capacity is an
    #     estimate that leans on the battery voltage, and charging lifts that voltage (the charge current through the
    #     cell's resistance) — so on the charger it jumps up, sags when the radio's draw rises, and drops several % the
    #     moment the cord comes out. The meter therefore only moves the way the battery can: never DOWN while the cord is
    #     in (the battery is not emptying), never UP without it, and at most kBatStep % per reading — fast enough to follow
    #     ~1 A into the cell (about 1 % in 20 s). A real move in the "wrong" direction (a charger too weak for the load,
    #     a gauge re-calibration) is followed once it has held for kBatHold readings. The 3 % shutdown and the 10 %
    #     warning read the RAW figure, as before.
    BAT_STEP, BAT_HOLD = 2, 3
    def smooth_battery(self, b):
        raw, shown = b["raw"], self.battery.get("pct")
        if raw is None or shown is None or b["online"] != self.battery.get("online"):
            self.bat_against = 0
            out = raw if shown is None or raw is None else shown   # ★ a plug change holds what was shown, then follows
        else:
            d = raw - shown
            wrong = (d < 0) if b["online"] else (d > 0)
            if wrong:
                self.bat_against = getattr(self, "bat_against", 0) + 1
                d = 0 if self.bat_against < self.BAT_HOLD else d
            else:
                self.bat_against = 0
            out = shown + max(-self.BAT_STEP, min(self.BAT_STEP, d))
            if raw == 100 and b["status"] == "Full": out = 100
        if raw is not None and shown is not None and abs(raw - shown) >= 3:
            # ★ the evidence for the next debug-log read: what the gauge said, and why it may have said it
            log("battery: gauge %d %% (showing %d %%), %s, online %d, %s uV, %s uA" % (raw, out, b["status"], b["online"],
                rd(BAT + "/voltage_now", "?"), rd(BAT + "/current_now", "?")))
        return dict(b, pct=out)

    async def charger_loop(self):
        """Hold the charge port's input limit at 2 A whenever the charger is in (see PMIC_ADDR above), and log what the
        port does around every plug-in / plug-out (ChargerWatch). A 100 ms look at sysfs; the PMIC is touched only on
        a plug edge, once a second while charging, and during the 5 s trace after an edge."""
        dev = pmic_bus()
        if not dev:
            log("charger: PMIC i2c bus not found — the input limit stays at the driver's 1.5 A and there is no fast trace")
        else:
            try:   # ★ once, read only: the evidence for vibe-charge-fast's 0xA0 and for the driver's own CHRG_IN
                log("charger: PMIC at start-up — CHRG_OUT 0x%02x (vibe-charge-fast expects 0xa0), CHRG_IN 0x%02x" %
                    (pmic_read(dev, CHRG_OUT), pmic_read(dev, CHRG_IN)))
            except OSError as e:
                log("charger: PMIC not readable:", e)
        # ★★ the drop-triggered fast trace (FastTrace): its own thread and its own fd, so a 20 ms sample never waits on
        #    the event loop (the buttons) and the loop never waits on it
        reader = None
        if dev:
            try:
                reader = PmicFd(dev)
            except OSError as e:
                log("chgtrace: PMIC not opened — no fast trace:", e)
        trace = FastTrace(reader, res_div=sense_res_div(), vlim_mv=lambda: self.cfg["vlimMv"])
        if reader:
            self.trace_stop = threading.Event()
            threading.Thread(target=trace.run, args=(self.trace_stop,), name="chgtrace", daemon=True).start()
            log("chgtrace: ready — PMIC registers every %d ms while the charger is in and a USB device is plugged; a burst "
                "at every USB drop and plug edge (sense resistor %s)" % (round(FastTrace.SAMPLE_S * 1000),
                "÷%d" % trace.res_div if trace.res_div else "unknown — battery current left out"))
        w = self.watch = ChargerWatch(dev, self.chrg_in_target, trace if reader else None)
        while True:
            w.tick(time.monotonic())
            await asyncio.sleep(ChargerWatch.POLL_S)

    async def battery_loop(self):
        while True:
            b = self.smooth_battery(self.read_battery())
            if (b["pct"], b["charging"]) != (self.battery["pct"], self.battery["charging"]):
                self.battery = b
                if b["pct"] is not None:
                    self.emit({"event": "battery", "pct": b["pct"], "charging": b["charging"]})
            self.battery = b
            pct = b["raw"]   # ★ the floor and the warning judge the gauge itself, not the smoothed meter
            if pct is not None and not b["charging"]:
                if pct <= LOW_PCT and not self.low_warned:
                    self.low_warned = True
                    self.emit({"event": "battery_low", "pct": pct})
                # ★ two readings in a row at or under 3 % — one glitchy fuel-gauge sample must not switch the radio off.
                self.empty_count = self.empty_count + 1 if pct <= EMPTY_PCT else 0
                if self.empty_count >= 2:
                    # ★ a calibration reaching the floor before its own empty point: that IS its empty point
                    if self.cal.phase == "running":
                        self.cal_event(self.cal.finish(rd_num(BAT + "/charge_now", 1), self.full_uah, "the %d %% floor" % EMPTY_PCT))
                    await self.shutdown("battery", "poweroff")
            else:
                self.empty_count = 0
                if pct is not None and pct > LOW_PCT + 2:
                    self.low_warned = False
            await asyncio.sleep(20 if (pct or 100) > 15 else 5)

    # ── the live figures + calibration (once a second) ──
    def power_tick(self, t):
        online = rd(CHG + "/online", "0") == "1"
        status = rd(BAT + "/status", "Unknown")
        bat_v = rd_num(BAT + "/voltage_avg")
        if bat_v is None:
            bat_v = rd_num(BAT + "/voltage_now")
        bat_a = rd_num(BAT + "/current_avg")
        if bat_a is None:
            bat_a = rd_num(BAT + "/current_now")
        port_v = rd_num(CHG + "/voltage_avg")
        q = rd_num(BAT + "/charge_now", 1)
        full = rd_num(BAT + "/charge_full", 1) or rd_num(BAT + "/charge_full_design", 1)
        if not online:
            self.use.feed_battery(t, bat_v, bat_a)       # ★ only a genuine discharge is the unit's use
        self.q_now, self.full_uah = q, full
        # ★★★ GENUINELY FULL? the charger's physics, never the gauge's % (FullJudge)
        cfg = self.charger_cfg(t)
        sts = self.pmic(CHRG_STS) if online else None
        self.judge.feed(t, online, status, bat_v, bat_a, port_v, cfg, sts)
        gp = rd(BAT + "/capacity")
        self.power = live_power(online, status, bat_v, bat_a, port_v, self.use.w, q, full, self.use.age(t),
                                int(gp) if gp and gp.lstrip("-").isdigit() else None, self.judge.wire(t, cfg))
        self.cal_event(self.cal.step(t, online, status, bat_v, q, full, self.judge.state == "full"))
        self.stress.thermal()

    def cal_event(self, ev):
        """What a calibration step decided: the load on / off, an event for the UI, the clean power-off at empty."""
        if not ev:
            return
        if ev[0] in ("armed", "notfull", "charging"):
            # ★ on the charger: genuinely full (unplug now) · pulled out before full · the cord back in. No load yet.
            self.emit({"event": "battery_cal", "phase": ev[0], "mode": self.cal.mode})
        elif ev[0] == "running":
            if self.cal.mode == "stress":
                self.stress.start()
            self.emit({"event": "battery_cal", "phase": "running", "mode": self.cal.mode})
        elif ev[0] == "cancelled":
            self.stress.stop()
            self.emit({"event": "battery_cal", "phase": "cancelled", "note": ev[1]})
        elif ev[0] == "done":
            self.stress.stop()
            res, note = ev[1], ev[2]
            self.emit({"event": "battery_cal", "phase": "done", "mah": res["mah"] if res else None, "note": note})
            if not self.shutting_down:
                asyncio.get_running_loop().create_task(self.shutdown("battery-cal", "poweroff"))

    def cal_start(self, mode):
        online = rd(CHG + "/online", "0") == "1"
        self.cal.start(mode, online, self.judge.state == "full", rd_num(BAT + "/charge_now", 1))
        self.emit({"event": "battery_cal", "phase": self.cal.phase, "mode": mode, "start": True})   # (the UI toasts its own reply)

    def cal_cancel(self):
        if self.cal.cancel("calibration cancelled"):
            self.stress.stop()
            self.emit({"event": "battery_cal", "phase": "cancelled", "note": "calibration cancelled"})

    async def power_loop(self):
        while True:
            try:
                self.power_tick(time.monotonic())
            except Exception as e:          # ★ a sysfs oddity must never stop the clean shutdown at empty
                log("power:", type(e).__name__, e)
            await asyncio.sleep(1)

    # ── shutdown ──
    async def shutdown(self, reason, how):
        """Tell the engine, wait ≤ 5 s for its ack (every radio's memory saved), then a clean systemd power-off —
        which stops the engine, unmounts the card and the state partition, and saves the clock on the way."""
        if self.shutting_down:
            return
        self.shutting_down = True
        log("shutdown:", reason, how)
        self.stress.stop()
        self.acks.clear()
        waiting = set(self.subscribers)
        self.emit({"event": "shutdown", "reason": reason, "inSec": int(ACK_WAIT_S)})
        t0 = time.monotonic()
        while waiting - self.acks and time.monotonic() - t0 < ACK_WAIT_S:
            await asyncio.sleep(0.1)
        log("engine ack" if waiting and not (waiting - self.acks) else "no ack (%d subscriber(s))" % len(waiting),
            "after %.1f s" % (time.monotonic() - t0))
        os.sync()
        if self.screen == "off":
            self.set_screen(True)
        msg = {"battery": "Battery empty — switching off", "power-button": "Switching off",
               "battery-cal": "Battery calibrated — switching off",
               "request": "Restarting" if how == "reboot" else "Switching off"}[reason]
        if DRYRUN:
            log("DRYRUN: would stop the kiosk, show '%s' and systemctl %s" % (msg, how))
            self.shutting_down = False
            return
        # ★ Cog holds the display; stop it so the splash can say what is happening while systemd shuts down.
        subprocess.run(["systemctl", "stop", "vibe-kiosk.service"], timeout=10)
        subprocess.Popen([SPLASH, "--message", msg, "--no-progress"], stdin=subprocess.DEVNULL)
        subprocess.run(["systemctl", "--no-block", how])

    # ── clock ──
    def set_time(self, utc_ms):
        utc_ms = int(utc_ms)
        if not 1577836800000 <= utc_ms <= 4102444800000:       # 2020 … 2100: anything else is a bad request
            raise ValueError("time out of range")
        time.clock_settime(time.CLOCK_REALTIME, utc_ms / 1000.0)
        # ★ vibe-clock writes the RTC (when it can be written) and the saved floor/offset on the state partition.
        # ★★ OFF THE LOOP (2026-11-08): a save now waits up to a second for the RTC's tick (vibe-clock's header), and the
        #    loop is what answers the buttons — so it runs in a thread, after the clock itself is already set.
        threading.Thread(target=lambda: subprocess.run([CLOCK, "save"], timeout=10), daemon=True).start()

    async def clock_loop(self):
        while True:
            await asyncio.sleep(600)       # ★ every 10 min: a flat battery loses at most 10 min of the clock floor
            await asyncio.get_running_loop().run_in_executor(None, lambda: subprocess.run([CLOCK, "save"], timeout=10))

    # ── the socket ──
    def emit(self, ev):
        line = (json.dumps(ev) + "\n").encode()
        for w in list(self.subscribers):
            try:
                w.write(line)
            except Exception:
                self.subscribers.discard(w)

    def state(self):
        b = self.battery if self.battery["pct"] is not None else self.read_battery()
        return {"ok": True, "brightness": self.cfg["brightness"], "maxBrightness": self.max_brightness,
                "volume": self.cfg["volume"], "muted": self.cfg["volume"] == 0, "output": self.output,
                "battery": {"pct": b["pct"], "charging": b["charging"], "status": b["status"]}, "screen": self.screen,
                "power": self.power, "calib": dict(self.cal.wire(self.q_now), stress=self.stress.wire()),
                "vlimMv": self.cfg["vlimMv"], "vlimChoices": sorted(VLIM_CHOICES, reverse=True)}

    async def handle(self, req, writer):
        if not isinstance(req, dict):
            raise ValueError("bad request")
        if req.get("ack") == "shutdown":
            self.acks.add(writer)
            return None                                    # ★ an ack is not a request: no reply line
        if req.get("subscribe") is True:
            self.subscribers.add(writer)
            return {"ok": True}
        g, s, a = req.get("get"), req.get("set"), req.get("action")
        if g == "state":
            return self.state()
        if g == "ssh" or s in ("ssh", "ssh-password"):
            # ★★★ NO SSH ON THE HANDHELD (Stuart 2026-11-05: "we don't need SSH"). The image has no sshd at all and
            #     nothing listens on any port but the engine on 127.0.0.1; debugging is the card's "Diagnostic logs/".
            #     The §0.2 requests are answered — never silently ignored — and a password is never read or kept.
            raise ValueError("not supported")
        if s == "brightness":
            self.set_brightness(req.get("value"))
        elif s == "volume":
            self.set_volume(req.get("value"))
        elif s == "boost":
            self.set_boost(req.get("value"))
        elif s == "vlim":
            self.set_vlim(req.get("value"))
        elif s == "time":
            self.set_time(req.get("utcMs"))
        elif a in ("poweroff", "reboot"):
            asyncio.get_running_loop().create_task(self.shutdown("request", a))
        elif a == "calibrate":
            self.cal_start(req.get("mode"))
        elif a == "calibrate-cancel":
            self.cal_cancel()
        elif a == "screen-off":
            # ★ not while a STRESS calibration runs: the lit backlight is part of the load (the power button still can)
            if not self.stress.on:
                self.set_screen(False)
        elif a == "screen-on":
            self.set_screen(True)
        else:
            raise ValueError("unknown request")
        return {"ok": True}

    async def client(self, reader, writer):
        self.clients.add(writer)
        try:
            while True:
                line = await reader.readline()
                if not line:
                    break
                if len(line) > 8192:
                    reply = {"ok": False, "error": "request too long"}
                else:
                    try:
                        req = json.loads(line)
                    except ValueError:
                        req = None
                    try:
                        reply = await self.handle(req, writer)
                    except (ValueError, TypeError) as e:
                        reply = {"ok": False, "error": str(e) or "bad request"}
                    except Exception as e:      # ★ one bad request must never take the service down
                        log("request failed:", type(e).__name__)
                        reply = {"ok": False, "error": "internal error"}
                if reply is not None:
                    writer.write((json.dumps(reply) + "\n").encode())
                    await writer.drain()
        except (ConnectionError, asyncio.IncompleteReadError):
            pass
        finally:
            self.clients.discard(writer)
            self.subscribers.discard(writer)
            writer.close()

    # ── input ──
    def on_key(self, dev, code, value):
        if code in (KEY_VOLUMEUP, KEY_VOLUMEDOWN) and value in (1, 2):        # press + auto-repeat
            step = VOL_STEP if code == KEY_VOLUMEUP else -VOL_STEP
            v = max(0, min(100, self.cfg["volume"] + step))
            if v != self.cfg["volume"] or value == 1:
                self.set_volume(v, announce=True)
        elif code == KEY_POWER:
            loop = asyncio.get_running_loop()
            if value == 1:
                self.power_down_at = time.monotonic()
                async def held():
                    await asyncio.sleep(LONG_PRESS_S)
                    self.power_down_at = None
                    await self.shutdown("power-button", "poweroff")
                self.power_task = loop.create_task(held())
            elif value == 0 and self.power_down_at is not None:
                self.power_down_at = None
                if self.power_task:
                    self.power_task.cancel()
                self.set_screen(self.screen == "off", "power button")         # short press: screen off / on
        elif dev == "gamepad" and value == 1 and self.screen == "off":
            self.set_screen(True, "pad button")                               # ★ any pad button wakes the screen

    def on_switch(self, code, value):
        if code == SW_HEADPHONE_INSERT:
            self.set_output(bool(value))

    async def read_dev(self, kind, path):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            log("cannot open", path, e)
            return
        try:
            if kind in ("power", "volume"):
                # ★ ours alone: Cog's libinput would otherwise hand KEY_POWER / volume keys to the page as keystrokes.
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 1)
                except OSError:
                    pass
            if kind == "jack":
                buf = bytearray(8)
                fcntl.ioctl(fd, EVIOCGSW(len(buf)), buf)
                self.set_output(bool(buf[0] & (1 << SW_HEADPHONE_INSERT)))
            loop = asyncio.get_running_loop()
            q = asyncio.Event()
            loop.add_reader(fd, q.set)
            try:
                while True:
                    await q.wait()
                    q.clear()
                    while True:
                        try:
                            data = os.read(fd, EVENT.size * 64)
                        except BlockingIOError:
                            break
                        if not data:
                            raise OSError("gone")
                        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                            _, _, typ, code, value = EVENT.unpack_from(data, i)
                            if typ == EV_KEY:
                                self.on_key(kind, code, value)
                            elif typ == EV_SW:
                                self.on_switch(code, value)
            finally:
                loop.remove_reader(fd)
        except OSError as e:
            log(path, "closed:", e)
        finally:
            os.close(fd)
            self.readers.pop(path, None)

    async def input_loop(self):
        kinds = {"rk805 pwrkey": "power", "adc-keys": "volume", "gpio-keys": "volume",
                 "rk817_ext Headphones": "jack", "r36s_Gamepad": "gamepad"}
        jack_seen = False
        while True:
            for name, path in input_devices():
                kind = kinds.get(name)
                if kind and path not in self.readers:
                    jack_seen |= kind == "jack"
                    self.readers[path] = asyncio.get_running_loop().create_task(self.read_dev(kind, path))
            if not jack_seen and self.output != "speaker":
                self.set_output(False)
            await asyncio.sleep(5)       # ★ the joypad is a module and can arrive late; a USB keyboard can come and go

    async def main(self):
        self.apply_brightness()
        self.apply_cpu()          # ★ the CPU SPEED cap, after vibe-cpu.service set schedutil + the 1296 MHz ceiling
        self.apply_volume()
        if not any(n == "rk817_ext Headphones" for n, _ in input_devices()):
            self.set_output(False)       # ★ no jack detector: the speaker, never the silent default (HP)
        try:
            os.unlink(SOCK)
        except FileNotFoundError:
            pass
        old = os.umask(0o117)
        server = await asyncio.start_unix_server(self.client, path=SOCK, limit=16384)
        os.umask(old)
        # ★ root:vibeserver 0660 — the engine connects, nobody else (§0.2).
        try:
            os.chown(SOCK, 0, grp.getgrnam("vibeserver").gr_gid)
        except KeyError:
            log("no vibeserver group — socket left root-only")
        os.chmod(SOCK, 0o660)
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(sig, server.close)
        log("ready on", SOCK)
        tasks = [loop.create_task(t) for t in (self.input_loop(), self.battery_loop(), self.charger_loop(), self.clock_loop(),
                                                    self.power_loop())]
        try:
            await server.serve_forever()
        except asyncio.CancelledError:
            pass
        finally:
            for t in tasks:
                t.cancel()
            self.stress.stop()
            if self.save_task and not self.save_task.done():
                atomic_write(HWD_JSON, json.dumps(self.cfg))


if __name__ == "__main__":
    try:
        asyncio.run(Hwd().main())
    except KeyboardInterrupt:
        pass
