CAL_JSON = os.path.join(STATE_DIR, "battery-cal.json")
THERMAL = SYS + "/class/thermal/thermal_zone0/temp"
CAL_EMPTY_V = 3.50            # ★ a safe empty: the battery UNDER LOAD at or below this …
CAL_EMPTY_HOLD_S = 8.0        #   … for this long without a reading above it (one dip is a load step, not empty)
USE_TAU_S = 60.0              # the "unit using" figure: discharge power smoothed over about a minute
