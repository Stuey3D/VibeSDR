# ── the PMIC's charge-port input limit ──────────────────────────────────────────────────────────────────────────────
# ★★★ 2 A FROM THE CHARGER WHILE THE CONSOLE IS ON (Stuart 2026-11-11: "if we can tell the charger to give 2a when the
#     unit is powered on then that will be good" — the R36S manual's charger is 5 V 2 A). The mainline rk817 driver
#     hard-wires the USB input limit at 1.5 A and writes it again on every UNPLUG (its plug-out handler: the PMIC resets
#     those bits when the cord comes out). At 1.5 A, ~1.0 A into the battery + the console + the radio pinned the port:
#     the BOOST's supply sagged as the RTL-SDR started streaming and it dropped off USB every ~4 s (handheld61 logs
#     2f39c04a / cac5d085). So: 2 A at start-up and again whenever the charger is in and the limit is not 2 A (i.e.
#     after every plug-in), with the battery held at 1.0 A (vibe-r36s.dts &battery) — ~1.5 A drawn, ~0.5 A spare.
#     ★ Register 0xE5 RK817_PMIC_CHRG_IN: bit 3 USB_ILIM_EN, bits 2:0 USB_ILIM_SEL — Rockchip's own rk817 driver's
#       table: 0 = 450 mA, 1 = 80, 2 = 850, 3 = 1500, 4 = 1750, 5 = 2000, 6 = 2500, 7 = 3000. Bits 7:4 (the 4.5 V input
#       voltage floor the driver set) are kept. The register is uncached in the kernel (REGCACHE_NONE, volatile), and the
#       driver touches it only on unplug, so this write stands until then.
PMIC_ADDR, CHRG_OUT, CHRG_IN = 0x20, 0xE4, 0xE5
# ★★ WRITTEN AS ONE FIXED VALUE, never read-modify-write: 0xDD = USB_VLIM_EN | 4.5 V floor (sel 5, the driver's own) |
#    USB_ILIM_EN | 2 A (sel 5). The driver's value is 0xDB (the same with 1.5 A) — read at start-up on handheld62.
CHRG_IN_2A = 0xDD
class _SmbusData(ctypes.Union):
    _fields_ = [("byte", ctypes.c_uint8), ("word", ctypes.c_uint16), ("block", ctypes.c_uint8 * 34)]

class _SmbusIoctl(ctypes.Structure):
    _fields_ = [("read_write", ctypes.c_uint8), ("command", ctypes.c_uint8), ("size", ctypes.c_uint32),
                ("data", ctypes.POINTER(_SmbusData))]

I2C_SLAVE_FORCE, I2C_SMBUS, SMBUS_BYTE_DATA, SMBUS_READ, SMBUS_WRITE = 0x0706, 0x0720, 2, 1, 0

def _smbus(dev, rw, reg, val=0):
    """ONE SMBus byte-data transfer (I2C_SMBUS ioctl): the register-pointer write and the read go as one i2c_transfer
    with a repeated start, under the adapter's lock, so the kernel's own PMIC traffic (the fuel gauge polls it many
    times a second) cannot land in between. ★★ handheld62 read with two plain read()/write() calls and the driver DID
    land in between: about one second in three read ANOTHER register (0x24, 0x0f, 0x05 instead of 0xdb) — and the
    read-modify-write then wrote those bits back (CHRG_IN 0x2d: the 4.5 V input floor switched off).
    FORCE: the rk808 driver owns address 0x20."""
    data = _SmbusData()
    data.byte = val
    fd = os.open(dev, os.O_RDWR)
    try:
        fcntl.ioctl(fd, I2C_SLAVE_FORCE, PMIC_ADDR)
        fcntl.ioctl(fd, I2C_SMBUS, _SmbusIoctl(rw, reg, SMBUS_BYTE_DATA, ctypes.pointer(data)))
    finally:
        os.close(fd)
    return data.byte

def pmic_read(dev, reg):
    return _smbus(dev, SMBUS_READ, reg)

def pmic_write(dev, reg, val):
    _smbus(dev, SMBUS_WRITE, reg, val)

def pmic_bus():
    """/dev/i2c-N of the RK817 (address 0x20 on i2c@ff180000) — found by its device node, never assumed."""
    for d in glob.glob(SYS + "/bus/i2c/devices/*-0020"):
        if "ff180000" in os.path.realpath(d):
            return "/dev/i2c-" + os.path.basename(d).split("-")[0]
    return None

# ── evdev ────────────────────────────────────────────────────────────────────────────────────────────────────────────
EV_KEY, EV_SW = 0x01, 0x05
KEY_VOLUMEDOWN, KEY_VOLUMEUP, KEY_POWER = 114, 115, 116
SW_HEADPHONE_INSERT = 0x02
EVENT = struct.Struct("llHHi")              # struct input_event on 64-bit: timeval (2 × long), type, code, value

def _IOC(d, t, nr, size): return (d << 30) | (size << 16) | (ord(t) << 8) | nr
EVIOCGRAB = _IOC(1, "E", 0x90, 4)
def EVIOCGSW(n): return _IOC(2, "E", 0x1B, n)
def EVIOCGKEY(n): return _IOC(2, "E", 0x18, n)

def log(*a):
    print("vibe-hwd:", *a, file=sys.stderr, flush=True)

def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def wr(path, value):
    with open(path, "w") as f:
        f.write(str(value))

def atomic_write(path, data, mode=0o644):
    # ★ temp + fsync + rename + fsync(dir): a power cut leaves the old file or the new one, never half of either.
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        os.write(fd, data.encode() if isinstance(data, str) else data)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, path)
    dfd = os.open(os.path.dirname(path) or ".", os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)

def input_devices():
    """[(name, /dev/input/eventN)] for every input device the kernel has right now (names can repeat)."""
    out = []
    for p in sorted(glob.glob(SYS + "/class/input/event*")):
        name = rd(p + "/device/name")
        if name:
            out.append((name, "/dev/input/" + os.path.basename(p)))
    return out

# ── ALSA (amixer: tiny, always in alsa-utils, and the controls change rarely) ─────────────────────────────────────────
def amixer(*args):
    try:
        r = subprocess.run(["amixer", "-q", "-c", CARD, *args], capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            log("amixer", *args, "failed:", r.stderr.strip())
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired) as e:
        log("amixer", *args, "failed:", e)
        return False

def pct_to_raw(pct):
    """0..100 → 'Master Playback Volume' 0..255, which the codec spans as −95..0 dB in even steps.
    ★ alsamixer's own mapping (volume_mapping.c): equal steps sound like equal steps — linear raw values would put
      all the audible change in the top quarter of the slider."""
    if pct <= 0:
        return 0
    min_db, max_db = -95.0, 0.0
    min_norm = 10 ** ((min_db - max_db) / 60.0)
    n = (pct / 100.0) * (1 - min_norm) + min_norm
    db = 60.0 * math.log10(n) + max_db
    return max(0, min(255, round((db - min_db) / (max_db - min_db) * 255)))


def _uv(path):
    """A sysfs µV / µA figure as V / A (None when missing)."""
    v = rd(path)
    try:
        return int(v) / 1e6
    except (TypeError, ValueError):
        return None

def _f(v, unit, signed=False):
    return "?" if v is None else (("%+.3f" if signed else "%.3f") % v) + unit


# ── the battery's live figures + calibration ──────────────────────────────────────────────────────────────────────────
CAL_JSON = os.path.join(STATE_DIR, "battery-cal.json")
THERMAL = SYS + "/class/thermal/thermal_zone0/temp"
CAL_EMPTY_V = 3.50            # ★ a safe empty: the battery UNDER LOAD at or below this …
CAL_EMPTY_HOLD_S = 8.0        #   … for this long without a reading above it (one dip is a load step, not empty)
USE_TAU_S = 60.0              # the "unit using" figure: discharge power smoothed over about a minute
STRESS_MAX_KHZ = 1296000      # ★★ the image's own ceiling (vibe-cpu.service) — NEVER the 1416 / 1512 overclock OPPs
STRESS_BURNERS = 4            # one per core
STRESS_HOT_C, STRESS_HOTTER_C, STRESS_COOL_C = 75.0, 80.0, 70.0

def rd_num(path, scale=1e6):
    """A sysfs µ-unit figure scaled (µV → V by default); None when missing or not a number."""
    v = rd(path)
    try:
        return int(v) / scale
    except (TypeError, ValueError):
        return None

def cal_pct(q_now_uah, result):
    """★ THE % ON THE MEASURED CAPACITY: where the counter is between this unit's own empty and full, as calibrated —
    (now − the counter at empty) / the measured capacity. None when not calibrated or the counter cannot be read."""
    if not result or q_now_uah is None:
        return None
    try:
        span = float(result["mah"]) * 1000.0
        q_empty = float(result["qEmpty"])
    except (KeyError, TypeError, ValueError):
        return None
    if span <= 0:
        return None
    return int(max(0, min(100, round((q_now_uah - q_empty) * 100.0 / span))))

def cal_plausible(mah, design_mah):
    """A measured capacity worth keeping: 30 … 150 % of what the gauge assumes (or ≥ 200 mAh when it says nothing)."""
    if mah is None or mah <= 0:
        return False
    if not design_mah:
        return mah >= 200
    return 0.3 * design_mah <= mah <= 1.5 * design_mah

class EmptyDetector:
    """CAL_EMPTY_V or under, held CAL_EMPTY_HOLD_S with no reading above it (a reading of None changes nothing)."""
    def __init__(self, volts=CAL_EMPTY_V, hold_s=CAL_EMPTY_HOLD_S):
        self.volts, self.hold_s, self.since = volts, hold_s, None
    def feed(self, t, v):
        if v is None:
            return False
        if v > self.volts:
            self.since = None
            return False
        if self.since is None:
            self.since = t
        return t - self.since >= self.hold_s

class UseSmoother:
    """★ WHAT THE UNIT ITSELF USES. The rk817 driver reports no input current and no system draw, so on the charger
    the console's own use is not measured at all. The best figure is the last one measured: the battery's discharge
    power, smoothed (exponential, USE_TAU_S), kept from before the cord went in. Fed only while on battery."""
    def __init__(self, tau=USE_TAU_S):
        self.tau, self.w, self.t = tau, None, None
    def feed(self, t, watts):
        if watts is None or watts <= 0:
            return self.w
        if self.w is None or self.t is None:
            self.w = watts
        else:
            k = 1.0 - math.exp(-max(0.0, t - self.t) / self.tau)
            self.w += (watts - self.w) * k
        self.t = t
        return self.w

def live_power(online, status, bat_v, bat_a, port_v, use_w, charge_now_uah, full_uah):
    """The figures the Battery block shows (rounded for the wire). bat_a is a magnitude; `dir` says which way."""
    discharging = not online or status == "Discharging"
    r = lambda x, n: None if x is None else round(x, n)
    return {"online": online, "status": status, "batV": r(bat_v, 3), "batA": r(None if bat_a is None else abs(bat_a), 3),
            "batW": r(None if bat_a is None or bat_v is None else abs(bat_a) * bat_v, 2),
            "dir": "discharge" if discharging else "charge", "portV": r(port_v, 3) if online else None,
            "useW": r(use_w, 2), "chargeMah": None if charge_now_uah is None else int(charge_now_uah // 1000),
            "fullMah": None if full_uah is None else int(full_uah // 1000)}


class BatteryCal:
    """★★★ BATTERY CALIBRATION (Stuart, 2026-11-15): the rk817 gauge assumes a full-charge capacity (boot log "fcc 2808
    mAh") bigger than this owner's cell — it reads ~93 % at a true full. Every unit differs, so nothing is hard-coded:
    the DISCHARGE leg is measured. It starts only on Full (else "charge to Full first"); the owner unplugs; the PMIC's
    coulomb counter (charge_now) is read at Full and again at a SAFE empty (CAL_EMPTY_V under load, held — EmptyDetector);
    the difference is this cell's capacity. Then a CLEAN shutdown (never the hard cut-off).
    ★★ The PMIC's counter keeps counting while the console is off, so a power-off mid-way does not spoil it: the state
       is on the state partition (CAL_JSON) and the next boot carries on — in NORMAL mode always (a STRESS run is ended
       by holding POWER; the next boot is the ordinary radio). Only CHARGING before empty cancels it.
    Phases: idle → armed (on Full, the cord still in; the counter at Full kept fresh) → running (unplugged) → idle."""
    def __init__(self, path=CAL_JSON):
        self.path = path
        self.phase, self.mode, self.q0, self.started, self.note, self.result = "idle", "normal", None, None, "", None
        self.empty = EmptyDetector()
        try:
            with open(path) as f:
                d = json.load(f)
            self.phase = d.get("phase", "idle") if d.get("phase") in ("idle", "armed", "running") else "idle"
            self.q0, self.started, self.note = d.get("q0"), d.get("started"), d.get("note", "")
            self.result = d.get("result") if isinstance(d.get("result"), dict) else None
            if self.phase != "idle":
                # ★ a boot in the middle: carry on, as an ordinary radio (a stress run never resumes)
                self.mode = "normal"
                log("battery calibration: resumed after a restart (%s, counter at Full %s µAh) — normal mode" % (self.phase, self.q0))
        except (OSError, ValueError):
            pass

    def save(self):
        try:
            os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
            atomic_write(self.path, json.dumps({"phase": self.phase, "mode": self.mode, "q0": self.q0,
                                                "started": self.started, "note": self.note, "result": self.result}))
        except OSError as e:
            log("battery calibration: could not save", self.path, e)

    def start(self, mode, online, status, q_now):
        if mode not in ("normal", "stress"):
            raise ValueError("mode must be normal or stress")
        if self.phase != "idle":
            raise ValueError("a calibration is already under way")
        if not (online and status == "Full"):
            raise ValueError("charge to Full first")
        if q_now is None:
            raise ValueError("this battery has no charge counter to read")
        self.phase, self.mode, self.q0, self.started, self.note = "armed", mode, q_now, time.time(), ""
        self.empty = EmptyDetector()
        self.save()
        log("battery calibration: armed (%s) — counter at Full %d µAh; unplug to start" % (mode, q_now))

    def cancel(self, note):
        if self.phase == "idle":
            return False
        log("battery calibration:", note)
        self.phase, self.note, self.q0 = "idle", note, None
        self.save()
        return True

    def step(self, t, online, status, bat_v, q_now, design_uah):
        """Once a second. Returns None, ("running",), ("cancelled", note) or ("done", result-or-None, note)."""
        if self.phase == "armed":
            if online:
                if status == "Full" and q_now is not None:
                    self.q0 = q_now                        # ★ the counter at Full, as of the moment the cord comes out
                return None
            self.phase = "running"
            self.save()
            log("battery calibration: unplugged — counting from %s µAh down to %.2f V" % (self.q0, CAL_EMPTY_V))
            return ("running",)
        if self.phase != "running":
            return None
        if online:
            n = "calibration cancelled — it was charged before empty"
            self.cancel(n)
            return ("cancelled", n)
        if self.empty.feed(t, bat_v):
            return self.finish(q_now, design_uah, "%.2f V held %.0f s" % (bat_v, CAL_EMPTY_HOLD_S))
        return None

    def finish(self, q_now, design_uah, why):
        """The empty point: the capacity is the counter's fall since Full."""
        if self.phase != "running":
            return None
        mah = None if q_now is None or self.q0 is None else (self.q0 - q_now) / 1000.0
        design = None if not design_uah else design_uah / 1000.0
        if cal_plausible(mah, design):
            self.result = {"mah": int(round(mah)), "design": None if design is None else int(round(design)),
                           "qEmpty": q_now, "qFull": self.q0, "utc": int(time.time())}
            self.note = ""
            log("battery calibration: empty (%s) — measured %d mAh (the gauge assumes %s)" % (why, self.result["mah"], self.result["design"]))
        else:
            self.note = "calibration failed — the charge counter read %s mAh" % ("?" if mah is None else int(round(mah)))
            log("battery calibration:", self.note, "(%s)" % why)
        self.phase, self.q0 = "idle", None
        self.save()
        return ("done", self.result if not self.note else None, self.note)

    def wire(self, q_now):
        """The calibration's part of {"get":"state"}."""
        counted = None if self.phase != "running" or self.q0 is None or q_now is None else int((self.q0 - q_now) // 1000)
        return {"phase": self.phase, "mode": self.mode, "countedMah": counted, "note": self.note, "result": self.result}


class Stress:
    """★★ STRESS calibration's load (the FAST way to empty): the backlight at full, the CPU on `performance` at the
    image's own ceiling (STRESS_MAX_KHZ — never the overclock steps), a busy loop per core (nice 10, killed with us),
    the speaker muted — none of it saved, all of it put back by stop() (and by any restart: hwd.json is untouched).
    ★ Thermal: over STRESS_HOT_C two burners pause, over STRESS_HOTTER_C all four; under STRESS_COOL_C they run again.
    ★ No GPU load: any clock step off the 300 MHz pin has reset this board's GPU (BOOST_TARGETS' notes), and a
      synthetic GL load means a second display client — not cheap, not safe. The radio is left running as it is."""
    def __init__(self, hwd, spawn=None):
        self.hwd, self.procs, self.running, self.gov = hwd, [], 0, {}
        self._spawn = spawn or self._spawn_burner

    @staticmethod
    def _spawn_burner():
        def child():
            try:   # ★ PR_SET_PDEATHSIG: if vibe-hwd dies, so does the load
                ctypes.CDLL(None).prctl(1, signal.SIGKILL)
            except Exception:
                pass
        return subprocess.Popen(["nice", "-n", "10", "sh", "-c", "while :; do :; done"], stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=child)

    @property
    def on(self):
        return bool(self.procs)

    def start(self):
        if self.procs:
            return
        h = self.hwd
        try:
            wr(BL + "/bl_power", 0)
            wr(BL + "/brightness", h.max_brightness)
        except OSError as e:
            log("stress: backlight:", e)
        for p in glob.glob(CPUFREQ + "/policy*"):
            self.gov[p] = rd(p + "/scaling_governor")
            avail = sorted(int(f) for f in rd(p + "/scaling_available_frequencies", "").split() if f.isdigit())
            top = max([f for f in avail if f <= STRESS_MAX_KHZ] or avail[:1] or [0])
            try:
                if top:
                    wr(p + "/scaling_max_freq", top)
                wr(p + "/scaling_governor", "performance")
            except OSError as e:
                log("stress: cpufreq:", e)
        amixer("cset", "name=Master Playback Volume", "0,0")
        try:
            self.procs = [self._spawn() for _ in range(STRESS_BURNERS)]
        except OSError as e:
            log("stress: load not started:", e)
        self.running = len(self.procs)
        log("stress: on — backlight %d, CPU performance ≤ %d MHz, %d busy loops, speaker muted" %
            (h.max_brightness, STRESS_MAX_KHZ // 1000, len(self.procs)))

    def thermal(self):
        """Once a second while on: pause / resume burners by the SoC temperature."""
        if not self.procs:
            return
        t = rd_num(THERMAL, 1000.0)
        if t is None:
            return
        want = 0 if t >= STRESS_HOTTER_C else STRESS_BURNERS // 2 if t >= STRESS_HOT_C else \
            len(self.procs) if t < STRESS_COOL_C else self.running
        want = min(want, len(self.procs))
        if want != self.running:
            for i, pr in enumerate(self.procs):
                try:
                    os.kill(pr.pid, signal.SIGCONT if i < want else signal.SIGSTOP)
                except OSError:
                    pass
            log("stress: %.1f °C — %d of %d busy loops running" % (t, want, len(self.procs)))
            self.running = want

    def stop(self):
        if not self.procs and not self.gov:
            return
        for pr in self.procs:
            try:
                os.kill(pr.pid, signal.SIGCONT)
                pr.kill()
                pr.wait(timeout=2)
            except Exception:
                pass
        self.procs, self.running = [], 0
        for p, g in self.gov.items():
            if g:
                try:
                    wr(p + "/scaling_governor", g)
                except OSError as e:
                    log("stress: governor back:", e)
        self.gov = {}
        h = self.hwd
        h.apply_cpu()
        if h.screen == "on":
            h.apply_brightness()
        h.apply_volume()
        log("stress: off — clocks, backlight and volume back")


class ChargerWatch:
    """★★★ THE CHARGE PORT, WATCHED CLOSELY (Stuart, 2026-11-15 log): vibe-hwd took up to 58 s to notice a plug-in (a
    1 s look, and a 30 s back-off after any PMIC error), the SDR dropped off USB at the very moment of plug-in, and the
    charge LED goes off / on at ~20 % while the bank still puts out 5.2 V. Suspected: the port's voltage (4.67–4.85 V
    measured while the bank gives 5.1–5.2 V — cable + connector drop) dipping under CHRG_IN's 4.5 V input floor (VLIM),
    where the PMIC stops taking current from the port. So:
      • the plug edge is seen within POLL_S (sysfs `online`, read 10 times a second — one small file) and the 2 A
        input limit goes on AT the edge, not up to a second (or 30 s) later;
      • for TRACE_S after every plug-in AND plug-out, a line every POLL_S: the port's voltage, the battery's voltage,
        current and status, and the PMIC's CHRG_IN / CHRG_OUT — the sag (or not) at the moment the SDR drops;
      • a line whenever the battery's status flips (Charging ↔ Not charging / Discharging / Full) with the cord still
        in, with the port voltage at that moment — the LED symptom.
    ★★ CHRG_IN's VALUE IS NOT CHANGED HERE (0xDD stays — the VLIM decision waits for this data).
    ★ Bounded: a handful of numbers, no history; the flip lines are capped at FLIP_MAX a minute (the rest counted).
    The PMIC reads are the same atomic SMBus transfers as the limit's (pmic_read), never a read-modify-write."""
    POLL_S, TRACE_S, CHECK_S, ERR_BACKOFF_S, FLIP_MAX = 0.1, 5.0, 1.0, 5.0, 20

    def __init__(self, dev):
        self.dev = dev
        self.online = None            # last `online` seen (None before the first look)
        self.status = None
        self.trace_t0 = None          # the edge's time; tracing until trace_t0 + TRACE_S
        self.trace_edge = ""
        self.next_check = 0.0
        self.err_logged_at = -1e9
        self.flip_min, self.flip_n, self.flip_dropped = -1, 0, 0

    def _pmic(self, reg):
        if not self.dev:
            return None
        try:
            return pmic_read(self.dev, reg)
        except OSError as e:
            self._err("read", e)
            return None

    def _err(self, what, e):
        now = time.monotonic()
        if now - self.err_logged_at >= 30:              # ★ one line per 30 s, however often the bus fails
            self.err_logged_at = now
            log("charger: PMIC %s failed:" % what, e)

    def apply_limit(self, why, now):
        """CHRG_IN to 0xDD if it is not (one atomic read; a write only when needed). True when it is (or was) 0xDD."""
        if not self.dev:
            return False
        try:
            old = pmic_read(self.dev, CHRG_IN)
            if old == CHRG_IN_2A:
                return True
            pmic_write(self.dev, CHRG_IN, CHRG_IN_2A)
            got = pmic_read(self.dev, CHRG_IN)
            log("charger: input limit 2 A at %s (CHRG_IN 0x%02x -> 0x%02x)%s" %
                (why, old, got, "" if got == CHRG_IN_2A else " ✗ DID NOT STICK"))
            return got == CHRG_IN_2A
        except OSError as e:
            self._err("input limit", e)
            self.next_check = now + self.ERR_BACKOFF_S     # ★ 5 s, not 30: a plug-in still gets its limit soon
            return False

    def sample(self):
        """The trace line's figures: port V, battery V / A, status, CHRG_IN, CHRG_OUT."""
        return {"port": _uv(CHG + "/voltage_avg"), "batV": _uv(BAT + "/voltage_avg"), "batA": _uv(BAT + "/current_avg"),
                "status": rd(BAT + "/status", "Unknown")}

    def trace_line(self, now, online, s):
        cin, cout = self._pmic(CHRG_IN), self._pmic(CHRG_OUT)
        return ("charger: %s %+.1fs online %d port %s bat %s %s %s IN %s OUT %s" %
                (self.trace_edge, now - self.trace_t0, online, _f(s["port"], "V"), _f(s["batV"], "V"),
                 _f(s["batA"], "A", True), s["status"], "?" if cin is None else "0x%02x" % cin,
                 "?" if cout is None else "0x%02x" % cout))

    def tick(self, now):
        online = rd(CHG + "/online", "0") == "1"
        status = rd(BAT + "/status", "Unknown")
        if self.online is None:
            self.online, self.status = online, status
            if online:
                self.apply_limit("start-up", now)
            return
        if online != self.online:
            # ★ the edge: the limit FIRST (the SDR is drawing through this port right now), then the trace begins
            if online and self.apply_limit("plug-in", now):
                self.next_check = now + self.CHECK_S
            self.trace_t0, self.trace_edge = now, "plug-in" if online else "plug-out"
            log("charger: %s seen (within %.1f s) — tracing the port for %.0f s" % (self.trace_edge, self.POLL_S, self.TRACE_S))
        elif online and status != self.status:
            self._flip(now, status)
        self.online, self.status = online, status
        if self.trace_t0 is not None:
            if now - self.trace_t0 <= self.TRACE_S + 1e-6:
                log(self.trace_line(now, online, self.sample()))
            else:
                self.trace_t0 = None
        if online and now >= self.next_check:
            self.next_check = now + self.CHECK_S
            self.apply_limit("check", now)            # (a failure moves next_check out to ERR_BACKOFF_S)

    def _flip(self, now, status):
        m = int(now // 60)
        if m != self.flip_min:
            if self.flip_dropped:
                log("charger: (%d more status flips on the cord that minute, not logged)" % self.flip_dropped)
            self.flip_min, self.flip_n, self.flip_dropped = m, 0, 0
        self.flip_n += 1
        if self.flip_n > self.FLIP_MAX:
            self.flip_dropped += 1
            return
        s = self.sample()
        cin = self._pmic(CHRG_IN)
        log("charger: battery %s -> %s with the cord in — port %s, bat %s %s, CHRG_IN %s" %
            (self.status, status, _f(s["port"], "V"), _f(s["batV"], "V"), _f(s["batA"], "A", True),
             "?" if cin is None else "0x%02x" % cin))


class Hwd:
    def __init__(self):
        self.clients = set()          # writers of every connection
        self.subscribers = set()
        self.acks = set()
        # ★★ cpuMax: the CPU's cap, FIXED at 1008 MHz (Stuart, 2026-11-07: "try 1.0GHz" — 1.175 V against 1.30 V at 1104,
        #    a quarter less energy per unit of work). The CPU SPEED row is gone (2026-11-09: "that isnt needed anymore since we
        #    have determined 1GHz gives us good performance"), so a cap an older build saved is NOT read back — it could
        #    otherwise strand a console at 408 MHz with no way to change it.
        self.cfg = {"brightness": DEFAULT_BRIGHTNESS, "volume": DEFAULT_VOLUME, "cpuMax": 1008000}
        try:
            with open(HWD_JSON) as f:
                self.cfg.update({k: v for k, v in json.load(f).items() if k in self.cfg and k != "cpuMax"})
        except (OSError, ValueError):
            pass
        self.max_brightness = int(rd(BL + "/max_brightness", "255"))
        self.screen = "on"
        self.output = "speaker"
        self.battery = {"pct": None, "raw": None, "charging": False, "online": False, "status": "Unknown"}
        self.bat_against = 0
        self.low_warned = False
        self.empty_count = 0
        self.shutting_down = False
        self.power_down_at = None
        self.power_task = None
        self.save_task = None
        self.readers = {}             # path → task
        self.cal = BatteryCal()       # ★ battery calibration (BatteryCal) — resumes a run a power-off interrupted
        self.stress = Stress(self)
        self.use = UseSmoother()
        self.power = {}               # the live figures (power_tick, once a second)
        self.q_now = self.full_uah = None

    # ── persistence ──
    def save_soon(self):
        # ★ debounced: holding a volume button sends ~30 auto-repeats a second; the card gets one write.
        if self.save_task:
            self.save_task.cancel()
        async def later():
            await asyncio.sleep(2)
            try:
                os.makedirs(STATE_DIR, exist_ok=True)
                atomic_write(HWD_JSON, json.dumps(self.cfg))
            except OSError as e:
                log("could not save", HWD_JSON, e)
        self.save_task = asyncio.get_running_loop().create_task(later())

    # ── CPU speed ──
    def cpu_steps(self):
        steps = set()
        for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            for f in rd(p + "/scaling_available_frequencies", "").split():
                if f.isdigit():
                    steps.add(int(f))
        return sorted(steps)

    def apply_cpu(self):
        steps = self.cpu_steps()
        want = int(self.cfg.get("cpuMax", 1008000))
        # ★★★ NO CPU BOOST EITHER (handheld43 log, 2026-11-08): with the GPU left at 300, 14 GPU timeouts still came
        #     within ~1 s of the boost lifting the CPU to 1296 MHz (157–184 s), and none with the map up unboosted
        #     (handheld40, 1277–1327 s). The map never needed it: the UI thread used 19–25 % of a core with the map up.
        #     So the boost moves nothing; the request is still accepted and logged (an older UI sends it).
        ok = [f for f in steps if f <= want] or steps[:1]
        if not ok:
            return
        cap = ok[-1]
        for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            try:
                wr(p + "/scaling_max_freq", cap)
            except OSError as e:
                log("cpu speed:", e)
        log("cpu speed: capped at", cap // 1000, "MHz")


    # ★★ THE MAP'S BOOST (Stuart, 2026-11-07: "the map is super slow and keeps looking like it is refreshing all the time"
    #    — on handheld29's caps: the CPU 1008 MHz, the GPU 300 MHz, the memory 450 MHz). While the UI asks (the map is on
    #    screen) every cap is lifted to the top step; off, the caps come straight back. NEVER saved — a restart, or a UI
    #    that went away, always comes back capped (vibe-cpu.service sets the GPU and memory caps at boot).
    DEVFREQ_CAPS = (("/sys/class/devfreq/ff400000.gpu", 300000000), ("/sys/class/devfreq/dmc", 450000000))
    # ★★★ WHAT THE MAP BOOST MAY RAISE (handheld40 log, 2026-11-08). Boosting BOTH to their tops (GPU 560, memory 666) was
    #     followed within ~1 s, every time, by Panfrost "gpu sched timeout"s (13 in one session: a GPU job over half a
    #     second, the GPU reset) — and their burst starved the speaker (12 starved / 9 underruns that minute). The steady
    #     boosted map was fine; the STEP was not. And at 300 the map page costs 1.4–5.6 ms a frame at 26–30 fps — the
    #     boost bought little. So: the memory clock is never moved (a DDR frequency change stalls the bus under the GPU),
    #     and the GPU steps one notch, to 400. If the timeouts persist, take the GPU out of the boost too.
    # ★★★ THEY PERSISTED — WORSE (handheld42 log, 2026-11-08): at 400 the timeouts ran the WHOLE boost, one every
    #     ~0.7 s (37 in two boosts: 209–226 s and 256–274 s), none before the first boost and none with it off. Each
    #     reset cut a map render short and left the old picture in the buffer (Stuart: "a zoomed in UK over a zoomed
    #     out USA"), and the renders it did finish took 84–193 ms. Unboosted at 300 the same map rendered in ~20 ms with
    #     no timeouts at all (handheld40, 1277–1327 s). So the GPU is no longer boosted: ANY step off the 300 pin breaks
    #     this board's GPU. The boost is the CPU's top step alone (apply_cpu); the GPU and memory stay on their caps.
    BOOST_TARGETS = {}

    def set_boost(self, v):
        on = bool(int(v))
        if on == getattr(self, "boost", False):
            return
        self.boost = on
        self.apply_cpu()
        for d, cap in self.DEVFREQ_CAPS:
            avail = sorted(int(x) for x in rd(d + "/available_frequencies", "").split() if x.isdigit())
            if not avail:
                continue
            if d not in self.BOOST_TARGETS:
                continue                                    # ★ never moved by the boost (BOOST_TARGETS)
            up = max([f for f in avail if f <= self.BOOST_TARGETS[d]] or [avail[0]])
            target = up if on else min(cap, avail[-1])
            # ★★★ the GPU is PINNED (min = max — vibe-cpu.service): its clock may share a PLL with the speaker's I2S, so it
            #     never roams; the boost moves the pin (400 while the map is up, 300 after). Order keeps min ≤ max.
            pin = d.endswith("ff400000.gpu")
            try:
                if on:
                    wr(d + "/max_freq", target)
                    if pin: wr(d + "/min_freq", target)
                else:
                    if pin: wr(d + "/min_freq", target)
                    wr(d + "/max_freq", target)
            except OSError as e:
                log("boost:", d, e)
        log("performance boost:", "ON (the map) — no clock moved" if on else "off")

    # ── backlight ──
    def apply_brightness(self):
        if self.screen == "on":
            try:
                wr(BL + "/bl_power", 0)
                # ★ a STRESS calibration holds the backlight at full (Stress) — a screen woken mid-run stays at full
                st = getattr(self, "stress", None)
                wr(BL + "/brightness", self.max_brightness if st and st.on else self.cfg["brightness"])
            except OSError as e:
                log("backlight:", e)

    def set_brightness(self, v):
        v = int(v)
        if not 0 <= v <= self.max_brightness:
            raise ValueError("brightness out of range 0..%d" % self.max_brightness)
        self.cfg["brightness"] = max(MIN_BRIGHTNESS, v)
        self.apply_brightness()
        self.save_soon()

    def set_screen(self, on, why="request"):
        want = "on" if on else "off"
        if want == self.screen:
            return
        self.screen = want
        log("screen", want, "(%s, %d listening)" % (why, len(self.subscribers)))
        try:
            if on:
                self.apply_brightness()
            else:
                # ★ bl_power 4 = FB_BLANK_POWERDOWN: pwm-backlight drops its enable line and stops the PWM — the LEDs
                #   are what cost the battery. The panel itself keeps scanning out: DPMS needs the DRM master, and that
                #   is Cog. Audio is untouched (Stuart: short press = screen off, audio keeps playing).
                wr(BL + "/brightness", 0)
                wr(BL + "/bl_power", 4)
        except OSError as e:
            log("screen:", e)
        self.emit({"event": "screen", "screen": self.screen})

    # ── audio ──
    def apply_volume(self):
        raw = pct_to_raw(self.cfg["volume"])
        amixer("cset", "name=Master Playback Volume", "%d,%d" % (raw, raw))

    def set_volume(self, v, announce=False):
        v = int(v)
        if not 0 <= v <= 100:
            raise ValueError("volume out of range 0..100")
        self.cfg["volume"] = v
        self.apply_volume()
        self.save_soon()
        if announce:
            self.emit({"event": "volume", "volume": v, "muted": v == 0})

    def set_output(self, headphones):
        # ★ 'Playback Mux' (numid 6 on rk817_ext): item 0 = HP, 1 = SPK. The card is SILENT until it is set — day one
        #   (2026-11-05, measured on the device: SPK = the speaker).
        # ★★ This unit's tree is rk817-sound-AMPLIFIED: the speaker is an external amp ("Speaker Amp", GPIO enable) behind
        #    a DAPM pin switch, 'Internal Speakers Switch'. Under ROCKNIX something had it on; here nothing did, so it is
        #    set explicitly — on for the speaker, off with headphones in (2026-11-06, the first card: no audio).
        self.output = "headphones" if headphones else "speaker"
        amixer("cset", "name=Playback Mux", "HP" if headphones else "SPK")
        if self.has_control("Internal Speakers Switch"):
            amixer("cset", "name=Internal Speakers Switch", "off" if headphones else "on")
        self.emit({"event": "output", "output": self.output})

    def has_control(self, name):
        cache = self.__dict__.setdefault("_controls", None)
        if cache is None:
            try:
                r = subprocess.run(["amixer", "-c", CARD, "controls"], capture_output=True, text=True, timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                return False                      # ★ not cached: asked again on the next switch
            cache = self._controls = r.stdout
            log("ALSA controls:", " | ".join(l.split("name=", 1)[-1] for l in r.stdout.splitlines()))
        return ("name='%s'" % name) in cache

    # ── battery ──
    def read_battery(self):
        pct = rd(BAT + "/capacity")
        status = rd(BAT + "/status", "Unknown")
        online = rd(CHG + "/online", "0") == "1"
        raw = int(pct) if pct and pct.lstrip("-").isdigit() else None
        # ★★ CALIBRATED: the % on this unit's MEASURED capacity (BatteryCal), not the gauge's assumed one — the meter,
        #    the 10 % warning, the 3 % floor and the engine's time-left (its slope of this %) all follow it
        cal = getattr(self, "cal", None)
        cp = cal_pct(rd_num(BAT + "/charge_now", 1), cal.result) if cal else None
        if cp is not None:
            raw = 100 if status == "Full" else cp
        # ★★ CHARGING = THE CORD IS IN (Stuart 2026-11-14: "the battery meter seems a bit erratic when charging"). The
        #    battery's own status flips Charging / Not charging / Discharging while the console + radio share the 2 A port
        #    with it (the charge current falls to ~0 and back), so the bolt came and went; the charger's `online` is the
        #    plug itself. "Full" with the cord in is still "on the charger".
        return {"pct": raw, "raw": raw, "charging": online or status in ("Charging", "Full"), "online": online, "status": status}

    # ★★★ WHAT THE METER SHOWS IS SMOOTHED; WHAT SWITCHES THE RADIO OFF IS NOT. The rk817 fuel gauge's capacity is an
    #     estimate that leans on the battery voltage, and charging lifts that voltage (the charge current through the
    #     cell's resistance) — so on the charger it jumps up, sags when the radio's draw rises, and drops several % the
    #     moment the cord comes out. The meter therefore only moves the way the battery can: never DOWN while the cord is
    #     in (the battery is not emptying), never UP without it, and at most kBatStep % per reading — fast enough to follow
    #     ~1 A into the cell (about 1 % in 20 s). A real move in the "wrong" direction (a charger too weak for the load,
    #     a gauge re-calibration) is followed once it has held for kBatHold readings. The 3 % shutdown and the 10 %
    #     warning read the RAW figure, as before.
    BAT_STEP, BAT_HOLD = 2, 3
    def smooth_battery(self, b):
        raw, shown = b["raw"], self.battery.get("pct")
        if raw is None or shown is None or b["online"] != self.battery.get("online"):
            self.bat_against = 0
            out = raw if shown is None or raw is None else shown   # ★ a plug change holds what was shown, then follows
        else:
            d = raw - shown
            wrong = (d < 0) if b["online"] else (d > 0)
            if wrong:
                self.bat_against = getattr(self, "bat_against", 0) + 1
                d = 0 if self.bat_against < self.BAT_HOLD else d
            else:
                self.bat_against = 0
            out = shown + max(-self.BAT_STEP, min(self.BAT_STEP, d))
            if raw == 100 and b["status"] == "Full": out = 100
        if raw is not None and shown is not None and abs(raw - shown) >= 3:
            # ★ the evidence for the next debug-log read: what the gauge said, and why it may have said it
            log("battery: gauge %d %% (showing %d %%), %s, online %d, %s uV, %s uA" % (raw, out, b["status"], b["online"],
                rd(BAT + "/voltage_now", "?"), rd(BAT + "/current_now", "?")))
        return dict(b, pct=out)

    async def charger_loop(self):
        """Hold the charge port's input limit at 2 A whenever the charger is in (see PMIC_ADDR above), and log what the
        port does around every plug-in / plug-out (ChargerWatch). A 100 ms look at sysfs; the PMIC is touched only on
        a plug edge, once a second while charging, and during the 5 s trace after an edge."""
        dev = pmic_bus()
        if not dev:
            log("charger: PMIC i2c bus not found — the input limit stays at the driver's 1.5 A (the port is still traced)")
        else:
            try:   # ★ once, read only: the evidence for vibe-charge-fast's 0xA0 and for the driver's own CHRG_IN
                log("charger: PMIC at start-up — CHRG_OUT 0x%02x (vibe-charge-fast expects 0xa0), CHRG_IN 0x%02x" %
                    (pmic_read(dev, CHRG_OUT), pmic_read(dev, CHRG_IN)))
            except OSError as e:
                log("charger: PMIC not readable:", e)
        w = ChargerWatch(dev)
        while True:
            w.tick(time.monotonic())
            await asyncio.sleep(ChargerWatch.POLL_S)

    async def battery_loop(self):
        while True:
            b = self.smooth_battery(self.read_battery())
            if (b["pct"], b["charging"]) != (self.battery["pct"], self.battery["charging"]):
                self.battery = b
                if b["pct"] is not None:
                    self.emit({"event": "battery", "pct": b["pct"], "charging": b["charging"]})
            self.battery = b
            pct = b["raw"]   # ★ the floor and the warning judge the gauge itself, not the smoothed meter
            if pct is not None and not b["charging"]:
                if pct <= LOW_PCT and not self.low_warned:
                    self.low_warned = True
                    self.emit({"event": "battery_low", "pct": pct})
                # ★ two readings in a row at or under 3 % — one glitchy fuel-gauge sample must not switch the radio off.
                self.empty_count = self.empty_count + 1 if pct <= EMPTY_PCT else 0
                if self.empty_count >= 2:
                    # ★ a calibration reaching the floor before its own empty point: that IS its empty point
                    if self.cal.phase == "running":
                        self.cal_event(self.cal.finish(rd_num(BAT + "/charge_now", 1), self.full_uah, "the %d %% floor" % EMPTY_PCT))
                    await self.shutdown("battery", "poweroff")
            else:
                self.empty_count = 0
                if pct is not None and pct > LOW_PCT + 2:
                    self.low_warned = False
            await asyncio.sleep(20 if (pct or 100) > 15 else 5)

    # ── the live figures + calibration (once a second) ──
    def power_tick(self, t):
        online = rd(CHG + "/online", "0") == "1"
        status = rd(BAT + "/status", "Unknown")
        bat_v = rd_num(BAT + "/voltage_avg")
        if bat_v is None:
            bat_v = rd_num(BAT + "/voltage_now")
        bat_a = rd_num(BAT + "/current_avg")
        if bat_a is None:
            bat_a = rd_num(BAT + "/current_now")
        port_v = rd_num(CHG + "/voltage_avg")
        q = rd_num(BAT + "/charge_now", 1)
        full = rd_num(BAT + "/charge_full", 1) or rd_num(BAT + "/charge_full_design", 1)
        if not online and bat_v is not None and bat_a is not None:
            self.use.feed(t, abs(bat_a) * bat_v)
        self.q_now, self.full_uah = q, full
        self.power = live_power(online, status, bat_v, bat_a, port_v, self.use.w, q, full)
        self.cal_event(self.cal.step(t, online, status, bat_v, q, full))
        self.stress.thermal()

    def cal_event(self, ev):
        """What a calibration step decided: the load on / off, an event for the UI, the clean power-off at empty."""
        if not ev:
            return
        if ev[0] == "running":
            if self.cal.mode == "stress":
                self.stress.start()
            self.emit({"event": "battery_cal", "phase": "running", "mode": self.cal.mode})
        elif ev[0] == "cancelled":
            self.stress.stop()
            self.emit({"event": "battery_cal", "phase": "cancelled", "note": ev[1]})
        elif ev[0] == "done":
            self.stress.stop()
            res, note = ev[1], ev[2]
            self.emit({"event": "battery_cal", "phase": "done", "mah": res["mah"] if res else None, "note": note})
            if not self.shutting_down:
                asyncio.get_running_loop().create_task(self.shutdown("battery-cal", "poweroff"))

    def cal_start(self, mode):
        online = rd(CHG + "/online", "0") == "1"
        self.cal.start(mode, online, rd(BAT + "/status", "Unknown"), rd_num(BAT + "/charge_now", 1))
        self.emit({"event": "battery_cal", "phase": "armed", "mode": mode})

    def cal_cancel(self):
        if self.cal.cancel("calibration cancelled"):
            self.stress.stop()
            self.emit({"event": "battery_cal", "phase": "cancelled", "note": "calibration cancelled"})

    async def power_loop(self):
        while True:
            try:
                self.power_tick(time.monotonic())
            except Exception as e:          # ★ a sysfs oddity must never stop the clean shutdown at empty
                log("power:", type(e).__name__, e)
            await asyncio.sleep(1)

    # ── shutdown ──
    async def shutdown(self, reason, how):
        """Tell the engine, wait ≤ 5 s for its ack (every radio's memory saved), then a clean systemd power-off —
        which stops the engine, unmounts the card and the state partition, and saves the clock on the way."""
        if self.shutting_down:
            return
        self.shutting_down = True
        log("shutdown:", reason, how)
        self.stress.stop()
        self.acks.clear()
        waiting = set(self.subscribers)
        self.emit({"event": "shutdown", "reason": reason, "inSec": int(ACK_WAIT_S)})
        t0 = time.monotonic()
        while waiting - self.acks and time.monotonic() - t0 < ACK_WAIT_S:
            await asyncio.sleep(0.1)
        log("engine ack" if waiting and not (waiting - self.acks) else "no ack (%d subscriber(s))" % len(waiting),
            "after %.1f s" % (time.monotonic() - t0))
        os.sync()
        if self.screen == "off":
            self.set_screen(True)
        msg = {"battery": "Battery empty — switching off", "power-button": "Switching off",
               "battery-cal": "Battery calibrated — switching off",
               "request": "Restarting" if how == "reboot" else "Switching off"}[reason]
        if DRYRUN:
            log("DRYRUN: would stop the kiosk, show '%s' and systemctl %s" % (msg, how))
            self.shutting_down = False
            return
        # ★ Cog holds the display; stop it so the splash can say what is happening while systemd shuts down.
        subprocess.run(["systemctl", "stop", "vibe-kiosk.service"], timeout=10)
        subprocess.Popen([SPLASH, "--message", msg, "--no-progress"], stdin=subprocess.DEVNULL)
        subprocess.run(["systemctl", "--no-block", how])

    # ── clock ──
    def set_time(self, utc_ms):
        utc_ms = int(utc_ms)
        if not 1577836800000 <= utc_ms <= 4102444800000:       # 2020 … 2100: anything else is a bad request
            raise ValueError("time out of range")
        time.clock_settime(time.CLOCK_REALTIME, utc_ms / 1000.0)
        # ★ vibe-clock writes the RTC (when it can be written) and the saved floor/offset on the state partition.
        # ★★ OFF THE LOOP (2026-11-08): a save now waits up to a second for the RTC's tick (vibe-clock's header), and the
        #    loop is what answers the buttons — so it runs in a thread, after the clock itself is already set.
        threading.Thread(target=lambda: subprocess.run([CLOCK, "save"], timeout=10), daemon=True).start()

    async def clock_loop(self):
        while True:
            await asyncio.sleep(600)       # ★ every 10 min: a flat battery loses at most 10 min of the clock floor
            await asyncio.get_running_loop().run_in_executor(None, lambda: subprocess.run([CLOCK, "save"], timeout=10))

    # ── the socket ──
    def emit(self, ev):
        line = (json.dumps(ev) + "\n").encode()
        for w in list(self.subscribers):
            try:
                w.write(line)
            except Exception:
                self.subscribers.discard(w)

    def state(self):
        b = self.battery if self.battery["pct"] is not None else self.read_battery()
        return {"ok": True, "brightness": self.cfg["brightness"], "maxBrightness": self.max_brightness,
                "volume": self.cfg["volume"], "muted": self.cfg["volume"] == 0, "output": self.output,
                "battery": {"pct": b["pct"], "charging": b["charging"], "status": b["status"]}, "screen": self.screen,
                "power": self.power, "calib": self.cal.wire(self.q_now)}

    async def handle(self, req, writer):
        if not isinstance(req, dict):
            raise ValueError("bad request")
        if req.get("ack") == "shutdown":
            self.acks.add(writer)
            return None                                    # ★ an ack is not a request: no reply line
        if req.get("subscribe") is True:
            self.subscribers.add(writer)
            return {"ok": True}
        g, s, a = req.get("get"), req.get("set"), req.get("action")
        if g == "state":
            return self.state()
        if g == "ssh" or s in ("ssh", "ssh-password"):
            # ★★★ NO SSH ON THE HANDHELD (Stuart 2026-11-05: "we don't need SSH"). The image has no sshd at all and
            #     nothing listens on any port but the engine on 127.0.0.1; debugging is the card's "Diagnostic logs/".
            #     The §0.2 requests are answered — never silently ignored — and a password is never read or kept.
            raise ValueError("not supported")
        if s == "brightness":
            self.set_brightness(req.get("value"))
        elif s == "volume":
            self.set_volume(req.get("value"))
        elif s == "boost":
            self.set_boost(req.get("value"))
        elif s == "time":
            self.set_time(req.get("utcMs"))
        elif a in ("poweroff", "reboot"):
            asyncio.get_running_loop().create_task(self.shutdown("request", a))
        elif a == "calibrate":
            self.cal_start(req.get("mode"))
        elif a == "calibrate-cancel":
            self.cal_cancel()
        elif a == "screen-off":
            # ★ not while a STRESS calibration runs: the lit backlight is part of the load (the power button still can)
            if not self.stress.on:
                self.set_screen(False)
        elif a == "screen-on":
            self.set_screen(True)
        else:
            raise ValueError("unknown request")
        return {"ok": True}

    async def client(self, reader, writer):
        self.clients.add(writer)
        try:
            while True:
                line = await reader.readline()
                if not line:
                    break
                if len(line) > 8192:
                    reply = {"ok": False, "error": "request too long"}
                else:
                    try:
                        req = json.loads(line)
                    except ValueError:
                        req = None
                    try:
                        reply = await self.handle(req, writer)
                    except (ValueError, TypeError) as e:
                        reply = {"ok": False, "error": str(e) or "bad request"}
                    except Exception as e:      # ★ one bad request must never take the service down
                        log("request failed:", type(e).__name__)
                        reply = {"ok": False, "error": "internal error"}
                if reply is not None:
                    writer.write((json.dumps(reply) + "\n").encode())
                    await writer.drain()
        except (ConnectionError, asyncio.IncompleteReadError):
            pass
        finally:
            self.clients.discard(writer)
            self.subscribers.discard(writer)
            writer.close()

    # ── input ──
    def on_key(self, dev, code, value):
        if code in (KEY_VOLUMEUP, KEY_VOLUMEDOWN) and value in (1, 2):        # press + auto-repeat
            step = VOL_STEP if code == KEY_VOLUMEUP else -VOL_STEP
            v = max(0, min(100, self.cfg["volume"] + step))
            if v != self.cfg["volume"] or value == 1:
                self.set_volume(v, announce=True)
        elif code == KEY_POWER:
            loop = asyncio.get_running_loop()
            if value == 1:
                self.power_down_at = time.monotonic()
                async def held():
                    await asyncio.sleep(LONG_PRESS_S)
                    self.power_down_at = None
                    await self.shutdown("power-button", "poweroff")
                self.power_task = loop.create_task(held())
            elif value == 0 and self.power_down_at is not None:
                self.power_down_at = None
                if self.power_task:
                    self.power_task.cancel()
                self.set_screen(self.screen == "off", "power button")         # short press: screen off / on
        elif dev == "gamepad" and value == 1 and self.screen == "off":
            self.set_screen(True, "pad button")                               # ★ any pad button wakes the screen

    def on_switch(self, code, value):
        if code == SW_HEADPHONE_INSERT:
            self.set_output(bool(value))

    async def read_dev(self, kind, path):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            log("cannot open", path, e)
            return
        try:
            if kind in ("power", "volume"):
                # ★ ours alone: Cog's libinput would otherwise hand KEY_POWER / volume keys to the page as keystrokes.
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 1)
                except OSError:
                    pass
            if kind == "jack":
                buf = bytearray(8)
                fcntl.ioctl(fd, EVIOCGSW(len(buf)), buf)
                self.set_output(bool(buf[0] & (1 << SW_HEADPHONE_INSERT)))
            loop = asyncio.get_running_loop()
            q = asyncio.Event()
            loop.add_reader(fd, q.set)
            try:
                while True:
                    await q.wait()
                    q.clear()
                    while True:
                        try:
                            data = os.read(fd, EVENT.size * 64)
                        except BlockingIOError:
                            break
                        if not data:
                            raise OSError("gone")
                        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                            _, _, typ, code, value = EVENT.unpack_from(data, i)
                            if typ == EV_KEY:
                                self.on_key(kind, code, value)
                            elif typ == EV_SW:
                                self.on_switch(code, value)
            finally:
                loop.remove_reader(fd)
        except OSError as e:
            log(path, "closed:", e)
        finally:
            os.close(fd)
            self.readers.pop(path, None)

    async def input_loop(self):
        kinds = {"rk805 pwrkey": "power", "adc-keys": "volume", "gpio-keys": "volume",
                 "rk817_ext Headphones": "jack", "r36s_Gamepad": "gamepad"}
        jack_seen = False
        while True:
            for name, path in input_devices():
                kind = kinds.get(name)
                if kind and path not in self.readers:
                    jack_seen |= kind == "jack"
                    self.readers[path] = asyncio.get_running_loop().create_task(self.read_dev(kind, path))
            if not jack_seen and self.output != "speaker":
                self.set_output(False)
            await asyncio.sleep(5)       # ★ the joypad is a module and can arrive late; a USB keyboard can come and go

    async def main(self):
        self.apply_brightness()
        self.apply_cpu()          # ★ the CPU SPEED cap, after vibe-cpu.service set schedutil + the 1296 MHz ceiling
        self.apply_volume()
        if not any(n == "rk817_ext Headphones" for n, _ in input_devices()):
            self.set_output(False)       # ★ no jack detector: the speaker, never the silent default (HP)
        try:
            os.unlink(SOCK)
        except FileNotFoundError:
            pass
        old = os.umask(0o117)
        server = await asyncio.start_unix_server(self.client, path=SOCK, limit=16384)
        os.umask(old)
        # ★ root:vibeserver 0660 — the engine connects, nobody else (§0.2).
        try:
            os.chown(SOCK, 0, grp.getgrnam("vibeserver").gr_gid)
        except KeyError:
            log("no vibeserver group — socket left root-only")
        os.chmod(SOCK, 0o660)
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(sig, server.close)
        log("ready on", SOCK)
        tasks = [loop.create_task(t) for t in (self.input_loop(), self.battery_loop(), self.charger_loop(), self.clock_loop(),
                                                    self.power_loop())]
        try:
            await server.serve_forever()
        except asyncio.CancelledError:
            pass
        finally:
            for t in tasks:
                t.cancel()
            self.stress.stop()
            if self.save_task and not self.save_task.done():
                atomic_write(HWD_JSON, json.dumps(self.cfg))


if __name__ == "__main__":
    try:
        asyncio.run(Hwd().main())
    except KeyboardInterrupt:
        pass
