#!/bin/sh
# vibe-state — mount the state partition (p3, ext4 "vibestate") and everything that lives on it. Every boot.
#
# ★★★ WHY NOT /etc/fstab. A fstab mount is a systemd device job, and a service with RequiresMountsFor= on it does not
#     start until that job ends. When the partition is missing the job did not end — not in 60 s, the timeout ignored
#     (seen 2026-11-05, the image booted in a container): the engine and the browser waited for ever, the handheld
#     showed nothing. Here the wait is bounded (10 s) and EVERY failure carries on: a damaged or missing state
#     partition costs the saved settings for that boot (they live in RAM), never the radio.
# ★ fsck before mounting: -p (safe repairs), then -y if -p cannot (the state is ours; there is no one to ask).
# ★ Then: the bind mounts the engine and the browser use, the owner's SSH password hash back into the RAM /etc/shadow,
#   and the boot partition read-only at /boot/firmware (diagnostics, SOURCES.txt).
set -u
S=/var/lib/vibe-state
say() { echo "vibe-state: $*"; }

root_part() { findmnt -n -o SOURCE /media/root-ro 2>/dev/null; }
part_n() { r=$(root_part); case "$r" in /dev/mmcblk*p[0-9]*|/dev/loop*p[0-9]*) echo "${r%p*}p$1" ;; /dev/sd*) echo "${r%[0-9]*}$1" ;; esac; }

find_dev() {   # $1 label, $2 partition number
  i=0
  while [ $i -lt 100 ]; do
    [ -b "/dev/disk/by-label/$1" ] && { readlink -f "/dev/disk/by-label/$1"; return 0; }
    p=$(part_n "$2"); [ -n "$p" ] && [ -b "$p" ] && [ "$(blkid -o value -s LABEL "$p" 2>/dev/null)" = "$1" ] && { echo "$p"; return 0; }
    sleep 0.1; i=$((i + 1))
  done
  return 1
}

mkdir -p "$S"
if D=$(find_dev vibestate 3); then
  fsck.ext4 -p "$D" >/dev/null 2>&1; rc=$?
  if [ $rc -ge 4 ]; then say "fsck -p could not repair $D (rc $rc) — fsck -y"; fsck.ext4 -y "$D" >/dev/null 2>&1; fi
  if mount -t ext4 -o noatime,commit=5,errors=remount-ro "$D" "$S"; then
    say "state partition $D mounted"
  else
    say "!! could not mount $D — settings live in RAM this boot"
  fi
else
  say "!! no state partition (LABEL=vibestate) — settings live in RAM this boot"
fi

mkdir -p "$S/vibeserver" "$S/kiosk" "$S/ssh"
chmod 0700 "$S/ssh"
chown vibeserver:vibeserver "$S/vibeserver" 2>/dev/null
chmod 0750 "$S/vibeserver"
chown vibe-kiosk:vibe-kiosk "$S/kiosk" 2>/dev/null
for b in "vibeserver:/var/lib/vibeserver" "kiosk:/var/lib/vibe-kiosk"; do
  mkdir -p "${b#*:}"
  mountpoint -q "${b#*:}" || mount --bind "$S/${b%%:*}" "${b#*:}" || say "!! bind ${b#*:} failed"
done

if [ -s "$S/ssh/root.hash" ]; then
  H=$(head -n1 "$S/ssh/root.hash")
  case "$H" in
    '$'*) usermod -p "$H" root && say "root password restored (SSH)" ;;
    *) say "$S/ssh/root.hash is not a hash — ignored" ;;
  esac
fi

if B=$(find_dev VIBEBOOT 1); then
  mkdir -p /boot/firmware
  mountpoint -q /boot/firmware || mount -t vfat -o ro,noatime "$B" /boot/firmware 2>/dev/null
fi
/usr/lib/vibesdr-r36s/vibe-splash-ctl progress 12
exit 0
