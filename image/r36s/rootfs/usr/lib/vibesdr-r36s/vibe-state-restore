#!/bin/sh
# vibe-state-restore — at every boot, after the state partition is mounted.
# ★ /etc is RAM (overlay-init), so anything the owner set that lives in /etc comes back from the state partition here.
#   Today that is one thing: root's password HASH (SSH, §0.2) — never the password, which is never stored.
set -u
S=/var/lib/vibe-state
mkdir -p "$S/vibeserver" "$S/kiosk" "$S/ssh"
chmod 0700 "$S/ssh"
chown vibeserver:vibeserver "$S/vibeserver" 2>/dev/null
chown vibe-kiosk:vibe-kiosk "$S/kiosk" 2>/dev/null
if [ -s "$S/ssh/root.hash" ]; then
  H=$(head -n1 "$S/ssh/root.hash")
  case "$H" in
    '$'*) usermod -p "$H" root && echo "vibe-state-restore: root password restored (SSH)" ;;
    *) echo "vibe-state-restore: $S/ssh/root.hash is not a hash — ignored" >&2 ;;
  esac
fi
/usr/lib/vibesdr-r36s/vibe-splash-ctl progress 12
exit 0
