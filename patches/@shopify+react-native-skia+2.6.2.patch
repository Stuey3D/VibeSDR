+// VibeSDR: see VibeExport.h for why this exists (hidden Skia symbols; the
+// per-dispose memory-pressure cost).
+
+#include "VibeExport.h"
+
+#include <memory>
+#include <mutex>
+#include <utility>
+
+#include "JsiSkHostObjects.h"
+#include "JsiSkImage.h"
+#include "JsiSkPath.h"
+#include "RNSkPlatformContext.h"
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdocumentation"
+#include "include/core/SkData.h"
+#include "include/core/SkImage.h"
+#include "include/core/SkImageInfo.h"
+#include "include/core/SkPathBuilder.h"
+#pragma clang diagnostic pop
+
+namespace vibe_rnskia {
+
+namespace jsi = facebook::jsi;
+using RNSkia::RNSkPlatformContext;
+
+namespace {
+// Written on the JS thread (RNSkManager ctor) and read on the UI runtime's
+// thread, so guarded. Holds the context alive across a reload until the new
+// RNSkManager replaces it.
+std::mutex gContextMutex;
+std::shared_ptr<RNSkPlatformContext> gContext;
+
+std::shared_ptr<RNSkPlatformContext> currentContext() {
+  std::lock_guard<std::mutex> lock(gContextMutex);
+  return gContext;
+}
+} // namespace
+
+// Called from RNSkManager's constructor (not part of the exported header).
+void vibeSetPlatformContext(std::shared_ptr<RNSkPlatformContext> context) {
+  std::lock_guard<std::mutex> lock(gContextMutex);
+  gContext = std::move(context);
+}
+
+void *makeGray8Image(const uint8_t *pixels, int width, int height,
+                     size_t rowBytes) {
+  if (pixels == nullptr || width <= 0 || height <= 0 ||
+      rowBytes < static_cast<size_t>(width)) {
+    return nullptr;
+  }
+  auto info = SkImageInfo::Make(width, height, kGray_8_SkColorType,
+                                kOpaque_SkAlphaType);
+  auto data = SkData::MakeWithCopy(pixels, rowBytes * height);
+  sk_sp<SkImage> image =
+      SkImages::RasterFromData(info, std::move(data), rowBytes);
+  return image.release(); // one ref, owned by the handle
+}
+
+void *makePolyPath(const float *xy, int nPoints, bool close) {
+  if (xy == nullptr || nPoints < 1) {
+    return nullptr;
+  }
+  auto builder = std::make_shared<SkPathBuilder>();
+  builder->incReserve(nPoints);
+  builder->moveTo(xy[0], xy[1]);
+  for (int i = 1; i < nPoints; ++i) {
+    builder->lineTo(xy[2 * i], xy[2 * i + 1]);
+  }
+  if (close) {
+    builder->close();
+  }
+  return new std::shared_ptr<SkPathBuilder>(std::move(builder));
+}
+
+void releaseImage(void *imageHandle) {
+  if (imageHandle != nullptr) {
+    static_cast<SkImage *>(imageHandle)->unref();
+  }
+}
+
+void releasePath(void *pathHandle) {
+  delete static_cast<std::shared_ptr<SkPathBuilder> *>(pathHandle);
+}
+
+bool setPlatformContextFrom(jsi::Runtime &rt, const jsi::Value &anySkiaHostObject) {
+  if (!anySkiaHostObject.isObject()) {
+    return false;
+  }
+  auto obj = anySkiaHostObject.asObject(rt);
+  if (!obj.isHostObject(rt)) {
+    return false;
+  }
+  auto skObj =
+      std::dynamic_pointer_cast<RNSkia::JsiSkHostObject>(obj.getHostObject(rt));
+  if (!skObj || !skObj->vibePlatformContext()) {
+    return false;
+  }
+  vibeSetPlatformContext(skObj->vibePlatformContext());
+  return true;
+}
+
+bool hasPlatformContext() { return currentContext() != nullptr; }
+
+jsi::Value wrapImage(jsi::Runtime &rt, void *imageHandle) {
+  if (imageHandle == nullptr) {
+    return jsi::Value::undefined();
+  }
+  // Adopt the handle's ref first so it is released even if we throw.
+  sk_sp<SkImage> image(static_cast<SkImage *>(imageHandle));
+  auto hostObject =
+      std::make_shared<RNSkia::JsiSkImage>(currentContext(), std::move(image));
+  hostObject->setVibeNoMemoryPressure();
+  // Plain createFromHostObject: NOT JSI_CREATE_HOST_OBJECT_WITH_MEMORY_PRESSURE.
+  return jsi::Object::createFromHostObject(rt, std::move(hostObject));
+}
+
+jsi::Value wrapPath(jsi::Runtime &rt, void *pathHandle) {
+  if (pathHandle == nullptr) {
+    return jsi::Value::undefined();
+  }
+  std::unique_ptr<std::shared_ptr<SkPathBuilder>> handle(
+      static_cast<std::shared_ptr<SkPathBuilder> *>(pathHandle));
+  // JsiSkPath has no shared_ptr constructor; build it empty, then swap our
+  // builder in so the points are not copied.
+  auto hostObject =
+      std::make_shared<RNSkia::JsiSkPath>(currentContext(), SkPathBuilder());
+  hostObject->setObject(std::move(*handle));
+  hostObject->setVibeNoMemoryPressure();
+  return jsi::Object::createFromHostObject(rt, std::move(hostObject));
+}
