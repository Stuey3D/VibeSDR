index 0000000..75425af
--- /dev/null
+++ b/node_modules/@shopify/react-native-skia/android/cpp/rnskia-android/RNSkRenderThread.h
@@ -0,0 +1,114 @@
+#pragma once
+
+// VIBESDR PATCH — ONE SKIA RENDER THREAD FOR EVERY CANVAS (Android, OpenGL).
+//
+// Stock react-native-skia draws each canvas SYNCHRONOUSLY ON THE UI THREAD: setting a new picture calls
+// requestRedraw → runOnMainThread, and from the UI thread that runs at once — make the GL context current,
+// replay the picture, swap. Measured on a Galaxy XCover 4s (2026-10-12, VibeSDR, per-canvas timers in
+// Container.native.ts): the waterfall canvas 2.7 ms × 58/s, the spectrum 3.7 ms × 31/s — ~300 ms of every
+// second of the UI thread, half of all it did, and the UI thread was the frame limit.
+// Here every canvas draws on ONE dedicated thread with its own GL context (OpenGLContext is thread_local, so
+// that comes for free); the UI thread only records the picture (~0.15 ms) and hands it over. Surface create /
+// resize / destroy run on the same thread (an EGL window surface belongs to the context that draws it) and
+// the UI thread WAITS for them, so a surface can never be torn down mid-draw.
+// Kill switch: `adb shell setprop debug.rnskia.renderthread 0` (read once, at the first canvas).
+
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/system_properties.h>
+
+#include <condition_variable>
+#include <functional>
+#include <future>
+#include <mutex>
+#include <queue>
+#include <thread>
+
+#include <fbjni/fbjni.h>
+
+#include "RNSkLog.h"
+
+namespace RNSkia {
+
+class RNSkRenderThread {
+public:
+  static bool enabled() {
+    static const bool on = [] {
+      char v[PROP_VALUE_MAX] = {0};
+      __system_property_get("debug.rnskia.renderthread", v);
+      return v[0] != '0';
+    }();
+    return on;
+  }
+
+  static RNSkRenderThread &instance() {
+    static RNSkRenderThread t;
+    return t;
+  }
+
+  bool isCurrent() const { return std::this_thread::get_id() == _id; }
+
+  void post(std::function<void()> task) {
+    {
+      std::lock_guard<std::mutex> lock(_mx);
+      _queue.push(std::move(task));
+    }
+    _cv.notify_one();
+  }
+
+  // Runs `task` on the render thread and waits for it. Never called FROM the render thread's own tasks in a
+  // way that waits on another thread, so this cannot deadlock.
+  void runSync(const std::function<void()> &task) {
+    if (isCurrent()) {
+      task();
+      return;
+    }
+    std::promise<void> done;
+    auto f = done.get_future();
+    post([&task, &done] {
+      task();
+      done.set_value();
+    });
+    f.wait();
+  }
+
+private:
+  RNSkRenderThread() {
+    std::promise<std::thread::id> started;
+    auto f = started.get_future();
+    std::thread([this, &started] {
+      prctl(PR_SET_NAME, "SkiaRender");
+      setpriority(PRIO_PROCESS, 0, -10); // = THREAD_PRIORITY_URGENT_DISPLAY, the RenderThread's own class
+      started.set_value(std::this_thread::get_id());
+      facebook::jni::ThreadScope scope; // attached for its whole life (updateTexImage is a JNI call)
+      loop();
+    }).detach();
+    _id = f.get();
+  }
+
+  void loop() {
+    for (;;) {
+      std::function<void()> task;
+      {
+        std::unique_lock<std::mutex> lock(_mx);
+        _cv.wait(lock, [this] { return !_queue.empty(); });
+        task = std::move(_queue.front());
+        _queue.pop();
+      }
+      try {
+        if (task) task();
+      } catch (const std::exception &e) {
+        RNSkLogger::logToConsole("SkiaRender task threw: %s", e.what());
+      } catch (...) {
+        RNSkLogger::logToConsole("SkiaRender task threw");
+      }
+    }
+  }
+
+  std::thread::id _id;
+  std::mutex _mx;
+  std::condition_variable _cv;
+  std::queue<std::function<void()>> _queue;
+};
+
+} // namespace RNSkia
