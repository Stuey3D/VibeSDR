+#pragma once
+
+// VibeSDR: a tiny EXPORTED API compiled inside librnskia (Android) / the
+// react-native-skia pod (iOS) so our own native library can build Skia raster
+// images and paths on any thread and hand them to a worklet runtime as
+// ordinary SkImage / SkPath host objects.
+//
+// WHY: react-native-skia links Skia statically with hidden visibility, so
+// SkImages::RasterFromData, SkData, SkPathBuilder ... are NOT exported from
+// librnskia.so - an outside library cannot call Skia directly. This header
+// deliberately includes NO Skia headers: every Skia object crosses the
+// boundary as an opaque void* handle.
+//
+// HANDLE OWNERSHIP: a handle from make* is owned by the caller until it is
+// either ADOPTED by wrap* (the host object then owns it; do not release it) or
+// dropped with release*. Exactly one of the two, exactly once.
+
+#include <cstddef>
+#include <cstdint>
+
+#include <jsi/jsi.h>
+
+#define VIBE_RNSKIA_EXPORT __attribute__((visibility("default")))
+
+namespace vibe_rnskia {
+
+// --- Any thread, no GPU context needed --------------------------------------
+
+/**
+ * Copies width*height Gray_8 pixels (rowBytes stride, >= width) into a new
+ * SkData and returns a raster SkImage (kGray_8, opaque alpha) as an opaque
+ * handle (a ref'd SkImage* released from sk_sp), or nullptr on bad arguments.
+ */
+VIBE_RNSKIA_EXPORT void *makeGray8Image(const uint8_t *pixels, int width,
+                                        int height, size_t rowBytes);
+
+/**
+ * Builds a polyline path: moveTo(xy[0],xy[1]), lineTo for the remaining
+ * nPoints-1 points (xy is interleaved x,y floats, 2*nPoints of them),
+ * optional close(). The handle is a heap `std::shared_ptr<SkPathBuilder>*` -
+ * the type JsiSkPath (JsiSkWrappingSharedPtrHostObject<SkPathBuilder>) holds,
+ * so wrapPath adopts it without copying the points. nullptr if nPoints < 1.
+ */
+VIBE_RNSKIA_EXPORT void *makePolyPath(const float *xy, int nPoints,
+                                      bool close);
+
+/** Drop a handle that was never wrapped. nullptr is a no-op. */
+VIBE_RNSKIA_EXPORT void releaseImage(void *imageHandle);
+VIBE_RNSKIA_EXPORT void releasePath(void *pathHandle);
+
+// --- On the thread that owns rt ---------------------------------------------
+
+/**
+ * Remember the RNSkPlatformContext held by any react-native-skia host object
+ * (e.g. the `Skia` API object, an SkImage, an SkPaint ...). Optional: the
+ * context is also captured automatically when RNSkManager is created (every
+ * JS reload). Returns false if the value is not a Skia host object.
+ */
+VIBE_RNSKIA_EXPORT bool
+setPlatformContextFrom(facebook::jsi::Runtime &rt,
+                       const facebook::jsi::Value &anySkiaHostObject);
+
+/** True once a platform context is known (wrap* can run). */
+VIBE_RNSKIA_EXPORT bool hasPlatformContext();
+
+/**
+ * ADOPT the handle into a new JsiSkImage / JsiSkPath host object on rt
+ * (normally the Reanimated UI runtime). The object is created WITHOUT Hermes
+ * external memory pressure, and its dispose() is cheap (no
+ * setExternalMemoryPressure). Call dispose() on the previous frame's object
+ * when you replace it. A nullptr handle returns undefined. The handle is
+ * consumed even if this throws.
+ */
+VIBE_RNSKIA_EXPORT facebook::jsi::Value wrapImage(facebook::jsi::Runtime &rt,
+                                                  void *imageHandle);
+VIBE_RNSKIA_EXPORT facebook::jsi::Value wrapPath(facebook::jsi::Runtime &rt,
+                                                 void *pathHandle);
+
+} // namespace vibe_rnskia
