+EGLDisplay gFenceDisplay = EGL_NO_DISPLAY;
+PFNEGLCREATESYNCKHRPROC pCreateSync = nullptr;
+PFNEGLCLIENTWAITSYNCKHRPROC pClientWait = nullptr;
+PFNEGLDESTROYSYNCKHRPROC pDestroySync = nullptr;
