+#pragma once
+
+// VIBESDR PATCH — ONE SKIA RENDER THREAD FOR EVERY CANVAS (Android, OpenGL).
+//
+// Stock react-native-skia draws each canvas SYNCHRONOUSLY ON THE UI THREAD: setting a new picture calls
+// requestRedraw → runOnMainThread, and from the UI thread that runs at once — make the GL context current,
+// replay the picture, swap. Measured on a Galaxy XCover 4s (2026-10-12, VibeSDR, per-canvas timers in
+// Container.native.ts): the waterfall canvas 2.7 ms × 58/s, the spectrum 3.7 ms × 31/s — ~300 ms of every
+// second of the UI thread, half of all it did, and the UI thread was the frame limit.
+// Here every canvas draws on ONE dedicated thread with its own GL context (OpenGLContext is thread_local, so
+// that comes for free); the UI thread only records the picture (~0.15 ms) and hands it over. Surface create /
+// resize / destroy run on the same thread (an EGL window surface belongs to the context that draws it) and
+// the UI thread WAITS for them, so a surface can never be torn down mid-draw.
+// Kill switch: `adb shell setprop debug.rnskia.renderthread 0` (read once, at the first canvas).
+
+#include <android/api-level.h>
+#include <android/choreographer.h>
+#include <android/looper.h>
+#include <sys/eventfd.h>
+#include <dlfcn.h>
+#include <sys/prctl.h>
+#include <unistd.h>
+#include <sys/resource.h>
+#include <sys/system_properties.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <vector>
+#include <functional>
+#include <future>
+#include <mutex>
+#include <queue>
+#include <thread>
+
+#include <fbjni/fbjni.h>
+
+#include "RNSkLog.h"
+
+namespace RNSkia {
+
+class RNSkRenderThread {
+public:
+  static bool enabled() {
+    static const bool on = [] {
+      char v[PROP_VALUE_MAX] = {0};
+      __system_property_get("debug.rnskia.renderthread", v);
+      return v[0] != '0';
+    }();
+    return on;
+  }
+
+  static RNSkRenderThread &instance() {
+    static RNSkRenderThread t;
+    return t;
+  }
+
+  bool isCurrent() const { return std::this_thread::get_id() == _id; }
+
+  // ★★★ VSYNC-TIED DRAWS (2026-10-13, Moto G35): the analogue needle juddered in some PHASES and not others — the shade,
+  //   a rotation or an app switch flipped it ("a rotate to landscape and back restored it"). Draws ran the moment they
+  //   were asked for, so where they finished relative to RenderThread's latch of the TextureView drifted with whatever
+  //   last disturbed the timing; near the latch a frame was sometimes taken and sometimes missed — 0, 2, 1, 1, 0, 2.
+  //   Now redraw requests are collected and drawn on this thread's OWN Choreographer callback, and at each vsync only
+  //   requests made BEFORE that vsync are drawn — the UI thread's animation callbacks post theirs just after it, so
+  //   every frame takes exactly one vsync, never sometimes one and sometimes two. Surface create / resize / destroy
+  //   (runSync) still run at once. Kill switch: `adb shell setprop debug.rnskia.vsync 0` (draw at once, as before).
+  static bool vsyncOn() {
+    static const bool on = [] {
+      char v[PROP_VALUE_MAX] = {0};
+      __system_property_get("debug.rnskia.vsync", v);
+      return v[0] != '0';
+    }();
+    return on;
+  }
+
+  void post(std::function<void()> task) {
+    {
+      std::lock_guard<std::mutex> lock(_mx);
+      if (vsyncOn()) _frameQ.push_back({nowNs(), std::move(task)});
+      else _queue.push(std::move(task));
+    }
+    wake();
+  }
+
+  // Runs `task` on the render thread and waits for it. Never called FROM the render thread's own tasks in a
+  // way that waits on another thread, so this cannot deadlock.
+  void runSync(const std::function<void()> &task) {
+    if (isCurrent()) {
+      task();
+      return;
+    }
+    std::promise<void> done;
+    auto f = done.get_future();
+    {
+      std::lock_guard<std::mutex> lock(_mx);
+      _queue.push([&task, &done] {
+        task();
+        done.set_value();
+      });
+    }
+    wake();
+    f.wait();
+  }
+
+private:
+  RNSkRenderThread() {
+    _efd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    std::promise<std::thread::id> started;
+    auto f = started.get_future();
+    std::thread([this, &started] {
+      prctl(PR_SET_NAME, "SkiaRender");
+      setpriority(PRIO_PROCESS, 0, -10); // = THREAD_PRIORITY_URGENT_DISPLAY, the RenderThread's own class
+      started.set_value(std::this_thread::get_id());
+      facebook::jni::ThreadScope scope; // attached for its whole life (updateTexImage is a JNI call)
+      loop();
+    }).detach();
+    _id = f.get();
+  }
+
+  static int64_t nowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+        .count();   // CLOCK_MONOTONIC — the clock Choreographer's frame times are on
+  }
+
+  void wake() {
+    uint64_t one = 1;
+    (void)write(_efd, &one, sizeof one);
+  }
+
+  // ★★★ PERFORMANCE HINT (ADPF, Android 13+): THIS THREAD'S DRAWS ARE FRAME WORK. Measured on a Moto G35, 2026-10-12:
+  //   the UI thread, RenderThread and SkiaRender all sat on one A76 clocked at 614 MHz of its 2210 — the governor
+  //   judges a core by how busy it looks, and bursty draws look idle. HWUI already puts the UI thread and RenderThread
+  //   in a hint session; SkiaRender, ours, was in none. Each frame's draws are reported against a target, and the
+  //   governor raises the clock to meet it — what iOS does for its render threads unasked. Target 8 ms (half a 60 Hz
+  //   frame). Below API 33, or with no vendor support, nothing happens. Kill switch: `setprop debug.rnskia.hint 0`.
+  struct Hint {
+    void *session = nullptr;
+    int (*report)(void *, int64_t) = nullptr;
+  };
+  static Hint makeHint() {
+    Hint h;
+    char v[PROP_VALUE_MAX] = {0};
+    __system_property_get("debug.rnskia.hint", v);
+    if (v[0] == '0' || android_get_device_api_level() < 33) return h;
+    void *lib = dlopen("libandroid.so", RTLD_NOW);
+    if (!lib) return h;
+    auto getManager = (void *(*)())dlsym(lib, "APerformanceHint_getManager");
+    auto create = (void *(*)(void *, const int32_t *, size_t, int64_t))dlsym(lib, "APerformanceHint_createSession");
+    h.report = (int (*)(void *, int64_t))dlsym(lib, "APerformanceHint_reportActualWorkDuration");
+    if (!getManager || !create || !h.report) { h.report = nullptr; return h; }
+    void *mgr = getManager();
+    if (!mgr) { h.report = nullptr; return h; }
+    const int32_t tid = (int32_t)gettid();
+    h.session = create(mgr, &tid, 1, 8000000LL);
+    if (!h.session) h.report = nullptr;
+    return h;
+  }
+
+  void runTask(std::function<void()> &task) {
+    try {
+      if (task) task();
+    } catch (const std::exception &e) {
+      RNSkLogger::logToConsole("SkiaRender task threw: %s", e.what());
+    } catch (...) {
+      RNSkLogger::logToConsole("SkiaRender task threw");
+    }
+  }
+
+  // Immediate work: runSync tasks, and (vsync off) every task. Reported to the hint as one burst.
+  void runImmediate() {
+    const int64_t t0 = nowNs();
+    bool any = false;
+    for (;;) {
+      std::function<void()> task;
+      {
+        std::lock_guard<std::mutex> lock(_mx);
+        if (_queue.empty()) break;
+        task = std::move(_queue.front());
+        _queue.pop();
+      }
+      any = true;
+      runTask(task);
+    }
+    if (any && _hint.report) _hint.report(_hint.session, nowNs() - t0);
+  }
+
+  void maybePostFrame() {
+    if (_framePosted || !_choreo) return;
+    {
+      std::lock_guard<std::mutex> lock(_mx);
+      if (_frameQ.empty()) return;
+    }
+    _framePosted = true;
+    if (_post64) _post64(_choreo, &RNSkRenderThread::onFrame64, this);
+    else if (_post32) _post32(_choreo, &RNSkRenderThread::onFrame32, this);
+  }
+
+  static void onFrame64(int64_t frameTimeNanos, void *d) { static_cast<RNSkRenderThread *>(d)->frame(frameTimeNanos); }
+  // ★★★ THE 32-BIT FRAME TIME (NickB, Moto G6, Android 9, 2026-10-16: "waterfall does not appear" — audio fine).
+  //   postFrameCallback64 is API 29+, so on Android 7-9 the only callback is this one, and its frame time is a `long`.
+  //   The Moto G6 runs a 32-BIT userspace on its 64-bit SoC: there `long` is 32 bits and Android hands over the vsync
+  //   time TRUNCATED to its low 32 bits — the very bug API 29 added the 64-bit call to fix. Compared with the full
+  //   64-bit request times in frame(), no request was ever "before this vsync", so nothing was ever drawn: the queue
+  //   re-posted itself every vsync for ever and every vsync-tied canvas (waterfall, spectrum) stayed blank.
+  //   Rebuild the full time from the low 32 bits and our own clock (the same CLOCK_MONOTONIC): the vsync is at most a
+  //   few ms in the past, far inside the 4.29 s the low bits cover. Done whatever `long`'s width — exact on 64-bit
+  //   too, so the API 24-28 path is ONE code path on every phone (and testable on a 64-bit API 28 emulator).
+  static void onFrame32(long frameTimeNanos, void *d) {
+    const int64_t now = nowNs();
+    const uint32_t back = (uint32_t)now - (uint32_t)(uint64_t)frameTimeNanos;   // now − vsync, mod 2^32
+    // A vsync "in the future" or over a second old cannot be real: take now, which draws everything already asked for.
+    const int64_t vsync = back < 1000000000u ? now - (int64_t)back : now;
+    static_cast<RNSkRenderThread *>(d)->frame(vsync);
+  }
+
+  void frame(int64_t vsyncNs) {
+    _framePosted = false;
+    std::vector<std::function<void()>> due;
+    const int64_t now = nowNs();
+    {
+      std::lock_guard<std::mutex> lock(_mx);
