diff --git a/ingress/origins/dns_android.go b/ingress/origins/dns_android.go
new file mode 100644
index 0000000..5107a86
--- /dev/null
+++ b/ingress/origins/dns_android.go
@@ -0,0 +1,55 @@
+//go:build android
+
+package origins
+
+import (
+	"net"
+	"net/netip"
+)
+
+// ★★★ ANDROID HAS NO LOCAL DNS RESOLVER TO DISCOVER.
+//
+// DNSResolverService exists to find out which nameserver THIS MACHINE uses, by peeking at the
+// address Go's resolver dials, so that DNS queries arriving through the tunnel can be forwarded
+// to it. That whole idea assumes an /etc/resolv.conf naming a local resolver. Android has
+// neither the file nor, usually, a resolver on 127.0.0.1 — so the peek fails with
+// "connection refused", the service logs "Failed to initialize DNS local resolver", and it then
+// falls back to 127.0.0.1:53, which is equally absent.
+//
+// ★★ HARMLESS FOR VIBESERVER, WHICH NEVER SERVES DNS THROUGH THE TUNNEL — the tunnel's own edge
+//    discovery uses net.DefaultResolver and is fixed separately in cmd/cloudflared/dns_android.go.
+//    But it puts a red ERR in front of an operator on every start, and leaves the service pointed
+//    at an address that cannot answer. Both are cheap to fix honestly.
+//
+// So on Android we do not try to discover a local resolver: we name one. The peek then succeeds
+// against a real nameserver, the error disappears, and the service is left pointing somewhere
+// that can actually answer a query.
+
+func init() {
+	// Where the fallback lands when no address has been discovered.
+	defaultResolverAddr = netip.AddrPortFrom(netip.MustParseAddr("1.1.1.1"), defaultResolverPort)
+
+	// ★ And how the peek itself dials. Go hands us the address it worked out from resolv.conf —
+	//   on Android that is the bogus [::1]:53 — so we ignore it and dial a resolver that exists.
+	//   The port is kept from the caller only when it named a real one.
+	resolverDialFunc = func(network, address string) (net.Conn, error) {
+		if isUnusableResolver(address) {
+			address = defaultResolverAddr.String()
+		}
+		return net.Dial(network, address)
+	}
+}
+
+// ★ Loopback is what Go falls back to when it can find no nameserver, and on Android that is
+//   never a real resolver. Anything else the platform genuinely told us about is left alone.
+func isUnusableResolver(address string) bool {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return true
+	}
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return true
+	}
+	return addr.IsLoopback() || addr.IsUnspecified()
+}
