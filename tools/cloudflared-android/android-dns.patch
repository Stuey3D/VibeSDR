+//go:build android
+
+package main
+
+// ★★★ ANDROID HAS NO /etc/resolv.conf, AND THAT IS WHY cloudflared FAILS ON A PHONE.
+//
+// Go's pure-Go resolver (the only one that can look up the SRV record cloudflared's edge discovery
+// needs) reads /etc/resolv.conf to find a nameserver. Android does not ship that file, so every lookup
+// of the tunnel edge fails and the tunnel never dials. See cloudflared issue #425.
+//
+// ★★★ THE CIRCULATING FIX IS TO HEX-PATCH THE SHIPPED BINARY — replacing the "/etc/resolv.conf"
+//     string with a same-length path fed on stdin. We do not do that: cloudflared is Apache-2.0
+//     and we compile it ourselves, so the resolver is fixed HERE, in source, where it can be
+//     reviewed and survives a version bump.
+//
+// ★★★ AND NOT TO HARD-CODED PUBLIC SERVERS ALONE (Kiko, Android 6.0.1, 2026-10-26): his network drops
+//     outbound UDP 53 to the internet, so 1.1.1.1:53 timed out and the tunnel never came up. The app
+//     now hands over the device's own DNS servers (VIBE_DNS_SERVERS), which are tried first; public
+//     UDP/TCP 53 next; verified DNS-over-TLS last. See vibedns/resolver.go for the ladder.
+
+import (
+	"net"
+
+	"github.com/cloudflare/cloudflared/vibedns"
+)
+
+func init() {
+	net.DefaultResolver = vibedns.New(vibedns.DefaultConfig(vibedns.SystemServers())).Resolver()
+}
