diff --git a/cmd/cloudflared/dns_android.go b/cmd/cloudflared/dns_android.go
new file mode 100644
index 0000000..6039044
--- /dev/null
+++ b/cmd/cloudflared/dns_android.go
@@ -0,0 +1,52 @@
+//go:build android
+
+package main
+
+// ★★★ ANDROID HAS NO /etc/resolv.conf, AND THAT IS WHY cloudflared FAILS ON A PHONE.
+//
+// Go's pure-Go resolver (the only one available with CGO_ENABLED=0) reads /etc/resolv.conf to
+// discover a nameserver. Android does not ship that file, so every lookup of the tunnel edge
+// (region1.v2.argotunnel.com and friends) fails with "connection refused" and the tunnel never
+// dials. See cloudflared issue #425.
+//
+// ★★★ THE CIRCULATING FIX IS TO HEX-PATCH THE SHIPPED BINARY — replacing the "/etc/resolv.conf"
+//     string with a same-length path fed on stdin. We do not do that: cloudflared is Apache-2.0
+//     and we compile it ourselves, so the resolver is fixed HERE, in source, where it can be
+//     reviewed and survives a version bump.
+
+import (
+	"context"
+	"net"
+	"time"
+)
+
+// Public resolvers, tried in order. Cloudflare's own first — we are dialling Cloudflare's edge.
+var androidNameservers = []string{
+	"1.1.1.1:53",
+	"1.0.0.1:53",
+	"8.8.8.8:53",
+}
+
+func init() {
+	net.DefaultResolver = &net.Resolver{
+		// ★ Must be true: this Dial is only consulted by the pure-Go resolver.
+		PreferGo: true,
+		Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			// ★ Ignore the address Go worked out from resolv.conf — there isn't one. The
+			//   network ("udp"/"tcp") is honoured so TCP retry for truncated replies works.
+			var lastErr error
+			for _, ns := range androidNameservers {
+				d := net.Dialer{Timeout: 5 * time.Second}
+				conn, err := d.DialContext(ctx, network, ns)
+				if err == nil {
+					return conn, nil
+				}
+				lastErr = err
+				if ctx.Err() != nil {
+					break
+				}
+			}
+			return nil, lastErr
+		},
+	}
+}
