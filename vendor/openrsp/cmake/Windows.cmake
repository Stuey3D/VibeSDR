# Windows build rules.
# Included from cmake/Platform.cmake on WIN32, after the generic libusb probe and before any target.
#
#   SDRPLAY_WINDOWS_PLATFORM_SOURCES  src/platform/windows/*.cpp for sdrplay_platform (the
#                                     Windows clock replaces common/ClockStd.cpp)
#   PkgConfig::LIBUSB                 libusb-1.0 (WinUSB backend) compiled from source, static
#   sdrplay_windows_client_lib(tgt)   API 3.15 DLL name, .def with the API 3.15 names + ordinals
#   sdrplay_windows_finalize()        static runtime, system libraries, service linker flags
#
# Toolchains: cmake/toolchains/mingw-w64-x86_64.cmake (client DLL x64 + test/Wine builds) and
# cmake/toolchains/mingw-w64-i686.cmake (client DLL x86 + the 32-bit service).
# libusb: pinned release, downloaded at configure time (SHA-256 checked) unless
# SDRPLAY_WINDOWS_LIBUSB_SRC points at an extracted libusb source tree (offline builds).

set(SDRPLAY_WINDOWS_NATIVE ON)
set(_win_src ${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows)
set(SDRPLAY_WINDOWS_PLATFORM_SOURCES
  ${_win_src}/WinCommon.cpp
  ${_win_src}/SharedMemoryWindows.cpp
  ${_win_src}/InterProcessSemaphoreWindows.cpp
  ${_win_src}/InterProcessMutexWindows.cpp
  ${_win_src}/ThreadOsWindows.cpp
  ${_win_src}/ClockWindows.cpp
  ${_win_src}/LogSinkWindows.cpp
  ${_win_src}/ServiceHostWindows.cpp
  ${_win_src}/RegistryWindows.cpp)

# The service reads its firmware sets from here first, then from "<exe dir>/firmware" (where the
# Windows installer puts them).
set(SDRPLAY_FIRMWARE_DIR "C:/Program Files/SDRplay/firmware" CACHE PATH
    "Where the service looks for firmware sets (<dir>/own, ...)")

# ------------------------------------------------------------------ libusb-1.0
set(SDRPLAY_WINDOWS_LIBUSB_VERSION 1.0.27)
set(SDRPLAY_WINDOWS_LIBUSB_SHA256 ffaa41d741a8a3bee244ac8e54a72ea05bf2879663c098c82fc5757853441575)
set(SDRPLAY_WINDOWS_LIBUSB_SRC "" CACHE PATH "Extracted libusb ${SDRPLAY_WINDOWS_LIBUSB_VERSION} source tree (empty: download)")
if(NOT SDRPLAY_HAVE_LIBUSB)
  if(SDRPLAY_WINDOWS_LIBUSB_SRC)
    set(_lusb ${SDRPLAY_WINDOWS_LIBUSB_SRC})
  else()
    set(_lusb_tar ${CMAKE_BINARY_DIR}/_deps/libusb-${SDRPLAY_WINDOWS_LIBUSB_VERSION}.tar.bz2)
    set(_lusb ${CMAKE_BINARY_DIR}/_deps/libusb-${SDRPLAY_WINDOWS_LIBUSB_VERSION})
    if(NOT EXISTS ${_lusb}/libusb/core.c)
      file(DOWNLOAD
        https://github.com/libusb/libusb/releases/download/v${SDRPLAY_WINDOWS_LIBUSB_VERSION}/libusb-${SDRPLAY_WINDOWS_LIBUSB_VERSION}.tar.bz2
        ${_lusb_tar} EXPECTED_HASH SHA256=${SDRPLAY_WINDOWS_LIBUSB_SHA256} TLS_VERIFY ON STATUS _st)
      list(GET _st 0 _rc)
      if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "libusb download failed (${_st}); set SDRPLAY_WINDOWS_LIBUSB_SRC to an extracted tree")
      endif()
      file(ARCHIVE_EXTRACT INPUT ${_lusb_tar} DESTINATION ${CMAKE_BINARY_DIR}/_deps)
    endif()
  endif()
  if(NOT EXISTS ${_lusb}/libusb/os/windows_winusb.c)
    message(FATAL_ERROR "no libusb source tree at ${_lusb}")
  endif()
  # What libusb's configure produces for MinGW; the API is not exported from our DLL/EXE.
  file(WRITE ${CMAKE_BINARY_DIR}/libusb-windows/config.h.tmp
"/* generated by cmake/Windows.cmake (MinGW equivalent of libusb's configure output) */
#define DEFAULT_VISIBILITY
#define ENABLE_LOGGING 1
#define HAVE_STRUCT_TIMESPEC 1
#define HAVE_SYS_TIME_H 1
#define PLATFORM_WINDOWS 1
#define PRINTF_FORMAT(a, b) __attribute__ ((__format__ (__printf__, a, b)))
")
  configure_file(${CMAKE_BINARY_DIR}/libusb-windows/config.h.tmp ${CMAKE_BINARY_DIR}/libusb-windows/config.h COPYONLY)
  add_library(sdrplay_libusb STATIC
    ${_lusb}/libusb/core.c
    ${_lusb}/libusb/descriptor.c
    ${_lusb}/libusb/hotplug.c
    ${_lusb}/libusb/io.c
    ${_lusb}/libusb/sync.c
    ${_lusb}/libusb/strerror.c
    ${_lusb}/libusb/os/events_windows.c
    ${_lusb}/libusb/os/threads_windows.c
    ${_lusb}/libusb/os/windows_common.c
    ${_lusb}/libusb/os/windows_usbdk.c
    ${_lusb}/libusb/os/windows_winusb.c)
  target_include_directories(sdrplay_libusb PRIVATE ${CMAKE_BINARY_DIR}/libusb-windows ${_lusb}/libusb/os)
  # SYSTEM: libusb.h uses zero-length arrays, which -Wpedantic rejects in our code.
  target_include_directories(sdrplay_libusb SYSTEM PUBLIC ${_lusb}/libusb)
  target_compile_options(sdrplay_libusb PRIVATE -w)
  # WinUSB/SetupAPI/cfgmgr are loaded at run time by libusb itself (DLL_LOAD_FUNC).
  target_link_libraries(sdrplay_libusb PUBLIC Threads::Threads)
  if(NOT TARGET PkgConfig::LIBUSB)
    add_library(PkgConfig::LIBUSB INTERFACE IMPORTED)
  endif()
  set_target_properties(PkgConfig::LIBUSB PROPERTIES INTERFACE_LINK_LIBRARIES sdrplay_libusb)
  set(SDRPLAY_HAVE_LIBUSB ON)
  set(LIBUSB_FOUND ON)
  set(LIBUSB_VERSION ${SDRPLAY_WINDOWS_LIBUSB_VERSION})
  message(STATUS "windows: libusb ${SDRPLAY_WINDOWS_LIBUSB_VERSION} (static, WinUSB backend) from ${_lusb}")
endif()

# --------------------------------------------------------------- client DLL
# API 3.15 layout: API\x64\sdrplay_api.dll / API\x86\sdrplay_api.dll + sdrplay_api.lib, 24 exports
# with ordinals 1-24, no CRT DLL dependency beyond the system (static libstdc++/libgcc/winpthread).
function(sdrplay_windows_client_lib tgt)
  file(READ ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/sdrplay_api.def _def)
  if(CMAKE_SIZEOF_VOID_P EQUAL 4)
    # x86 spelling of the decorated name: its pointer arguments lose the 64-bit qualifier.
    string(REPLACE "@@PEAXPEAPEAU" "@@PAXPAPAU" _def "${_def}")
  endif()
  string(REGEX MATCHALL "@([0-9]+)\n" _ords "${_def}")
  list(LENGTH _ords _n)
  if(NOT _n EQUAL 24)
    message(FATAL_ERROR "sdrplay_api.def: expected 24 ordinals, found ${_n}")
  endif()
  set(_out ${CMAKE_BINARY_DIR}/sdrplay_api.def)
  file(WRITE ${_out}.tmp "${_def}")
  configure_file(${_out}.tmp ${_out} COPYONLY)
  target_sources(${tgt} PRIVATE ${_out})
  set_target_properties(${tgt} PROPERTIES
    OUTPUT_NAME sdrplay_api PREFIX "" SUFFIX ".dll"
    IMPORT_PREFIX "" IMPORT_SUFFIX ".lib")
  # -static: libstdc++, libgcc and winpthread inside the DLL (no MinGW runtime DLLs to ship).
  # Linker flags: preferred image base below (MSVC's default DLL base), subsystem version 6.0,
  # ASLR (--dynamicbase, plus --high-entropy-va on x64) and DEP (--nxcompat).
  if(CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(_pe "LINKER:--image-base=0x10000000")
  else()
    set(_pe "LINKER:--image-base=0x180000000" "LINKER:--high-entropy-va")
  endif()
  target_link_options(${tgt} PRIVATE -static -static-libgcc -static-libstdc++
    "LINKER:--no-undefined" "LINKER:--dynamicbase" "LINKER:--nxcompat" ${_pe}
    "LINKER:--major-subsystem-version=6" "LINKER:--minor-subsystem-version=0")
endfunction()

function(sdrplay_windows_finalize)
  target_link_libraries(sdrplay_platform PUBLIC advapi32)
  # The API header defaults _SDRPLAY_DLL_QUALIFIER to __declspec(dllimport) on _WIN32; the
  # implementation must not see that (exports come from the .def, not from dllexport).
  if(TARGET sdrplay_client)
    target_compile_definitions(sdrplay_client PRIVATE "_SDRPLAY_DLL_QUALIFIER=")
  endif()
  if(TARGET sdrplay_apiService)
    # Linker flags: console subsystem version 6.0, ASLR, DEP and terminal-server aware, with
    # the default executable image base.
    target_link_options(sdrplay_apiService PRIVATE -static -static-libgcc -static-libstdc++
      "LINKER:--dynamicbase" "LINKER:--nxcompat" "LINKER:--tsaware"
      "LINKER:--major-subsystem-version=6" "LINKER:--minor-subsystem-version=0")
  endif()
endfunction()
