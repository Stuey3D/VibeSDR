# Android build rules. Included from cmake/Platform.cmake
# when CMAKE_SYSTEM_NAME is Android, after the generic libusb probe and before any target.
#
#   SDRPLAY_ANDROID_PLATFORM_SOURCES  sources of sdrplay_platform (bionic shm registry, IPC, log, ...)
#   SDRPLAY_ANDROID_USB_SOURCES       sources of sdrplay_platform_usb (libusb + injected UsbManager fds)
#   PkgConfig::LIBUSB                 libusb-1.0 compiled from source for the NDK (static, hidden)
#   sdrplay_android_finalize()        embeds the service in libsdrplay_api.so, JNI, Android-only tests
#
# libusb: pinned release, downloaded at configure time (SHA-256 checked) unless
# SDRPLAY_ANDROID_LIBUSB_SRC points at an extracted libusb source tree (offline builds).

set(_and_src ${CMAKE_CURRENT_LIST_DIR})
set(SDRPLAY_ANDROID_PLATFORM_SOURCES
  ${_and_src}/SharedMemoryAndroid.cpp
  ${_and_src}/InterProcessSemaphoreAndroid.cpp
  ${_and_src}/InterProcessMutexAndroid.cpp
  ${_and_src}/ThreadOsAndroid.cpp
  ${_and_src}/LogSinkAndroid.cpp
  ${_and_src}/ServiceHostAndroid.cpp)
set(SDRPLAY_ANDROID_USB_SOURCES ${_and_src}/UsbAndroid.cpp)

if(ANDROID_PLATFORM_LEVEL AND ANDROID_PLATFORM_LEVEL LESS 26)
  message(FATAL_ERROR "Android builds need -DANDROID_PLATFORM=android-26 or later (ASharedMemory_create)")
endif()

option(SDRPLAY_ANDROID_QEMU_STATIC "Shim libandroid/liblog for static qemu-user test executables (tests only)" OFF)

# ------------------------------------------------------------------ libusb-1.0
set(SDRPLAY_ANDROID_LIBUSB_VERSION 1.0.27)
set(SDRPLAY_ANDROID_LIBUSB_SHA256 ffaa41d741a8a3bee244ac8e54a72ea05bf2879663c098c82fc5757853441575)
set(SDRPLAY_ANDROID_LIBUSB_SRC "" CACHE PATH "Extracted libusb ${SDRPLAY_ANDROID_LIBUSB_VERSION} source tree (empty: download)")
if(SDRPLAY_ANDROID_LIBUSB_SRC)
  set(_lusb ${SDRPLAY_ANDROID_LIBUSB_SRC})
else()
  set(_lusb_tar ${CMAKE_BINARY_DIR}/_deps/libusb-${SDRPLAY_ANDROID_LIBUSB_VERSION}.tar.bz2)
  set(_lusb ${CMAKE_BINARY_DIR}/_deps/libusb-${SDRPLAY_ANDROID_LIBUSB_VERSION})
  if(NOT EXISTS ${_lusb}/libusb/core.c)
    file(DOWNLOAD
      https://github.com/libusb/libusb/releases/download/v${SDRPLAY_ANDROID_LIBUSB_VERSION}/libusb-${SDRPLAY_ANDROID_LIBUSB_VERSION}.tar.bz2
      ${_lusb_tar} EXPECTED_HASH SHA256=${SDRPLAY_ANDROID_LIBUSB_SHA256} TLS_VERIFY ON STATUS _st)
    list(GET _st 0 _rc)
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "libusb download failed (${_st}); set SDRPLAY_ANDROID_LIBUSB_SRC to an extracted tree")
    endif()
    file(ARCHIVE_EXTRACT INPUT ${_lusb_tar} DESTINATION ${CMAKE_BINARY_DIR}/_deps)
  endif()
endif()
if(NOT EXISTS ${_lusb}/libusb/os/linux_usbfs.c)
  message(FATAL_ERROR "no libusb source tree at ${_lusb}")
endif()

# libusb's android/config.h, except that the API is NOT exported from our shared library
# (DEFAULT_VISIBILITY empty + -fvisibility=hidden): libsdrplay_api.so must not leak a
# second libusb into apps that bring their own.
file(WRITE ${CMAKE_BINARY_DIR}/libusb-android/config.h.tmp
"/* generated by src/platform/android/Android.cmake from libusb android/config.h */
#define DEFAULT_VISIBILITY
#define ENABLE_LOGGING 1
#define HAVE_ASM_TYPES_H 1
#define HAVE_CLOCK_GETTIME 1
#define HAVE_NFDS_T 1
#define HAVE_PIPE2 1
#define HAVE_SYS_TIME_H 1
#define PLATFORM_POSIX 1
#define PRINTF_FORMAT(a, b) __attribute__ ((__format__ (__printf__, a, b)))
#define USE_SYSTEM_LOGGING_FACILITY 1
#define _GNU_SOURCE 1
")
configure_file(${CMAKE_BINARY_DIR}/libusb-android/config.h.tmp ${CMAKE_BINARY_DIR}/libusb-android/config.h COPYONLY)

add_library(sdrplay_libusb STATIC
  ${_lusb}/libusb/core.c
  ${_lusb}/libusb/descriptor.c
  ${_lusb}/libusb/hotplug.c
  ${_lusb}/libusb/io.c
  ${_lusb}/libusb/sync.c
  ${_lusb}/libusb/strerror.c
  ${_lusb}/libusb/os/linux_usbfs.c
  ${_lusb}/libusb/os/events_posix.c
  ${_lusb}/libusb/os/threads_posix.c
  ${_lusb}/libusb/os/linux_netlink.c)
target_include_directories(sdrplay_libusb PRIVATE ${CMAKE_BINARY_DIR}/libusb-android ${_lusb}/libusb/os)
# SYSTEM: libusb.h uses zero-length arrays, which -Wpedantic -Werror rejects in our code.
target_include_directories(sdrplay_libusb SYSTEM PUBLIC ${_lusb}/libusb)
target_compile_options(sdrplay_libusb PRIVATE -fvisibility=hidden -w)
if(SDRPLAY_ANDROID_QEMU_STATIC)
  target_link_libraries(sdrplay_libusb PUBLIC Threads::Threads)
else()
  target_link_libraries(sdrplay_libusb PUBLIC log Threads::Threads)
endif()
set_target_properties(sdrplay_libusb PROPERTIES POSITION_INDEPENDENT_CODE ON)

if(NOT TARGET PkgConfig::LIBUSB)
  add_library(PkgConfig::LIBUSB INTERFACE IMPORTED)
endif()
set_target_properties(PkgConfig::LIBUSB PROPERTIES INTERFACE_LINK_LIBRARIES sdrplay_libusb)
set(SDRPLAY_HAVE_LIBUSB ON)
set(LIBUSB_FOUND ON)
set(LIBUSB_VERSION ${SDRPLAY_ANDROID_LIBUSB_VERSION})
message(STATUS "android: libusb ${SDRPLAY_ANDROID_LIBUSB_VERSION} from ${_lusb}")

# ------------------------------------------------------------------ finalize
function(sdrplay_android_finalize)
  if(SDRPLAY_ANDROID_QEMU_STATIC)
    # Static test executables for qemu-user (armeabi-v7a cannot run on the x86_64 AVD):
    # libandroid/liblog exist only as .so, so a shim (memfd + stderr) stands in for them.
    target_sources(sdrplay_platform PRIVATE ${_and_src}/QemuStaticShim.c)
    target_link_libraries(sdrplay_libusb PUBLIC sdrplay_platform)
  else()
    # ASharedMemory (libandroid), logcat (liblog).
    target_link_libraries(sdrplay_platform PUBLIC android log)
  endif()

  # The embedded service + JNI live INSIDE libsdrplay_api.so (Android has no daemon).
  add_library(sdrplay_android_embed OBJECT
    ${_and_src}/EmbeddedService.cpp
    ${_and_src}/Jni.cpp
    ${_and_src}/ServiceClient.cpp)
  target_include_directories(sdrplay_android_embed PUBLIC ${_and_src})
  target_link_libraries(sdrplay_android_embed PUBLIC sdrplay_core sdrplay_platform_usb)
  sdrplay_set_warnings(sdrplay_android_embed)
  target_sources(sdrplay_api PRIVATE $<TARGET_OBJECTS:sdrplay_android_embed>)
  target_include_directories(sdrplay_api PRIVATE ${_and_src})
  target_link_libraries(sdrplay_api PRIVATE sdrplay_platform_usb)
  # Exports: the 101 API 3.15 symbols (cmake/libsdrplay_api.map) + the embedding C API + JNI
  # (org.openrspapi.RspNative: embedded mode and the OpenRSP service side;
  #  org.openrsp.api.OpenRsp: the service-mode client helper);
  # everything else (libusb, the static libc++, our internals) stays local.
  file(READ ${PROJECT_SOURCE_DIR}/cmake/libsdrplay_api.map _map)
  string(REPLACE "global:" "global:\n    sdrplay_android_*;\n    Java_org_openrspapi_*;\n    Java_org_openrsp_api_*;" _map "${_map}")
  file(WRITE ${CMAKE_BINARY_DIR}/libsdrplay_api_android.map.tmp "${_map}")
  configure_file(${CMAKE_BINARY_DIR}/libsdrplay_api_android.map.tmp ${CMAKE_BINARY_DIR}/libsdrplay_api_android.map COPYONLY)
  target_link_options(sdrplay_api PRIVATE
    "LINKER:--version-script=${CMAKE_BINARY_DIR}/libsdrplay_api_android.map" "LINKER:--no-undefined")
  set_property(TARGET sdrplay_api APPEND PROPERTY LINK_DEPENDS ${CMAKE_BINARY_DIR}/libsdrplay_api_android.map)
  # Not a GNU/Linux soname chain: Android's loader and APK packaging want a plain
  # libsdrplay_api.so (System.loadLibrary("sdrplay_api")).

  if(COMMAND sdrplay_android_tests)
    sdrplay_android_tests(${_and_src})
  endif()
endfunction()
