# USB access for VibeServer without root.
# ★ The Airspy HF+ needed none of this on Debian 13 (it opened as an ordinary user), but an
#   RTL-SDR generally does — and a rule that is already there is one less thing to debug in a
#   cupboard. plugdev is the conventional group and the service joins it.
# RTL-SDR (RTL2832U, all common tuner variants)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", MODE="0660", GROUP="plugdev"
# Airspy HF+ / Discovery
SUBSYSTEM=="usb", ATTRS{idVendor}=="03eb", ATTRS{idProduct}=="800c", MODE="0660", GROUP="plugdev"
# Airspy R2 / Mini (libairspy, driver "airspy")
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="60a1", MODE="0660", GROUP="plugdev"
# HackRF One (libhackrf, driver "hackrf")
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6089", MODE="0660", GROUP="plugdev"
# SDRplay RSP1 / RSP1A / RSP2 / RSPduo / RSPdx / RSP1B / RSPdx-R2 — for the bundled OpenRSP service
# (vibeserver-rsp.service), which runs as `vibeserver` in plugdev rather than as root. The product IDs
# are the ones OpenRSP's own rules list (vendor/openrsp/system/linux/66-sdrplay.rules).
# ★ A system SDRplay stack's own 66-sdrplay.rules makes these 0666; this later rule narrows them to
#   0660 plugdev, which its root-run service does not notice.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="2500", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="3000", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="3010", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="3020", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="3030", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="3050", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1df7", ATTRS{idProduct}=="3060", MODE="0660", GROUP="plugdev"
# ★★ …and the RSP's arrival STARTS the bundled RSP service — only machines with an RSP ever run it. Whole
#    device only (not each interface). The unit skips itself when a system SDRplay service is installed.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1df7", TAG+="systemd", ENV{SYSTEMD_WANTS}+="vibeserver-rsp.service"
