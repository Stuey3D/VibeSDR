# ★★★ THE BUILD ROOT, AS A FILE RATHER THAN AS FOLKLORE.
#
#     The build root used to be a chroot on the Pi, created once by hand and never written down.
#     That was survivable until the Pi became the machine we WIPE to test fresh installs: two
#     formats in one evening took the chroot, the signing key and the source with them, and the
#     rebuild-from-memory shipped 3.0.0-2 with the settings wizard compiled out, because
#     libncursesw-dev was not on the list anyone remembered. A build environment that only exists
#     in somebody's head is one bad evening from shipping a broken release. (2026-08-08)
#
# ★★ BOOKWORM, AND THAT IS THE ENTIRE POINT. CPack derives Depends: from whatever the build
#    machine links against, so building on trixie stamped `libc6 (>= 2.38)` and made the package
#    uninstallable on Debian 12 and Ubuntu 22.04 — it cost a user their working OpenWebRX. glibc
#    is backward compatible, so a binary built against 2.36 runs on 2.41 but never the reverse.
#    Do not "update" this to a newer base image.
#
# ★ arm64 native on Apple Silicon, so this is a real build and not emulation.
FROM debian:bookworm-slim

# ★★★ EVERY ONE OF THESE IS LOAD-BEARING, and the ones that look optional are the dangerous ones:
#     CMake does not fail without them, it QUIETLY DROPS THE FEATURE and prints a status line.
#       libncursesw5-dev  → the settings wizard. Without it `vibeserver` starts a daemon instead
#                           of the setup screen, which is the one command new owners are told to
#                           type. This is what 3.0.0-2 shipped without.
#       libopus-dev       → compressed audio.
#       libfftw3-dev      → the DSP.
#       librtlsdr/libusb  → the dongle, driven directly.
#     VIBESERVER_STRICT_RADIOS=ON now turns the silent ones into hard errors, but the real fix is
#     that the list lives here instead of in a memory.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config file ca-certificates curl \
      librtlsdr-dev libusb-1.0-0-dev libopus-dev libfftw3-dev libncursesw5-dev \
      dpkg-dev apt-utils gnupg git rsync xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ★★ SDRplay headers: STAGED FROM THE BUILD HOST, never downloaded. The API is dlopen'd at
#    runtime, so the headers are all the build needs — and SDRplay's licence is theirs, which is
#    why the library itself can never be a dependency of our package, and why these headers are
#    NOT committed to this repository either.
#
# ★★★ THIS USED TO `curl` THEM FROM sdrplay.com AND THAT URL IS NOW A 404 (found 2026-08-20, on
#     the first amd64 build). Their whole /software/ path is gone and downloads sit behind a
#     recaptcha form, so no version number would have fixed it. The arm64 image had the step
#     CACHED, which is the only reason releases kept working — a clean rebuild on ANY architecture
#     would have failed exactly the same way, at some far less convenient moment.
#
# ★★ A BUILD MUST NOT DEPEND ON A THIRD PARTY'S WEBSITE STILL BEING SHAPED THE WAY IT WAS. The
#    headers come from the publishing machine now (publish-apt-docker.sh stages them into this
#    directory from /usr/local/include, where SDRplay's own installer puts them), so the build is
#    reproducible for as long as we have them — which is the same condition as having the source.
#
# ★ Without these, RSP support compiles out silently — which shipped once already, and is why
#   VIBESERVER_STRICT_RADIOS exists.
COPY sdrplay-inc/ /usr/local/include/
RUN ls /usr/local/include/sdrplay_api.h \
    && grep -q SDRPLAY_API_VERSION /usr/local/include/sdrplay_api.h

# ★★★ OUR OWN librtlsdr, BUILT HERE AND SHIPPED IN THE PACKAGE. Debian's is 2.0.2 and does not
#     know the RTL-SDR Blog V4L ("V4 Lite", R828S) at all — it sees a plain R820T, which "works" on
#     VHF and fails confusingly on HF. Waiting for a distribution to ship a driver means hardware
#     support arrives on THEIR release cycle rather than ours, and the V4 would have been the same
#     story.
# ★★ THIS IS THE MODEL THE OTHER TWO PLATFORMS ALREADY USE. Android vendors the .so; macOS links it
#     statically so one .app works with nothing installed. Linux was the odd one out, at the mercy
#     of whatever the distro had. Everything except SDRplay — whose API is theirs and is dlopen'd —
#     is now self-contained on all three (Stuart, 2026-08-15).
# ★ SHARED, not static: forcing static on Linux fails on Debian's libusb-1.0.a, which needs udev
#   symbols that are not pulled in (Raspberry Pi, 2026-07-31). Our .so links the system libusb
#   dynamically, exactly as Debian's does.
# ★ Installed to a PREFIX OF OUR OWN so it cannot be confused with, or overwrite, the system copy.
#   The build picks it up from there and the package ships it to /usr/lib/vibeserver.
ARG RTLSDR_TAG=797f814
RUN git clone --quiet https://github.com/osmocom/rtl-sdr.git /tmp/rtlsdr \
    && git -C /tmp/rtlsdr checkout --quiet "${RTLSDR_TAG}" \
    && cmake -S /tmp/rtlsdr -B /tmp/rtlsdr/b -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=/opt/vibe-rtlsdr -DBUILD_SHARED_LIBS=ON \
             -DDETACH_KERNEL_DRIVER=ON \
    && cmake --build /tmp/rtlsdr/b --target rtlsdr -j"$(nproc)" \
    # ★ COPIED, NOT `cmake --install`. The upstream install target also wants librtlsdr.a and the
    #   rtl_* command-line tools, none of which we ship — building them to satisfy an install rule
    #   is work and dependencies for nothing. Two things are needed: the shared library (with its
    #   SONAME symlinks, which the loader follows) and the header the build compiles against.
    && mkdir -p /opt/vibe-rtlsdr/lib /opt/vibe-rtlsdr/include \
    && cp -a /tmp/rtlsdr/b/src/librtlsdr.so* /opt/vibe-rtlsdr/lib/ \
    && cp /tmp/rtlsdr/include/rtl-sdr.h /tmp/rtlsdr/include/rtl-sdr_export.h /opt/vibe-rtlsdr/include/ \
    && rm -rf /tmp/rtlsdr \
    # ★ VERIFY, do not assume: a library without V4L support is the whole reason this step exists,
    #   and a silent fallback to Debian's would look identical from the outside.
    && strings /opt/vibe-rtlsdr/lib/librtlsdr.so | grep -q "Blog V4L" \
    && echo "bundled librtlsdr has RTL-SDR Blog V4L support"

WORKDIR /work
