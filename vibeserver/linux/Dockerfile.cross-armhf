# ★ armhf by CROSS-COMPILE on a native arm64 bookworm host — see armhf-toolchain.cmake.
#   Same libraries as Dockerfile.build, installed for :armhf beside the host's own.
# ★★★ NO DISTRIBUTION RADIO OR CODEC LIBRARIES (2026-10-18) — see Dockerfile.build. Only ncurses (linked
#     statically) and libc6:armhf (dpkg-shlibdeps reads ITS shlibs file for the one Depends we keep) are
#     installed for armhf; build-deps.sh builds libusb/libopus/librtlsdr from pinned source, once for
#     ARMv7+NEON and once for ARMv6 against the Raspbian sysroot.
FROM debian:bookworm-slim
RUN dpkg --add-architecture armhf && apt-get update && apt-get install -y --no-install-recommends \
      build-essential crossbuild-essential-armhf cmake pkg-config file ca-certificates curl \
      libncursesw5-dev:armhf libc6:armhf bzip2 \
      dpkg-dev apt-utils gnupg git rsync xz-utils binutils-arm-linux-gnueabihf \
      clang lld mmdebstrap \
    && rm -rf /var/lib/apt/lists/*
COPY sdrplay-inc/ /usr/local/include/
COPY armhf-toolchain.cmake /opt/armhf-toolchain.cmake
# ★ The ARMv7+NEON prefix the armhf package links (see build-deps.sh; same pins as the Mac).
COPY build-deps.sh /opt/build-deps.sh
# ★ Two compile jobs, niced: the Mac overheats and the Lenovo is a live receiver.
ARG DEPS_JOBS=2
RUN JOBS=${DEPS_JOBS} nice -n 10 bash /opt/build-deps.sh /opt/vibe-deps armhf
# ★★★ THE ARMv6 HALF — a RASPBIAN bookworm sysroot (see armv6-toolchain.cmake). `extract` unpacks
#     packages without running any of them, so no emulation is needed to build a foreign root.
# ★★★ THE ARCHIVE KEY IS COMMITTED, NOT FETCHED. It used to be curl'd over plain http and trusted
#     as-is — so anyone on the path could hand us their own key and then sign their own sysroot,
#     and every ARMv6 binary we ship links against that sysroot. raspbian-archive-keyring.gpg is
#     the dearmored raspbian.public.key, taken from the image that built 5.6.x (2026-09-29), and
#     its fingerprint is checked here against the published one before mmdebstrap may use it.
#     Mike Thompson (Raspberry Pi Debian armhf ARMv6+VFP), rsa2048 2012-04-01.
# ★ https to the mirror as well: the key protects the Release file, https protects the rest.
COPY armv6-toolchain.cmake /opt/armv6-toolchain.cmake
COPY raspbian-archive-keyring.gpg /opt/raspbian-archive-keyring.gpg
# ★★ HTTP, NOT HTTPS (2026-10-04): raspbian.raspberrypi.com REFUSES port 443 (connection refused), so the audit's https
#    mirror broke every armhf image build — found cutting RC4. Integrity never depended on the transport: apt checks the
#    signed InRelease against the pinned keyring whose fingerprint is verified just below.
ARG RASPBIAN_KEY_FPR=A0DA38D0D76E8B5D638872819165938D90FDDD2E
RUN fpr="$(gpg --show-keys --with-colons /opt/raspbian-archive-keyring.gpg | awk -F: '$1=="fpr"{print $10; exit}')" \
    && { [ "$fpr" = "${RASPBIAN_KEY_FPR}" ] || { echo "!! raspbian key fingerprint '$fpr', expected ${RASPBIAN_KEY_FPR} — refusing"; exit 1; }; } \
    && mmdebstrap --variant=extract --architectures=armhf --keyring=/opt/raspbian-archive-keyring.gpg \
         --include=libc6-dev,libstdc++-12-dev,libgcc-12-dev,libncurses-dev,libatomic1 \
         bookworm /opt/rpi-sysroot http://raspbian.raspberrypi.com/raspbian \
    && rm -rf /opt/rpi-sysroot/var/cache/apt /opt/rpi-sysroot/var/lib/apt/lists \
    && ls /opt/rpi-sysroot/usr/lib/gcc/arm-linux-gnueabihf/12/crtbegin.o
# ★ And the ARMv6 prefix, built the same way — an ARMv7 object inside an ARMv6 binary is the same crash
#   as an ARMv7 binary, just later. build-deps.sh checks every object is Tag_CPU_arch v6.
RUN JOBS=${DEPS_JOBS} nice -n 10 bash /opt/build-deps.sh /opt/vibe-deps-v6 armv6
WORKDIR /work
