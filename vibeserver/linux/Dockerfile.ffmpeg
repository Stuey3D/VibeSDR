# ★ The build root for the BUNDLED FFmpeg (android/app/src/main/cpp/sdr-kit/build-ffmpeg-linux.sh, V12 2026-10-29).
#   ONE native linux/arm64 bookworm container on the Mac that CROSS-compiles all five binaries the Linux packages carry:
#   amd64, i386, arm64 (native), armhf (ARMv7 + NEON, the Pi 2) and armv6 (Pi Zero / Pi 1, against the Raspbian sysroot,
#   the same recipe as Dockerfile.cross-armhf). Cross compilers, never an emulated container — see build-debs-remote.sh.
# ★★ Bookworm, like every other build image: the binaries link glibc only (libc + libm), and the floor check in the
#    script holds them to GLIBC_2.35 (Ubuntu 22.04), the same floor as vibeserver itself.
# ★ nasm assembles FFmpeg's x86 SIMD (amd64 + i386) — architecture-free host tool. qemu-user is for the script's smoke
#   test and the profiling run only (running a finished binary, never compiling under emulation).
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential make pkg-config file ca-certificates xz-utils bzip2 \
      gcc-x86-64-linux-gnu libc6-dev-amd64-cross \
      gcc-i686-linux-gnu libc6-dev-i386-cross \
      gcc-arm-linux-gnueabihf libc6-dev-armhf-cross binutils-arm-linux-gnueabihf \
      nasm clang lld mmdebstrap gnupg qemu-user \
    && rm -rf /var/lib/apt/lists/*
# ★★★ THE ARMv6 SYSROOT — Raspbian's own runtime objects, with the archive key COMMITTED and its fingerprint checked,
#     exactly as Dockerfile.cross-armhf does it (see the notes there: why committed, why http).
COPY raspbian-archive-keyring.gpg /opt/raspbian-archive-keyring.gpg
ARG RASPBIAN_KEY_FPR=A0DA38D0D76E8B5D638872819165938D90FDDD2E
RUN fpr="$(gpg --show-keys --with-colons /opt/raspbian-archive-keyring.gpg | awk -F: '$1=="fpr"{print $10; exit}')" \
    && { [ "$fpr" = "${RASPBIAN_KEY_FPR}" ] || { echo "!! raspbian key fingerprint '$fpr', expected ${RASPBIAN_KEY_FPR} — refusing"; exit 1; }; } \
    && mmdebstrap --variant=extract --architectures=armhf --keyring=/opt/raspbian-archive-keyring.gpg \
         --include=libc6-dev,libgcc-12-dev,libatomic1 \
         bookworm /opt/rpi-sysroot http://raspbian.raspberrypi.com/raspbian \
    && rm -rf /opt/rpi-sysroot/var/cache/apt /opt/rpi-sysroot/var/lib/apt/lists \
    && ls /opt/rpi-sysroot/usr/lib/gcc/arm-linux-gnueabihf/12/crtbegin.o
# ★★ ABSOLUTE SYMLINKS POINT OUT OF THE SYSROOT. libm.so -> /lib/arm-linux-gnueabihf/libm.so.6 is dangling here, so lld
#    silently took libm.a instead — and FFmpeg's configure then found no cbrt/cbrtf (static libm needs libc.a's __frexpf)
#    and the build broke on its own fallbacks. Re-rooted inside /opt/rpi-sysroot, -lm is the shared libm.so.6 again.
RUN find /opt/rpi-sysroot -type l -lname '/*' | while read -r l; do ln -sfn "/opt/rpi-sysroot$(readlink "$l")" "$l"; done \
    && test -e /opt/rpi-sysroot/usr/lib/arm-linux-gnueabihf/libm.so
WORKDIR /work
