#!/bin/sh
# VibeServer — post-install.
# ★★ THE THREE THINGS THAT WERE DONE BY HAND ON THE PI, and every one of them is a silent
#    failure if skipped: without the udev reload a fresh install cannot open the radio until
#    the next reboot; without plugdev membership the same; without a config the daemon has no
#    settings to read.
set -e

case "$1" in
  configure)
    # ── 0. THE SERVICE ACCOUNT ───────────────────────────────────────────────
    # ★★★ NOTHING ELSE CREATES IT, AND THE UNIT CANNOT START WITHOUT IT. The service declares
    #     User=vibeserver, so a box where that account does not exist fails at
    #     "Failed to determine user credentials" before a line of our code runs — and every chown
    #     below silently no-ops (they are all `|| true`), leaving /etc/vibeserver root-owned so
    #     the browser Save would fail later too.
    #     ★ This survived because the account was created BY HAND on the development Pi months
    #       ago, so every install since has been an upgrade onto a box that already had it. Only a
    #       genuinely fresh machine can catch it, which is the entire argument for testing one.
    #     ★★ --system: no login, no home to speak of, no password. This account exists to own a
    #        config file and a state directory, and nothing else should be possible with it.
    if ! getent passwd vibeserver >/dev/null; then
      adduser --system --group --no-create-home \
              --home /var/lib/vibeserver \
              --gecos "VibeServer SDR" vibeserver >/dev/null 2>&1 \
        || useradd --system --user-group --no-create-home \
                   --home-dir /var/lib/vibeserver \
                   --shell /usr/sbin/nologin vibeserver >/dev/null 2>&1 \
        || true
    fi
    # ★ The radio is USB, and the daemon is not root: without plugdev the service user cannot open
    #   the device even though the udev rules below grant the group.
    if getent group plugdev >/dev/null; then
      adduser vibeserver plugdev >/dev/null 2>&1 || true
    fi

    # ── 1. The config: NEVER clobber the user's edits ────────────────────────
    # ★ Copied from /usr/share on FIRST install only. Shipping it as a packaged file would let
    #   an upgrade overwrite the name, locator and admin password someone set months ago.
    # ★★ THE SERVER WRITES ITS OWN CONFIG NOW (config.json, saved from the browser setup page),
    #    so the directory must belong to the service user — not just be readable by it. Without
    #    this, Save fails with a permission error the owner cannot act on.
    mkdir -p /etc/vibeserver
    chown vibeserver:vibeserver /etc/vibeserver 2>/dev/null || true
    chmod 755 /etc/vibeserver
    # ★ And the config itself holds the admin password and PIN in clear: owner-only, always.
    if [ -e /etc/vibeserver/config.json ]; then
      chown vibeserver:vibeserver /etc/vibeserver/config.json 2>/dev/null || true
      chmod 600 /etc/vibeserver/config.json
    fi

    if [ ! -e /etc/vibeserver/vibeserver.conf ]; then
      mkdir -p /etc/vibeserver
      cp /usr/share/vibeserver/vibeserver.conf /etc/vibeserver/vibeserver.conf
      chmod 644 /etc/vibeserver/vibeserver.conf
    fi

    # ── 2. USB access without root ───────────────────────────────────────────
    # ★ The rules file is installed by the package; udev must be told to re-read it, or the
    #   radio stays root-only until reboot — which on a headless box in a cupboard reads as
    #   "VibeServer cannot see my SDR".
    if [ -x /bin/udevadm ] || [ -x /sbin/udevadm ] || command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload-rules >/dev/null 2>&1 || true
      udevadm trigger --subsystem-match=usb >/dev/null 2>&1 || true
    fi

    # ★★ plugdev may not exist on a minimal Debian — create it rather than assume. The udev
    #    rules grant the group, so a missing group means the rules grant nothing at all.
    if ! getent group plugdev >/dev/null; then
      addgroup --system plugdev >/dev/null 2>&1 || true
    fi
    # ★ Again here, because the group may not have existed at step 0 on a minimal image. Both
    #   calls are idempotent; missing this one costs the daemon its access to the radio.
    adduser vibeserver plugdev >/dev/null 2>&1 || true
    # ★ The invoking user is the one who will run `vibeserver` interactively for the TUI.
    #   SUDO_USER is who typed `sudo apt install`; without this they must know to add
    #   themselves, which is exactly the sort of undocumented step that sinks an install.
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
      adduser "$SUDO_USER" plugdev >/dev/null 2>&1 || true
      echo "VibeServer: added $SUDO_USER to 'plugdev' — log out and back in for it to take effect."
    fi

    # ── 2b. Drop the old sudo rule, if an earlier 2.0 build installed one ───
    # ★ 2.0.0-4 shipped a /etc/sudoers.d/vibeserver that could never work (NoNewPrivileges=yes
    #   makes sudo impossible for this service). Leaving it behind would leave a real privilege
    #   grant lying around for no benefit at all.
    rm -f /etc/sudoers.d/vibeserver

    # ── 2b. THE PI'S USB CURRENT BUDGET ──────────────────────────────────────
    #
    # ★★★ SEVERAL SDRs NEED MORE CURRENT THAN A PI 5 HANDS OUT BY DEFAULT. Without this the board
    #     caps total USB draw and devices drop off under load — it produced 66 over-current events
    #     on the development Pi with three radios attached, and cost most of an afternoon because
    #     it presents as a USB BANDWIDTH problem, which it is not: the same machine had run several
    #     RSPs and dongles happily before. Nobody installing a multi-radio receiver package should
    #     have to discover that for themselves, so it is set here rather than documented.
    # ★★ IDEMPOTENT, and it never edits a line it did not write: an existing setting is left alone
    #    (the owner may have set 0 deliberately, and a package that overrules a deliberate choice
    #    is worse than one that does nothing). Appended once, with a backup taken first.
    # ★ Pi only — the file does not exist elsewhere, and the setting means nothing there.
    for BOOTCFG in /boot/firmware/config.txt /boot/config.txt; do
      [ -f "$BOOTCFG" ] || continue
      if grep -q '^[[:space:]]*usb_max_current_enable' "$BOOTCFG"; then
        echo "VibeServer: usb_max_current_enable is already set in $BOOTCFG — left as it is."
      else
        cp -n "$BOOTCFG" "${BOOTCFG}.bak-vibeserver" 2>/dev/null || true
        {
          echo ""
          echo "# Added by VibeServer: several SDRs draw more than the default USB budget allows."
          echo "# Without this the Pi caps total USB current and devices drop out under load."
          echo "usb_max_current_enable=1"
        } >> "$BOOTCFG"
        echo "VibeServer: enabled the Pi's full USB current budget in $BOOTCFG."
        echo "VibeServer: this needs a REBOOT before several radios will run reliably."
      fi
      break
    done

    # ── 3. systemd ───────────────────────────────────────────────────────────
    # ★ Enabled but NOT started: the user has not chosen a radio, a name or a location yet, and
    #   an unconfigured server that starts itself and fails is a worse first impression than one
    #   that waits to be asked. `vibeserver` with no arguments opens the TUI to set that up.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl enable vibeserver.service >/dev/null 2>&1 || true
      # ★★ THE WATCHER MUST BE ENABLED OR THE MAINTENANCE BUTTONS DO NOTHING. The daemon writes
      #    its request happily; without this unit running, nothing is watching for it, and the
      #    admin page reports success for an action that never happens — worse than an error.
      systemctl enable --now vibeserver-maintenance.path >/dev/null 2>&1 || true
      # ★★ THE OTHER RADIOS. Enabled, and RUN NOW on an upgrade so a machine that was already
      #    serving several comes back serving several — without this, the second and third radios
      #    would quietly stay down until the next reboot and the owner would have no idea why.
      #    On a fresh install it finds nothing configured and exits, which is correct.
      systemctl enable vibeserver-radios.service >/dev/null 2>&1 || true
      systemctl start  vibeserver-radios.service >/dev/null 2>&1 || true
      # ★ The wizard enables and starts the service itself (tui.cpp), so telling people to run
      #   systemctl afterwards is wrong — and it is the sort of wrong that makes someone think a
      #   step failed when it simply was not needed (Stuart hit exactly this, 2026-08-06).
      # ★★★ AN UPGRADE IS NOT AN INSTALL. This told a server that has been running for weeks to
      #     "log out and back in, then run 'vibeserver' to set it up" — advice that is not merely
      #     unnecessary but alarming: it reads as though the upgrade had reset the machine, and it
      #     invites an owner to re-run a wizard over a working configuration (Stuart, 2026-08-13:
      #     "this line about logging out and in and setting up with vibeserver is incorrect for
      #     updates as the server is already setup").
      # ★★ dpkg tells us which this is: $2 is the OLD version on an upgrade and EMPTY on a first
      #    install. The group change is the only reason to log out at all, and that only happens
      #    once — so the sentence about it belongs only to the install that made it.
      if [ -z "${2:-}" ]; then
        echo "VibeServer: installed. Log out and back in, then run 'vibeserver' to set it up."
      elif [ -f /etc/vibeserver/vibeserver.conf ]; then
        echo "VibeServer: upgraded to $(dpkg-query -W -f='${Version}' vibeserver 2>/dev/null). Your settings are unchanged."
      else
        echo "VibeServer: upgraded. Run 'vibeserver' to set it up."
      fi
    fi
    ;;
esac
exit 0
