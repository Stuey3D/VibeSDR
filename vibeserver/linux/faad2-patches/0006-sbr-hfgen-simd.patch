+#if !defined(FIXED_POINT) && !defined(VIBE_FAAD_STOCK)
+/* VibeSDR (2026-10-26): the covariance sums of auto_correlation for FOUR adjacent QMF bands at once (vibe_simd4f.h) —
+ * the same sums in the same order per lane — and the prediction coefficients from them exactly as calc_prediction_coef
+ * computes them. hf_generation fills its alpha tables four bands at a time with these before patching. */
+static void vibe_acorr4(sbr_info *sbr, acorr_coef ac[4], qmf_t buffer[MAX_NTSRHFG][64], uint8_t bd, uint8_t len)
+{
+    const real_t rel = 1 / (1 + 1e-6f);
+    const uint8_t offset = sbr->tHFAdj;
+    v4f r01r = v4_dup(0), r01i = v4_dup(0), r02r = v4_dup(0), r02i = v4_dup(0), r11r = v4_dup(0);
+    v4f t1r, t1i, t2r, t2i, t3r, t3i, t4r, t4i, t5r, t5i, x, y;
+    ALIGN real_t o[13][4];
+    int8_t j;
+    uint8_t q;
+    v4_ld2(buffer[offset - 2][bd], t2r, t2i);
+    v4_ld2(buffer[offset - 1][bd], t3r, t3i);
+    t4r = t2r; t4i = t2i; t5r = t3r; t5i = t3i;
+    t1r = t1i = v4_dup(0);
+    for (j = offset; j < len + offset; j++)
+    {
+        t1r = t2r; t1i = t2i; t2r = t3r; t2i = t3i;
+        v4_ld2(buffer[j][bd], t3r, t3i);
+        r01r = v4_add(r01r, v4_add(v4_mul(t3r, t2r), v4_mul(t3i, t2i)));
+        r01i = v4_add(r01i, v4_sub(v4_mul(t3i, t2r), v4_mul(t3r, t2i)));
+        r02r = v4_add(r02r, v4_add(v4_mul(t3r, t1r), v4_mul(t3i, t1i)));
+        r02i = v4_add(r02i, v4_sub(v4_mul(t3i, t1r), v4_mul(t3r, t1i)));
+        r11r = v4_add(r11r, v4_add(v4_mul(t2r, t2r), v4_mul(t2i, t2i)));
+    }
+    x = v4_add(v4_sub(r01r, v4_add(v4_mul(t3r, t2r), v4_mul(t3i, t2i))), v4_add(v4_mul(t5r, t4r), v4_mul(t5i, t4i)));
+    y = v4_add(v4_sub(r01i, v4_sub(v4_mul(t3i, t2r), v4_mul(t3r, t2i))), v4_sub(v4_mul(t5i, t4r), v4_mul(t5r, t4i)));
+    v4_st(o[0], x); v4_st(o[1], y);
+    v4_st(o[2], v4_add(v4_sub(r11r, v4_add(v4_mul(t2r, t2r), v4_mul(t2i, t2i))), v4_add(v4_mul(t4r, t4r), v4_mul(t4i, t4i))));
+    v4_st(o[3], r01r); v4_st(o[4], r01i); v4_st(o[5], r02r); v4_st(o[6], r02i); v4_st(o[7], r11r);
+    for (q = 0; q < 4; q++)
+    {
+        RE(ac[q].r12) = o[0][q]; IM(ac[q].r12) = o[1][q]; RE(ac[q].r22) = o[2][q];
+        RE(ac[q].r01) = o[3][q]; IM(ac[q].r01) = o[4][q];
+        RE(ac[q].r02) = o[5][q]; IM(ac[q].r02) = o[6][q];
+        RE(ac[q].r11) = o[7][q];
+        ac[q].det = MUL_R(RE(ac[q].r11), RE(ac[q].r22)) - MUL_F(rel, (MUL_R(RE(ac[q].r12), RE(ac[q].r12)) + MUL_R(IM(ac[q].r12), IM(ac[q].r12))));
+    }
+}
+/** calc_prediction_coef's arithmetic, from a ready acorr_coef */
+static void vibe_alpha_from_ac(const acorr_coef *pac, complex_t *alpha_0, complex_t *alpha_1, uint8_t k)
+{
+    real_t tmp;
+    const acorr_coef ac = *pac;
+    if (ac.det == 0)
+    {
+        RE(alpha_1[k]) = 0;
+        IM(alpha_1[k]) = 0;
+    } else {
+        tmp = REAL_CONST(1.0) / ac.det;
+        RE(alpha_1[k]) = (MUL_R(RE(ac.r01), RE(ac.r12)) - MUL_R(IM(ac.r01), IM(ac.r12)) - MUL_R(RE(ac.r02), RE(ac.r11))) * tmp;
+        IM(alpha_1[k]) = (MUL_R(IM(ac.r01), RE(ac.r12)) + MUL_R(RE(ac.r01), IM(ac.r12)) - MUL_R(IM(ac.r02), RE(ac.r11))) * tmp;
+    }
+    if (RE(ac.r11) == 0)
+    {
+        RE(alpha_0[k]) = 0;
+        IM(alpha_0[k]) = 0;
+    } else {
+        tmp = 1.0f / RE(ac.r11);
+        RE(alpha_0[k]) = -(RE(ac.r01) + MUL_R(RE(alpha_1[k]), RE(ac.r12)) + MUL_R(IM(alpha_1[k]), IM(ac.r12))) * tmp;
+        IM(alpha_0[k]) = -(IM(ac.r01) + MUL_R(IM(alpha_1[k]), RE(ac.r12)) - MUL_R(RE(alpha_1[k]), IM(ac.r12))) * tmp;
+    }
+    if ((MUL_R(RE(alpha_0[k]),RE(alpha_0[k])) + MUL_R(IM(alpha_0[k]),IM(alpha_0[k])) <= REAL_CONST(16)) &&
+        (MUL_R(RE(alpha_1[k]),RE(alpha_1[k])) + MUL_R(IM(alpha_1[k]),IM(alpha_1[k])) <= REAL_CONST(16)))
+        return;
     RE(alpha_0[k]) = 0;
     IM(alpha_0[k]) = 0;
     RE(alpha_1[k]) = 0;
     IM(alpha_1[k]) = 0;
 }
+/** hf_generation's prediction coefficients for every source band its patches read, four bands at a time */
+static void vibe_alphas4(sbr_info *sbr, qmf_t Xlow[MAX_NTSRHFG][64], complex_t *alpha_0, complex_t *alpha_1, uint8_t *vibe_have)
+{
+    uint8_t i;
+    memset(vibe_have, 0, 64);
+    for (i = 0; i < sbr->noPatches; i++)
+    {
+        uint8_t p0 = sbr->patchStartSubband[i], pn = sbr->patchNoSubbands[i], pp;
+        for (pp = p0; pp + 4 <= p0 + pn && pp + 4 <= 64; pp += 4)
+        {
+            acorr_coef ac4[4];
+            uint8_t q;
+            if (vibe_have[pp] && vibe_have[pp + 1] && vibe_have[pp + 2] && vibe_have[pp + 3]) continue;
+            vibe_acorr4(sbr, ac4, Xlow, pp, sbr->numTimeSlotsRate + 6);
+            for (q = 0; q < 4; q++) { vibe_alpha_from_ac(&ac4[q], alpha_0, alpha_1, (uint8_t)(pp + q)); vibe_have[pp + q] = 1; }
+        }
+    }
+}
+#endif
 #else
 static void calc_prediction_coef_lp(sbr_info *sbr, qmf_t Xlow[MAX_NTSRHFG][64],
                                     complex_t *alpha_0, complex_t *alpha_1, real_t *rxx)
