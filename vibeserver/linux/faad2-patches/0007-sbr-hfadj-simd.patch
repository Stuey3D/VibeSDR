 #include "sbr_hfadj.h"
 
 #include "sbr_noise.h"
+#if !defined(FIXED_POINT)
+#include "vibe_simd4f.h"
+#endif
 
 
 /* static function declarations */
@@ -1631,8 +1634,62 @@
             memcpy(sbr->G_temp_prev[ch][sbr->GQ_ringbuf_index[ch]], adj->G_lim_boost[l], sbr->M*sizeof(real_t));
             memcpy(sbr->Q_temp_prev[ch][sbr->GQ_ringbuf_index[ch]], adj->Q_M_lim_boost[l], sbr->M*sizeof(real_t));
 
-            for (m = 0; m < sbr->M; m++)
+            m = 0;
+#if !defined(FIXED_POINT) && !defined(SBR_LOW_POWER) && !defined(VIBE_FAAD_STOCK)
+            /* VibeSDR (2026-10-26): four QMF bands at a time — the smoothed gains (the same five-slot ring for every band),
+             * the noise floor from V[] (each band its own index), and the sinusoid — the stock arithmetic per lane.
+             * The remainder of fewer than four, and the bitstream's 3/42 extension case, as stock below. */
+            if (!(sbr->bs_extension_id == 3 && sbr->bs_extension_data == 42))
             {
+                const v4f vphr = v4_dup((real_t)phi_re[fIndexSine]);
+                const v4f vphi = v4_dup((real_t)phi_im[fIndexSine]);
+                for (; m + 4 <= sbr->M; m += 4)
+                {
+                    ALIGN real_t vr[4], vi[4], qz[4], rv[4];
+                    v4f g, q, xr, xi, smb;
