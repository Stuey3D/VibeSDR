+                        }
+                    } else {
+                        g = v4_ld(sbr->G_temp_prev[ch][sbr->GQ_ringbuf_index[ch]] + m);
+                        q = v4_ld(sbr->Q_temp_prev[ch][sbr->GQ_ringbuf_index[ch]] + m);
+                    }
+                    for (j = 0; j < 4; j++)
+                    {
+                        const uint16_t f = (uint16_t)((fIndexNoise + 1 + j) & 511);
+                        vr[j] = RE(V[f]); vi[j] = IM(V[f]);
+                        qz[j] = (adj->S_M_boost[l][m + j] != 0 || no_noise) ? 0.f : 1.f;
