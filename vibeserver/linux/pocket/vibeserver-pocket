def advert_from_nm(security):
    """★ The second opinion: nmcli's SECURITY column, for a network iw had nothing on. No MFP in it."""
    s = (security or "").upper().split()
    if not s or s == ["--"]:
        kind, words = "open", ADVERT_WORDS["open"]
    elif "802.1X" in s or s == ["OWE"]:
        kind, words = "other", ADVERT_WORDS["other"]
    elif "WPA3" in s and "WPA2" not in s and "WPA1" not in s:
        kind, words = "wpa3", ADVERT_WORDS["wpa3"]
    elif "WPA3" in s:
        kind, words = "transition", ADVERT_WORDS["transition"]
    elif "WPA2" in s:
        kind, words = "wpa2-mfpc", "WPA2 (PMF not reported)"   # ★ PMF unknown: optional joins both kinds of WPA2
    else:
        kind, words = "wpa1", ADVERT_WORDS["wpa1"]
    return {"kind": kind, "words": words + " (nmcli)", "n": 0, "mixed": False, "fp": "nm:" + " ".join(s)}


def plan_for(adv):
    """What advertises `adv` → the profile to ask with: {"km": "wpa-psk"|"sae"|"", "pmf": PMF_*} or None (leave the
    profile alone: open, or not a password network). adv None = not heard → wpa-psk + PMF optional."""
    kind = adv["kind"] if adv else None
    if kind in ("open", "other"):
        return None
    return {"wpa3": {"km": "sae", "pmf": PMF_REQUIRED},
            "transition": {"km": "wpa-psk", "pmf": PMF_OPTIONAL},
            "wpa2-mfpr": {"km": "wpa-psk", "pmf": PMF_REQUIRED},
            "wpa2-mfpc": {"km": "wpa-psk", "pmf": PMF_OPTIONAL},
            "wpa2": {"km": "wpa-psk", "pmf": PMF_DISABLE},
            "wpa1": {"km": "wpa-psk", "pmf": PMF_DISABLE}}.get(kind, {"km": "wpa-psk", "pmf": PMF_OPTIONAL})


PLAN_OPTIONAL = {"km": "wpa-psk", "pmf": PMF_OPTIONAL}
PLAN_OFF = {"km": "wpa-psk", "pmf": PMF_DISABLE}


def ladder_of(plan):
    """★★ THE SAFETY NET after a refusal: every setting still to try, in order, after `plan` — the whole ladder, every
    time (Stuart, 2026-10-21: a known network is no reason to give up; "the same SSID might now have different security
    settings"). SAE-only or PMF required → wpa-psk + PMF optional (SAE and PSK both offered) → PMF off (plain WPA2-PSK);
    PMF optional → off; PMF off → optional (a network that needs PMF but did not say so, or was not heard — Stuart's
    iPhone, 2026-10-21)."""
    plan = plan or PLAN_OPTIONAL
    if plan.get("km") == "sae" or plan.get("pmf") == PMF_REQUIRED:
        rest = [PLAN_OPTIONAL, PLAN_OFF]
    elif plan.get("pmf") == PMF_DISABLE:
        rest = [PLAN_OPTIONAL]
    else:
        rest = [PLAN_OFF]
    return [dict(p) for p in rest if p != plan]


def plan_words(plan):
    """A profile's security in the history's words."""
    if not plan or not plan.get("km"):
        return "open"
    km, pmf = plan["km"], plan.get("pmf") or PMF_DEFAULT
    if km == "sae":
        return "WPA3 (SAE), PMF required" if pmf == PMF_REQUIRED else "WPA3 (SAE), PMF %s" % (
            {"1": "off", "2": "optional"}.get(pmf, "default"))
    return {"1": "WPA2-PSK, PMF off", "2": "WPA2/WPA3 (SAE allowed), PMF optional",
            "3": "WPA2/WPA3, PMF required"}.get(pmf, "WPA2/WPA3 (SAE allowed), PMF default")


def load_wifi_sec(path):
    """What worked, per network: {ssid: {"km", "pmf", "adv" (the kind advertised then), "t"}}; {} when missing."""
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(d, dict):
        return {}
    return {k: v for k, v in d.items() if isinstance(k, str) and isinstance(v, dict)
            and v.get("km") in ("wpa-psk", "sae") and str(v.get("pmf", "")) in ("0", "1", "2", "3")}


def save_wifi_sec(path, d):
    keep = dict(sorted(d.items(), key=lambda kv: -int(kv[1].get("t", 0)))[:WIFI_SEC_KEEP])
    try:
        write_atomic(path, json.dumps(keep, ensure_ascii=False, sort_keys=True), mode=0o600)   # ★ SSIDs: root only
    except OSError:
        pass                                              # ★ no settings partition: it lasts until the restart

