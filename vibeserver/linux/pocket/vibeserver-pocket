def pmf_value(v):
    """nmcli prints PMF as "1", "1 (disable)", "disable", "0 (default)", "2 (optional)"… → "0".."3" ("" unknown)."""
    v = (v or "").strip().lower()
    m = re.match(r"(\d)", v)
    if m:
        return m.group(1)
    return {"default": "0", "disable": "1", "optional": "2", "required": "3"}.get(v.split(" ")[0] if v else "", "")


def join_result(reason):
    """NetworkManager's reason for a failed activation → one word the owner can read in the history."""
    r = reason or ""
    if re.search(r"not be found|not found|no network", r, re.I):
        return "not seen"
    if re.search(r"secret|password|psk|4-way|handshake|authenticat", r, re.I):
        return "auth failed"
    if re.search(r"IP configuration|DHCP|ip-config|no available address", r, re.I):
        return "DHCP failed"
    if re.search(r"timed out|timeout|associat", r, re.I):
        return "assoc timeout"
    return "failed"


def band_of(freq):
    try:
        f = int(freq)
    except (TypeError, ValueError):
        return ""
    return "2.4 GHz" if f < 3000 else ("5 GHz" if f < 5925 else "6 GHz")


def powersave_disabled(v):
    """★ nmcli prints the setting as "2", "2 (disable)" or "disable" depending on its version and output mode; anything
    else ("0 (default)", "3 (enable)", "" for a profile written before the field existed) means the global default,
    which on brcmfmac is ON."""
    return bool(re.match(r"\s*(2\b|disable\b)", v or ""))


# ── What a network advertises (see DETECTION FIRST above) ──────────────────────────────────────
def parse_iw_scan(text):
    """`iw dev <dev> scan dump` (or `scan`) → {ssid: [bss, …]}, one dict per access point heard:
    {"bssid", "freq" (MHz int|None), "signal" (dBm float|None), "privacy" (bool), "rsn" (bool), "wpa" (bool),
     "akm" (set of iw's suite names: "PSK", "SAE", "PSK/SHA-256", "FT/PSK", "FT/SAE", "IEEE 802.1X", "OWE", …),
     "mfpc", "mfpr" (bools)}.
    ★ Defensive: an access point with no SSID line (hidden) is skipped; one printed twice (beacon + probe response IEs)
      has its suites and flags UNITED; lines it does not know are ignored; the RSN capabilities are read from iw's words
      AND its hex (bit 6 = MFPR, bit 7 = MFPC), so an iw that prints only the number is still understood."""
    out = {}
    bss, sect = None, None

    def done(b):
        if b and b.get("ssid") and b["ssid"].strip("\x00"):     # ★ hidden: empty, or NUL bytes in its place
            out.setdefault(b["ssid"], []).append({k: v for k, v in b.items() if k != "ssid"})

    for raw in (text or "").splitlines():
        if raw.startswith("BSS "):
            done(bss)
            m = re.match(r"BSS ([0-9A-Fa-f:]{17})", raw)
            bss = {"bssid": m.group(1).lower() if m else "", "ssid": "", "freq": None, "signal": None,
                   "privacy": False, "rsn": False, "wpa": False, "akm": set(), "mfpc": False, "mfpr": False}
            sect = None
            continue
        if bss is None:
            continue
        line = raw.strip()
        if line.startswith("RSN:"):
            sect, bss["rsn"] = "rsn", True
            line = line[4:].strip()
        elif line.startswith("WPA:"):
            sect, bss["wpa"] = "wpa", True
            line = line[4:].strip()
        elif not line.startswith("*"):
            sect = None
        if sect is None:
            if line.startswith("SSID: ") or line == "SSID:":
                bss["ssid"] = bss["ssid"] or iw_unescape(line[6:])
            elif line.startswith("freq:"):
                m = re.match(r"freq:\s*(\d+)", line)
                bss["freq"] = int(m.group(1)) if m else None
            elif line.startswith("signal:"):
                m = re.match(r"signal:\s*(-?\d+(?:\.\d+)?)", line)
                bss["signal"] = float(m.group(1)) if m else None
            elif line.startswith("capability:"):
                bss["privacy"] = bss["privacy"] or bool(re.search(r"\bPrivacy\b", line))
            continue
        item = line.lstrip("*").strip()
        if item.startswith("Authentication suites:"):
            suites = item.split(":", 1)[1].split()
            # ★ iw writes "IEEE 802.1X" as two words: put them back together.
            joined, i = [], 0
            while i < len(suites):
                if suites[i].endswith("IEEE") and i + 1 < len(suites):     # "IEEE 802.1X", "FT/IEEE 802.1X", …
                    joined.append(suites[i] + " " + suites[i + 1]); i += 2; continue
                joined.append(suites[i]); i += 1
            if sect == "rsn":
                bss["akm"] |= set(joined)
            else:
                bss.setdefault("wpa_akm", set()).update(joined)
        elif item.startswith("Capabilities:") and sect == "rsn":
            bss["mfpc"] = bss["mfpc"] or "MFP-capable" in item
            bss["mfpr"] = bss["mfpr"] or "MFP-required" in item
            m = re.search(r"\(0x([0-9a-fA-F]+)\)", item)
            if m:
                v = int(m.group(1), 16)
                bss["mfpc"] = bss["mfpc"] or bool(v & 0x80)
                bss["mfpr"] = bss["mfpr"] or bool(v & 0x40)
    done(bss)
    return out


_PSK_AKMS = {"PSK", "PSK/SHA-256", "FT/PSK"}
_SAE_AKMS = {"SAE", "FT/SAE", "SAE-EXT-KEY", "FT/SAE-EXT-KEY"}


def advert_kind(b):
    """One access point → what it is, in one word: "open", "wpa1", "wpa3", "transition", "wpa2-mfpr", "wpa2-mfpc",
    "wpa2", or "other" (enterprise, OWE — a password cannot join those)."""
    akm = b.get("akm") or set()
    if not b.get("rsn"):
        if b.get("wpa"):
            return "wpa1" if (b.get("wpa_akm") or {"PSK"}) & {"PSK"} else "other"
        return "wpa1" if b.get("privacy") else "open"      # ★ Privacy with no RSN/WPA element = WEP: still a password
    psk, sae = bool(akm & _PSK_AKMS), bool(akm & _SAE_AKMS)
    if sae and not psk:
        return "wpa3"
    if sae and psk:
        return "transition"
    if not psk:
        return "other"
    if b.get("mfpr") or akm <= {"PSK/SHA-256"}:          # ★ PSK/SHA-256 alone is the 802.11w AKM: PMF it is
        return "wpa2-mfpr" if b.get("mfpr") else "wpa2-mfpc"
    return "wpa2-mfpc" if b.get("mfpc") else "wpa2"


# How each kind is described to the owner (log, join history) — plain words.
ADVERT_WORDS = {
    "open": "open (no password)", "wpa1": "old WPA", "wpa3": "WPA3 only (PMF required)",
    "transition": "WPA2/WPA3", "wpa2-mfpr": "WPA2, PMF required", "wpa2-mfpc": "WPA2, PMF capable",
    "wpa2": "WPA2, no PMF", "other": "enterprise / OWE (not a password network)",
}


def advert_of(bsss):
    """Every access point heard under one name → ONE verdict {"kind", "words", "n" (APs heard), "mixed" (bool)}. The
    strongest decides when they agree; when they disagree (a mesh mid-upgrade, a router's 2.4 and 5 GHz set differently)
    the verdict is "transition" — wpa-psk + PMF optional, which every PSK/SAE access point accepts — because NetworkManager
    may pick any one of them. None for nothing heard."""
    bsss = [b for b in (bsss or []) if isinstance(b, dict)]
    if not bsss:
        return None
    bsss = sorted(bsss, key=lambda b: -(b.get("signal") if b.get("signal") is not None else -999))
    kinds = [advert_kind(b) for b in bsss]
    usable = [k for k in kinds if k not in ("other",)] or kinds
    kind = usable[0]
    mixed = len(set(usable)) > 1
    if mixed:
        kind = "transition" if all(k in ("wpa3", "transition", "wpa2-mfpr", "wpa2-mfpc", "wpa2") for k in usable) \
            else usable[0]
    words = ADVERT_WORDS.get(kind, kind) + (" (access points disagree: %s)" % "/".join(sorted(set(usable))) if mixed else "")
    return {"kind": kind, "words": words, "n": len(bsss), "mixed": mixed, "fp": advert_fingerprint(bsss)}


def advert_fingerprint(bsss):
    """★★ WHAT A PROFILE WAS BUILT FROM, in a few bytes: every distinct (AKM suites, MFPC, MFPR) heard under the name —
    NOT the BSSIDs (Stuart, 2026-10-21: "I have had Meow! over multiple different routers" — a new router or mesh node
    with the same security is the same network to us; the same name with DIFFERENT security is not)."""
    sigs = set()
    for b in bsss:
        if b.get("rsn"):
            s = "+".join(sorted(b.get("akm") or [])) or "-"
            s += "/" + ("R" if b.get("mfpr") else ("C" if b.get("mfpc") else "0"))
        elif b.get("wpa"):
            s = "WPA1"
        else:
            s = "WEP" if b.get("privacy") else "OPEN"
        sigs.add(s)
    return ",".join(sorted(sigs))


