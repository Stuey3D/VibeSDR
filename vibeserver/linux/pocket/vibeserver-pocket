#   terminal. Its presence at boot forgets every saved network and the fallback hotspot, so the
#   OPEN setup hotspot comes back. The admin password is NOT reset by it (see the doc's questions).
RESET_FILES  = ("/boot/firmware/vibeserver-reset-wifi", "/boot/vibeserver-reset-wifi")

NET_PREFIX   = "vibe-net-"          # vibe-net-1 … vibe-net-3, in order
