def log(msg):
    print("vibeserver-pocket: " + msg, flush=True)


# ── Validation (the daemon's rules, again, because this side is root) ──────────────────────────
def valid_ssid(s):
    if not isinstance(s, str) or not s:
        return False
    b = s.encode("utf-8", "surrogatepass")
    return 1 <= len(b) <= 32 and not any(c < 0x20 or c == 0x7F for c in b)


def valid_psk(p):
    if not isinstance(p, str):
        return False
    if len(p) == 64 and re.fullmatch(r"[0-9A-Fa-f]{64}", p):
        return True
    return 8 <= len(p) <= 63 and all(0x20 <= ord(c) <= 0x7E for c in p)


def valid_country(c):
    return isinstance(c, str) and re.fullmatch(r"[A-Z]{2}", c) is not None


def validate_request(req):
    """Returns (clean_request, error). Mirrors vibepocket::parseWifiRequest."""
    if not isinstance(req, dict):
        return None, "not an object"
    nets = req.get("networks", [])
    if not isinstance(nets, list) or len(nets) > 3:
        return None, "networks must be a list of at most three"
    out, seen = [], set()
    for k, n in enumerate(nets, 1):
        if not isinstance(n, dict):
            return None, "network %d is not valid" % k
        ssid, psk = n.get("ssid"), n.get("psk", "")
        keep, hidden = n.get("keep") is True, n.get("hidden") is True
        if not valid_ssid(ssid) or ssid in seen:
            return None, "network %d has a bad or repeated name" % k
        seen.add(ssid)
        if not keep and psk and not valid_psk(psk):
            return None, "network %d has a bad password" % k
        out.append({"ssid": ssid, "psk": "" if keep else (psk or ""), "keep": keep, "hidden": hidden})
    ap = req.get("ap")
    if not isinstance(ap, dict):
        return None, "no hotspot given"
    ap_ssid, ap_psk, ap_keep = ap.get("ssid"), ap.get("psk", ""), ap.get("keep") is True
    if not valid_ssid(ap_ssid) or ap_ssid.lower() == "vibeserver" or ap_ssid in seen:
        return None, "bad hotspot name"
    if not ap_keep and not valid_psk(ap_psk):
        return None, "the hotspot needs a WPA2 password of 8 to 63 characters"
    country = req.get("country", "")
    if country and not valid_country(country):
        return None, "bad country"
    return {"networks": out, "ap": {"ssid": ap_ssid, "psk": "" if ap_keep else ap_psk, "keep": ap_keep},
            "country": country, "switch": req.get("switch") is True}, ""


def read_request_file(path, owner_uid, limit=16 * 1024):
    """★★★ Root reading a file the unprivileged daemon wrote. A link is removed and ignored; only a
    regular file owned by the daemon's user is read, without following a link, without blocking on
    a FIFO, and at most `limit` bytes. The file is DELETED before it is acted on, so a request that
    breaks something can never be read twice. Returns the bytes or None."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    try:
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or \
                (owner_uid is not None and st.st_uid != owner_uid) or st.st_size > limit:
            log("ignoring %s — not a plain file from the vibeserver user" % os.path.basename(path))
            return None
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            data = os.read(fd, limit + 1)
        finally:
            os.close(fd)
        return data if len(data) <= limit else None
    except OSError as e:
        log("could not read %s (%s)" % (os.path.basename(path), e.strerror))
        return None
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


# ── nmcli ──────────────────────────────────────────────────────────────────────────────────────
def terse_split(line):
    """nmcli -t escapes ':' and '\\' inside values. Split on the unescaped colons only."""
    out, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1]); i += 2; continue
        if c == ":":
            out.append("".join(cur)); cur = []; i += 1; continue
        cur.append(c); i += 1
    out.append("".join(cur))
    return out


def iw_unescape(s):
    """iw prints non-printable SSID bytes as \\xNN."""
    b = bytearray()
    i = 0
    while i < len(s):
        if s[i] == "\\" and i + 4 <= len(s) and s[i + 1] == "x":
            try:
                b.append(int(s[i + 2:i + 4], 16)); i += 4; continue
            except ValueError:
                pass
        b.extend(s[i].encode("utf-8")); i += 1
    return b.decode("utf-8", "replace")


# ★★★ EVERY TOOL WE READ SPEAKS UTF-8, IN ENGLISH, WHATEVER THE BOX'S LOCALE (Stuart's road test, 2026-10-14: the phone's
#     hotspot never joined). An iPhone's hotspot is named after the phone — "Stuart’s iPhone", with a CURLY apostrophe
#     (U+2019). nmcli prints through glib's g_print, which CONVERTS to the locale's charset: under a C/POSIX locale (a
#     unit started with no LANG, a locale that was never generated) that apostrophe comes out as "?". The scan would then
#     list "Stuart?s iPhone", a saved network would read back the same way, and a re-save of the Wi-Fi card (keep: the
#     page sends back the name it was shown) would WRITE "Stuart?s iPhone" into NetworkManager — a network that does not
#     exist. C.UTF-8 is built into glibc (no locale-gen needed), so this holds on every image. LANGUAGE/LC_ALL also pin
#     the messages we match on ("Connectivity is now", "Not connected", NM's activation errors) to English.
TOOL_ENV = dict(os.environ, LC_ALL="C.UTF-8", LANG="C.UTF-8", LANGUAGE="")


# ★★★ THE NAME AS TYPED vs THE NAME ON THE AIR (Stuart's road test, 2026-10-14). NetworkManager matches a saved network
#     to a scan BYTE FOR BYTE, and a phone hotspot is the one network an owner must TYPE (it is rarely on when they set
#     the box up). The iPhone's name has a curly apostrophe — "Stuart’s iPhone" — that a Mac keyboard types as ' and an
#     iPhone keyboard (Smart Punctuation) types as ’; dashes and quotes go the same way, a trailing space slips in, and
#     the capitals of "iPhone" are easy to get wrong. Any one of those and the box never joins, with nothing to say why.
#     So a saved name that is NOT on the air is matched to one that IS by this key, and — only when exactly ONE network
#     in range matches — the saved network is corrected to the name on the air (ssid_on_air, Box.correct_ssid). The key
#     is only ever used to FIND that one network; what NetworkManager is given is always the exact name it scanned.
_SSID_FOLD = {}
for _c in "\u2018\u2019\u201a\u201b\u2032\u02bc\u00b4\u0060\uff07":
    _SSID_FOLD[ord(_c)] = "'"
for _c in "\u201c\u201d\u201e\u201f\u2033\uff02":
    _SSID_FOLD[ord(_c)] = '"'
for _c in "\u2010\u2011\u2012\u2013\u2014\u2015\u2212":
    _SSID_FOLD[ord(_c)] = "-"


def ssid_key(s):
    """What a person means by a network name: apostrophes, quotes and dashes of every kind as one, Unicode composed the
    same way, spaces of every kind as one space, no space at either end, capitals ignored."""
    s = unicodedata.normalize("NFKC", s or "").translate(_SSID_FOLD)
    return " ".join(s.split()).casefold()


def ssid_on_air(ssid, visible):
    """The name to use for saved network `ssid` given the names seen in a scan: `ssid` itself if it is there, else the
    ONE scanned name that means the same (ssid_key), else None. Two candidates = ambiguous = None: a guess could put the
    owner's password on a stranger's network."""
    if not visible:
        return None
    if ssid in visible:
        return ssid
    k = ssid_key(ssid)
    hits = [v for v in visible if v and "\ufffd" not in v and ssid_key(v) == k]
    return hits[0] if len(hits) == 1 else None


def nm_reason(stderr):
    """NetworkManager's own words for a failed `connection up` ("Secrets were required, but not provided", "The Wi-Fi
    network could not be found", …) — shown to the owner, because "check its password" was said for EVERY failure."""
    m = re.search(r"failed:\s*(.+)$", stderr or "")
    r = (m.group(1) if m else (stderr or "")).strip()
    r = re.sub(r"^\(\d+\)\s*", "", r)
    return r[:140]


class Shell:
    """The only thing that runs programs. Swapped for a fake in the tests."""
    last_stderr = ""                 # ★ the last failed command's last stderr line — the WHY of a failed join

    def run(self, args, timeout=40, secret=False):
        self.last_stderr = ""
        try:
            p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout,
                               text=True, encoding="utf-8", errors="replace", env=TOOL_ENV,
                               stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as e:
            # ★ The VERB only — the arguments can hold a password.
            log("%s %s failed (%s)" % (args[0], args[1] if len(args) > 1 else "", type(e).__name__))
            return 1, ""
        if p.returncode != 0 and not secret:
            # ★ Never for a `secret` run: nmcli can quote a refused property (a password) back in its error.
            err = (p.stderr or "").strip().splitlines()
            self.last_stderr = err[-1] if err else ""
            log("%s: %s" % (" ".join(args[:3]), err[-1] if err else "exit %d" % p.returncode))
        elif p.returncode != 0:
            log("%s %s failed (exit %d)" % (args[0], args[1], p.returncode))
        return p.returncode, p.stdout

    def run_input(self, args, data, timeout=20):
        try:
            p = subprocess.run(args, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               timeout=timeout, text=True, encoding="utf-8", env=TOOL_ENV)
            return p.returncode
        except (OSError, subprocess.TimeoutExpired):
            return 1

    def now(self):
        return time.monotonic()

    def sleep(self, s):
        time.sleep(s)

    def port_open(self, port):
        """True when something accepts a TCP connection on 127.0.0.1:port (the server's front door)."""
        import socket
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=1):
                return True
        except OSError:
            return False


class Box:
    """The state machine. One instance, one Wi-Fi device, one turn of the wheel per tick().

    ★★ CHEAP ON PURPOSE. Every nmcli call is a process start plus a D-Bus round trip — tens of
       milliseconds of an A53 — and this runs for ever beside a radio. So the connection list and
       each connection's fields are CACHED, refreshed when we change them ourselves and once a minute
       otherwise; a quiet tick is one nmcli call (the device's state), plus `iw` on a hotspot."""

    def __init__(self, sh, conf, state_path=None):
        self.sh = sh
        self.conf = conf
        self.state_path = state_path or os.path.join(STATE_DIR, "state.json")
        self.dev = None
        self.mode = "off"
        self.cur, self.st = "", 0     # the active connection and NM's device state, this tick
        self.scan_cache = []          # [{"ssid","signal","secure"}] — the setup page's list
        self.scan_at = 0
        self.last_error = ""
        self.join_reason = ""         # NetworkManager's reason for the last failed join (nm_reason)
        self.boot_at = sh.now()
        self.next_rescan = 0
        self.next_upgrade = 0
        self.next_try = 0
        self.door_wait_since = None   # ★ when the hotspot started waiting for the front door
        self.connecting_since = None
        self.last_client = sh.now()
        self.clients = 0
        self.captive_port = None
        self.setup_door_port = None   # ★ the :80 → front door redirect on every link, while setting up (setup_door)
        self.host_synced = False
        self.saw_unconfigured = False
        self.configured_at = None
        self.since = int(time.time())
        self.failed_until = {}        # name -> monotonic time: an upgrade that failed is not retried for a while
        self.fail_count = {}          # name -> refusals in a row (the back-off doubles with each)
        self.hold_own = False         # ★ the owner chose Own Wi-Fi (memory only — a power cycle clears it)
        self.hold_at = 0.0            # wall clock, when it was chosen
        self.hold_net = ""            # ★ a NETWORK chosen in the menu, held the same way (memory only)
        self.want = None              # ★ the network being looked for after a menu choice: dict(name, ssid, hidden, until, back)
        self.link = None              # the joined link: {signal, tx, rx, retry} — shown beside the choice
        self.link_ssid = ""           # ★ the network the RADIO is on (iw), not the name in the slot
        self._link_prev = None        # (tx packets, tx retries) at the last reading, for the retry %
        self.scan_info = {}           # ★ ssid -> {"freq", "security", "via": "scan"|"probe"} from the last look
        self.retried = set()          # ★ networks the security ladder has been run on this run (once each)
        self.after_join = None        # ★ called after every join attempt (KeptLog.soon — keep the evidence)
        self.adverts = {}             # ★ ssid -> advert_of(…): what each network ADVERTISES, from `iw … scan dump`
        self.sec_path = WIFI_SEC_FILE
        self.sec_memory = load_wifi_sec(self.sec_path)   # ★ ssid -> what joined it, and what it advertised then
        self.history_path = JOIN_HISTORY
        self.history = load_history(self.history_path)
        self.power_save = None        # ★ the radio's own power save, as `iw … get power_save` says: "off" | "on" | None
        self._ps_key = None           #   the join it was last checked for (connection, since)
        self._ps_next = 0.0           #   …and when it is next re-checked while that join lasts
        self._names, self._names_at, self._fields = [], -1e9, {}
        self._ip = ("", "")
        self.internet = "unknown"     # NetworkManager's connectivity verdict, from NetWatch (events)
        # ★★ THE WIRED SIDE (2026-10-13). An Ethernet device NM reports connected (or one NM does not manage that has an
        #    address) — the box is reachable there, by its .local name, whatever the Wi-Fi is doing.
        self.wired = False
        self.wired_dev, self.wired_ip = "", ""
        self.wifi_off = str(conf.get("WIFI_OFF", "0")).strip() == "1"
        self.radio_off_done = False   # `nmcli radio wifi off` already sent this run
        self._was_wired_off = True    # (for one log line when the cable goes while Wi-Fi is off)

    def ci(self, k):
        try:
            return int(self.conf.get(k, DEFAULTS[k]))
        except ValueError:
            return int(DEFAULTS[k])

    # ── the cache ──
    def invalidate(self):
        self._names_at, self._fields = -1e9, {}

    def nm_change(self, args, secret=False, timeout=40):
        """Every add/modify/delete goes through here, so the cache can never be stale after one."""
        rc, out = self.sh.run(args, timeout=timeout, secret=secret)
        self.invalidate()
        return rc

    # ── NetworkManager reads ──
    def devices(self):
        """[(device, type, state)] as NM lists them — ONE call that answers both "is there a Wi-Fi radio" and "is there a
        wired link". None when nmcli failed: a failed call is never read as "no devices" (that would drop the radio)."""
        rc, out = self.sh.run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"])
        if rc != 0:
            return None
        devs = []
        for line in out.splitlines():
            f = terse_split(line)
            if len(f) >= 2:
                devs.append((f[0], f[1], f[2] if len(f) > 2 else ""))
        return devs

    def wifi_device(self):
        return next((d for d, t, _ in (self.devices() or []) if t == "wifi"), None)

    def dev_ip4(self, dev):
        rc, out = self.sh.run(["nmcli", "-g", "IP4.ADDRESS", "device", "show", dev])
        first = out.strip().split("|")[0].strip() if rc == 0 and out.strip() else ""
        return first.split("/")[0]

    def unmanaged_ip4(self, dev):
        """★ An Ethernet port NM does not manage (an owner's own dhcpcd or static setup) is still a way in if it has an
        address. `ip`, not nmcli — NM knows nothing about it."""
        rc, out = self.sh.run(["ip", "-4", "-o", "addr", "show", "dev", dev, "scope", "global"], timeout=10)
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)/", out or "") if rc == 0 else None
        return m.group(1) if m else ""

    def refresh_links(self):
        """★★★ What this box can be reached on, each turn: the Wi-Fi radio (which may appear late — NM lists the onboard
        chip a few seconds into boot, and a USB dongle whenever it is plugged in — or not at all, on a Pi 2) and a wired
        link. Never a reason to stop: a box with no Wi-Fi is a wired box, not a broken one."""
        devs = self.devices()
        if devs is None:
            return
        wifi = next((d for d, t, _ in devs if t == "wifi"), None)
        if wifi and not self.dev:
            self.dev = wifi
            # ★ NM's own autoconnect gets its BOOT_GRACE_SEC from the moment the radio exists, not from our start.
            self.boot_at, self.connecting_since = self.sh.now(), None
            self.radio_off_done = False
            log("managing %s%s" % (wifi, " (Wi-Fi is switched off by the owner)" if self.wifi_off else ""))
        elif self.dev and not wifi:
            log("the Wi-Fi device %s went away — wired only until one appears" % self.dev)
            self.dev, self.cur, self.st, self.link, self.want = None, "", 0, None, None
        wired, ip = "", ""
        for d, t, s in devs:
            if t != "ethernet":
                continue
            if s.startswith("connected"):
                wired = d
                break
            if s.startswith("unmanaged"):
                ip = self.unmanaged_ip4(d)
                if ip:
                    wired = d
                    break
        if wired != self.wired_dev:
            log("wired link %s" % (("up on %s" % wired) if wired else "down"))
            self.wired_dev, self.wired_ip = wired, ip
        if wired and not self.wired_ip:
            # ★ Asked on the change (and until it answers), not every turn — shown, not decided on.
            self.wired_ip = ip or self.dev_ip4(wired)
        if not wired:
            self.wired_ip = ""
        self.wired = bool(wired)

    def connection_names(self):
        if self.sh.now() - self._names_at > 60:
            rc, out = self.sh.run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"])
            names = []
            for line in out.splitlines():
                f = terse_split(line)
                if len(f) >= 2:
                    names.append((f[0], f[1]))
            if rc == 0:
                if names != self._names:
                    self._fields = {}
                self._names, self._names_at = names, self.sh.now()
        return self._names

    def get(self, name, field, secrets=False):
        if not secrets and (name, field) in self._fields:
            return self._fields[(name, field)]
        args = ["nmcli", "-g", field] + (["-s"] if secrets else []) + ["connection", "show", name]
        rc, out = self.sh.run(args, secret=secrets)
        v = out.rstrip("\n") if rc == 0 else ""
        if "\\" in v:
            v = "".join(terse_split(v))
        if not secrets and rc == 0:
            self._fields[(name, field)] = v
        return v

    def saved(self):
        """Ours, IN ORDER: [(rank, name, ssid, hidden)]. Then any other client Wi-Fi connection
        (e.g. one Raspberry Pi Imager wrote) as rank 9 — tried after ours, never before."""
        names = self.connection_names()
        ours, others = [], []
        for n, t in names:
            if t != "802-11-wireless" or n in (AP_NAME, SETUP_NAME):
                continue
            if n.startswith(NET_PREFIX) and n[len(NET_PREFIX):].isdigit():
                rank = int(n[len(NET_PREFIX):])
                if 1 <= rank <= 3:
                    ours.append((rank, n, self.get(n, "802-11-wireless.ssid"),
                                 self.get(n, "802-11-wireless.hidden") == "yes"))
                continue
            if self.get(n, "802-11-wireless.mode") in ("ap", "adhoc", "mesh"):
                continue
            others.append((9, n, self.get(n, "802-11-wireless.ssid"), False))
        ours.sort()
        return ours + others

    def have(self, name):
        return any(n == name for n, _ in self.connection_names())

    def read_active(self):
        """Sets self.cur / self.st from NM: the active connection's name and the device state
        (100 = connected, 40-90 = on its way, 30 = disconnected, 20 = unavailable)."""
        if not self.dev:
            self.cur, self.st = "", 0             # ★ no radio (a Pi 2): nothing to ask, never None in an argv
            return "", 0
        rc, out = self.sh.run(["nmcli", "-t", "-f", "GENERAL.STATE,GENERAL.CONNECTION", "device", "show", self.dev])
        st, conn = 0, ""
        for line in out.splitlines():
            f = terse_split(line)
            if len(f) >= 2 and f[0] == "GENERAL.STATE":
                m = re.match(r"(\d+)", f[1]); st = int(m.group(1)) if m else 0
            elif len(f) >= 2 and f[0] == "GENERAL.CONNECTION":
                conn = f[1] if f[1] != "--" else ""
        self.cur, self.st = conn, st
        return conn, st

    def ip4(self):
        # ★ Asked only when the connection changes — it is shown, not decided on.
        if self._ip[0] == self.cur:
            return self._ip[1]
        if not self.dev:
            return ""
        rc, out = self.sh.run(["nmcli", "-g", "IP4.ADDRESS", "device", "show", self.dev])
        first = out.strip().split("|")[0].strip() if out.strip() else ""
        ip = first.split("/")[0]
        if ip:
            self._ip = (self.cur, ip)
        return ip

    def scan(self):
        """A full scan (station mode only — NM refuses one while the radio is a hotspot).
        Returns the set of SSIDs seen, or None if the scan failed."""
        rc, out = self.sh.run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY,FREQ", "device", "wifi", "list",
                               "ifname", self.dev, "--rescan", "yes"], timeout=30)
        if rc != 0:
            return None
        best = self.parse_list(out)
        self.scan_info = {k: {"freq": v["freq"], "security": v["security"], "via": "scan"} for k, v in best.items()}
        self.read_adverts(replace=True)
        self.scan_cache = sorted(({"ssid": v["ssid"], "signal": v["signal"], "secure": v["secure"]} for v in best.values()),
                                 key=lambda x: -x["signal"])[:40]
        self.scan_at = int(time.time())
        return set(best)

    @staticmethod
    def parse_list(out):
        """`nmcli -t -f SSID,SIGNAL,SECURITY,FREQ device wifi list` → {ssid: {...}}, the strongest row per name.
        ★ Every security is kept (WPA2/WPA3 transition, WPA3, SAE, OWE, enterprise): only an empty column is open."""
        best = {}
        for line in (out or "").splitlines():
            f = terse_split(line)
            if len(f) < 3 or not f[0]:
                continue
            try:
                sig = int(f[1])
            except ValueError:
                sig = 0
            m = re.match(r"\s*(\d+)", f[3]) if len(f) > 3 else None
            if f[0] not in best or sig > best[f[0]]["signal"]:
                best[f[0]] = {"ssid": f[0], "signal": sig, "secure": f[2] not in ("", "--"),
                              "security": f[2] if f[2] != "--" else "", "freq": int(m.group(1)) if m else None}
        return best

    def probe(self, ssids):
        """★★★ ASK FOR A SAVED NETWORK BY NAME (a directed probe) — for the ones the last scan did not see. A phone hotspot
        often does not answer a wildcard scan (an idle iPhone hotspot barely beacons) but answers its own name.
        ★★ PRIVACY, WEIGHED: a directed probe says the name out loud to anyone listening. So only SAVED names, only those the
           scan missed, and only while the box is looking for a network anyway (boot, link lost, a menu choice, or an idle
           upgrade check) — never on a timer of its own and never for a network it can already see. Marking every profile
           "hidden" instead would have the supplicant shout every saved name (the home network's too) on every scan.
        Returns the set of those names that answered; their freq/security are merged into scan_info as via "probe"."""
        ssids = [x for x in ssids if x]
        if not ssids or not self.dev:
            return set()
        args = ["nmcli", "device", "wifi", "rescan", "ifname", self.dev]
        for x in ssids:
            args += ["ssid", x]
        if self.sh.run(args, timeout=20)[0] != 0:
            return set()
        self.sh.sleep(4)                                  # ★ the rescan returns at once; results land a few seconds later
        rc, out = self.sh.run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY,FREQ", "device", "wifi", "list",
                               "ifname", self.dev, "--rescan", "no"], timeout=20)
        if rc != 0:
            return set()
        got = self.parse_list(out)
        self.read_adverts()
        hits = set()
        for x in ssids:
            on = ssid_on_air(x, set(got))
            if on is not None:
                hits.add(x)
                self.scan_info.setdefault(on, {"freq": got[on]["freq"], "security": got[on]["security"], "via": "probe"})
        return hits

    def read_adverts(self, replace=False):
        """★★ WHAT EACH NETWORK ADVERTISES (DETECTION FIRST, above): `iw dev <dev> scan dump` is the kernel's copy of the
        scan NetworkManager just made — reading it sends nothing on the air and costs one netlink dump. `replace` after a
        full scan (a network that went is forgotten); merged after a directed probe or before a join. A failed dump
        leaves what we had: nmcli's SECURITY column is the fallback (advert_for)."""
        if not self.dev:
            return
        rc, out = self.sh.run(["iw", "dev", self.dev, "scan", "dump"], timeout=10)
        if rc != 0:
            if replace:
                self.adverts = {}
            return
        got = {k: advert_of(v) for k, v in parse_iw_scan(out).items()}
        if replace:
            self.adverts = got
        else:
            self.adverts.update(got)

    def advert_for(self, ssid):
        """What network `ssid` advertises: from iw, else from nmcli's SECURITY column, else None (not heard)."""
        a = self.adverts.get(ssid)
        if a:
            return a
        info = self.scan_info.get(ssid)
        return advert_from_nm(info.get("security", "")) if info else None

    def profile_plan(self, name):
        """The profile's security as it is saved: {"km", "pmf"} ("km" "" = open)."""
        return {"km": self.get(name, "802-11-wireless-security.key-mgmt"),
                "pmf": pmf_value(self.get(name, "802-11-wireless-security.pmf")) or PMF_DEFAULT}

    def set_plan(self, name, plan):
        self.nm_change(["nmcli", "connection", "modify", name, "802-11-wireless-security.key-mgmt", plan["km"],
                        "802-11-wireless-security.pmf", plan["pmf"]])

    def choose_security(self, name, ssid, adv):
        """★★★ BEFORE EVERY JOIN: the profile is made to ask for what the network advertises NOW. What joined it before
        (sec_memory) is used only while the network advertises EXACTLY what it did then (the fingerprint — AKM suites and
        MFP flags, never the BSSID), or when it was not heard at all; anything else is read afresh. A downgrade is logged
        in plain words — a replaced router, or another network using the same name — and never blocked (Stuart's routers
        do change). Returns the plan the join will use."""
        q = ssid.encode("unicode_escape").decode("ascii")
        cur = self.profile_plan(name)
        mem = self.sec_memory.get(ssid)
        if adv and adv["kind"] in ("open", "other"):
            log("network \"%s\" advertises %s — the saved password profile is left as it is" % (q, adv["words"]))
            return cur
        if mem and (adv is None or mem.get("fp") == adv.get("fp")):
            plan = {"km": mem["km"], "pmf": str(mem["pmf"])}
            why = ("not heard in the scan — using what joined it last time" if adv is None else
                   "advertises %s, as when it last joined" % adv["words"])
        else:
            plan = plan_for(adv) or dict(PLAN_OPTIONAL)
            if adv is None:
                why = "not heard in the scan (hidden, or not on yet) — asking with the setting nearly everything takes"
            else:
                why = "advertises %s" % adv["words"]
                if mem and mem.get("fp") != adv.get("fp"):
                    was = mem.get("adv", "")
                    if ADVERT_RANK.get(adv["kind"], 9) < ADVERT_RANK.get(was, -1):
                        why += (" — WEAKER than the %s it advertised when it last joined: a replaced router, or another "
                                "network using the same name. Joining as advertised" % ADVERT_WORDS.get(was, was))
                    else:
                        why += " — changed since it last joined (%s then), so read afresh" % ADVERT_WORDS.get(was, was or "not heard")
        log("network \"%s\" %s — joining with %s" % (q, why, plan_words(plan)))
        if plan != cur:
            self.set_plan(name, plan)
        return plan

    def remember_security(self, ssid, adv, plan):
        """What joined, and what the network advertised then — written only when it changed (the SD card)."""
        old = self.sec_memory.get(ssid)
        e = {"km": plan["km"], "pmf": plan["pmf"], "adv": adv["kind"] if adv else "", "fp": adv.get("fp", "") if adv else ""}
        if old and not adv:
            e["adv"], e["fp"] = old.get("adv", ""), old.get("fp", "")   # ★ not heard this time: keep what it was built from
        if old and all(old.get(k) == v for k, v in e.items()):
            return
        e["t"] = int(time.time())
        self.sec_memory[ssid] = e
        save_wifi_sec(self.sec_path, self.sec_memory)

    def found_by_name_only(self, name, ssid):
        """★★ A network that answered only when asked by name is saved as "not visible" (802-11-wireless.hidden yes), so
        NetworkManager's own join — and its autoconnect at the next boot — probes for it by name too; a profile left
        "visible" would look for it with a wildcard scan and not find it again. Only for networks PROVEN to need it."""
        if self.get(name, "802-11-wireless.hidden") == "yes":
            return
        log("network \"%s\" answers only when asked by name — saved as not visible, so it is always asked for by name"
            % ssid.encode("unicode_escape").decode("ascii"))
        self.nm_change(["nmcli", "connection", "modify", name, "802-11-wireless.hidden", "yes"])

    def scan_while_ap(self):
        """★ A scan WITHOUT taking the hotspot down, where the driver allows it (iw's ap-force).
        brcmfmac support varies by firmware — None means "cannot", and the caller then falls back to
        a short, disruptive scan, only when nobody is connected. To be measured on the Pi 3 A+."""
        rc, out = self.sh.run(["iw", "dev", self.dev, "scan", "ap-force"], timeout=20)
        if rc != 0:
            return None
        seen = set()
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("SSID: "):
                s = iw_unescape(line[6:])
                if s:
                    seen.add(s)
        return seen

    def link_info(self):
        """★ The joined link as Linux reports it: signal (dBm), tx/rx bitrate (Mbit/s) from `iw … link`, and the share
        of transmissions retried since the last reading from `iw … station dump` — retries climb before the signal
        figure looks bad, and they are what a listener hears as drop-outs. None when not joined."""
        rc, out = self.sh.run(["iw", "dev", self.dev, "link"], timeout=10)
        if rc != 0 or "Not connected" in (out or ""):
            self._link_prev = None
            return None
        def num(pat, text):
            m = re.search(pat, text or "")
            return float(m.group(1)) if m else None
        m = re.search(r"^\s*SSID:\s?(.*)$", out or "", re.M)
        self.link_ssid = iw_unescape(m.group(1)) if m else ""
        sig = num(r"signal:\s*(-?\d+)", out)
        tx = num(r"tx bitrate:\s*([\d.]+)", out)
        rx = num(r"rx bitrate:\s*([\d.]+)", out)
        retry = None
        rc2, dump = self.sh.run(["iw", "dev", self.dev, "station", "dump"], timeout=10)
        # ★★★ THE PI'S CHIP HAS NO "tx retries" (2026-10-20: retry was null on every reading). brcmfmac is FullMAC and
        #     reports only TX_PACKETS and TX_FAILED to cfg80211 (brcmf_cfg80211_get_station), so `iw` prints "tx failed:"
        #     and never "tx retries:". Retries where the driver has them (mac80211: USB dongles, PCIe cards); otherwise
        #     the frames that failed after every retry — fewer, but the same warning. `retryKind` says which it is.
        pk, rt = num(r"tx packets:\s*(\d+)", dump), num(r"tx retries:\s*(\d+)", dump)
        kind = "retries"
        if rt is None:
            rt, kind = num(r"tx failed:\s*(\d+)", dump), "failed"
        if rc2 == 0 and pk is not None and rt is not None:
            prev = self._link_prev
            if prev and prev[2] == kind and pk >= prev[0] and rt >= prev[1]:   # (a counter that went back = a re-join)
                dp, dr = pk - prev[0], rt - prev[1]
                retry = int(round(100.0 * dr / (dp + dr))) if dp + dr > 0 else 0   # nothing sent since: none retried
            self._link_prev = (pk, rt, kind)
        return {"signal": int(sig) if sig is not None else None,
                "tx": tx, "rx": rx, "retry": retry, "retryKind": kind}

    def migrate_powersave(self):
        """★★★ PROFILES SAVED BY AN OLDER BUILD (Phase 0.1). The powersave line in apply()/ap_args() reaches a profile only
        when it is next saved, so a box set up before it existed keeps NetworkManager's default — power save ON on
        brcmfmac — until the owner happens to re-save Wi-Fi. Every profile WE own (vibe-net-N, the two hotspots) that does
        not say disable is modified to say it. Idempotent: a correct profile is read, not written.
        ★★ NEVER BOUNCES A LINK. `connection modify` rewrites the profile only; NetworkManager applies it at the next
           activation. The live link is put right by powersave_check(), on the radio, without a down/up. Returns the
           names it changed."""
        fixed = []
        for n, t in self.connection_names():
            if t != "802-11-wireless":
                continue
            ours = n in (AP_NAME, SETUP_NAME) or (n.startswith(NET_PREFIX) and n[len(NET_PREFIX):].isdigit())
            if not ours or powersave_disabled(self.get(n, "802-11-wireless.powersave")):
                continue
            if self.nm_change(["nmcli", "connection", "modify", n, "802-11-wireless.powersave", "2"]) == 0:
                fixed.append(n)
        if fixed:
            log("Wi-Fi power save switched off in %d saved profile(s) from an older build: %s" % (len(fixed), ", ".join(fixed)))
        return fixed

    def powersave_check(self):
        """★★★ THE RADIO ITSELF, AFTER EVERY JOIN (Phase 0.2). The profile can say disable and the radio still doze:
        brcmfmac re-enables power save after a reassociation or a firmware recovery. So `iw … get power_save` on each new
        join, and again every POWERSAVE_RECHECK_SEC while it lasts (one netlink call — cheap beside the `iw link` this
        tick already makes); if it says on, it is switched off and logged once for that join. Returns "off", "on" (could
        not be switched off) or None (iw would not say)."""
        now = self.sh.now()
        key = (self.cur, self.since)
        if key == self._ps_key and now < self._ps_next:
            return self.power_save
        first = key != self._ps_key
        self._ps_key, self._ps_next = key, now + POWERSAVE_RECHECK_SEC
        def read():
            rc, out = self.sh.run(["iw", "dev", self.dev, "get", "power_save"], timeout=10)
            m = re.search(r"Power save:\s*(on|off)", out or "", re.I) if rc == 0 else None
            return m.group(1).lower() if m else None
        ps = read()
        if ps == "on":
            self.sh.run(["iw", "dev", self.dev, "set", "power_save", "off"], timeout=10)
            after = read()
            if first or self.power_save != "on":
                log("Wi-Fi power save was ON on %s (%s) — %s" % (self.dev, self.cur or "?",
                    "switched off" if after == "off" else "could NOT be switched off; audio may stutter on a busy network"))
            ps = "off" if after == "off" else "on"
        self.power_save = ps
        return ps

    def own_wifi(self):
        """The owner's choice: leave the network for the box's own (secured) hotspot, and hold it there."""
        if not self.have(AP_NAME):
            self.last_error = "Own Wi-Fi needs the box's own hotspot set up first"
            return
        self.hold_own, self.hold_at = True, time.time()
        self.hold_net, self.want = "", None
        log("the owner chose Own Wi-Fi — leaving the network for the box's own hotspot")
        if self.cur not in (AP_NAME, SETUP_NAME):
            if self.cur:
                self.down(self.cur)
            self.read_active()
            self.raise_hotspot("the owner chose Own Wi-Fi")

    def radio_off(self):
        self.sh.run(["nmcli", "radio", "wifi", "off"], timeout=15)
        self.radio_off_done = True
        self.cur, self.st, self.link, self.clients = "", 0, None, 0

    def wifi_switch(self, off, why=""):
        """★★★ THE OWNER'S WI-FI OFF / ON (Stuart, 2026-10-13). Off: no hotspot, no network, the radio powered down, and
        it STAYS down whatever happens to the cable — allowed only while a wired link is up at the moment it is asked
        (switching off a box's only way in is never a choice to offer). On: back to the ordinary state machine, exactly
        as at boot (NM gets its grace to autoconnect first). Returns True if done."""
        if off:
            self.refresh_links()                  # ★ decide on the link as it is NOW, not as it was 5 s ago
            if not self.dev:
                self.last_error = "this box has no Wi-Fi to switch off"
                return False
            if not self.wired:
                self.last_error = "Wi-Fi can only be switched off while this box is wired — plug in an Ethernet cable first"
                log("Wi-Fi off refused: no wired link (the box would have no way in)")
                return False
            self.persist_wifi_off(True)
            self.want, self.hold_own, self.hold_net = None, False, ""
            self.read_active()
            if self.cur:
                self.down(self.cur)
            self.radio_off()
            self.mode, self.since, self.last_error = "wifi-off", int(time.time()), ""
            log("Wi-Fi switched off by the owner — the box is reachable on its wired link (%s)" % self.wired_dev)
            return True
        self.persist_wifi_off(False)
        self.radio_off_done = False
        self.sh.run(["rfkill", "unblock", "wifi"], timeout=10)
        self.sh.run(["nmcli", "radio", "wifi", "on"], timeout=15)
        # ★ As at boot: NM's own autoconnect first, then the saved networks in order, then a hotspot.
        self.boot_at, self.connecting_since, self.next_try = self.sh.now(), None, 0
        self.mode, self.since = ("connecting" if self.dev else "wired"), int(time.time())
        log("Wi-Fi switched on — " + (why or "the owner turned it on"))
        return True

    def persist_wifi_off(self, off):
        self.wifi_off = off
        self.conf["WIFI_OFF"] = "1" if off else "0"
        try:
            write_conf_value("WIFI_OFF", "1" if off else "0", path=STATE_CONF)
        except OSError:
            # ★ The settings partition is missing (settingsSaved: false says so): held for this run only.
            log("could not save the Wi-Fi %s setting — it lasts until the next restart" % ("off" if off else "on"))

    def network_again(self, why):
        """Back to the saved networks, in order (the owner's choice, or the hold expiring)."""
        self.hold_own = False
        self.hold_net = ""
        self.want = None
        if self.cur in (AP_NAME, SETUP_NAME):
            self.leave_hotspot_and_try(why)

    def hold_quiet_for(self):
        """Seconds since the radio was last in use (or since Own Wi-Fi was chosen, if later)."""
        try:
            last = os.stat(ACTIVE_FILE).st_mtime
        except OSError:
            last = 0.0
        return time.time() - max(self.hold_at, last)

    def station_count(self):
        rc, out = self.sh.run(["iw", "dev", self.dev, "station", "dump"], timeout=10)
        return sum(1 for l in out.splitlines() if l.startswith("Station "))

    # ── NetworkManager writes ──
    def up(self, name, wait=None):
        wait = wait or self.ci("JOIN_WAIT_SEC")
        rc, _ = self.sh.run(["nmcli", "--wait", str(wait), "connection", "up", name, "ifname", self.dev],
                            timeout=wait + 15)
        self.join_reason = "" if rc == 0 else nm_reason(getattr(self.sh, "last_stderr", ""))
        self.read_active()
        return rc == 0

    def security_used(self, name):
        """What this profile asks for, in the history's words."""
        return plan_words(self.profile_plan(name))

    def join(self, name, ssid, via="scan"):
        try:
            return self._join(name, ssid, via)
        finally:
            if self.after_join:
                self.after_join()

    def _join(self, name, ssid, via="scan"):
        """★★★ JOIN A SAVED CLIENT NETWORK, RECORDED. DETECTION FIRST: the kernel's scan results are read again and the
        profile is made to ask for what the network advertises now (choose_security). If the network refuses us at
        authentication or association (never for "not found": nothing was there to refuse), THE WHOLE LADDER is tried
        (ladder_of: SAE → WPA2/WPA3 PMF optional → plain WPA2 PMF off, or off → optional) — once per network per run,
        so a wrong password costs two or three attempts, not that many every rescan. Whatever joins is remembered with
        what the network advertised then; if nothing does, the profile goes back to the detected setting."""
        secured = bool(self.get(name, "802-11-wireless-security.key-mgmt"))
        adv = None
        if secured:
            self.read_adverts()                       # ★ what the network says NOW — no radio work, the last scan's copy
            adv = self.advert_for(ssid)
            first = self.choose_security(name, ssid, adv)
        used = self.security_used(name)
        ok_ = self.up(name)
        self.record(ssid, "joined" if ok_ else join_result(self.join_reason), self.join_reason, visible=via, name=name,
                    used=used, seen=adv["words"] if adv else None)
        if ok_:
            if secured:
                self.remember_security(ssid, adv, self.profile_plan(name))
            return True
        if not secured or name in self.retried:
            return False
        if join_result(self.join_reason) not in ("auth failed", "assoc timeout", "failed"):
            return False
        self.retried.add(name)
        q = ssid.encode("unicode_escape").decode("ascii")
        for nxt in ladder_of(first):
            log("network \"%s\" refused %s — trying %s" % (q, used, plan_words(nxt)))
            self.set_plan(name, nxt)
            used2 = self.security_used(name)
            ok_ = self.up(name)
            self.record(ssid, "joined" if ok_ else join_result(self.join_reason), self.join_reason, visible=via, name=name,
                        used=used2, seen=adv["words"] if adv else None)
            if ok_:
                log("network \"%s\" took %s — remembered for as long as it advertises the same thing" % (q, used2))
                self.remember_security(ssid, adv, nxt)
                return True
            used = used2
            if join_result(self.join_reason) not in ("auth failed", "assoc timeout", "failed"):
                break                                 # ★ gone, or DHCP: another security setting will not help
        self.set_plan(name, first)                    # nothing took: back to what the network advertises
        log("network \"%s\" refused every setting — left at %s (is the password right?)" % (q, plan_words(first)))
        return False

    def record(self, ssid, result, reason="", visible="scan", name="", used=None, seen=None):
        """One line of the join history (see JOIN_HISTORY). The same network failing the same way again updates the last
        line (its time and a count) instead of pushing the useful lines out — an absent phone is asked for every two
        minutes."""
        info = self.scan_info.get(ssid_on_air(ssid, set(self.scan_info)) or ssid) or {}
        e = {"t": int(time.time()), "ssid": ssid, "freq": info.get("freq"), "band": band_of(info.get("freq")),
             "seen": seen or info.get("security", ""), "visible": visible,
             "used": used if used is not None else (self.security_used(name) if name else ""),
             "result": result, "reason": (reason or "")[:140], "n": 1}
        last = self.history[-1] if self.history else None
        if last and result != "joined" and all(last.get(k) == e[k] for k in ("ssid", "result", "used", "visible", "reason")):
            last["t"], last["n"] = e["t"], int(last.get("n", 1)) + 1
            last["freq"], last["band"], last["seen"] = e["freq"] or last.get("freq"), e["band"] or last.get("band"), e["seen"] or last.get("seen")
        else:
            self.history.append(e)
            del self.history[:-JOIN_KEEP]
        save_history(self.history_path, self.history)

    def join_error(self, ssid):
        """★ What the owner is told when a join fails — NetworkManager's reason, not a guess. It used to say "check its
        password" for every failure, which sent Stuart to retype a password that was right (2026-10-14)."""
        r = self.join_reason
        if re.search(r"secret|password|psk|4-way|handshake", r, re.I):
            return "could not join \"%s\" — it refused the password" % ssid
        if re.search(r"not be found|not found|no network", r, re.I):
            return "could not join \"%s\" — it was not found (is it switched on?)" % ssid
        return "could not join \"%s\"%s" % (ssid, (" — " + r) if r else " — check its password")

    def correct_ssid(self, name, saved_ssid, on_air):
        """★★★ The saved name differs from the one on the air only in apostrophes, dashes, spaces or capitals (ssid_key):
        rewrite the saved network to the EXACT name on the air — the password, order and everything else stay — so this
        join and every later one (NetworkManager's own autoconnect at boot included) use the real name."""
        if on_air == saved_ssid or not valid_ssid(on_air):
            return
        log("network \"%s\" is on the air as \"%s\" — the saved name is corrected to match"
            % (saved_ssid.encode("unicode_escape").decode("ascii"), on_air.encode("unicode_escape").decode("ascii")))
        self.nm_change(["nmcli", "connection", "modify", name, "802-11-wireless.ssid", on_air])

    def down(self, name):
        self.sh.run(["nmcli", "connection", "down", name], timeout=20)

    def delete(self, name):
        self.nm_change(["nmcli", "connection", "delete", name], timeout=20)

    def ap_args(self):
        return ["802-11-wireless.mode", "ap", "802-11-wireless.band", "bg",
                "802-11-wireless.channel", str(self.ci("AP_CHANNEL")),
                "802-11-wireless.powersave", "2",
                "ipv4.method", "shared", "ipv4.addresses", AP_ADDR + "/24",
                "ipv6.method", "disabled", "connection.autoconnect", "no"]

    def ensure_setup_ap(self):
        ssid = self.conf.get("SETUP_SSID", DEFAULTS["SETUP_SSID"])
        if self.have(SETUP_NAME) and self.get(SETUP_NAME, "802-11-wireless.ssid") == ssid:
            return
        if self.have(SETUP_NAME):
            self.delete(SETUP_NAME)
        # ★★ OPEN, deliberately and only here — the first-boot door. It is never raised once a
        #    secured fallback hotspot exists (see ap_name()).
        self.nm_change(["nmcli", "connection", "add", "type", "wifi", "ifname", self.dev,
                        "con-name", SETUP_NAME, "ssid", ssid] + self.ap_args())

    def ap_name(self):
        """★★★ THE OPEN HOTSPOT EXISTS ONLY UNTIL A SECURED ONE DOES."""
        return AP_NAME if self.have(AP_NAME) else SETUP_NAME

    # ── captive portal plumbing (only while a hotspot is up) ──
    def front_door_port(self):
        data = read_plain(PORT_FILE, 16) or ""
        digits = re.sub(r"[^0-9]", "", data)[:5]
        p = int(digits) if digits else 0
        return p if 0 < p < 65536 else 48000

    def captive_on(self):
        port = self.front_door_port()
        if self.captive_port == port:
            return
        # ★★ OUR OWN TABLE — NM's shared mode has its own NAT rules and this never touches them.
        #    The "add, delete, add" opening makes the load idempotent on any nft version.
        # ★★ IPv6 TOO (2026-10-25): the server listens dual-stack now, and a name that resolves to IPv6 first (Nick's
        #    network) must reach :80 the same way. nft_redirect falls back to IPv4 alone on a kernel without IPv6 NAT.
        if nft_redirect(self.sh, NFT_TABLE, port, 'iifname "%s" ' % self.dev):
            self.captive_port = port
        else:
            log("could not load the :80 redirect (is nftables installed?) — the phone's captive "
                "sheet will not open by itself; http://%s:%d/ still works" % (AP_ADDR, port))

    def sync_hostname(self, configured):
        """The setup name while unconfigured, the run name after. Cheap when nothing changes.
        ★★★ NOT THE MOMENT SETUP FINISHES (Stuart's pocket box, 2026-10-10: "Save and Restart" hung). The page that
        pressed it is still talking to VibeServerSetup.local, waiting for the server to come back — retiring the name
        within seconds left it waiting on a name that no longer answered. So a box that was set up DURING this run
        keeps the setup name for RETIRE_SEC (the page shows the new address meanwhile); one that boots already set up
        switches at once."""
        now = self.sh.now()
        if not configured:
            self.saw_unconfigured, self.configured_at = True, None
        elif self.configured_at is None:
            self.configured_at = now
        retire = configured and (not self.saw_unconfigured or now - self.configured_at >= RETIRE_SEC)
        # ★★★ http://vibeserversetup.local/ ON ETHERNET TOO, and only while setting up (2026-10-25). It goes with the
        #     setup NAME, at the same moment — the page that pressed Save is still talking to :80 for RETIRE_SEC.
        self.setup_door(not retire)
        want = RUN_HOST if retire else SETUP_HOST
        try:
            with open(HOSTNAME_FILE) as f:
                have = f.read().strip()
        except OSError:
            have = ""
        if have == want and self.host_synced:
            return
        self.host_synced = True
        if have == want:
            return
        # ★★ sh.run returns (rc, out). This compared the PAIR with 0 — never equal — so hostnamectl renamed the
        #    box and then everything after it (/etc/hosts, the avahi restart) was skipped as a "failure": avahi
        #    went on announcing vibeserversetup.local and vibepocket.local never answered (v8, 2026-10-10).
        rc, _ = self.sh.run(["hostnamectl", "set-hostname", want], timeout=15)
        if rc != 0:
            log("could not set the hostname to %s" % want)
            return
        try:
            with open(HOSTS_FILE) as f:
                hosts = f.read()
            hosts = re.sub(r"(?m)^127\.0\.1\.1\s.*$", "127.0.1.1\t" + want, hosts)
            if "127.0.1.1" not in hosts:
                hosts += "127.0.1.1\t%s\n" % want
            write_atomic(HOSTS_FILE, hosts)
        except OSError:
            pass
        # ★ avahi does not follow a hostname change by itself — a restart republishes at once.
        self.sh.run(["systemctl", "try-restart", "avahi-daemon.service"], timeout=20)
        log("answering as %s.local%s" % (want, "" if configured else " until setup is finished"))

    def setup_door(self, on):
        """★★★ PORT 80 ON EVERY LINK WHILE THE BOX IS BEING SET UP — Ethernet included (Nick, G4IRX, a real Orange Pi One
        on Ethernet, 2026-10-25: "entering http://vibeserversetup.local/ in the browser results in 'site not found'"). The
        :80 redirect was loaded for the Wi-Fi radio only (captive_on: `iifname <wlan>`), so a box set up over a cable —
        every board card without Wi-Fi, a Pi 2 — needed :48000 typed, which the card's instructions never say. So, until
        setup is finished: :80 → the front door on EVERY interface, IPv4 and IPv6, in a table of its own.
        ★★ STOPS WHEN SETUP IS FINISHED — a set-up server does not take over port 80 on someone's LAN. Exactly when the
           setup name retires (sync_hostname: at once on a box that boots set up; RETIRE_SEC after a Save in this run).
        ★ The Wi-Fi-interface redirect (captive_on / captive_off) is not this, and is unchanged."""
        port = self.front_door_port() if on else None
        if self.setup_door_port == port:
            return
        if on:
            if nft_redirect(self.sh, SETUP_TABLE, port, ""):
                self.setup_door_port = port
                log("http://%s.local/ (port 80) leads to the setup page on every link until setup is finished" % SETUP_HOST)
            else:
                log("could not load the setup :80 redirect (is nftables installed?) — use http://%s.local:%d/" % (SETUP_HOST, port))
            return
        if self.sh.run_input(["nft", "-f", "-"], nft_drop(SETUP_TABLE)) == 0:
            self.setup_door_port = None
            log("setup is finished — port 80 is left alone on the wired network")

    def captive_off(self):
        # ★★★ THE :80 REDIRECT STAYS, ON EVERY NETWORK (Stuart, 2026-10-10: the owner must reach the
        #     box straight away by its .local name "without having to work out the IP address"). It
        #     was removed on leaving the hotspot, which made the address http://vibepocket.local:48000/
        #     on the home network — a port nobody remembers. Kept, it is http://vibepocket.local/
        #     everywhere. Harmless as a client: nothing else on this box listens on :80, and the
        #     captive DNS answers (the part that hijacks lookups) belong to NM's hotspot only.
        self.captive_on()

    # ── transitions ──
    def raise_hotspot(self, why):
        name = self.ap_name()
        now = self.sh.now()
        # ★★★ NOTHING ON THE AIR UNTIL THE CAPTIVE SHEET CAN OPEN (Stuart's v7 card, 2026-10-10: joined the open
        #     hotspot, no sheet — iOS showed "connected", fell back to 5G, and never asked again). A phone checks
        #     within a second or two of joining, ONCE; if nothing answers it settles on "no internet" and the
        #     owner is left with a hotspot that does nothing. This service starts BEFORE vibeserver, so on a fresh
        #     box the hotspot used to beat the front door. Now, in order: the front door is LISTENING, the :80
        #     redirect is loaded, and the state already says hotspot (the server turns its captive answers on
        #     from it) — and only then does the hotspot come up. After DOOR_WAIT_SEC it opens anyway: a box with
        #     a dead server must still be reachable to be fixed.
        port = self.front_door_port()
        if not self.sh.port_open(port):
            if self.door_wait_since is None:
                self.door_wait_since = now
                log("waiting for VibeServer on :%d before opening the hotspot" % port)
            if now - self.door_wait_since < self.ci("DOOR_WAIT_SEC"):
                self.next_try = now + 2
                return False
            log("VibeServer still not answering on :%d after %s s — opening the hotspot anyway"
                % (port, self.ci("DOOR_WAIT_SEC")))
        self.door_wait_since = None
        if name == SETUP_NAME:
            self.ensure_setup_ap()
        log("raising the %s hotspot — %s" % ("OPEN setup" if name == SETUP_NAME else "secured", why))
        prev_mode = self.mode
        self.captive_port = None                 # ★ reload the redirect for this hotspot, before it exists
        self.captive_on()
        self.mode = "setup-ap" if name == SETUP_NAME else "fallback-ap"
        self.write_state()
        self.sh.sleep(self.ci("STATE_LEAD_SEC"))  # ★ the server reads the state every second
        if self.up(name, wait=20):
            self.since = int(time.time())
            self.last_client = self.sh.now()
            self.next_rescan = self.last_client + self.ci("RESCAN_SEC")
            return True
        # ★ Do not hammer a radio that will not start a hotspot: try again in half a minute.
        self.last_error = "the hotspot would not start"
        self.mode = "off" if prev_mode in ("setup-ap", "fallback-ap") else prev_mode
        self.write_state()
        self.next_try = now + 30
        return False

    def radio_quiet_for(self):
        """Seconds since anyone last used the radio (the server touches ACTIVE_FILE every 30 s while they do)."""
        try:
            return time.time() - os.stat(ACTIVE_FILE).st_mtime
        except OSError:
            return 1e9

    def try_networks(self, visible=None, below_rank=None, blind=True):
        """Join the saved networks STRICTLY IN ORDER — 1, then 2, then 3, then any other. With
        `below_rank`, only those ranked above the current one (an upgrade). True once joined.
        `blind=False` (an upgrade, off a WORKING link): a "not visible" network is tried only if the scan saw it."""
        saved = self.saved()
        unseen = False
        if visible is None:
            visible = self.scan()
            if visible is None:
                # ★★ A FAILED SCAN IS NOT AN EMPTY SKY. NetworkManager refuses a rescan straight after another, or while
                #    the driver is still leaving AP mode; this read that as "nothing in range", skipped every network
                #    not ticked "not visible", and raised the hotspot — where a phone joining it then kept it up for
                #    good. Look again once; if the radio still will not say, try each saved network by name (we have no
                #    link to lose here — `visible` is only passed in from a working link, which never probes blind).
                self.sh.sleep(3)
                visible = self.scan()
                if visible is None:
                    log("the scan failed twice — trying the saved networks by name")
                    visible, unseen = set(), True
        # ★★★ THE ONES THE SCAN MISSED ARE ASKED FOR BY NAME (see probe()) — a blind join costs JOIN_WAIT_SEC each, a
        #     directed probe a few seconds for all of them. From a working link too (an upgrade: the caller only gets here
        #     while nobody is listening), where a blind join is never made.
        want = [(r, n, x, h) for r, n, x, h in saved
                if (below_rank is None or r < below_rank) and ssid_on_air(x, visible) is None
                and not (below_rank is not None and self.failed_until.get(n, 0) > self.sh.now())]
        probed = self.probe([x for _, _, x, _ in want]) if want and not unseen else set()
        for r, n, x, h in want:
            if x in probed:
                if not h:
                    self.found_by_name_only(n, x)
            elif r <= 3:
                self.record(x, "not seen", "asked by name, no answer", visible="no", name=n)
        visible = set(visible) | {ssid_on_air(x, set(self.scan_info)) or x for x in probed}
        now = self.sh.now()
        for rank, name, ssid, hidden in saved:
            if below_rank is not None and rank >= below_rank:
                break
            if self.cur == name and self.st >= 100:
                return True                     # already on the best one there is
            # ★ A phone hotspot may not be ADVERTISING (the phone is busy) — the owner ticks
            #   "not visible" and NM probes for it by name; everything else must be SEEN first, or
            #   each absent network costs JOIN_WAIT_SEC of nothing.
            on_air = ssid_on_air(ssid, visible)
            if on_air is None and not ((hidden or unseen) and blind):
                continue
            if below_rank is not None and self.failed_until.get(name, 0) > now:
                continue
            if on_air is not None:
                self.correct_ssid(name, ssid, on_air)
                ssid = on_air
            log("joining network %s (%s)" % (rank if rank < 9 else "other", ssid))
            if self.join(name, ssid, via="probe" if ssid in probed else ("scan" if on_air is not None else "blind")):
                self.captive_off()
                self.mode = "client"
                self.since = int(time.time())
                self.last_error = ""
                self.next_upgrade = self.sh.now() + self.ci("UPGRADE_SEC")
                self.fail_count.pop(name, None)
                return True
            # ★★ A NETWORK THAT IS THERE BUT WILL NOT TAKE US (wrong password, MAC filter) must not
            #    cost an outage every UPGRADE_SEC for ever. It used to rest a flat 15 minutes — which is
            #    an outage every 16½ minutes for ever (the portable box, all night 2026-10-11, ~25 s each
            #    time). Now 15 min, 30, 1 h … 6 h — and no upgrade at all while the radio is in use (tick).
            n = self.fail_count.get(name, 0) + 1
            self.fail_count[name] = n
            self.failed_until[name] = self.sh.now() + min(900 * 2 ** (n - 1), 6 * 3600)
            self.last_error = self.join_error(ssid)
        return False

    def choose_net(self, rank):
        """★★★ A NETWORK CHOSEN IN THE MENU (Stuart, 2026-10-11) — e.g. the owner's phone hotspot, switched on after
        pressing. Look for it for TRY_SEC, KEEPING a network link while looking (but never its own hotspot — pursue); join it the
        moment it appears; if it never does, stay (or go back) where we were. Once joined it is held like Own Wi-Fi."""
        hit = [(r, n, s, h) for r, n, s, h in self.saved() if r == rank and r <= 3]
        if not hit:
            self.last_error = "there is no network %d saved" % rank
            return
        r, name, ssid, hidden = hit[0]
        self.read_active()
        if self.cur == name and self.st >= 100:
            self.want = None
            self.hold_net, self.hold_at, self.hold_own = name, time.time(), False
            return
        self.want = {"name": name, "ssid": ssid, "hidden": hidden,
                     "until": self.sh.now() + self.ci("TRY_SEC"), "back": self.cur}
        self.last_error = ""
        log("the owner chose network %d (%s) — looking for it for %d s" % (rank, ssid, self.ci("TRY_SEC")))

    def pursue(self):
        """One turn of looking for the chosen network (tick calls this instead of everything else while it runs)."""
        w = self.want
        now = self.sh.now()
        if self.cur == w["name"] and self.st >= 100:
            self.want = None
            return
        if now >= w["until"]:
            self.want = None
            log("network \"%s\" did not appear in %d s — back to where it was" % (w["ssid"], self.ci("TRY_SEC")))
            if not self.last_error:
                self.last_error = "\"%s\" was not found — is its hotspot on?" % w["ssid"]
            back = w["back"]
            if self.cur and self.st >= 100:
                return                                  # never left: nothing to undo
            if back in (AP_NAME, SETUP_NAME):
                self.raise_hotspot("back after looking for \"%s\"" % w["ssid"])
            elif not (back and self.up(back)):
                self.leave_hotspot_and_try("back after looking for \"%s\"" % w["ssid"])
            return
        if self.cur in (AP_NAME, SETUP_NAME):
            # ★★★ ON A HOTSPOT: LEAVE IT, AT ONCE (Stuart's road test, 2026-10-14: on the box's own Wi-Fi, chose his
            #     iPhone's hotspot in the app — it never switched). This used to keep the hotspot up while it looked
            #     (ap-force) until the chosen network appeared. But the phone that pressed is ON this hotspot, and an
            #     iPhone does not run its Personal Hotspot over Wi-Fi while its own Wi-Fi is joined to another network:
            #     keeping ours up kept the network we were looking for switched off, for the whole TRY_SEC. Whoever
            #     pressed is leaving it anyway (the menu says so), and if the network never appears the hotspot comes
            #     back (below). A station-mode scan is also the only one every driver can do.
            self.down(self.cur)
            self.captive_off()
            self.sh.sleep(2)
            self.read_active()
            self.mode = "connecting"
        vis = self.scan() or set()                      # ★ a scan keeps the link: nobody is dropped until it is there
        on_air = ssid_on_air(w["ssid"], vis)
        via = "scan" if on_air is not None else "blind"
        if on_air is None and self.probe([w["ssid"]]):
            # ★★ The scan missed it but it answered its name (a phone hotspot): join it the same way from now on.
            on_air, via = ssid_on_air(w["ssid"], set(self.scan_info)) or w["ssid"], "probe"
            if not w["hidden"]:
                self.found_by_name_only(w["name"], w["ssid"])
                w["hidden"] = True
        if on_air is None and not w["hidden"]:
            if not w.get("said"):
                w["said"] = True
                self.record(w["ssid"], "not seen", "not in the scan and no answer by name", visible="no", name=w["name"])
            return
        if on_air is not None and on_air != w["ssid"]:
            self.correct_ssid(w["name"], w["ssid"], on_air)
            w["ssid"] = on_air
        log("joining the chosen network (%s)" % w["ssid"])
        if self.join(w["name"], w["ssid"], via=via):
            self.captive_off()
            self.mode = "client"
            self.since = int(time.time())
            self.last_error = ""
            self.hold_net, self.hold_at, self.hold_own = w["name"], time.time(), False
            self.fail_count.pop(w["name"], None)
            self.failed_until.pop(w["name"], None)
            self.next_upgrade = self.sh.now() + self.ci("UPGRADE_SEC")
            self.want = None
            return
        self.last_error = self.join_error(w["ssid"])

    def leave_hotspot_and_try(self, why):
        log("looking for a saved network — " + why)
        if self.cur in (AP_NAME, SETUP_NAME):
            self.down(self.cur)
            self.captive_off()
            self.sh.sleep(2)              # ★ let the driver come back to station mode before scanning
            self.read_active()
        if self.try_networks():
            return True
        # ★★ NO HOME NETWORK IS REQUIRED (Stuart, 2026-10-13): with none saved the box is simply its own hotspot —
        #    nothing went wrong, so nothing is reported as a problem.
        if not self.last_error and self.saved():
            self.last_error = "none of the saved networks is in range"
        return self.raise_hotspot("no saved network in range" if self.saved() else "no home network saved — its own hotspot")

    # ── the request inbox ──
    def apply(self, req):
        """Write the owner's networks and hotspot into NetworkManager, in order."""
        # ★ Which Wi-Fi we are PHYSICALLY on, before the slots are rewritten (see the rejoin at the end).
        was_cur = self.cur if self.mode == "client" else ""
        was_ssid = self.get(was_cur, "802-11-wireless.ssid") if was_cur else ""
        # Passwords we were told to KEEP: read back from NM before anything is deleted.
        old = {}
        for rank, name, ssid, hidden in self.saved():
            if rank <= 3:
                old[ssid] = self.get(name, "802-11-wireless-security.psk", secrets=True)
        # ★★★ A POWER CUT MID-SAVE MUST LEAVE A WAY IN (Stuart, 2026-10-10). This used to delete every
        #     saved network and then add the new list — a cut between the two left NONE. Now each rank's
        #     connection is MODIFIED IN PLACE (NetworkManager rewrites that one keyfile atomically), new
        #     ranks are added, and only ranks beyond the new list are deleted, last. At any instant
        #     every network is the old one or the new one; the box is never left with nothing to join.
        existing = {n for n, t in self.connection_names() if n.startswith(NET_PREFIX)}
        for rank, net in enumerate(req["networks"], 1):
            psk = old.get(net["ssid"], "") if net["keep"] else net["psk"]
            name = NET_PREFIX + str(rank)
            modify = name in existing and bool(psk) == bool(self.get(name, "802-11-wireless-security.key-mgmt"))
            head = (["nmcli", "connection", "modify", name, "802-11-wireless.ssid", net["ssid"]] if modify else
                    ["nmcli", "connection", "add", "type", "wifi", "ifname", self.dev,
                     "con-name", name, "ssid", net["ssid"]])
            if not modify and name in existing:
                self.delete(name)               # open ⇄ secured: the security section changes shape
            args = head + [
                    "connection.autoconnect", "yes",
                    # ★★★ THE ORDER, AS NM SEES IT: 30 / 20 / 10. NM picks the highest-priority
                    #     VISIBLE connection when it autoconnects; this service enforces the rest.
                    "connection.autoconnect-priority", str(PRIORITY[rank]),
                    "802-11-wireless.powersave", "2",
                    "802-11-wireless.hidden", "yes" if net["hidden"] else "no"]
            if psk:
                # ★★★ DETECTION FIRST (see above): saved asking for what the network advertised in the last scan — or,
                #     not heard, wpa-psk + PMF optional. Every join reads it again (choose_security), so this is only the
                #     first guess, and the one NetworkManager's own autoconnect uses at the next boot.
                plan = None
                if modify and self.get(name, "802-11-wireless.ssid") == net["ssid"]:
                    plan = self.profile_plan(name)                  # same slot, same name: what it already had
                    if plan["km"] not in ("wpa-psk", "sae"):
                        plan = None
                if plan is None:
                    plan = plan_for(self.advert_for(net["ssid"])) or dict(PLAN_OPTIONAL)
                args += ["wifi-sec.key-mgmt", plan["km"], "wifi-sec.psk", psk, "wifi-sec.pmf", plan["pmf"]]
            if self.nm_change(args, secret=True) != 0:
                self.last_error = "network %d could not be saved" % rank
        for n in sorted(existing):
            r = n[len(NET_PREFIX):]
            if r.isdigit() and int(r) > len(req["networks"]):
                self.delete(n)
        self.failed_until = {}
        self.fail_count = {}
        self.retried = set()                    # ★ a re-save (a new password?) earns every network the full ladder again
        # ★ What joined a network is kept only for networks still saved (SSIDs are private; nothing lingers).
        names = {n["ssid"] for n in req["networks"]}
        if any(k not in names for k in self.sec_memory):
            self.sec_memory = {k: v for k, v in self.sec_memory.items() if k in names}
            save_wifi_sec(self.sec_path, self.sec_memory)
        ap = req["ap"]
        if ap["keep"] and self.have(AP_NAME):
            self.nm_change(["nmcli", "connection", "modify", AP_NAME, "802-11-wireless.ssid", ap["ssid"]])
        elif self.have(AP_NAME):
            # ★ In place, for the same reason as the networks: never a moment with no hotspot saved.
            self.nm_change(["nmcli", "connection", "modify", AP_NAME, "802-11-wireless.ssid", ap["ssid"],
                            "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", ap["psk"]], secret=True)
        else:
            # ★★★ WPA2 (RSN/CCMP) only, PMF off: brcmfmac's AP mode and several phones do not
            #     agree on PMF, and a hotspot a phone cannot join is no fallback at all.
            self.nm_change(["nmcli", "connection", "add", "type", "wifi", "ifname", self.dev,
                            "con-name", AP_NAME, "ssid", ap["ssid"]] + self.ap_args() +
                           ["wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.proto", "rsn",
                            "wifi-sec.pairwise", "ccmp", "wifi-sec.group", "ccmp",
                            "wifi-sec.pmf", "disable", "wifi-sec.psk", ap["psk"]], secret=True)
        if req["country"] and req["country"] != self.conf.get("COUNTRY"):
            self.set_country(req["country"])
        log("saved %d network(s) and the hotspot \"%s\"" % (len(req["networks"]), ap["ssid"]))
        # ★★★ REJOIN IN THE NEW ORDER (Stuart's Pi 3 A+, 2026-10-10: the phone hotspot moved to 1 while on Home, the box
        #     stayed on Home). A slot's profile is rewritten IN PLACE, and NetworkManager keeps the live link on what it
        #     joined — so after a reorder the box sat physically on Home under the slot that now says "phone", and only
        #     a DROP ever made it look again. If the slot we are on now names a different network, or the link went
        #     with a deleted slot, leave it and join in the saved order (the page warns of the moment's drop).
        self.read_active()
        if was_cur:
            now_ssid = self.get(was_cur, "802-11-wireless.ssid") if self.have(was_cur) else ""
            if not self.cur or now_ssid != was_ssid:
                if self.cur:
                    self.down(self.cur)
                    self.read_active()
                self.leave_hotspot_and_try("the saved networks changed — rejoining in the new order")

    def set_country(self, cc):
        if os.path.exists("/usr/bin/raspi-config"):
            self.sh.run(["raspi-config", "nonint", "do_wifi_country", cc], timeout=60)
        else:
            self.sh.run(["iw", "reg", "set", cc])
        self.conf["COUNTRY"] = cc
        try:
            write_conf_value("COUNTRY", cc)
        except OSError:
            pass

    def reset_wifi(self):
        for n, t in list(self.connection_names()):
            if n.startswith(NET_PREFIX) or n == AP_NAME:
                self.delete(n)
        log("Wi-Fi reset: every saved network and the fallback hotspot forgotten")

    # ── one turn of the wheel ──
    def tick(self):
        now = self.sh.now()
        self.refresh_links()
        if not self.dev:
            # ★★★ A WIRED BOX (a Pi 2 has no Wi-Fi chip). Nothing to manage; the name, the governor and the state go on
            #     in main_loop, and refresh_links() picks up a radio the moment one appears.
            self.mode, self.cur, self.st, self.clients, self.link = "wired", "", 0, 0, None
            return
        if self.wifi_off:
            # ★★★ OFF MEANS OFF (Stuart, 2026-10-13) — a lost cable is NOT a reason to switch it back on; the owner was
            #     warned that the box is out of reach until the cable is back.
            if self.wired != self._was_wired_off:
                self._was_wired_off = self.wired
                if not self.wired:
                    log("Wi-Fi is off and the wired link is down — the box is out of reach until the cable is back")
            if not self.radio_off_done:
                self.read_active()
                if self.cur:
                    self.down(self.cur)
                self.radio_off()
            self.mode, self.clients, self.link = "wifi-off", 0, None
            return
        saved = self.saved()
        self.read_active()
        if self.want:
            self.pursue()
            return
        cur, st = self.cur, self.st
        if cur in (AP_NAME, SETUP_NAME):
            self.mode = "setup-ap" if cur == SETUP_NAME else "fallback-ap"
            self.captive_on()
            self.clients = self.station_count()
            if self.clients:
                self.last_client = now
            idle = now - self.last_client >= self.ci("IDLE_SEC")
            # ★★★ OWN WI-FI IS HELD while the radio is in use — none of the "a network is back" logic below runs. Once
            #     nobody has listened for RELEASE_SEC: back to a saved network if one is in range, else stay.
            if self.hold_own and cur == AP_NAME:
                if self.hold_quiet_for() >= self.ci("RELEASE_SEC"):
                    seen = self.scan_while_ap()
                    if seen is None or any(ssid_on_air(s, seen) for _, _, s, _ in saved) or any(h for _, _, _, h in saved):
                        self.network_again("Own Wi-Fi released: the radio has not been used for %d min"
                                           % (self.ci("RELEASE_SEC") // 60))
                    else:
                        self.hold_own = False      # nothing to go back to: the ordinary rescans take over
                return
            # ★ The OPEN setup hotspot gives way as soon as setup has saved a secured one and nobody
            #   is on it — networks first, the secured hotspot if none is in range.
            if cur == SETUP_NAME and self.have(AP_NAME) and idle:
                self.leave_hotspot_and_try("setup is finished; the open hotspot closes")
                return
            # ★★ A HOTSPOT WITH SOMEONE ON IT IS NEVER PULLED FROM UNDER THEM. Look for a saved
            #    network every RESCAN_SEC, and leave only once nobody has been on it for IDLE_SEC.
            if saved and now >= self.next_rescan:
                self.next_rescan = now + self.ci("RESCAN_SEC")
                seen = self.scan_while_ap()
                maybe = seen is None or any(ssid_on_air(s, seen) for _, _, s, _ in saved) or any(h for _, _, _, h in saved)
                if maybe and idle:
                    self.leave_hotspot_and_try("hotspot idle for %d s" % self.ci("IDLE_SEC"))
            return
        self.clients = 0
        if now < self.next_try:
            return
        if not saved:
            # First boot (or after a reset): scan while the radio is still a station, then open the door.
            if not self.scan_cache:
                self.scan()
            self.raise_hotspot("no Wi-Fi network saved yet")
            return
        if cur and st >= 100:
            self.connecting_since = None
            self.link = self.link_info()
            ps = self.powersave_check()
            if self.link is not None:
                self.link["powerSave"] = ps          # ★ shown beside the link's figures (state.json → the setup page)
            # ★★ THE SAFETY NET: the radio on a different network from the one its slot names (a reorder, or anything
            #    else that rewrote a live profile) → rejoin in the saved order, whatever caused it.
            prof = self.get(cur, "802-11-wireless.ssid")
            if self.link_ssid and prof and self.link_ssid != prof:
                log("the radio is on \"%s\" but slot %s now names \"%s\" — rejoining in order" % (self.link_ssid, cur, prof))
                self.down(cur)
                self.read_active()
                self.leave_hotspot_and_try("the saved networks changed under a live link")
                return
            if self.mode != "client":
                self.mode, self.since = "client", int(time.time())
                self.captive_off()          # ★ keeps (or, on a boot straight into a network, loads) :80
            rank = next((r for r, n, s, h in saved if n == cur), 10)
            if self.hold_net and self.hold_net != cur:
                self.hold_net = ""                  # the chosen network went (out of range): the usual order again
            if rank > 1 and now >= self.next_upgrade:
                self.next_upgrade = now + self.ci("UPGRADE_SEC")
                # ★★★ WHILE THE RADIO IS IN USE, STAY PUT (Stuart, 2026-10-11): "when in use wifi stays connected to
                #     whatever it was connected to when the session started until stopped then it can scan again, or
                #     if you move out of the wifi network range". Not even a scan — each one takes the radio
                #     off-channel for seconds. Losing the link is NetworkManager's to notice, and the paths below
                #     take over from there.
                if self.radio_quiet_for() < self.ci("IDLE_SEC"):
                    return
                # ★ A network picked in the menu is held like Own Wi-Fi: until RELEASE_SEC without a listener.
                if self.hold_net == cur and self.hold_quiet_for() < self.ci("RELEASE_SEC"):
                    return
                self.hold_net = ""
                vis = self.scan() or set()
                before = cur
                # ★★ blind=False: a "not visible" network (a phone's hotspot) is never probed FROM A WORKING LINK. A
                #    probe is a 30 s outage whenever the phone is not hosting — the portable box's drop every 16½ min
                #    all night (2026-10-11). It is still tried blind when there is nothing else (boot, link lost),
                #    and the menu's network choice is how to send the box to it on purpose.
                if self.try_networks(vis, below_rank=rank, blind=False) and self.cur != before:
                    log("moved up to a higher-priority network")
                elif not self.cur:
                    # ★ The upgrade attempt dropped us and failed — straight back to where we were.
                    self.up(before)
            return
        # On its way somewhere (NM's own autoconnect), or nowhere.
        if cur or now - self.boot_at < self.ci("BOOT_GRACE_SEC"):
            if self.connecting_since is None:
                self.connecting_since = now
            self.mode = "connecting"
            if now - self.connecting_since < max(60, self.ci("BOOT_GRACE_SEC")):
                return
        self.connecting_since = None
        self.leave_hotspot_and_try("not connected to anything")

    def write_state(self):
        saved = self.saved() if self.dev else []
        on_wifi_net = self.mode == "client"
        ap_set = self.have(AP_NAME) if self.dev else False
        doc = {
            "v": 1, "mode": self.mode, "since": self.since,
            "connection": self.cur,
            # ★★★ THE NETWORK THE RADIO IS ON, not the name in the slot (Stuart, 2026-10-10: "its a lie, that IP address is
            #     home network range" — after a reorder the slot said the phone while the radio was still on Home).
            "ssid": (self.link_ssid if self.mode == "client" and self.link_ssid
                     else (self.get(self.cur, "802-11-wireless.ssid") if self.cur else "")),
            "ip": self.ip4() if self.cur else "",
            "saved": [{"rank": r, "ssid": s, "hidden": h} for r, n, s, h in saved if r <= 3],
            "others": [{"name": n, "ssid": s} for r, n, s, h in saved if r > 3],
            "ap": {"set": ap_set, "ssid": self.get(AP_NAME, "802-11-wireless.ssid") if ap_set else ""},
            "setupSsid": self.conf.get("SETUP_SSID", DEFAULTS["SETUP_SSID"]),
            "country": self.conf.get("COUNTRY", DEFAULTS["COUNTRY"]),
            "scan": self.scan_cache, "scanAt": self.scan_at, "clients": self.clients,
            "rescanSec": self.ci("RESCAN_SEC"), "idleSec": self.ci("IDLE_SEC"),
            "apAddress": AP_ADDR, "lastError": self.last_error,
            "hold": self.hold_own,                                        # Own Wi-Fi chosen by hand
            "holdNet": self.hold_net and (self.get(self.hold_net, "802-11-wireless.ssid") or ""),
            # ★ The network chosen in the menu, while the box is still looking for it, and for how much longer.
            "trying": self.want["ssid"] if self.want else "",
            "tryLeft": max(0, int(self.want["until"] - self.sh.now())) if self.want else 0,
            "link": self.link if self.mode == "client" else None,        # signal / rates / retries
            # ★★ "full" = NM proved real internet. The server starts the tunnel ONLY on "full" — never
            #    on a hotspot, which has no upstream by definition.
            #  ★★ …or over a WIRED link, which has an upstream whatever the radio is doing (a Pi 2; a Pi 3 on its hotspot
            #     with Ethernet in) — NM's verdict covers every device.
            "internet": self.internet if on_wifi_net or self.wired else "none",
            # ★★★ THE WIRED SIDE (2026-10-13): what the page and the app need to stop being Wi-Fi-first on a wired box.
            "hasWifi": bool(self.dev),             # a Wi-Fi radio exists (a Pi 2 has none)
            "wifiOff": self.wifi_off,              # the owner switched it off (the radio is down, no hotspot)
            "wired": self.wired,                   # an Ethernet link with an address — the box is reachable there
            "wiredIp": self.wired_ip,
            # ★★★ False when the settings partition is not in use (vibeserver-pocket-data could neither find
            #     nor make it): setup would be held in RAM and lost at the next restart. The page says so.
            "settingsSaved": not os.path.exists(VOLATILE_FILE),
            # ★★★ The last JOIN_KEEP join attempts, oldest first (see JOIN_HISTORY) — admin-only, like the rest of this.
            "joins": self.history,
            # ★★ The owner's SSH switch (11.0.11): on/off, the login name, whether this box has sshd at all. Never a hash.
            "ssh": self.ssh.doc() if getattr(self, "ssh", None) else {"available": False, "on": False},
        }
        write_state_file(self.state_path, doc)


class NetWatch:
    """★★★ NETWORKMANAGER'S CONNECTIVITY, BY EVENT — not by polling the internet ourselves.
    NM already checks (its [connectivity] section — the image sets the URI) whenever a connection
    comes up and every few minutes after; `nmcli monitor` prints "Connectivity is now 'full'" each
    time that verdict changes. One long-lived nmcli, read without blocking; the server's tunnel
    follows it (vibedir::setInternet), so a box on its own hotspot never spawns cloudflared."""
    def __init__(self, sh):
        self.sh = sh
        self.proc = None
        self.buf = b""
        self.state = "unknown"
        self.retry_at = 0

    def query(self):
        rc, out = self.sh.run(["nmcli", "networking", "connectivity"], timeout=15)
        v = out.strip().lower()
        if rc == 0 and v:
            self.state = v

    def start(self):
        try:
            self.proc = subprocess.Popen(["nmcli", "monitor"], stdout=subprocess.PIPE, env=TOOL_ENV,
                                         stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
            os.set_blocking(self.proc.stdout.fileno(), False)
        except OSError:
            self.proc = None
        self.query()

    def poll(self):
        if self.proc is None or self.proc.poll() is not None:
            # ★ The monitor died (NM restarted): start it again, at most every 30 s.
            if self.sh.now() >= self.retry_at:
                self.retry_at = self.sh.now() + 30
                self.start()
            return self.state
        try:
            chunk = self.proc.stdout.read()
        except (BlockingIOError, OSError):
            chunk = None
        if chunk:
            self.buf += chunk
            *lines, self.buf = self.buf.split(b"\n")
            for line in lines:
                m = re.search(rb"[Cc]onnectivity is now '([a-z-]+)'", line)
                if m:
                    new = m.group(1).decode()
                    if new != self.state:
                        log("internet: %s" % new)
                    self.state = new
        return self.state


def owner_governor(path=None):
    """The governor the owner chose in setup ("" = the default, performance)."""
    try:
        with open(path or SERVER_CONF, "rb") as f:
            v = json.loads(f.read(256 * 1024).decode("utf-8")).get("cpuGovernor", "")
            return v if isinstance(v, str) else ""
    except (OSError, ValueError, UnicodeDecodeError, AttributeError):
        return ""


class GovernorFollower:
    """performance while the radio is in use, an idle governor after GOV_IDLE_SEC without a listener."""
    def __init__(self):
        self.applied = None

    def files(self):
        try:
            return sorted(os.path.join(CPUFREQ_DIR, d, "cpufreq", "scaling_governor")
                          for d in os.listdir(CPUFREQ_DIR) if re.match(r"cpu\d+$", d))
        except OSError:
            return []

    def tick(self):
        if owner_governor() not in ("", "performance"):
            return                                   # ★ the owner chose: leave it alone
        try:
            quiet = time.time() - os.stat(ACTIVE_FILE).st_mtime
        except OSError:
            quiet = 1e9
        files = [f for f in self.files() if os.path.exists(f)]
        if not files:
            return
        if quiet < GOV_IDLE_SEC:
            want = "performance"
        else:
            try:
                with open(os.path.join(os.path.dirname(files[0]), "scaling_available_governors")) as f:
                    avail = f.read().split()
            except OSError:
                avail = []
            want = next((g for g in IDLE_GOVERNORS if g in avail), None)
            if not want:
                return
        if want == self.applied:
            return
        for p in files:
            try:
                with open(p, "w") as f:
                    f.write(want)
            except OSError:
                pass
        if self.applied is not None or want != "performance":
            log("CPU governor: %s (%s)" % (want, "a listener" if want == "performance" else "nobody listening for a minute"))
        self.applied = want


def server_configured(path=SERVER_CONF):
    """True once "Save and start" has configured the server. Unreadable = not yet (the setup name)."""
    try:
        with open(path, "rb") as f:
            return json.loads(f.read(256 * 1024).decode("utf-8")).get("configured") is True
    except (OSError, ValueError, UnicodeDecodeError, AttributeError):
        return False


def read_plain(path, limit):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        return os.read(fd, limit).decode("ascii", "replace")
    finally:
        os.close(fd)


def write_state_file(path, doc):
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o755, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f)
        f.write("\n")
    # ★ 0640 root:vibeserver — the SSIDs are the owner's business, not every local user's.
    try:
        import grp
        os.chown(tmp, 0, grp.getgrnam("vibeserver").gr_gid)
        os.chmod(tmp, 0o640)
    except (KeyError, PermissionError, ImportError):
        os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def load_conf(paths=(CONF, STATE_CONF)):
    conf = dict(DEFAULTS)
    for path in paths:
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip().strip('"')
        except OSError:
            pass
    return conf


def load_history(path):
    """The join history from the settings partition; [] when missing or unreadable (never a reason to fail)."""
    try:
        with open(path, encoding="utf-8") as f:
            h = json.load(f)
        return [e for e in h if isinstance(e, dict)][-JOIN_KEEP:] if isinstance(h, list) else []
    except (OSError, ValueError):
        return []


def save_history(path, history):
    try:
        write_atomic(path, json.dumps(history[-JOIN_KEEP:], ensure_ascii=False), mode=0o600)   # ★ SSIDs: root only
    except OSError:
        pass                                              # ★ no settings partition: it lasts until the restart


def nft_drop(table):
    """An nft script that removes `table` in both families — "add, delete" so it is a no-op when it is not there."""
    return "table ip %s\ndelete table ip %s\ntable ip6 %s\ndelete table ip6 %s\n" % (table, table, table, table)


def nft_redirect(sh, table, port, match):
    """★★ :80 → :port in our own `table`, IPv4 AND IPv6 (`match` narrows it, e.g. 'iifname "wlan0" '). One nft script,
    loaded atomically — the "add, delete, add" opening makes it idempotent on any nft version. A kernel without IPv6 NAT
    refuses the whole script: then IPv4 alone, as before 2026-10-25. NM's shared mode has its own NAT rules; these
    never touch them. Returns True when loaded."""
    def chain(fam):
        return ("table %s %s {\n  chain pre {\n    type nat hook prerouting priority dstnat; policy accept;\n"
                "    %stcp dport 80 redirect to :%d\n  }\n}\n") % (fam, table, match, port)
    both = nft_drop(table) + chain("ip") + chain("ip6")
    if sh.run_input(["nft", "-f", "-"], both) == 0:
        return True
    v4 = "table ip %s\ndelete table ip %s\n" % (table, table) + chain("ip")
    if sh.run_input(["nft", "-f", "-"], v4) == 0:
        log("IPv6 NAT is not available here — the :80 redirect (%s) is IPv4 only" % table)
        return True
    return False


def write_atomic(path, text, mode=0o644):
    """★★★ A POWER CUT LEAVES THE OLD FILE OR THE NEW ONE, NEVER HALF OF EITHER: temp file, fsync,
    rename, fsync the directory (the rename itself is only durable once its directory is)."""
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        os.write(fd, text.encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def write_conf_value(key, value, path=STATE_CONF):
    lines, found = [], False
    try:
        with open(path) as f:
            for line in f:
                if line.split("=", 1)[0].strip() == key:
                    lines.append("%s=%s\n" % (key, value)); found = True
                else:
                    lines.append(line)
    except OSError:
        pass
    if not found:
        lines.append("%s=%s\n" % (key, value))
    write_atomic(path, "".join(lines))


def vibeserver_uid():
    try:
        import pwd
        return pwd.getpwnam("vibeserver").pw_uid
    except (KeyError, ImportError):
        return None


def quiet_hardware(sh, which=shutil.which):
    """★★ EVERYTHING A POCKET RADIO DOES NOT USE, OFF (Stuart + Kiko, 2026-10-10: power AND EMI — a running
    display output or Bluetooth radio is one more thing radiating next to the antenna).
      · the DISPLAY output: with the KMS driver off (the image), the firmware drives HDMI — or, with no HDMI
        plugged in, composite video on the AV jack of a Pi 3. display_power 0 powers that output down.
        Nobody can log in on a screen anyway (no getty, locked account).
      · Bluetooth: the image's dtoverlay=disable-bt removes it; this blocks it as well, for a box whose
        config.txt predates that line.
    Done here as well as in the image so a box that updates over apt gets it too."""
    if which("vcgencmd"):
        sh.run(["vcgencmd", "display_power", "0"], timeout=10)
    if which("rfkill"):
        sh.run(["rfkill", "block", "bluetooth"], timeout=10)


def avahi_limits(path=None):
    """★★★ THE SETUP NAME ON EVERY NETWORK (Stuart, 2026-10-13: "the mdns must be present whenever any network connection
    is present"). avahi answers on every interface and announces a new address the moment one appears (it follows the
    kernel's netlink events) — UNLESS its config restricts it. The image strips any allow-interfaces / deny-interfaces
    line (customise.sh); this reports one that came back (an owner's edit, a package's new default), so a journal says
    why vibeserversetup.local answers on Wi-Fi and not on Ethernet. Returns the active restricting lines."""
    out, section = [], ""
    try:
        with open(path or AVAHI_CONF) as f:
            for line in f:
                t = line.strip()
                if t.startswith("["):
                    section = t.lower()
                elif section == "[server]" and re.match(r"(allow|deny)-interfaces\s*=\s*\S", t):
                    out.append(t)
    except OSError:
        pass
    return out


# ── SSH, switched on by the owner (2026-10-25, 11.0.11) ─────────────────────────────────────────────────────────────
# ★★★ OFF BY DEFAULT, THE OWNER'S PASSWORD, NOTHING OF OURS (Stuart, 2026-10-25: "Enable SSH" for Portable / board cards).
#     A Portable's first network is an OPEN hotspot, so the image ships sshd off and the console gettys masked: no login
#     at all. This lets the owner switch SSH on from the admin page, with a password THEY type there.
#  ★★ THE ACCOUNT: `vibe` (uid 1000) — the image's own login (customise.sh makes it, LOCKED), a member of sudo, and the
#     account Raspberry Pi OS users expect. root is never given a password here: Debian's sshd refuses root password
#     logins (PermitRootLogin prohibit-password) and that stays as it is. ★★ Armbian's sshd_config says
#     PermitRootLogin yes (root's password is the documented 1234), so a board card adds a drop-in that says no. The owner logs in as vibe and uses sudo.
#  ★★ THE PASSWORD: handed to chpasswd on STDIN ("vibe:<password>"), never in an argument list, never logged. chpasswd
#     hashes it as the system does (yescrypt on Trixie). What is KEPT is only that HASH, read back from /etc/shadow.
#  ★★★ IT SURVIVES THE READ-ONLY ROOT. On a sealed Portable /etc/shadow and the running sshd live in the RAM overlay and
#     are gone at the next boot. So the switch, the user and the hash are kept on the SETTINGS PARTITION
#     (/var/lib/vibeserver-pocket = /data/pocket, root 0600), and every boot puts them back: `chpasswd -e` with the
#     hash, then `systemctl start ssh` (start, never enable — the image's "off" stays the default on the real root).
#     The host keys are kept there too, so the box does not present a new key — and a warning — after each power cycle.
#  ★ Off = sshd stopped, vibe locked again (usermod -L), the hash forgotten. The host keys stay (they are not secret to
#    anyone but the box, and keeping them means the next "on" is the same box to the owner's ssh client).
#  ★★★ DEBIAN'S OWN "NEVER RUN sshd" FILE (2026-10-25, Nick's Orange Pi One: sshd was listening with root/1234). An
#     Armbian card ships /etc/ssh/sshd_not_to_be_run (image/sbc/customise-armbian.sh): ssh.service and ssh.socket
#     carry ConditionPathExists=!/etc/ssh/sshd_not_to_be_run (sshd@.service is masked there), so NOTHING that starts sshd through
#     systemd — Armbian's first run (`service ssh restart`), its first console login (`systemctl restart ssh`), a
#     package upgrade — can start it while the file is there. So ON removes it before the start (every boot too: on a
#     sealed root the removal is in RAM) and OFF puts it back. A Raspberry Pi card has no such file and gains one only
#     when the owner switches SSH OFF here — which is what "off" means.
SSH_INBOX = "/var/lib/vibeserver/pocket-ssh.request"         # the daemon writes (0600), we read + delete
SSH_STATE = "/var/lib/vibeserver-pocket/ssh.json"            # ★ on the settings partition; root 0600
SSH_KEEP_KEYS = "/var/lib/vibeserver-pocket/ssh-host-keys"   # the box's own host keys, kept across boots
SSH_ETC = "/etc/ssh"
SSH_USER = "vibe"
SSH_UNIT = "ssh.service"
SSHD = "/usr/sbin/sshd"
SHADOW = "/etc/shadow"
SSH_PASS_MIN, SSH_PASS_MAX = 8, 128


def valid_ssh_password(p):
    """★ The same character rule as everywhere a password is typed: printable ASCII only — no newline (it would end
    chpasswd's line), nothing a terminal could not type. 8 characters at least: this one opens a shell."""
    return isinstance(p, str) and SSH_PASS_MIN <= len(p) <= SSH_PASS_MAX and all(0x20 <= ord(c) < 0x7F for c in p)


def validate_ssh_request(req):
    """{"on": true, "pass": "…"} or {"on": false} → (request, "") or (None, why). Re-checked here: the side that is root."""
    if not isinstance(req, dict) or not isinstance(req.get("on"), bool):
        return None, "on must be true or false"
    if not req["on"]:
        return {"on": False}, ""
    if not valid_ssh_password(req.get("pass")):
        return None, "the SSH password must be %d to %d ordinary characters" % (SSH_PASS_MIN, SSH_PASS_MAX)
    return {"on": True, "pass": req["pass"]}, ""


class SshAccess:
    """The switch. Every path is an attribute so the tests run it on a temporary root (test_pocket_ssh.py)."""

    def __init__(self, sh):
        self.sh = sh
        self.state, self.keep, self.etc, self.shadow, self.sshd = SSH_STATE, SSH_KEEP_KEYS, SSH_ETC, SHADOW, SSHD
        self.user = SSH_USER
        self.last_error = ""

    # ── what the admin page is told: no hash, no password, ever ──
    def doc(self):
        st = self._load()
        return {"available": self.available(), "on": bool(st.get("on")), "user": self.user, "lastError": self.last_error}

    def available(self):
        """openssh-server is on the image and the login exists — else the page does not offer the switch."""
        if not os.path.exists(self.sshd):
            return False
        try:
            import pwd
            pwd.getpwnam(self.user)
            return True
        except (KeyError, ImportError):
            return self._user_in(os.path.join(os.path.dirname(self.shadow), "passwd"))

    def _user_in(self, path):
        try:
            with open(path) as f:
                return any(line.split(":", 1)[0] == self.user for line in f)
        except OSError:
            return False

    def _load(self):
        try:
            with open(self.state) as f:
                d = json.load(f)
            return d if isinstance(d, dict) else {}
        except (OSError, ValueError):
            return {}

    def _hash(self):
        """The user's hash as the system wrote it — '' if none (locked: '!…', or '*')."""
        try:
            with open(self.shadow) as f:
                for line in f:
                    parts = line.rstrip("\n").split(":")
                    if parts[0] == self.user and len(parts) > 1:
                        return parts[1] if parts[1].startswith("$") else ""
        except OSError:
            pass
        return ""

    def _keys_in(self, d):
        try:
            return sorted(n for n in os.listdir(d) if n.startswith("ssh_host_") and n.endswith("_key"))
        except OSError:
            return []

    def _copy_keys(self, src, dst):
        os.makedirs(dst, mode=0o700, exist_ok=True)
        for n in self._keys_in(src):
            for name, mode in ((n, 0o600), (n + ".pub", 0o644)):
                s = os.path.join(src, name)
                if not os.path.isfile(s) or os.path.islink(s):
                    continue
                with open(s, "rb") as f:
                    data = f.read()
                t = os.path.join(dst, name)
                cur = None
                try:
                    with open(t, "rb") as f:
                        cur = f.read()
                except OSError:
                    pass
                if cur != data:
                    fd = os.open(t + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
                    try:
                        os.write(fd, data)
                        os.fsync(fd)
                    finally:
                        os.close(fd)
                    os.replace(t + ".tmp", t)

    def _host_keys(self):
        """The box's host keys: the kept ones put back, or (first time) the image's own kept, or new ones made."""
        if self._keys_in(self.keep):
            self._copy_keys(self.keep, self.etc)
            return
        if not self._keys_in(self.etc):
            self.sh.run(["ssh-keygen", "-A"], timeout=120)
        if self._keys_in(self.etc):
            self._copy_keys(self.etc, self.keep)

    def _save(self, doc):
        write_atomic(self.state, json.dumps(doc), mode=0o600)
        os.chmod(self.state, 0o600)

    def _no_run_file(self):
        return os.path.join(self.etc, "sshd_not_to_be_run")

    def _allow_sshd(self):
        """Remove Debian's "never run sshd" file so the start below is not skipped by its condition."""
        try:
            os.unlink(self._no_run_file())
        except FileNotFoundError:
            pass

    def _forbid_sshd(self):
        write_atomic(self._no_run_file(), "VibeServer Portable: SSH is off (the owner's switch on the admin page)\n")

    def apply(self, req):
        """The owner's request (already validated). Returns True when it took."""
        self.last_error = ""
        if not self.available():
            self.last_error = "SSH is not available on this box"
            log(self.last_error)
            return False
        if not req["on"]:
            self._forbid_sshd()
            self.sh.run(["systemctl", "stop", SSH_UNIT], timeout=30)
            self.sh.run(["usermod", "-L", self.user], timeout=30)
            self._save({"v": 1, "on": False, "user": self.user})
            log("SSH switched OFF by the owner (%s locked)" % self.user)
            return True
        # ★★★ STDIN, never argv: the password exists in this process and in chpasswd's input, nowhere else.
        if self.sh.run_input(["chpasswd"], "%s:%s\n" % (self.user, req["pass"])) != 0:
            self.last_error = "the SSH password could not be set"
            log(self.last_error)
            return False
        self.sh.run(["usermod", "-U", self.user], timeout=30)
        h = self._hash()
        if not h:
            self.last_error = "the SSH password could not be read back"
            log(self.last_error)
            return False
        self._host_keys()
        self._save({"v": 1, "on": True, "user": self.user, "hash": h})
        self._allow_sshd()
        self.sh.run(["systemctl", "start", SSH_UNIT], timeout=60)
        log("SSH switched ON by the owner — log in as %s" % self.user)
        return True

    def restore(self):
        """At every start: a switch left ON is put back on a root that forgot it (the read-only overlay)."""
        st = self._load()
        if not st.get("on") or not isinstance(st.get("hash"), str) or not st["hash"].startswith("$"):
            return False
        if not self.available():
            return False
        if self._hash() != st["hash"]:
            # ★ -e: the HASH is set as it is — the password itself was never kept.
            if self.sh.run_input(["chpasswd", "-e"], "%s:%s\n" % (self.user, st["hash"])) != 0:
                self.last_error = "the kept SSH password could not be put back"
                log(self.last_error)
                return False
        self._host_keys()
        self._allow_sshd()
        self.sh.run(["systemctl", "start", SSH_UNIT], timeout=60)
        log("SSH is on (the owner's switch, kept on the settings partition)")
        return True


def setup_once(box):
    sh = box.sh
    quiet_hardware(sh)
    for line in avahi_limits():
        log("!! avahi is limited to some interfaces (%s) — the .local name will not answer on every network" % line)
    # ★ The Pi's Wi-Fi is soft-blocked until a country is set; the image sets one, this makes sure. Not when the owner
    #   switched it off — tick() keeps it off (and brings it back if the box has no other way in).
    if not box.wifi_off:
        sh.run(["rfkill", "unblock", "wifi"], timeout=10)
        sh.run(["nmcli", "radio", "wifi", "on"], timeout=10)
    # ★★ THE WI-FI COUNTRY, EVERY BOOT. Setup saves the owner's country to the settings partition (STATE_CONF), but
    #    set_country's raspi-config writes it to cmdline.txt on /boot — READ-ONLY on a Portable — and its `iw reg set`
    #    lasted only until the next power cycle. So the box came back on whatever the image was built with, or the
    #    world domain if that never took: channels 12/13 passive, a phone hotspot there harder to find. Cheap, and
    #    harmless when it is already set.
    cc = str(box.conf.get("COUNTRY", "")).strip().upper()
    if valid_country(cc):
        sh.run(["iw", "reg", "set", cc], timeout=10)
    # ★★ Power save off in every profile we own, including those an older build saved (Phase 0.1) — by name, so it needs
    #    no radio and runs on a wired box too (a USB dongle's profile is ready when it appears).
    box.migrate_powersave()
    # ★ (migrate_pmf, which forced every saved network to PMF off, is gone: 2026-10-21 — each join now reads what the
    #   network advertises and rewrites the profile to match; a profile left at PMF off by 11.0.9 is put right then.)
    # ★★ THE DNS HIJACK — every name resolves to the box, but ONLY on NM's shared (hotspot)
    #    connections: this directory is read by the dnsmasq NM starts for a hotspot and by nothing
    #    else, so the box's own lookups as a client are untouched.
    try:
        os.makedirs(os.path.dirname(DNSMASQ_CONF), exist_ok=True)
        want = "# Written by vibeserver-pocket: on the box's own hotspot, every name is this box.\n" \
               "address=/#/%s\n" % AP_ADDR
        cur = None
        try:
            with open(DNSMASQ_CONF) as f:
                cur = f.read()
        except OSError:
            pass
        if cur != want:
            with open(DNSMASQ_CONF, "w") as f:
                f.write(want)
    except OSError as e:
        log("could not write the captive DNS rule (%s)" % e.strerror)
    take_reset_files(box, sh)


def take_reset_files(box, sh, files=None):
    """★★ The owner's forget-the-Wi-Fi file(s): reset ONCE however many there are, then delete every one — so it acts
    once, not at every boot. ★★ A Raspberry Pi card's boot partition is mounted READ-ONLY on a Portable, so a plain
    unlink failed (EROFS) and the file stayed: the box forgot its Wi-Fi again at every boot. It is remounted rw for the
    one delete, then ro again (2026-10-25). Returns how many were found."""
    found = [rf for rf in (RESET_FILES if files is None else files) if os.path.exists(rf)]
    if not found:
        return 0
    log("a reset file is on the card (%s) — forgetting every saved network and the hotspot" % os.path.basename(found[0]))
    box.reset_wifi()
    for rf in found:
        # ★★ On a SEALED root a file under /boot that is part of root (an Armbian card) lives in the overlay's LOWER layer:
        #    deleting it through the overlay only hides it until the next boot. So it is deleted there too.
        low = LOWER_ROOT + rf
        if os.path.lexists(low):
            sh.run(["mount", "-o", "remount,rw", LOWER_ROOT], timeout=20)
            try:
                os.unlink(low)
            except OSError as e:
                log("could not delete %s on the real root (%s)" % (rf, e.strerror))
            sh.run(["mount", "-o", "remount,ro", LOWER_ROOT], timeout=20)
        try:
            os.unlink(rf)
            continue
        except FileNotFoundError:
            continue
        except OSError as e:
            if e.errno != 30:          # ★ EROFS only; anything else is reported and left
                log("could not delete %s (%s)" % (rf, e.strerror))
                continue
        mp = os.path.dirname(rf)
        sh.run(["mount", "-o", "remount,rw", mp], timeout=20)
        try:
            os.unlink(rf)
        except OSError as e:
            log("could not delete %s (%s) — the Wi-Fi will be forgotten again at the next boot" % (rf, e.strerror))
        sh.run(["mount", "-o", "remount,ro", mp], timeout=20)
    return len(found)


def boot(box, configured=None):
    """The first things a starting service does, IN THIS ORDER — the name, then the links, then the radio's set-up.
    Never waits for a Wi-Fi device and never gives up for want of one (tested: test_vibeserver_pocket.py)."""
    box.sync_hostname(server_configured() if configured is None else configured)
    box.refresh_links()
    if not box.dev:
        log("no Wi-Fi device (yet) — answering on any wired link; a radio that appears later is managed then")
    setup_once(box)
    # ★★ The owner's SSH switch, put back on a root that forgot it (the read-only overlay) — see SshAccess.
    if getattr(box, "ssh", None):
        try:
            box.ssh.restore()
        except Exception as e:                # ★ never take the Wi-Fi service down over SSH
            log("SSH restore failed (%s)" % type(e).__name__)


class KeptLog:
    """★★★ The Wi-Fi lines of the RAM journal, copied in batches to the settings partition (see WIFI_LOG)."""

    def __init__(self, sh, path=WIFI_LOG, cap=WIFI_LOG_CAP, wall=time.time):
        self.sh, self.path, self.cap, self.wall = sh, path, cap, wall
        self.since = None             # wall-clock second of the last copy; None = not yet this run (take the whole boot)
        self.last_line = ""           # the newest line copied — the overlap of the next read is cut there
        self.last_at = -1e9           # monotonic time of the last copy
        self.next_at = sh.now() + 60  # ★ the first copy a minute in: the boot's own lines, once NetworkManager settled
        # ★ A restarted service (Restart=always) reads the whole boot again: the last line already kept cuts the repeat.
        try:
            with open(path, "rb") as f:
                f.seek(max(0, os.path.getsize(path) - 4096))
                tail = [l for l in f.read().decode("utf-8", "replace").splitlines() if l and not l.startswith("────")]
            self.last_line = tail[-1] if tail else ""
        except OSError:
            pass

    def soon(self):
        """After a join attempt: copy ~20 s from now (NetworkManager's lines about it will be in), but never more often
        than WIFI_LOG_MIN_GAP_SEC."""
        now = self.sh.now()
        self.next_at = min(self.next_at, max(now + WIFI_LOG_AFTER_JOIN_SEC, self.last_at + WIFI_LOG_MIN_GAP_SEC))

    def due(self):
        return self.sh.now() >= self.next_at

    def read_new(self):
        """The journal's Wi-Fi lines since the last copy, oldest first (the microsecond timestamp leads each line, so the
        two reads merge by it; lines of one read keep their order)."""
        span = ["-b"] if self.since is None else ["--since", "@%d" % (self.since - 2)]   # ★ a small overlap, cut below
        base = ["journalctl", "--no-pager", "-q", "-o", "short-iso-precise"] + span
        rc, units = self.sh.run(base + sum((["-u", u] for u in WIFI_LOG_UNITS), []), timeout=60)
        rc2, kern = self.sh.run(base + ["-k"], timeout=60)
        lines = (units.splitlines() if rc == 0 else []) + \
                [l for l in (kern.splitlines() if rc2 == 0 else []) if KERNEL_WIFI_LINE.search(l)]
        lines = sorted((l for l in lines if l.strip() and not l.startswith("-- ")), key=lambda l: l.split(" ", 1)[0])
        if self.last_line and self.last_line in lines:
            i = len(lines) - 1 - lines[::-1].index(self.last_line)
            lines = lines[i + 1:]
        return lines

    def flush(self, why=""):
        """Copy what is new; returns the number of lines written. Never raises (a full or missing partition loses only
        this copy)."""
        self.last_at = self.sh.now()
        self.next_at = self.last_at + WIFI_LOG_FLUSH_SEC
        try:
            first = self.since is None
            lines = self.read_new()
            self.since = int(self.wall())
            if not lines and not first and not why:
                return 0                                      # ★ nothing new: no write at all
            if lines:
                self.last_line = lines[-1]
            text = ""
            if first:
                text += "──── %s: vibeserver-pocket started (this boot's Wi-Fi lines follow) ────\n" % \
                        time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(self.wall()))
            text += "".join(l + "\n" for l in lines)
            if why:
                text += "──── %s: %s ────\n" % (time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(self.wall())), why)
            data = text.encode("utf-8")
            if len(data) > self.cap:
                data = data[-self.cap:]
                data = data[data.find(b"\n") + 1:]
            try:
                size = os.path.getsize(self.path)
            except OSError:
                size = 0
            if size and size + len(data) > self.cap:
                os.replace(self.path, self.path + ".1")      # ★ the one rotation: never more than two files
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            try:
                os.write(fd, data)
            finally:
                os.close(fd)
            return len(lines)
        except Exception as e:
            log("could not keep the Wi-Fi log (%s) — it is in the RAM journal only" % type(e).__name__)
            return 0


CONVERGE = "/usr/lib/vibeserver/vibeserver-pocket-converge"


def converge_report(run=subprocess.run, path=CONVERGE):
    """★★ IS THIS BOX WHAT THIS RELEASE EXPECTS? (Stuart, 2026-10-13: Portables "fully updated without needing a full
    ISO again".) The admin Update applies vibeserver-pocket-converge to the real root; this asks the same script
    `--check` once at start and LOGS anything not converged — a package the Update could not install, a unit an owner
    re-enabled by hand, a config.txt line missing because the boot partition was out of reach. Report only: the root is
    the read-only overlay, so a change made here would vanish at the next boot (the converge refuses anyway), and
    nothing heavy belongs in the first seconds of a box that is raising its hotspot. Run on a THREAD (daemon), so a
    slow SD card never delays the Wi-Fi; any failure is a log line, never a crash. Returns the lines it logged."""
    out = []
    if not os.path.exists(path):
        return out
    try:
        r = run([path, "--check"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)
        text = r.stdout.decode("utf-8", "replace") if isinstance(r.stdout, bytes) else (r.stdout or "")
        if r.returncode != 0:
            for line in text.splitlines():
                if line.strip():
                    out.append(line.strip())
                    log("converge: " + line.strip())
            log("converge: the next 'Install updates' brings this box up to date")
    except Exception as e:                    # ★ never take the Wi-Fi service down over a report
        log("converge check could not run (%s)" % type(e).__name__)
    return out


def main_loop():
    if not os.path.exists(MARKER):
        log("not a pocket image (%s missing) — nothing to do" % MARKER)
        return 0
    sh = Shell()
    box = Box(sh, load_conf())
    box.ssh = SshAccess(sh)
    # ★★★ THE NAME BEFORE ANYTHING ELSE (Stuart, 2026-10-13: "the MDNS for vibeserversetup.local:48000 must be live the
    #     second it detects a network"). This used to wait up to 120 s for a Wi-Fi device and then EXIT without one — so
    #     on a Pi 2 the hostname was never synced (vibepocket.local never answered after setup) and no state was ever
    #     written. Now the name is set first, and a box without Wi-Fi runs on as a wired box (Box.tick: "wired").
    boot(box)
    import threading
    threading.Thread(target=converge_report, name="converge-check", daemon=True).start()
    uid = vibeserver_uid()
    net = NetWatch(sh)
    net.start()
    gov = GovernorFollower()
    kept = KeptLog(sh)
    box.after_join = kept.soon
    # ★ A stop (reboot, update, restart) copies the last lines first: SIGTERM ends the loop through the finally below.
    import signal
    def _term(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, _term)
    try:
        run_loop(sh, box, net, gov, kept, uid)
    finally:
        kept.flush("vibeserver-pocket stopped (a reboot, an update or a restart)")


def run_loop(sh, box, net, gov, kept, uid):
    was_mode = None
    last_tick = 0
    # ★ What the kick words below need: a radio, switched on.
    radio_words = {"switch", "own", "network", "net-1", "net-2", "net-3", "scan", "scan-force"}
    while True:
        data = read_request_file(INBOX, uid)
        if data is not None:
            try:
                req, err = validate_request(json.loads(data.decode("utf-8")))
            except (ValueError, UnicodeDecodeError):
                req, err = None, "not valid JSON"
            del data
            if req is None:
                box.last_error = "settings refused: " + err
                log(box.last_error)
            elif not box.dev:
                box.last_error = "settings refused: this box has no Wi-Fi"
                log(box.last_error)
            else:
                box.apply(req)
                # ★ Saved while Wi-Fi is off: kept for when it is switched on, never a reason to switch it on.
                if req["switch"] and not box.wifi_off:
                    box.leave_hotspot_and_try("the owner asked to switch now")
            last_tick = 0
        sreq = read_request_file(SSH_INBOX, uid, limit=1024)
        if sreq is not None:
            try:
                req, err = validate_ssh_request(json.loads(sreq.decode("utf-8")))
            except (ValueError, UnicodeDecodeError):
                req, err = None, "not valid JSON"
            del sreq
            if req is None:
                box.ssh.last_error = "SSH request refused: " + err
                log(box.ssh.last_error)
            else:
                try:
                    box.ssh.apply(req)
                except Exception as e:        # ★ never die on it; the page shows the error
                    box.ssh.last_error = "SSH: internal error (%s)" % type(e).__name__
                    log(box.ssh.last_error)
                req = None
            last_tick = 0
        kick = read_request_file(KICK, uid, limit=32)
        if kick is not None:
            word = re.sub(r"[^a-z0-9-]", "", kick.decode("ascii", "replace"))
            cur, _ = box.read_active()
            if word in radio_words and (not box.dev or box.wifi_off):
                box.last_error = "Wi-Fi is off" if box.dev else "this box has no Wi-Fi"
            elif word == "wifi-off":
                box.wifi_switch(True)
            elif word == "wifi-on":
                box.wifi_switch(False)
            elif word == "switch":
                box.leave_hotspot_and_try("the owner asked to switch now")
            elif word == "own":
                box.own_wifi()
            elif word == "network":
                box.network_again("the owner chose Network")
            elif word in ("net-1", "net-2", "net-3"):
                box.choose_net(int(word[-1]))
            elif word == "scan":
                if cur in (AP_NAME, SETUP_NAME):
                    seen = box.scan_while_ap()
                    if seen is not None:
                        box.scan_cache = [{"ssid": s, "signal": 0, "secure": True} for s in sorted(seen)]
                        box.scan_at = int(time.time())
                else:
                    box.scan()
            elif word == "scan-force" and cur in (AP_NAME, SETUP_NAME):
                # ★ The owner asked, knowing the hotspot drops for a few seconds (the page says so).
                box.down(cur); box.captive_off(); sh.sleep(2)
                box.scan()
                box.raise_hotspot("back after a scan the owner asked for")
            last_tick = 0
        box.internet = net.poll()
        if sh.now() - last_tick >= 5:
            last_tick = sh.now()
            if (box.mode, box.wired) != was_mode:
                # ★ A new connection: ask once now — the change event may have come before we looked.
                was_mode = (box.mode, box.wired)
                if box.mode == "client" or box.wired:
                    net.query()
                    box.internet = net.state
            box.sync_hostname(server_configured())
            gov.tick()
            try:
                box.tick()
            except Exception as e:            # ★ never die on one bad turn; systemd would only restart us
                box.last_error = "internal: %s" % type(e).__name__
                log(box.last_error)
            box.write_state()
            if kept.due():
                kept.flush()
        sh.sleep(1)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "run":
        sys.exit(main_loop() or 0)
    if cmd == "status":
        try:
            with open(os.path.join(STATE_DIR, "state.json")) as f:
                print(f.read(), end="")
        except OSError:
            print("no state yet")
        sys.exit(0)
    if cmd == "reset-wifi":
        b = Box(Shell(), load_conf())
        b.dev = b.wifi_device()
        b.reset_wifi()
        sys.exit(0)
    print("usage: vibeserver-pocket [run|status|reset-wifi]", file=sys.stderr)
    sys.exit(2)
