#!/bin/bash
# ★ bash, NOT sh: the output capture below uses process substitution (`> >(tee …)`), which dash
#   does not support — and Debian's /bin/sh IS dash. Under sh this script would have failed at the
#   first line that mattered, as root, with the failure visible only in the journal. bash is an
#   Essential package on Debian, so this adds no dependency.
# VibeServer — perform one maintenance action, as root, on behalf of the unprivileged daemon.
#
# ★★★ WHY A HELPER AND NOT sudo. The service runs with NoNewPrivileges=yes — correct hardening for
# a daemon exposed to the internet — and that flag makes sudo impossible by design, whatever the
# sudoers file says ("sudo: The 'no new privileges' flag is set, which prevents sudo from running
# as root"). The choice was to weaken the sandbox or to stop asking the daemon to elevate at all.
# This is the second: the daemon WRITES A REQUEST, systemd notices the file (vibeserver-
# maintenance.path) and runs this script as root. The daemon never holds privilege for a moment.
#
# ★★★ AND IT IS A BETTER BOUNDARY THAN sudo WAS. The list of permitted actions lives HERE, in a
# root-owned file the daemon cannot write to. Even if the daemon were compromised outright, the
# most it can do is ask for one of these things by name. That is the same argument that kept
# a web terminal out of the admin page, applied one layer down.
#
# ★★ The request is DELETED BEFORE it is acted on (just after the log is reset — see below).
#    systemd's .path unit triggers on the file EXISTING, so a request left in place after a failure would re-trigger for ever — a reboot
#    loop, on a machine in a loft.
set -e

REQ=/var/lib/vibeserver/maintenance.request
# ★★★ THE REQUEST LIVES IN THE DAEMON'S DIRECTORY, AND THIS SCRIPT IS ROOT. A symlink there (to a
#     FIFO, to /dev/zero, to a secret) is never followed: removed and ignored. Only a regular file
#     is read, and at most 32 bytes of it, filtered to a-z and '-' — so the most the daemon can put
#     in front of root is one of the action names below.
if [ -L "$REQ" ]; then rm -f "$REQ"; exit 0; fi
[ -f "$REQ" ] || exit 0

# ★ dd iflag=nofollow: the -L test above and this read are two moments, and a link swapped in
#   between them must make the read FAIL, not follow. nonblock so a FIFO cannot hang root here.
action=$(dd if="$REQ" bs=32 count=1 iflag=nofollow,nonblock 2>/dev/null | tr -cd 'a-z-' || true)

# ★★★ EVERYTHING THIS SCRIPT PRINTS GOES SOMEWHERE THE ADMIN PAGE CAN READ IT.
# Without this the output existed only in the journal, which the daemon cannot read (it is
# unprivileged) — so pressing "Install updates" produced a button that went quiet and a person
# with no idea whether apt was working, finished, or had failed. For an action that can take
# minutes and reboot the machine afterwards, "no feedback" is the same as "broken"
# (Stuart, 2026-08-07).
# ★ Truncated at the start of each action, so the page always shows THIS run and never a
#   confusing tail of the last one.
# ★★★ AND IT LIVES IN A ROOT-OWNED DIRECTORY, NOT THE DAEMON'S (2026-10-03 security pass). This used
#     to be /var/lib/vibeserver/maintenance.log, and `: >`, `chmod` and `tee -a` all FOLLOW A
#     SYMLINK — so a compromised daemon could plant one and have root truncate, chmod 644 and append
#     to any file on the machine. /var/lib/vibeserver-maint is root:vibeserver 0750 and the log is
#     0640: the daemon can READ it for the admin page and can neither replace nor redirect it.
#  ★ /var/lib is root's, so nobody but root can have created this path; a link here is still
#    refused rather than trusted, in case a hand edit put one there.
LOGDIR=/var/lib/vibeserver-maint
LOG=$LOGDIR/maintenance.log
[ -L "$LOGDIR" ] && rm -f "$LOGDIR"
# ★ Every step of the log set-up is allowed to fail: it is a convenience for the admin page, and
#   under set -e a failure here would exit BEFORE the request is removed — the re-trigger loop the
#   header warns about.
install -d -o root -g vibeserver -m 0750 "$LOGDIR" 2>/dev/null \
  || install -d -o root -g root -m 0755 "$LOGDIR" 2>/dev/null || true
# ★ rm then create, so the file is always one this run made: 0640, root, the daemon's group.
rm -f "$LOG" 2>/dev/null || true
( umask 027 && : > "$LOG" ) 2>/dev/null || true
chgrp vibeserver "$LOG" 2>/dev/null || true
# ★★ THE REQUEST GOES ONLY NOW — AFTER THE LOG IS EMPTY. The daemon reports "waiting to start"
#    for as long as the request file exists, and reads the log once it has gone; removing the
#    request before truncating left a moment in which the page saw the PREVIOUS run's finished
#    log and reported the new action as already done. Still before the action itself, so a
#    failing action can never re-trigger the .path unit for ever.
rm -f "$REQ"
# ★ The old location, from before this moved. Removing a symlink removes only the link.
rm -f /var/lib/vibeserver/maintenance.log
# ★ Only once the log is there; without it the output goes to the journal as it always could.
if [ -f "$LOG" ] && [ ! -L "$LOG" ]; then exec > >(tee -a "$LOG") 2>&1; fi
# ★★ The daemon decides "still running?" by the ABSENCE of this marker, so it must be written on
#    EVERY exit path — including a failure. A trap is the only way to be sure of that; an `echo`
#    at the end of the happy path would leave a failed update looking like one still in progress,
#    for ever.
finish() { rc=$?; echo "__VIBESERVER_DONE__ $rc"; }
trap finish EXIT

log() { echo "$*"; }

# ★★★ A READ-ONLY ROOT (the pocket image, 2026-10-10). With overlayroot=tmpfs every write to / lands in
#     RAM and is gone at the next boot — so apt run normally would "install" an update that vanishes,
#     using RAM the radio wants. Package work goes to the REAL root instead, through overlayroot's own
#     overlayroot-chroot (it remounts the lower filesystem read-write for the duration), with the boot
#     partition writable for a kernel or config.txt change — and the box REBOOTS afterwards, because an
#     overlay whose lower layer changed underneath it is not a state to keep running in.
#  ★ This is the one window in which the pocket box writes its root, so the doc says to leave it
#    powered until it is back. Everywhere else (no overlay) this is exactly the old behaviour.
OVERLAY=0
grep -qw "overlayroot=tmpfs" /proc/cmdline 2>/dev/null && command -v overlayroot-chroot >/dev/null && OVERLAY=1
# ★★★ AND THE BOOT PARTITION — AND /dev — IN THE CHROOT (2026-10-13). overlayroot-chroot binds only /proc /run /sys into
#     the real root (its lowerdir, /media/root-ro). The boot partition there is just an empty /boot/firmware directory,
#     so a config.txt line (vibeserver-pocket-converge), a kernel or an initramfs written in there landed on the ROOT
#     partition, where the firmware never looks.
#  ★★ The first fix (88b3b75e) mounted the boot device from INSIDE the chroot — and on Stuart's Portable it printed
#     "the boot partition could not be mounted inside the chroot": with no /dev bound in there, /dev/mmcblk0p1 does not
#     exist to mount. So both are BOUND FROM OUTSIDE, onto the lowerdir, before overlayroot-chroot runs:
#       · /dev — the chroot's apt, dpkg and initramfs hooks expect devices (a chroot without /dev is not a system);
#       · the live boot partition, remounted rw — overlayroot-chroot itself then lists it among the lowerdir's /dev/
#         mounts and keeps it writable for the duration; the kernel hands back the one superblock, so both views are
#         the same files.
#    Both are unmounted again afterwards, in reverse order, whatever the command returned. Already mounted there, or
#    no boot partition: left exactly as before.
#  ★ The initramfs half of the same night is in vibeserver-pocket-initramfs.conf (MODULES=dep cannot find / here).
apt_do() {
  if [ "$OVERLAY" = 1 ]; then
    local LOWER="" BOOTMP="" BOUND="" rc=0 B
    LOWER=$(awk '$1 == "overlayroot" && $2 == "/" { print $0 }' /proc/mounts)
    LOWER=${LOWER##*lowerdir=}; LOWER=${LOWER%%,*}
    for B in /boot/firmware /boot; do
      mountpoint -q "$B" && mount -o remount,rw "$B" 2>/dev/null && { BOOTMP=$B; break; }
    done
    if [ -n "$LOWER" ] && mountpoint -q "$LOWER"; then
      if [ -d "$LOWER/dev" ] && ! mountpoint -q "$LOWER/dev"; then
        mount --bind /dev "$LOWER/dev" && BOUND="$LOWER/dev $BOUND"
      fi
      if [ -n "$BOOTMP" ] && [ -d "$LOWER$BOOTMP" ] && ! mountpoint -q "$LOWER$BOOTMP"; then
        if mount --bind "$BOOTMP" "$LOWER$BOOTMP"; then BOUND="$LOWER$BOOTMP $BOUND"
        else log "(the boot partition could not be bound into the real root — config.txt and the kernel left as they are)"; fi
      fi
    fi
    overlayroot-chroot env DEBIAN_FRONTEND=noninteractive "$@" || rc=$?
    sync
    for B in $BOUND; do umount "$B" 2>/dev/null || umount -l "$B" 2>/dev/null || true; done
    if [ -n "$BOOTMP" ]; then mount -o remount,ro "$BOOTMP" 2>/dev/null || true; fi
    return $rc
  fi
  DEBIAN_FRONTEND=noninteractive "$@"
}
after_install() {
  if [ "$OVERLAY" = 1 ]; then log "read-only root updated — rebooting so it takes effect"; sync; systemctl reboot; fi
}

# ★★★ A PORTABLE UPDATES FULLY, NOT JUST ITS PACKAGE (Stuart, 2026-10-13: "after initial setup we need to make sure that
#     VibeServer Portables can be fully updated without needing a full ISO again"). After the vibeserver upgrade, on a
#     box carrying the pocket marker ONLY:
#       1. any system package pocket-packages.txt names that the box lacks is installed — the list ships IN the package
#          just installed and is read INSIDE the chroot, so it is this release's list, not the one the run started with;
#       2. vibeserver-pocket-converge brings the OS to this release's state (services, drop-ins, config.txt, fstab).
#          postinst ran it already; this run also sees the packages from step 1 and the boot partition.
#  ★★ Still ONE THING BY NAME, never something the daemon chose: the list is a root-owned file from our signed
#     package, and nothing the unprivileged daemon writes reaches this line. An ordinary install never gets here.
#  ★ A failure in either step is logged and the update carries on to its reboot: the server itself is already new,
#    and the next Update tries again (both steps are idempotent).
pocket_converge() {
  [ -f /etc/vibeserver-pocket/enabled ] || return 0
  [ -x /usr/lib/vibeserver/vibeserver-pocket-converge ] || return 0
  log "Portable: checking the system packages and settings this release expects"
  # shellcheck disable=SC2016
  apt_do /bin/sh -c 'M=$(/usr/lib/vibeserver/vibeserver-pocket-converge --missing-packages) || exit 0
    [ -n "$M" ] || exit 0
    echo "Portable: installing $M"
    apt-get install -y --no-install-recommends $M' \
    || log "!! Portable: some system packages did not install — the next Update tries again"
  apt_do /usr/lib/vibeserver/vibeserver-pocket-converge \
    || log "!! Portable: the settings check did not finish — the next Update runs it again"
}

# ★★★ BETA UPDATES — AN OPT-IN, AND THE WAY BACK (Stuart, 2026-10-22: "In the admin menu have an opt in message to
#     receive beta updates, user ticks it and then V12 gets offered, user unticks it V11 gets offered instead").
#     The tick IS ONE FILE: /etc/apt/sources.list.d/vibesdr-beta.list, naming suite `beta` of the same repository with
#     the same key. Present = ticked. The daemon reads the tick from that file's existence and never remembers it
#     itself, so the box can never claim beta is on when apt would not offer one (or the other way round).
#  ★★ beta-on ADDS a source; it never replaces the stable one. apt then offers the newest of both suites, and a V12
#     beta (12.0.0~betaN) sorts above every 11.x — so "Update VibeServer" installs it, nothing else needed.
#  ★★ beta-off REMOVES the file. apt never downgrades by itself, so a box running a beta stays on it, and the page
#     offers the newest STABLE version as "back to stable" — installed only by `update-stable`, which is only ever
#     asked for by a person pressing the button. The scheduled update sends `update`, which can never downgrade
#     (--only-upgrade), so nothing unattended ever goes backwards.
#  ★ The beta line copies the options of the stable line (arch=, signed-by=) — two sources for one host with
#    different Signed-By values make apt refuse to update AT ALL. No stable line of ours (a hand-made .sources
#    file, say): the installer's own form, if our keyring is there; otherwise refused, rather than guessed.
STABLE_LIST=/etc/apt/sources.list.d/vibesdr.list
BETA_LIST=/etc/apt/sources.list.d/vibesdr-beta.list
KEYRING=/usr/share/keyrings/vibesdr.gpg
OFFER=$LOGDIR/update-offer
beta_is_on() { [ -f "$BETA_LIST" ] && [ ! -L "$BETA_LIST" ]; }
beta_line() {
  local opts=""
  if [ -f "$STABLE_LIST" ] && [ ! -L "$STABLE_LIST" ]; then
    opts=$(sed -nE 's#^[[:space:]]*deb[[:space:]]+(\[[^]]*\])[[:space:]]+https?://apt\.vibesdr\.net/?[[:space:]]+stable[[:space:]]+main([[:space:]].*)?$#\1#p' \
             "$STABLE_LIST" | head -1 | tr -cd 'A-Za-z0-9 =,/._[]-')
  fi
  if [ -z "$opts" ]; then
    [ -s "$KEYRING" ] || return 1
    opts="[arch=$(dpkg --print-architecture) signed-by=$KEYRING]"
  fi
  echo "deb $opts https://apt.vibesdr.net beta main"
}
# ★ Written (or removed) where apt will read it: on a sealed Portable that is the REAL root, through apt_do, AND
#   the live overlay, so the page shows the change before the reboot that a later Update makes. rm, then a temp
#   file renamed into place, so a half-written list is never seen and a link in the way is replaced, not followed.
beta_write() {
  # shellcheck disable=SC2016
  local sh='rm -f "$1" "$1.tmp"; [ -n "$2" ] || exit 0
    ( umask 022 && printf "%s\n" "# VibeServer BETA updates. Written by the admin page (Receive beta updates);" \
        "# untick it there, or delete this file and run apt update, to go back to stable releases only." "$2" > "$1.tmp" ) \
      && mv -f "$1.tmp" "$1"'
  apt_do /bin/sh -c "$sh" sh "$BETA_LIST" "$1"
  if [ "$OVERLAY" = 1 ]; then /bin/sh -c "$sh" sh "$BETA_LIST" "$1"; fi
}
# >>> offer_for — WHAT "Update VibeServer" WOULD INSTALL. A pure function of four values; scripts/…/test_vibeserver_
#     maintenance.py runs it on its own, with every combination. Prints "<kind> <version>":
#       beta | stable      a newer version than the one installed, and which suite it comes from
#       back-to-stable     beta updates are OFF and the installed version is newer than the newest stable one
#                          (a beta): the newest stable, a DOWNGRADE, done only by `update-stable`
#       none               nothing to do          unknown   the repository named no VibeServer at all (offline?)
#  ★ With beta ON and a beta installed that is newer than everything published (an older beta pruned): none.
#  ★ The same version in both suites counts as stable.
ver_gt() { dpkg --compare-versions "$1" gt "$2"; }
offer_for() {   # $1 beta on (1/0)  $2 installed  $3 newest stable  $4 newest beta
  local best="" kind=""
  if [ "$1" = 1 ] && [ -n "$4" ] && { [ -z "$3" ] || ver_gt "$4" "$3"; }; then best=$4; kind=beta
  elif [ -n "$3" ]; then best=$3; kind=stable
  fi
  if [ -z "$best" ]; then echo "unknown"; return 0; fi
  if [ -z "$2" ] || ver_gt "$best" "$2"; then echo "$kind $best"; return 0; fi
  if [ "$1" != 1 ] && ver_gt "$2" "$best"; then echo "back-to-stable $best"; return 0; fi
  echo "none"
}
# ★ The newest version of ours in one suite, from `apt-cache madison vibeserver` on stdin
#   (" vibeserver | 11.0.10-4 | https://apt.vibesdr.net stable/main arm64 Packages").
newest_in() {
  local best="" v
  for v in $(awk -F'|' -v s=" $1/" 'index($3, "apt.vibesdr.net") && index($3, s) { gsub(/[[:space:]]/, "", $2); print $2 }' \
               | tr -cd 'A-Za-z0-9.+~:\n-'); do
    if [ -z "$best" ] || ver_gt "$v" "$best"; then best=$v; fi
  done
  echo "$best"
}
# <<< offer_for
# ★★ THE OFFER, WRITTEN FOR THE ADMIN PAGE after every action that can change it. Root's directory, root:vibeserver
#    0640, the same arrangement as the log: the daemon reads it and can never replace or redirect it. Never fatal.
OFFER_KIND=""; OFFER_VER=""; OFFER_INST=""
write_offer() {
  local m s b o on=0
  beta_is_on && on=1
  m=$(apt_do apt-cache madison vibeserver 2>/dev/null || true)
  OFFER_INST=$(dpkg-query -W -f='${Version}' vibeserver 2>/dev/null | tr -cd 'A-Za-z0-9.+~:-' || true)
  s=$(printf '%s\n' "$m" | newest_in stable)
  b=$(printf '%s\n' "$m" | newest_in beta)
  o=$(offer_for "$on" "$OFFER_INST" "$s" "$b")
  OFFER_KIND=${o%% *}; OFFER_VER=""; [ "$o" = "$OFFER_KIND" ] || OFFER_VER=${o#* }
  rm -f "$OFFER" "$OFFER.tmp" 2>/dev/null || true
  ( umask 027 && printf 'beta=%s\ninstalled=%s\noffer=%s\nversion=%s\nstable=%s\nbetaver=%s\nchecked=%s\n' \
      "$on" "$OFFER_INST" "$OFFER_KIND" "$OFFER_VER" "$s" "$b" "$(date +%s)" > "$OFFER.tmp" ) 2>/dev/null || return 0
  chgrp vibeserver "$OFFER.tmp" 2>/dev/null || true
  mv -f "$OFFER.tmp" "$OFFER" 2>/dev/null || true
}
say_offer() {
  case "$OFFER_KIND" in
    beta)           echo "A NEW VIBESERVER IS AVAILABLE: $OFFER_VER (beta)." ;;
    stable)         echo "A NEW VIBESERVER IS AVAILABLE: $OFFER_VER." ;;
    back-to-stable) echo "Beta updates are off. $OFFER_VER is the newest stable VibeServer (this is $OFFER_INST);"
                    echo "press BACK TO STABLE to return to it. Your settings are kept." ;;
    none)           echo "VibeServer itself is up to date ($OFFER_INST)." ;;
    *)              echo "The repository did not list VibeServer — is this machine online?" ;;
  esac
}

# ★★★ A NEW CARD'S ONE UPDATE CHECK (Stuart, 2026-10-28: "Make the SBC cards check for a VibeServer update on first
#     install if connected to the internet, that way any fixes other than underlying OS stuff get put on the box the
#     minute it gets set up, then the owner can choose auto updates thereafter"). His flow, exactly:
#       1. the owner flashes the card and connects to it;  2. they set up the network in the setup page;
#       3. THEN the setup page asks for this, ONCE, and shows it ("Checking for a VibeServer update…" → "Updated to
#          11.0.x" / "Up to date");  4. no internet → "cannot check — proceeding with setup", and setup goes on;
#       5. a check or update that FAILS is NEVER tried again by itself — not at boot, not later. From then on only the
#          owner's own Update button or the auto-update schedule they choose;
#       6. a Cancel while it runs: the installed VibeServer stays intact — the download is stopped, and once dpkg has
#          started it is let finish (the page says so). Never a half-installed package.
#  ★★ ONCE MEANS ONCE. The record is written BEFORE anything touches the network, on the settings partition (the bound
#     /var/lib/vibeserver-pocket), and this action refuses to run while it exists — a reload of the page, a second
#     request, a power cut mid-way: none of them runs it again. Only a CARD that was built to do it (the image's
#     /etc/vibeserver-pocket/first-update, image/pocket customise.sh) ever does: a box that updated to this package
#     from an older one was set up long ago, and its owner's choices already stand.
#  ★★ IT IS THE `update` ACTION, NOT A SECOND UPDATER: the same apt_do (the real root through overlayroot-chroot on a
#     sealed card), --only-upgrade of vibeserver ALONE (never the OS — Pi OS / Armbian stay as built), the same
#     pocket_converge, the same reboot on a read-only root. What it adds: a quick look first (our repository only, into
#     a throwaway list directory, so nothing is written anywhere when there is nothing to do), time limits, a cancel,
#     and the result recorded for the page.
#  ★ Never a downgrade: only an offer of kind stable/beta (a NEWER version, offer_for) is installed, by exact version,
#    with --only-upgrade. A beta card (built from a ~beta package, so it carries the beta source) gets the newest beta.
FIRST_ARM=/etc/vibeserver-pocket/first-update
FIRST_REC=/var/lib/vibeserver-pocket/first-update
FIRST_CANCEL=/var/lib/vibeserver/first-update.cancel
FIRST_TMP=/run/vibeserver-first-update
# ★ The time limits. VIBE_FIRST_*_SECS exist for test_first_update_inner.sh only: the helper runs from a root unit with
#   no environment of the daemon's, so nothing the daemon writes can reach them.
FIRST_CHECK_SECS=${VIBE_FIRST_CHECK_SECS:-90}       # the quick look at our repository
FIRST_INDEX_SECS=${VIBE_FIRST_INDEX_SECS:-600}      # every source's index, through the chroot (a Pi Zero parsing Debian's is slow)
FIRST_FETCH_SECS=${VIBE_FIRST_FETCH_SECS:-900}      # the package itself
first_rec() {   # <state> <from> <to> [why] — checking | downloading | installing | updated | uptodate | offline | failed | cancelled
  local d; d=$(dirname "$FIRST_REC")
  [ -L "$d" ] && return 0
  install -d -m 0755 "$d" 2>/dev/null || true
  rm -f "$FIRST_REC.tmp" 2>/dev/null || true
  ( umask 022 && printf 'state=%s\nfrom=%s\nto=%s\nwhy=%s\ntime=%s\n' "$1" "$2" "$3" "${4:-}" "$(date +%s)" \
      > "$FIRST_REC.tmp" ) 2>/dev/null || return 0
  sync "$FIRST_REC.tmp" 2>/dev/null || sync
  mv -f "$FIRST_REC.tmp" "$FIRST_REC" 2>/dev/null || true
  sync "$d" 2>/dev/null || sync
}
# ★ The daemon's Cancel is one file in ITS directory (it cannot write ours). Only its EXISTENCE is read — never its
#   contents, never followed — and it is removed with rm, which removes a link and not what it points at.
first_cancelled() { [ -e "$FIRST_CANCEL" ] || [ -L "$FIRST_CANCEL" ]; }
children_of() {
  if command -v pgrep >/dev/null 2>&1; then pgrep -P "$1" 2>/dev/null || true
  else awk -v p="$1" '$4 == p { print $1 }' /proc/[0-9]*/stat 2>/dev/null || true; fi
}
# ★★ STOP THE DOWNLOAD, NOT THE WRAPPER. Only apt-get and its download methods are signalled. overlayroot-chroot and
#    apt_do must run on to their own clean-up (the real root remounted read-only, /dev and the boot partition unbound) —
#    killing them would leave the real root mounted read-write under a running box. apt-get on SIGTERM drops its
#    partial files and its lock; nothing has been unpacked while it is still fetching.
stop_apt_under() {
  local c comm
  for c in $(children_of "$1"); do stop_apt_under "$c"; done
  comm=$(cat "/proc/$1/comm" 2>/dev/null || true)
  case "$comm" in apt-get|http|https) kill -TERM "$1" 2>/dev/null || true ;; esac
}
# Run "$@" (a command or apt_do …) with a time limit and the cancel. 0 done · 1 failed · 2 cancelled · 3 timed out.
run_watched() {
  local limit=$1 n=0 why="" rc=0 pid; shift
  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ -z "$why" ]; then
      if first_cancelled; then why=cancel; log "Cancel pressed — stopping the download"; stop_apt_under "$pid"
      elif [ "$n" -ge "$limit" ]; then why=timeout; log "!! no answer after ${limit} s — stopping"; stop_apt_under "$pid"; fi
    else
      stop_apt_under "$pid"    # ★ again, for a method started in between
    fi
    sleep 1; n=$((n + 1))
  done
  wait "$pid" || rc=$?
  case "$why" in cancel) return 2 ;; timeout) return 3 ;; esac
  [ "$rc" = 0 ] || return 1
  return 0
}
# ★ The quick look: OUR repository only (the stable source, and the beta one if this card has it), into a list
#   directory in RAM that is thrown away — no Debian or Armbian index, nothing written to the root, no stale answer from
#   an index left on the card. Prints apt-cache madison's lines for vibeserver.
first_look() {
  local f
  rm -rf "$FIRST_TMP"
  install -d -m 0755 "$FIRST_TMP" "$FIRST_TMP/lists" "$FIRST_TMP/lists/partial" || return 1
  : > "$FIRST_TMP/sources.list"
  for f in "$STABLE_LIST" "$BETA_LIST"; do
    if [ -f "$f" ] && [ ! -L "$f" ]; then cat "$f" >> "$FIRST_TMP/sources.list"; fi
  done
  FIRST_APT=(-o "Dir::Etc::SourceList=$FIRST_TMP/sources.list" -o Dir::Etc::SourceParts=- \
             -o "Dir::State::Lists=$FIRST_TMP/lists" -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= \
             -o APT::Get::List-Cleanup=false -o Acquire::Retries=0 \
             -o Acquire::http::Timeout=20 -o Acquire::https::Timeout=20)
  run_watched "$FIRST_CHECK_SECS" apt-get -q "${FIRST_APT[@]}" update
}
first_update() {
  local inst m s b o kind ver on=0 rc now
  if [ ! -f "$FIRST_ARM" ]; then log "this box was not set up from a new card — nothing to do (use Update VibeServer)"; return 0; fi
  if [ -e "$FIRST_REC" ] || [ -L "$FIRST_REC" ]; then
    log "the new-card update check has already run once — from now on Update VibeServer, or the schedule, does this"
    return 0
  fi
  # ★ A Cancel pressed while the request was still waiting for this helper counts: the file is NOT cleared here.
  inst=$(dpkg-query -W -f='${Version}' vibeserver 2>/dev/null | tr -cd 'A-Za-z0-9.+~:-' || true)
  first_rec checking "$inst" ""
  log "Checking for a VibeServer update (this is $inst)…"
  rc=0; first_look || rc=$?
  if [ "$rc" = 2 ]; then rm -f "$FIRST_CANCEL"; first_rec cancelled "$inst" "" cancel; log "Cancelled — VibeServer $inst is unchanged."; return 0; fi
  beta_is_on && on=1
  m=$(apt-cache "${FIRST_APT[@]}" madison vibeserver 2>/dev/null || true)
  rm -rf "$FIRST_TMP"
  s=$(printf '%s\n' "$m" | newest_in stable)
  b=$(printf '%s\n' "$m" | newest_in beta)
  o=$(offer_for "$on" "$inst" "$s" "$b")
  kind=${o%% *}; ver=""; [ "$o" = "$kind" ] || ver=${o#* }
  case "$kind" in
    unknown)
      # ★ No answer from the repository: no internet (a box set up on its own hotspot, a dead uplink, no DNS).
      first_rec offline "$inst" "" "$([ "$rc" = 3 ] && echo timeout || echo offline)"
      log "VibeServer cannot check for updates (no answer from apt.vibesdr.net) — proceeding with setup."
      return 0 ;;
    stable|beta) ;;
    *)
      # ★ none, or back-to-stable (a beta newer than every stable): nothing is EVER installed downwards here.
      first_rec uptodate "$inst" ""
      log "VibeServer is up to date ($inst)."
      return 0 ;;
  esac
  log "VibeServer $ver is available — downloading it"
  first_rec downloading "$inst" "$ver"
  # ★ Every source's index, as `update` does: the new package may need a system package the card does not have yet,
  #   and pocket_converge installs what this release's list adds. Cancellable — nothing is installed yet.
  rc=0; run_watched "$FIRST_INDEX_SECS" apt_do apt-get -q -o Acquire::Retries=1 \
          -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update || rc=$?
  if [ "$rc" = 0 ]; then
    rc=0; run_watched "$FIRST_FETCH_SECS" apt_do apt-get -q -y --only-upgrade --download-only \
            -o Acquire::Retries=1 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 \
            install "vibeserver=$ver" || rc=$?
  fi
  # ★ The last moment a Cancel can still be honoured: after this line dpkg runs, and dpkg is never interrupted.
  if [ "$rc" = 0 ] && first_cancelled; then rc=2; fi
  case "$rc" in
    0) ;;
    2) rm -f "$FIRST_CANCEL"; first_rec cancelled "$inst" "$ver" cancel
       log "Cancelled — nothing was installed; VibeServer $inst is unchanged."; return 0 ;;
    3) first_rec failed "$inst" "$ver" timeout
       log "!! The download took too long and was stopped — VibeServer $inst is unchanged. Update it later from the admin page."
       return 0 ;;
    *) first_rec failed "$inst" "$ver" download
       log "!! The download failed — VibeServer $inst is unchanged. Update it later from the admin page."
       return 0 ;;
  esac
  first_rec installing "$inst" "$ver"
  log "Installing VibeServer $ver — this part cannot be cancelled; it takes a minute"
  rc=0; apt_do apt-get -q -y --only-upgrade \
          -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
          install "vibeserver=$ver" || rc=$?
  rm -f "$FIRST_CANCEL"
  # ★ Asked of the REAL root (through the chroot): on a sealed card the live overlay may still show the old status file.
  now=$(apt_do dpkg-query -W -f='${Version}' vibeserver 2>/dev/null | tr -cd 'A-Za-z0-9.+~:-' || true)
  if [ "$rc" != 0 ] || [ "$now" != "$ver" ]; then
    first_rec failed "$inst" "$ver" install
    log "!! The install did not finish (apt said $rc; installed now: ${now:-?}). Update it later from the admin page."
    return 0
  fi
  pocket_converge
  write_offer
  first_rec updated "$inst" "$ver"
  log "Updated to VibeServer $ver."
  after_install
}

case "$action" in
  restart)      log "restarting vibeserver";     systemctl restart vibeserver ;;
  # ★ Asked for by the server's own stall watchdog, not by a button: sdrplay_apiService stopped
  #   answering ("WaitForResponse ... timed out - suspect Service problem"), every re-Init said
  #   AlreadyInitialised, and nothing an unprivileged process can send will clear it. The service
  #   is restarted and then VibeServer, which is what the owner did by hand on 2026-09-15.
  # ★★ THREE POSSIBLE SERVICES since the package carries its own (vibeserver-rsp, OpenRSP, 2026-10-21).
  #    The one that is RUNNING is the one the server is a client of; ours is installed everywhere but
  #    skips itself when a system SDRplay stack is present, so "the unit exists" no longer says which.
  #    Nothing running: the old rule (the first unit that exists) — a dead service is restarted, not left.
  sdrplay-restart) log "restarting the RSP driver service, then vibeserver"
                done_u=""
                for u in sdrplay.service sdrplay_apiService.service vibeserver-rsp.service; do
                  systemctl is-active --quiet "$u" && { systemctl restart "$u"; log "restarted $u"; done_u=1; break; }
                done
                if [ -z "$done_u" ]; then
                  for u in sdrplay.service sdrplay_apiService.service vibeserver-rsp.service; do
                    systemctl cat "$u" >/dev/null 2>&1 && { systemctl restart "$u"; log "restarted $u"; break; }
                  done
                fi
                sleep 3
                systemctl restart vibeserver ;;
  reboot)       log "rebooting";                 systemctl reboot ;;
  shutdown)     log "powering off";              systemctl poweroff ;;
  update-check) log "checking for updates"
                apt_do apt-get update
                # ★★ THEN SAY WHAT IS ACTUALLY AVAILABLE. Refreshing the index and printing
                #    nothing about the result is not "checking for updates" — the owner learns
                #    only that something happened. This is the line they actually want.
                echo
                n=$(apt list --upgradable 2>/dev/null | grep -c '^[a-z0-9]' || true)
                if [ "$n" -gt 0 ]; then
                  echo "$n package(s) can be upgraded:"
                  apt list --upgradable 2>/dev/null | grep '^[a-z0-9]' | cut -d/ -f1 | paste -sd' ' -
                  echo
                else
                  echo "Every system package is up to date."
                fi
                # ★★ VIBESERVER'S LINE COMES FROM THE OFFER (beta, stable, or back to stable), not from
                #    `apt list --upgradable` — that never lists a downgrade, so with beta updates just
                #    switched off it would say "up to date" on a box the page is offering to take back.
                write_offer
                say_offer ;;
  # ★★★ THE BETA TICK-BOX (see "BETA UPDATES" above). Each ends with a fresh index and a fresh offer, so the page
  #     says what UPDATE VIBESERVER will now do the moment the tick lands.
  beta-on)      log "turning on beta updates"
                line=$(beta_line) || { log "!! the VibeServer repository is not set up the usual way here (no $STABLE_LIST"
                                       log "!! and no $KEYRING) — run the one-line installer once, then tick this again"; exit 1; }
                beta_write "$line"
                log "added: $line"
                apt_do apt-get update
                echo
                write_offer
                say_offer ;;
  beta-off)     log "turning off beta updates"
                beta_write ""
                apt_do apt-get update
                echo
                write_offer
                say_offer ;;
  # ★★★ BACK TO STABLE — the one action that installs an OLDER VibeServer, and only by a person's press. Everything is
  #     decided again HERE, never taken from the request: beta must be off, and the version is the newest one the
  #     STABLE suite lists, from apt itself. Settings survive — 11.0.10-4 onwards keeps config keys it does not know.
  update-stable) log "returning to the stable VibeServer"
                apt_do apt-get update
                write_offer
                if beta_is_on; then log "!! beta updates are still ticked — untick them first"; exit 1; fi
                if [ "$OFFER_KIND" != back-to-stable ] || [ -z "$OFFER_VER" ]; then
                  log "nothing to go back to:"; say_offer; exit 0
                fi
                log "installing vibeserver $OFFER_VER (was $OFFER_INST)"
                apt_do apt-get install -y --allow-downgrades \
                  -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
                  "vibeserver=$OFFER_VER"
                pocket_converge
                write_offer
                after_install ;;
  update-all)   log "installing ALL available system updates"
                apt_do apt-get update
                # ★★ THE WHOLE SYSTEM, not just us. Offered because an owner who never logs in
                #    otherwise never gets security updates — but it is genuinely riskier than
                #    upgrading one package, so it is opt-in and the page says so.
                #    ★ -o Dpkg::Options 'confold': keep the admin's existing config files on a
                #      conflict rather than stopping to ask a question nobody is there to answer.
                #      An unattended upgrade that blocks on a prompt is an upgrade that never ends.
                apt_do apt-get -y \
                  -o Dpkg::Options::=--force-confdef \
                  -o Dpkg::Options::=--force-confold upgrade
                pocket_converge
                write_offer
                after_install ;;
  update)       log "installing updates"
                apt_do apt-get update
                # ★ ONLY this package, and never a fresh install of anything else. `--only-upgrade`
                #   means a request for `update` cannot pull in a new package by name.
                apt_do apt-get install -y --only-upgrade vibeserver
                # ★ A Portable's system packages + OS settings (see pocket_converge). Nothing elsewhere.
                pocket_converge
                # ★ The page's offer line follows (after a restart this process may already be gone — harmless).
                write_offer
                after_install ;;
  # ★★★ A NEW CARD'S ONE UPDATE CHECK — asked for by the setup page once the network is set up. See first_update.
  first-update) first_update || true ;;
  maps-install) log "installing the detail map pack"
                # ★★★ THE FULL MAP PACK, ON REQUEST. The server ships the basic pack; the detail
                #   pack is ~82 MB compressed and is its own package precisely so it is a choice
                #   rather than a download every owner pays for. Stuart's original shape for this:
                #   "tier 1 with prompt to download full maps when first setting up, and a setting
                #   to download them from the admin page afterwards."
                # ★ A named package and nothing else, the same discipline as `update` above: this
                #   path runs as root, so it asks for ONE thing by name and can never be talked
                #   into installing something else.
                apt_do apt-get update
                apt_do apt-get install -y vibeserver-mapdata-detail
                after_install ;;
  maps-remove)  log "removing the detail map pack"
                # ★ The way back. 82 MB on a Pi's SD card is worth being able to reclaim, and an
                #   install with no uninstall is a decision an owner cannot revisit.
                apt_do apt-get remove -y vibeserver-mapdata-detail
                after_install ;;
  # ★★★ DOWNLOAD DIAGNOSTICS (2026-10-20): one text file for the owner to send us. Built by vibeserver-diagnostics (it
  #     reads the journal and, on a Portable, dmesg and NetworkManager — root's to read), every secret scrubbed there,
  #     written HERE in root's directory (root:vibeserver 0640) for the daemon to serve — it can read it, never replace
  #     or redirect it. No python3 (a minimal install): a journal-only file, the daemon still scrubs what it knows.
  diagnostics)  log "building the diagnostics file"
                DIAG=$LOGDIR/diagnostics.txt
                rm -f "$DIAG" "$DIAG.tmp" 2>/dev/null || true
                if command -v python3 >/dev/null 2>&1 && [ -x /usr/lib/vibeserver/vibeserver-diagnostics ]; then
                  ( umask 027 && timeout 180 python3 -I /usr/lib/vibeserver/vibeserver-diagnostics > "$DIAG.tmp" ) \
                    || log "!! the diagnostics script did not finish — the file holds what it wrote"
                else
                  ( umask 027 && { echo "VibeServer diagnostics (no python3 here: the journal only)"
                                   dpkg-query -W -f='${Package} ${Version}\n' 'vibeserver*' 2>/dev/null; uname -a; uptime
                                   echo; echo "==== journal, last 24 h ===="
                                   journalctl --since -24h --no-pager -o short-iso -u 'vibeserver*' 2>/dev/null | tail -c 3000000
                                 } > "$DIAG.tmp" ) || true
                fi
                chgrp vibeserver "$DIAG.tmp" 2>/dev/null || true
                mv -f "$DIAG.tmp" "$DIAG" && log "diagnostics ready ($(( $(stat -c %s "$DIAG" 2>/dev/null || echo 0) / 1024 )) KB)" ;;
  *)            log "ignoring unknown action '$action'"; exit 0 ;;
esac
