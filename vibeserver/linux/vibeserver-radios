#!/bin/bash
# vibeserver-radios — start one VibeServer per radio the owner has enabled AND configured.
#
# ★★★ ONE PROCESS PER RADIO, which is the whole shape of multi-radio here. The shim is a singleton
#     and the wire protocol carries no radio id, so one process serving three radios would mean
#     threading an id through every socket, message and listener table. Separate processes get
#     that for free — and a separate crash domain with it, so one wedged radio cannot take the
#     others off the air.
#
# ★★ THE PRIMARY IS NOT STARTED HERE. It is `vibeserver.service`, exactly as it has always been,
#    and it keeps the machine's own port. That is what makes this safe to ship to every existing
#    install: a single-radio server does not gain a unit, does not change port, and does not
#    notice. This script only ever adds the SECOND and subsequent radios.
#
# ★ bash, not sh: `mapfile`, `[[ =~ ]]` and process substitution below. dash silently lacks both, which is how
#   vibeserver-maintenance broke once already.
set -uo pipefail

CONF="${VIBESERVER_CONFIG:-/etc/vibeserver/config.json}"
[ -r "$CONF" ] || { echo "vibeserver-radios: no readable $CONF — nothing to do"; exit 0; }

# ── What SHOULD be running ───────────────────────────────────────────────────────────────────
# Ask the binary rather than parsing JSON in shell: it already owns the rules for which radio is
# primary and which port each one takes, and two implementations of that would drift.
#
# ★★★ BUT NOT AS ROOT (2026-10-03 security pass). This script is root, and config.json belongs to
#     the daemon — so a compromised daemon controls every byte the parser sees. Parsing attacker-
#     controlled JSON in a root process turns any parser bug into root. The listing therefore runs
#     as the vibeserver user, with exactly the privilege the daemon already has, and only its
#     OUTPUT crosses back — and that output is then checked line by line (valid_serial) before a
#     single systemctl call is built from it.
#  ★ runuser (util-linux, Essential on Debian) rather than su/sudo: no PAM session, no password,
#    no NoNewPrivileges interaction. Only when we ARE root; run by hand as the user, it is already
#    unprivileged.
list_secondary() {
    if [ "$(id -u)" = 0 ]; then
        runuser -u vibeserver -- /usr/bin/vibeserver --list-secondary-radios 2>/dev/null
    else
        /usr/bin/vibeserver --list-secondary-radios 2>/dev/null
    fi
}

# ★★ A SERIAL IS A UNIT INSTANCE NAME HANDED TO systemctl AS ROOT — so it is held to a strict
#    alphabet first. Every real serial seen so far (RTL "00000001", SDRplay "2405xxxxxx", Airspy
#    HF+ "3b52ab5dac9d3f4b", HackRF "4") fits; anything else — a space, a slash, a leading '-' that
#    systemctl would read as an option, systemd's own '@' or '\' escapes — is refused and logged.
#  ★ The leading character may not be '-' or '.', so an instance name can never be an option or a
#    relative path component.
valid_serial() {
    [[ "$1" =~ ^[A-Za-z0-9_:][A-Za-z0-9._:-]{0,63}$ ]]
}

WANT=()
while IFS= read -r serial; do
    [ -z "$serial" ] && continue
    if valid_serial "$serial"; then
        WANT+=("$serial")
    else
        echo "vibeserver-radios: ignoring a radio with an unusable serial: $(printf '%q' "$serial")" >&2
    fi
done < <(list_secondary)

declare -A want_set=()
for serial in "${WANT[@]}"; do
    [ -n "$serial" ] && want_set["$serial"]=1
done

# ── What IS running ──────────────────────────────────────────────────────────────────────────
mapfile -t RUNNING < <(systemctl list-units --plain --no-legend --all 'vibeserver@*.service' 2>/dev/null \
                       | awk '{print $1}' | sed 's/^vibeserver@//; s/\.service$//')

# ── A serial change that has not been power-cycled yet ───────────────────────────────────────
# ★★★ THE ONE WINDOW WHERE THE CONFIG AND THE HARDWARE DISAGREE ON PURPOSE. After an EEPROM
#     rewrite, config.json names the NEW serial while the dongle on the bus still answers to the
#     OLD one — an RTL2832U only re-reads its EEPROM at power-on. Reconciling naively in that
#     window stops a radio that is running perfectly and then fails to start its replacement,
#     because the replacement does not exist until the machine reboots. So the old name is treated
#     as still wanted until the change has demonstrably taken.
# ★ The marker is removed by the server itself, and only once it has SEEN the new serial on the
#   bus — never on a timer, so this cannot expire while the dongle still answers to the old name.
PENDING=/var/lib/vibeserver/pending-serial.json
# ★ Daemon-written too: never followed if it is a link, and the serial checked like any other.
if [ -f "$PENDING" ] && [ ! -L "$PENDING" ] && [ -r "$PENDING" ]; then
    old_serial=$(head -c 512 "$PENDING" | sed -n 's/.*"old":"\([^"]*\)".*/\1/p' | head -n 1)
    if [ -n "$old_serial" ] && valid_serial "$old_serial"; then
        echo "vibeserver-radios: serial change pending — keeping $old_serial until the reboot"
        want_set["$old_serial"]=1
    fi
fi

# ── Stop what is no longer wanted ────────────────────────────────────────────────────────────
# ★ Before starting anything: a radio that has been switched off is still HOLDING its USB device,
#   and a newly enabled radio may be the same physical one under a different setting.
for serial in "${RUNNING[@]}"; do
    [ -z "$serial" ] && continue
    # ★ These come from systemd, not the daemon — but an instance someone created by hand with an
    #   odd name is still not something to feed back into systemctl unchecked.
    valid_serial "$serial" || continue
    if [ -z "${want_set[$serial]:-}" ]; then
        echo "vibeserver-radios: stopping $serial"
        systemctl stop "vibeserver@${serial}.service" 2>/dev/null
        systemctl disable "vibeserver@${serial}.service" 2>/dev/null
    fi
done

# ── Start what is ────────────────────────────────────────────────────────────────────────────
for serial in "${WANT[@]}"; do
    [ -z "$serial" ] && continue
    valid_serial "$serial" || continue          # already filtered; checked again at the point of use
    echo "vibeserver-radios: serving $serial"
    systemctl enable "vibeserver@${serial}.service" 2>/dev/null
    # restart, not start: if it is already up on stale settings this is how it picks up new ones.
    systemctl restart "vibeserver@${serial}.service" 2>/dev/null
done

exit 0
