[Unit]
# ★★ A HEADLESS BOX MUST COME BACK BY ITSELF. This is the whole point of the Pi appliance: it lives
# in a cupboard with a radio, and after a power cut nobody is going to log in and start it.
Description=VibeServer — SDR receiver server
Documentation=https://vibesdr.net
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ★ Options live in a config file, not in this unit. A user editing settings must never have to
# understand systemd — and `systemctl edit` overrides are invisible to anyone reading /etc.
# ★★★ THE DAEMON READS THE FILE, NOT SYSTEMD. This was EnvironmentFile + $VIBESERVER_ARGS, and
# systemd expands a variable but does NOT honour quotes inside the expansion — it splits on
# whitespace. So `--name VibeServer Pi500` sent "Pi500" in as a stray argument, the binary exited 2,
# and Restart=always looped it: saving any setting containing a SPACE broke the service
# (Stuart, 2026-08-01). Nothing shell-like ever parses that string, so quoting cannot save it.
# ★ Apply the owner's CPU governor first, as root ("+"), because the daemon itself is
#   unprivileged and sysfs is not writable to it. See vibeserver-governor for why it matters.
ExecStartPre=+/usr/lib/vibeserver/vibeserver-governor
ExecStart=/usr/bin/vibeserver --config /etc/vibeserver/vibeserver.conf
# ★★ RESTART ALWAYS, and rate-limited. A radio that fails to open (unplugged, or claimed by
# something else) must not spin the CPU retrying forever; five seconds is long enough to be polite
# and short enough that a replugged dongle comes back on its own.
Restart=always
RestartSec=5
# Run as an ordinary system user, not root. USB access comes from the udev rules shipped alongside.
User=vibeserver
Group=vibeserver
SupplementaryGroups=plugdev
# Modest hardening — this thing may be exposed to the internet.
# ★★★ LET THE REAL-TIME THREADS TAKE THE PRIORITY THEY ASK FOR. The DSP, the source reader, the
# DAB decoder and each listener's encode all call setpriority(-19) on themselves; a unit running as
# User=vibeserver cannot do that without this capability, so the call was failing and every thread
# ran at the default. Measured on the Pi before this line existed: nice 0, SCHED_OTHER, no caps —
# the DSP competing on equal terms with the web server and the tunnel. Falling behind is what the
# IQ-backlog counter in dspLoop exists to detect and what a listener hears as break-up.
# ★★ ONE CAPABILITY, NOT A BLANKET Nice=. Nice= would raise the WHOLE process, moving the accept
#    loop and the housekeeping tick up with the DSP and separating nothing. The capability lets the
#    code do what it already tries to do: lift only the chain that must keep real time.
# ★ Compatible with NoNewPrivileges=yes — systemd grants ambient capabilities itself rather than
#   the process acquiring them. If it is ever refused the server says so once and carries on.
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# ★★★ PrivateTmp=yes IS SAFE ONLY BECAUSE IT LEAVES /dev/shm ALONE. The SDRplay API talks to its
# service through SHARED MEMORY (/dev/shm/Glbl\sdrSrvDv00_*), not a socket — so the day that
# changes, the RSP stops being detected and nothing here will say why. systemd v257 added
# `PrivateTmp=disconnected`, which DOES give a private /dev/shm: do not "tighten" this to that
# value, and if a future default changes under us, this is the line to suspect first.
# ★ Verified 2026-08-06: restart with the API installed -> "SDRplay RSP detected".
PrivateTmp=yes
# ★★★ THE HAND-OFF SOCKETS LIVE HERE. RuntimeDirectory makes systemd create /run/vibeserver with
# the right owner and clean it up on stop — and, crucially, make it WRITABLE under
# ProtectSystem=strict. Without it mkdir() is refused silently, the radios never create their
# sockets, and the front door reports "no such file or directory" for every hand-off while looking
# otherwise healthy (2026-08-08).
RuntimeDirectory=vibeserver
RuntimeDirectoryMode=0700
# ★★★ PRESERVE IT, or stopping ONE unit deletes the directory for ALL of them. systemd removes a
# RuntimeDirectory when the unit stops, so restarting the front door wiped /run/vibeserver out from
# under two radios that were still running: they kept serving on their own ports and became
# unreachable through the front door, with "no such file or directory" as the only clue.
# ★ Every unit here shares this directory, so no single unit owns its lifetime.
RuntimeDirectoryPreserve=yes
StateDirectory=vibeserver
# ★★★ /etc/vibeserver MUST BE WRITABLE — the server now writes its own config.
# ProtectSystem=strict makes /etc read-only, which is right for a daemon whose settings a human
# edits by hand. It is wrong the moment the SERVER owns the file: saving from the browser setup
# page failed with "Read-only file system" and the owner had no way to tell why (2026-08-05).
# ★ Deliberately narrow — this ONE directory, with everything else still read-only.
ReadWritePaths=/var/lib/vibeserver /etc/vibeserver
# ★ The radio needs raw USB; everything else stays off.
DeviceAllow=char-usb_device rw

[Install]
WantedBy=multi-user.target
