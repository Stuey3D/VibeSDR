[Unit]
# ★★ A HEADLESS BOX MUST COME BACK BY ITSELF. This is the whole point of the Pi appliance: it lives
# in a cupboard with a radio, and after a power cut nobody is going to log in and start it.
Description=VibeServer — SDR receiver server
Documentation=https://vibesdr.net
After=network-online.target
Wants=network-online.target
# ★★★ THE RADIOS MUST COME UP WHENEVER THE FRONT DOOR DOES — Wants=, not just PartOf= (2026-09-24).
#
# The radios run as their own units (vibeserver@<serial>), started by vibeserver-radios.service.
# Those carry PartOf=vibeserver.service, which propagates STOP and RESTART but NEVER START. So a
# plain `systemctl restart vibeserver` worked, and a `stop` followed by a `start` left the front
# door running with every radio dead: the box answers, lists its radios, and hands every listener
# to a socket that is not there — "handoff to /run/vibeserver/<serial>.sock failed".
# ★★ AND STOP/START IS THE NORMAL WAY TO UPDATE. Replacing a running binary fails with "Text file
#    busy", so anyone installing a build by hand stops the service first. It looks exactly like the
#    update broke the radio. Found on the Pi 2 doing precisely that (Stuart: "fix that too").
# ★ Wants= (not Requires=) so a radio that cannot open — dongle unplugged, USB wedged — never stops
#   the front door from serving the setup page, which is the one thing you need to fix it from.
Wants=vibeserver-radios.service
Before=vibeserver-radios.service

[Service]
Type=simple
# ★ Options live in a config file, not in this unit. A user editing settings must never have to
# understand systemd — and `systemctl edit` overrides are invisible to anyone reading /etc.
# ★★★ THE DAEMON READS THE FILE, NOT SYSTEMD. This was EnvironmentFile + $VIBESERVER_ARGS, and
# systemd expands a variable but does NOT honour quotes inside the expansion — it splits on
# whitespace. So `--name VibeServer Pi500` sent "Pi500" in as a stray argument, the binary exited 2,
# and Restart=always looped it: saving any setting containing a SPACE broke the service
# (Stuart, 2026-08-01). Nothing shell-like ever parses that string, so quoting cannot save it.
# ★ Apply the owner's CPU governor first, as root ("+"), because the daemon itself is
#   unprivileged and sysfs is not writable to it. See vibeserver-governor for why it matters.
ExecStartPre=+/usr/lib/vibeserver/vibeserver-governor
ExecStart=/usr/bin/vibeserver --config /etc/vibeserver/vibeserver.conf
# ★★ RESTART ALWAYS, and rate-limited. A radio that fails to open (unplugged, or claimed by
# something else) must not spin the CPU retrying forever; five seconds is long enough to be polite
# and short enough that a replugged dongle comes back on its own.
Restart=always
RestartSec=5
# Run as an ordinary system user, not root. USB access comes from the udev rules shipped alongside.
User=vibeserver
Group=vibeserver
SupplementaryGroups=plugdev
# Modest hardening — this thing may be exposed to the internet.
# ★★★ LET THE REAL-TIME THREADS TAKE THE PRIORITY THEY ASK FOR. The DSP, the source reader, the
# DAB decoder and each listener's encode all call setpriority(-19) on themselves; a unit running as
# User=vibeserver cannot do that without this capability, so the call was failing and every thread
# ran at the default. Measured on the Pi before this line existed: nice 0, SCHED_OTHER, no caps —
# the DSP competing on equal terms with the web server and the tunnel. Falling behind is what the
# IQ-backlog counter in dspLoop exists to detect and what a listener hears as break-up.
# ★★ ONE CAPABILITY, NOT A BLANKET Nice=. Nice= would raise the WHOLE process, moving the accept
#    loop and the housekeeping tick up with the DSP and separating nothing. The capability lets the
#    code do what it already tries to do: lift only the chain that must keep real time.
# ★ Compatible with NoNewPrivileges=yes — systemd grants ambient capabilities itself rather than
#   the process acquiring them. If it is ever refused the server says so once and carries on.
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# ★★★ PrivateTmp=yes IS SAFE ONLY BECAUSE IT LEAVES /dev/shm ALONE. The SDRplay API talks to its
# service through SHARED MEMORY (/dev/shm/Glbl\sdrSrvDv00_*), not a socket — so the day that
# changes, the RSP stops being detected and nothing here will say why. systemd v257 added
# `PrivateTmp=disconnected`, which DOES give a private /dev/shm: do not "tighten" this to that
# value, and if a future default changes under us, this is the line to suspect first.
# ★ Verified 2026-08-06: restart with the API installed -> "SDRplay RSP detected".
PrivateTmp=yes
# ★★★ THE HAND-OFF SOCKETS LIVE HERE. RuntimeDirectory makes systemd create /run/vibeserver with
# the right owner and clean it up on stop — and, crucially, make it WRITABLE under
# ProtectSystem=strict. Without it mkdir() is refused silently, the radios never create their
# sockets, and the front door reports "no such file or directory" for every hand-off while looking
# otherwise healthy (2026-08-08).
RuntimeDirectory=vibeserver
RuntimeDirectoryMode=0700
# ★★★ PRESERVE IT, or stopping ONE unit deletes the directory for ALL of them. systemd removes a
# RuntimeDirectory when the unit stops, so restarting the front door wiped /run/vibeserver out from
# under two radios that were still running: they kept serving on their own ports and became
# unreachable through the front door, with "no such file or directory" as the only clue.
# ★ Every unit here shares this directory, so no single unit owns its lifetime.
RuntimeDirectoryPreserve=yes
StateDirectory=vibeserver
# ★★★ /etc/vibeserver MUST BE WRITABLE — the server now writes its own config.
# ProtectSystem=strict makes /etc read-only, which is right for a daemon whose settings a human
# edits by hand. It is wrong the moment the SERVER owns the file: saving from the browser setup
# page failed with "Read-only file system" and the owner had no way to tell why (2026-08-05).
# ★ Deliberately narrow — this ONE directory, with everything else still read-only.
ReadWritePaths=/var/lib/vibeserver /etc/vibeserver
# ★ The radio needs raw USB; everything else stays off.
DeviceAllow=char-usb_device rw
# ★★ The Pi's firmware mailbox, READ-ONLY — the true ARM clock and the throttle flags (vibe_vcio.h).
#    DeviceAllow= closes every other device, so group `video` alone would still be refused here.
#    On a machine with no /dev/vcio systemd logs that it cannot find it and carries on.
DeviceAllow=/dev/vcio r
# ★★ …and the node `video` can actually open on Pi OS (/dev/vcio itself is root-only there — measured on
#    the Pi 500, 2026-09-30). It carries only the vcgencmd text interface; see vibe_vcio.h.
DeviceAllow=/dev/vcio_gencmd r

# ── Further hardening (2026-10-03 security pass) ─────────────────────────────────────────────
# ★★★ EVERY LINE BELOW WAS CHECKED AGAINST WHAT THE DAEMON ACTUALLY DOES: raw USB through libusb
#     (/dev/bus/usb + netlink hotplug), /dev/vcio_gencmd read, CAP_SYS_NICE, children it spawns
#     (curl, cloudflared, ffmpeg, its own radios), writes to its state dir and /etc/vibeserver,
#     reads of /proc/self, /proc/stat, /proc/cpuinfo and /sys cpufreq/thermal/hwmon. If a radio or
#     a readout breaks after an upgrade, these are the lines to suspect — one at a time.
#  ★ Unknown keys are WARNED about and skipped by an older systemd (ProtectProc= is v247+), so
#    Buster-era boxes still start; they simply go without that one.
# Files and directories the daemon creates are NOT world-readable (group keeps read, for the
# helpers that run as the vibeserver group). config.json is 0600 regardless.
UMask=0027
# /var/lib/vibeserver: owner + group only. It holds the ban list, the connection log and the
# directory key; nothing outside the service account reads it.
StateDirectoryMode=0750
# Other users' processes vanish from /proc. The daemon only reads /proc/self/* and the system-wide
# files (/proc/stat, meminfo, cpuinfo, loadavg, uptime), which stay visible.
ProtectProc=invisible
# /proc/sys and /sys become read-only. Everything the daemon reads there (cpufreq, thermal, hwmon,
# power_supply) is a READ; the governor is written by the root ExecStartPre, which this does not
# reach (systemd applies the sandbox to the main process; "+" runs outside it).
ProtectKernelTunables=yes
# No module loading, no access to /usr/lib/modules. The DVB blacklist is a modprobe.d file, not us.
ProtectKernelModules=yes
# No kernel ring buffer (/dev/kmsg, /proc/kmsg, syslog(2)). The daemon never reads dmesg.
ProtectKernelLogs=yes
# The cgroup tree is read-only. We never move ourselves between cgroups.
ProtectControlGroups=yes
# No new namespaces of any kind — nothing here (or curl/cloudflared/ffmpeg) creates one.
RestrictNamespaces=yes
# personality(2) is locked to the default execution domain.
LockPersonality=yes
# Cannot create set-uid/set-gid files (the obvious step after a compromise).
RestrictSUIDSGID=yes
# ★★ AF_NETLINK IS REQUIRED: libusb's Linux hotplug listens on a NETLINK_KOBJECT_UEVENT socket, and
#    getifaddrs() (mDNS, the LAN address shown in setup) is netlink too. Without it a replugged
#    dongle is never seen again. AF_UNIX for the radio hand-off sockets and the SDRplay service.
#    No AF_PACKET, no AF_BLUETOOTH, no raw anything.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# ★ SystemCallFilter= is DELIBERATELY DEFERRED. @system-service would very likely be fine, but the
#   SDRplay API is a closed binary, ffmpeg and cloudflared are spawned children, and a filter that
#   kills one of them with SIGSYS on a box in a cupboard is exactly the "dead after upgrade with
#   nothing saying why" failure. It needs a soak on each radio type first, not a guess.

[Install]
WantedBy=multi-user.target
