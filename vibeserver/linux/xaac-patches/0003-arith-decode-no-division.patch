Subject: [PATCH 3/8] arith_dec: find the arithmetic-coder symbol without a division

VibeSDR patch for libxaac v0.1.14 (commit 2fbadd57; the decoder VibeServer links for xHE-AAC). Apache-2.0, as libxaac.
Written for VibeSDR, 2026-10-29; applied in the order of xaac-patches/series by vibeserver/linux/build-libxaac.sh (Linux
and Mac). Every file it changes carries a "Modified by VibeSDR" notice (Apache-2.0 section 4(b)). Measured with
xaacbench on the 7 ISO conformance streams, 12 xHE test streams (usac/xhe) and 4 off-air DAB+ unit logs, at PCM16 as
the server decodes, on arm64, armhf, ARMv6, i386 and amd64 (qemu) and the Mac. Instruction counts: qemu, guest
instructions per second of audio.

ixheaacd_arith_decode() divided the scaled value by the range for every symbol, then binary-searched cum_freq against
the quotient. For num >= 0, range > 0: (cf > num / range) is (cf * range > num), and (num / range <= 0) is
(num < range); cf <= 2^14 and range <= 2^16, so the product fits in 32 bits. Any other state takes the original
path. Decoded symbols identical; output bit-identical. Removes a library division per symbol on ARM without a hardware
divider (the armhf package's floor) and an idiv everywhere else.

diff --git a/decoder/ixheaacd_arith_dec.c b/decoder/ixheaacd_arith_dec.c
index d46b051..06bcd42 100644
--- a/decoder/ixheaacd_arith_dec.c
+++ b/decoder/ixheaacd_arith_dec.c
@@ -16,6 +16,11 @@
  *
  *****************************************************************************
  * Originally developed and contributed by Ittiam Systems Pvt. Ltd, Bangalore
+ *
+ * Modified by VibeSDR, 2026-10-29: ixheaacd_arith_decode() finds the symbol by
+ * comparing cum_freq * range against the scaled value, instead of dividing the
+ * value by range first (a library call per symbol on ARM without a divider).
+ * The comparison is equivalent, so the decoded symbols are identical.
 */
 #include <math.h>
 #include <string.h>
@@ -1741,6 +1746,31 @@ static WORD32 ixheaacd_arith_decode(ia_bit_buf_struct *it_bit_buff,
   value = s->value;
 
   range = high - low + 1;
+  {
+    /* VibeSDR: for num >= 0 and range > 0, (*q > num / range) is (*q * range > num),
+       and (num / range <= 0) is (num < range). cum_freq <= 2^14 and range <= 2^16,
+       so the product fits. Anything else (a damaged state) takes the original path. */
+    WORD32 num = (((WORD32)(value - low + 1)) << 14) - ((WORD32)1);
+    if (num >= 0 && range > 0 && range <= 65536) {
+      if (it_bit_buff->cnt_bits == 0)
+        if (num < range) {
+          longjmp(*(it_bit_buff->xaac_jmp_buf),
+                  IA_XHEAAC_DEC_EXE_NONFATAL_INSUFFICIENT_INPUT_BYTES);
+        }
+      p = cum_freq - 1;
+
+      do {
+        q = p + (cfl >> 1);
+
+        if ((WORD32)*q * range > num) {
+          p = q;
+          cfl++;
+        }
+        cfl >>= 1;
+      } while (cfl > 1);
+      goto vibe_found;
+    }
+  }
   cumulative = ((((WORD32)(value - low + 1)) << 14) - ((WORD32)1)) / ((WORD32)range);
 
   if (it_bit_buff->cnt_bits == 0)
@@ -1758,6 +1788,7 @@ static WORD32 ixheaacd_arith_decode(ia_bit_buf_struct *it_bit_buff,
     }
     cfl >>= 1;
   } while (cfl > 1);
+vibe_found:
 
   symbol = (WORD32)(p - cum_freq + 1);
 
