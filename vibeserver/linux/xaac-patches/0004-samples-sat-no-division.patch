Subject: [PATCH 4/8] decode_main: ixheaacd_samples_sat() without a division per sample

VibeSDR patch for libxaac v0.1.14 (commit 2fbadd57; the decoder VibeServer links for xHE-AAC). Apache-2.0, as libxaac.
Written for VibeSDR, 2026-10-29; applied in the order of xaac-patches/series by vibeserver/linux/build-libxaac.sh (Linux
and Mac). Every file it changes carries a "Modified by VibeSDR" notice (Apache-2.0 section 4(b)). Measured with
xaacbench on the 7 ISO conformance streams, 12 xHE test streams (usac/xhe) and 4 off-air DAB+ unit logs, at PCM16 as
the server decodes, on arm64, armhf, ARMv6, i386 and amd64 (qemu) and the Mac. Instruction counts: qemu, guest
instructions per second of audio.

The PCM output loop indexed out_samples[i % ch][i / ch]: a division and a modulo per output sample (a library call on
32-bit ARM, 4 % of an xHE stream). Two nested loops give the same samples in the same order. Bit-identical.

diff --git a/decoder/ixheaacd_decode_main.c b/decoder/ixheaacd_decode_main.c
index 982a6aa..ba5bd27 100644
--- a/decoder/ixheaacd_decode_main.c
+++ b/decoder/ixheaacd_decode_main.c
@@ -16,6 +16,10 @@
  *
  *****************************************************************************
  * Originally developed and contributed by Ittiam Systems Pvt. Ltd, Bangalore
+ *
+ * Modified by VibeSDR, 2026-10-29: ixheaacd_samples_sat() walks samples and
+ * channels in two loops instead of a division and a modulo per output sample.
+ * Same samples, same order.
 */
 #include <stdlib.h>
 #include <string.h>
@@ -92,35 +96,41 @@ VOID ixheaacd_samples_sat(WORD8 *outbuffer, WORD32 num_samples_out,
   num = num_channel_out * num_samples_out;
 
   if (pcmsize == 16) {
-    for (i = 0; i < num; i++) {
-      write_local_float =
-          (out_samples[i % num_channel_out][i / num_channel_out]);
-
-      if (write_local_float > 32767.0f) {
-        write_local_float = 32767.0f;
-      } else if (write_local_float < -32768.0f) {
-        write_local_float = -32768.0f;
+    /* VibeSDR: i = j * num_channel_out + c, without dividing per sample */
+    WORD32 j, c;
+    i = 0;
+    for (j = 0; j < num_samples_out; j++) {
+      for (c = 0; c < num_channel_out; c++, i++) {
+        write_local_float = out_samples[c][j];
+
+        if (write_local_float > 32767.0f) {
+          write_local_float = 32767.0f;
+        } else if (write_local_float < -32768.0f) {
+          write_local_float = -32768.0f;
+        }
+        out_buf[i] = (WORD16)write_local_float;
       }
-      out_buf[i] = (WORD16)write_local_float;
     }
 
     *out_bytes = num * sizeof(WORD16);
   } else {
     WORD8 *out_24bit = (WORD8 *)out_buf;
-    for (i = 0; i < num; i++) {
-      write_local_float =
-          (out_samples[i % num_channel_out][i / num_channel_out] * 256);
+    WORD32 j, c;
+    for (j = 0; j < num_samples_out; j++) {
+      for (c = 0; c < num_channel_out; c++) {
+        write_local_float = (out_samples[c][j] * 256);
+
+        if (write_local_float > 8388607.0f) {
+          write_local_float = 8388607.0f;
+        } else if (write_local_float < -8388608.0f) {
+          write_local_float = -8388608.0f;
+        }
+        write_local = (WORD32)write_local_float;
 
-      if (write_local_float > 8388607.0f) {
-        write_local_float = 8388607.0f;
-      } else if (write_local_float < -8388608.0f) {
-        write_local_float = -8388608.0f;
+        *out_24bit++ = (WORD32)write_local & 0xff;
+        *out_24bit++ = ((WORD32)write_local >> 8) & 0xff;
+        *out_24bit++ = ((WORD32)write_local >> 16) & 0xff;
       }
-      write_local = (WORD32)write_local_float;
-
-      *out_24bit++ = (WORD32)write_local & 0xff;
-      *out_24bit++ = ((WORD32)write_local >> 8) & 0xff;
-      *out_24bit++ = ((WORD32)write_local >> 16) & 0xff;
     }
 
     *out_bytes = num * 3 * sizeof(WORD8);
