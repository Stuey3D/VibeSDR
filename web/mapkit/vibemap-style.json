{
  "version": 8,
  "name": "VibeSDR basemap (GPU)",
  "metadata": {
    "vibesdr:note": "One style for the app (MapLibre Native) and the web (MapLibre GL JS). Palette copied from vibemap.js; zooms are MapLibre zooms (Leaflet zoom minus one) — see scripts/gen-map-tiles.mjs. Sources and glyphs are placeholders the host fills in.",
    "vibesdr:todo": "glyphs must be bundled for offline use before this ships; the demotiles URL is desktop-proof only"
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "basic":  { "type": "vector", "url": "BASIC_URL",  "maxzoom": 6 },
    "detail": { "type": "vector", "url": "DETAIL_URL", "maxzoom": 10 }
  },
  "layers": [
    { "id": "sea", "type": "background", "paint": { "background-color": "#123049" } },

    { "id": "shelf-b",  "type": "fill", "source": "basic",  "source-layer": "shelf", "maxzoom": 6,
      "paint": { "fill-color": "#194060", "fill-opacity": 0.58 } },
    { "id": "shelf-d",  "type": "fill", "source": "detail", "source-layer": "shelf", "minzoom": 6,
      "paint": { "fill-color": "#194060", "fill-opacity": 0.58 } },

    { "id": "land-b",   "type": "fill", "source": "basic",  "source-layer": "land", "maxzoom": 9,
      "paint": { "fill-color": "#3c5a3f" } },
    { "id": "land-d",   "type": "fill", "source": "detail", "source-layer": "land", "minzoom": 6,
      "paint": { "fill-color": "#3c5a3f" } },
    { "id": "islands",  "type": "fill", "source": "basic",  "source-layer": "islands",
      "paint": { "fill-color": "#3c5a3f" } },

    { "id": "cover-b",  "type": "fill", "source": "basic",  "source-layer": "cover", "maxzoom": 7,
      "paint": { "fill-color": ["match", ["get", "cls"], "desert", "#6d6142", "tundra", "#4a5750",
                                "wetland", "#33523f", "ice", "#8d9aa2", "alpine", "#6f7581", "#3c5a3f"] } },
    { "id": "cover-d",  "type": "fill", "source": "detail", "source-layer": "cover", "minzoom": 7,
      "paint": { "fill-color": ["match", ["get", "cls"], "desert", "#6d6142", "tundra", "#4a5750",
                                "wetland", "#33523f", "ice", "#8d9aa2", "alpine", "#6f7581", "#3c5a3f"] } },
    { "id": "playas",   "type": "fill", "source": "basic",  "source-layer": "playas",
      "paint": { "fill-color": "#8a8470" } },
    { "id": "urban-b",  "type": "fill", "source": "basic",  "source-layer": "urban", "maxzoom": 7,
      "paint": { "fill-color": "#5a5d62" } },
    { "id": "urban-d",  "type": "fill", "source": "detail", "source-layer": "urban", "minzoom": 7,
      "paint": { "fill-color": "#5a5d62" } },
    { "id": "lakes-b",  "type": "fill", "source": "basic",  "source-layer": "lakes", "maxzoom": 6,
      "paint": { "fill-color": "#1b4a6b" } },
    { "id": "lakes-d",  "type": "fill", "source": "detail", "source-layer": "lakes", "minzoom": 6,
      "paint": { "fill-color": "#1b4a6b" } },

    { "id": "coast-b",  "type": "line", "source": "basic",  "source-layer": "land", "maxzoom": 9,
      "paint": { "line-color": "#b5dcc0", "line-width": 0.9, "line-opacity": 0.9 } },
    { "id": "coast-d",  "type": "line", "source": "detail", "source-layer": "land", "minzoom": 9,
      "filter": ["has", "coast"],
      "paint": { "line-color": "#6fa37b", "line-width": 0.6, "line-opacity": 0.8 } },
    { "id": "reefs",    "type": "line", "source": "basic",  "source-layer": "reefs",
      "paint": { "line-color": "#4e8f93", "line-width": 1 } },
    { "id": "rivers-b", "type": "line", "source": "basic",  "source-layer": "rivers", "maxzoom": 6,
      "paint": { "line-color": "#3f7ba0", "line-width": 0.8 } },
    { "id": "rivers-d", "type": "line", "source": "detail", "source-layer": "rivers", "minzoom": 6,
      "paint": { "line-color": "#3f7ba0", "line-width": 1 } },
    { "id": "admin1-b", "type": "line", "source": "basic",  "source-layer": "admin1", "maxzoom": 7,
      "paint": { "line-color": "#5a7a5f", "line-width": 0.6, "line-dasharray": [3, 2] } },
    { "id": "admin1-d", "type": "line", "source": "detail", "source-layer": "admin1", "minzoom": 7,
      "paint": { "line-color": "#5a7a5f", "line-width": 0.6, "line-dasharray": [3, 2] } },
    { "id": "rail",     "type": "line", "source": "basic",  "source-layer": "rail", "minzoom": 4,
      "paint": { "line-color": "#6a6a4e", "line-width": 0.7, "line-dasharray": [2, 2] } },
    { "id": "roads-b",  "type": "line", "source": "basic",  "source-layer": "roads", "minzoom": 4, "maxzoom": 7,
      "paint": { "line-color": "#6a6a4e", "line-width": 0.8 } },
    { "id": "roads-d",  "type": "line", "source": "detail", "source-layer": "roads", "minzoom": 7,
      "paint": { "line-color": "#6a6a4e", "line-width": 1.1 } },
    { "id": "borders",  "type": "line", "source": "detail", "source-layer": "borders", "minzoom": 3,
      "paint": { "line-color": "#b5dcc0", "line-width": 1.1, "line-opacity": 0.9 } },
    { "id": "geolines", "type": "line", "source": "basic",  "source-layer": "geolines", "minzoom": 1, "maxzoom": 8,
      "paint": { "line-color": "#d9a441", "line-width": 0.8, "line-opacity": 0.6, "line-dasharray": [4, 3] } },
    { "id": "runways",  "type": "line", "source": "detail", "source-layer": "runways", "minzoom": 8,
      "paint": { "line-color": "#c9c9b0", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 12, 5] } },

    { "id": "regions",  "type": "symbol", "source": "basic", "source-layer": "regions", "maxzoom": 6,
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Italic"], "text-size": 10,
                  "text-letter-spacing": 0.2, "symbol-sort-key": ["get", "rank"] },
      "paint": { "text-color": "rgba(170,200,190,0.55)" } },
    { "id": "places",   "type": "symbol", "source": "basic", "source-layer": "places",
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Regular"],
                  "text-size": ["interpolate", ["linear"], ["get", "rank"], 0, 13, 10, 10],
                  "symbol-sort-key": ["get", "rank"], "text-anchor": "left", "text-offset": [0.4, 0] },
      "paint": { "text-color": "rgba(210,235,215,0.82)", "text-halo-color": "#123049", "text-halo-width": 1 } },
    { "id": "places-d", "type": "symbol", "source": "detail", "source-layer": "places", "minzoom": 7,
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Regular"], "text-size": 11,
                  "symbol-sort-key": ["get", "rank"], "text-anchor": "left", "text-offset": [0.4, 0] },
      "paint": { "text-color": "#9ec9a8", "text-halo-color": "#123049", "text-halo-width": 1 } },
    { "id": "airports", "type": "symbol", "source": "basic", "source-layer": "airports", "minzoom": 4,
      "filter": ["<=", ["get", "cls"], 1],
      "layout": { "text-field": ["coalesce", ["get", "iata"], ["get", "icao"]], "text-font": ["Open Sans Bold"],
                  "text-size": 10, "symbol-sort-key": ["get", "cls"] },
      "paint": { "text-color": "#f0c56a", "text-halo-color": "#123049", "text-halo-width": 1 } },
    { "id": "countries", "type": "symbol", "source": "basic", "source-layer": "countrylabels", "maxzoom": 7,
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Bold"],
                  "text-size": ["interpolate", ["linear"], ["get", "rank"], 1, 13, 6, 10],
                  "text-transform": "uppercase", "text-letter-spacing": 0.1, "symbol-sort-key": ["get", "rank"] },
      "paint": { "text-color": "rgba(230,240,225,0.9)", "text-halo-color": "#123049", "text-halo-width": 1.2 } }
  ]
}
